//! The same mainnet block through fevm's own block layer, beside
//! fevm-replay's: `fevm_chain` decodes the header and validates it against
//! its parent, decodes each transaction from its bytes (recovering its
//! sender from the signature), and hashes the transactions, receipts and
//! withdrawals; `fevm::Block` runs the system calls, the transactions, the
//! withdrawals and the request contracts. Everything the header commits to
//! is compared; the state root of `Block`'s end state is computed from the
//! parent's witness, as for fevm-replay's own run. Two block drivers on one
//! EVM, one mainnet block: they must agree with the header and so with
//! each other.
use core::MemVec
use std::io::{Display, Stdout}
use json::Value
use fevm::{BlobSchedule, Block, Config, Evm, Withdrawal, WorldState}
use fevm::status::VALID
use fevm_chain::{Header, Trie, decode_transaction, encode_receipt}
use ingot::load::field
use ingot::proof
use ingot::roots
use ingot::stateless
use ingot::chunks::CodeWatch
use ingot::gas4762

/// What the second run gives: whether it agrees with the header, and the
/// code it ran, as a witness would carry it.
pub struct Crosschecked {
    pub agreed: bool,
    /// The 31-byte chunks executed, by the address that holds the code
    /// (an EIP-7702 delegate's, for a delegated account); none of code
    /// created in the block.
    pub code: WorldState,
    /// Contracts whose code ran, and their whole code in bytes, as a
    /// Merkle-Patricia witness carries it.
    pub contracts: u64,
    pub code_bytes: u64,
    /// The chunks executed.
    pub chunks: u64,
    /// Each transaction's gas used, and what EIP-4762 would charge for its
    /// witness against today's charges for the same accesses and writes.
    pub tx_gas: MemVec<u64>,
    pub charges: MemVec<gas4762::Charged>,
}

fn failed() -> Crosschecked {
    Crosschecked {
        agreed: false,
        code: WorldState::empty(),
        contracts: 0,
        code_bytes: 0,
        chunks: 0,
        tx_gas: MemVec::new(),
        charges: MemVec::new(),
    }
}

fn root_or_zero(_ trie: own Trie) -> u256 {
    match trie.root() {
        Option::Some(root) => root,
        Option::None => 0,
    }
}

fn differs<T: Display>(_ wrong: mut u64, _ name: T) uses (out: mut Stdout) {
    println!("FEVM_CHAIN ", name, " differs from the header")
    wrong += 1
}

/// Runs the block on `pre`, the world the parent left as its proofs prove
/// it, and prints what agrees. True when the header is valid against its
/// parent, every transaction decodes to its hash and sender, and every
/// commitment in the header, the state root included, comes out of
/// `fevm_chain` and `fevm::Block`.
pub fn run(
    _ pre: own WorldState,
    _ header: Value,
    _ parent: Value,
    _ proofs: Value,
    parent_root: u256,
    _ keys: WorldState,
    code_unknown: MemVec<u256>,
    chain_id: u256,
    _ prestates: Value,
    _ diffs: Value,
) -> Crosschecked
uses (out: mut Stdout)
{
    var world = pre
    // The request contracts and the withdrawal recipients no transaction
    // touched enter the world as the parent's proofs prove them, as for
    // fevm-replay's run.
    for c in 0 .. 2 {
        let target = if c == 0 {
            proof::WITHDRAWAL_REQUESTS
        } else {
            proof::CONSOLIDATION_REQUESTS
        }
        // Before any transaction, every slot is the parent's: none is skipped.
        if !proof::load_request_contract(
            mut world,
            proofs,
            state_root: parent_root,
            address: target,
            WorldState::empty(),
        ) {
            println!("fevm_chain: a request contract is not proven")
            return failed()
        }
    }
    if header.has("withdrawals") {
        for ref w in header["withdrawals"].items() {
            let address = field(w, "address")
            if !world.exists(address) {
                let Option::Some(account) = proof::find_account(
                    proofs["pre"],
                    state_root: parent_root,
                    address,
                ) else {
                    println!("fevm_chain: a withdrawal recipient is not proven")
                    return failed()
                }
                world.set_balance(address, account.balance)
                world.set_nonce(address, account.nonce)
            }
        }
    }
    let encoded = proof::header_rlp(header)
    let parent_encoded = proof::header_rlp(parent)
    let Result::Ok(blk) = Header::decode(encoded.span()) else {
        println!("fevm_chain: the header does not decode")
        return failed()
    }
    let Result::Ok(before) = Header::decode(parent_encoded.span()) else {
        println!("fevm_chain: the parent's header does not decode")
        return failed()
    }
    // Mainnet since BPO2 (EIP-7892): Osaka's rules with a target of 14 blobs
    // a block and a maximum of 21. `Config::osaka()` holds Osaka's own schedule.
    var config = Config::osaka()
    config.blob_schedule = BlobSchedule { target: 14, max: 21, update_fraction: 11_684_671 }
    var wrong: u64 = 0
    if blk.hash != field(header, "hash") {
        differs(mut wrong, "block hash")
    }
    if let Result::Err(_) = blk.validate(before, config) {
        differs(mut wrong, "header against its parent")
    }
    let Option::Some(env) = blk.block_env(chain_id: chain_id, config) else {
        println!("fevm_chain: no block environment from the header")
        return failed()
    }
    var block = Block::begin(
        Evm::new(world, config),
        env,
        parent_hash: blk.parent_hash,
        parent_beacon_block_root: blk.parent_beacon_block_root,
    )
    var watch = CodeWatch::new()
    var transactions = Trie::new()
    var receipts = Trie::new()
    var decoded: u64 = 0
    var undecoded: u64 = 0
    var rejected: u64 = 0
    var senders: u64 = 0
    var tx_gas: MemVec<u64> = MemVec::new()
    var charges: MemVec<gas4762::Charged> = MemVec::new()
    var t: usize = 0
    for ref tx in header["transactions"].items() {
        let bytes = roots::encode_tx(tx)
        transactions.item().raw(bytes.span())
        match decode_transaction(bytes.span()) {
            Result::Ok((request, hash)) => {
                decoded += 1
                if hash == field(tx, "hash") && request.env.sender == field(tx, "from") {
                    senders += 1
                }
                // Each transaction's own chunks: EIP-4762 charges per
                // transaction.
                var ran = CodeWatch::new()
                let receipt = block.transact(request, mut ran)
                if receipt.invalid != VALID {
                    rejected += 1
                }
                let target = match receipt.created {
                    Option::Some(created) => created,
                    Option::None => field(tx, "to"),
                }
                let charged = gas4762::charge(
                    prestates[t]["result"],
                    diffs[t]["result"]["pre"],
                    diffs[t]["result"]["post"],
                    ran.chunks,
                    origin: field(tx, "from"),
                    target,
                    value: field(tx, "value"),
                    coinbase: field(header, "miner"),
                )
                tx_gas.push(receipt.gas_used)
                charges.push(charged)
                watch.absorb(ran)
                encode_receipt(mut receipts.item(), receipt, kind: request.env.kind)
            },
            Result::Err(_) => {
                undecoded += 1
            },
        }
        t += 1
    }
    var withdrawals: MemVec<Withdrawal> = MemVec::new()
    var withdrawals_trie = Trie::new()
    let w_encoded = roots::withdrawals(header)
    for i in 0 .. w_encoded.len() {
        withdrawals_trie.item().raw(w_encoded[i].span())
    }
    if header.has("withdrawals") {
        for ref w in header["withdrawals"].items() {
            withdrawals
                .push(
                    Withdrawal {
                        address: field(w, "address"),
                        amount: field(w, "amount").downcast_truncate(),
                    },
                )
        }
    }
    let (evm, finished) = block.finish(withdrawals)
    let Result::Ok(output) = finished else {
        println!("fevm_chain: fevm's Block did not finish the block")
        return failed()
    }
    if undecoded > 0 || rejected > 0 || senders != decoded {
        differs(mut wrong, "transactions")
    }
    if output.gas_used != blk.gas_used {
        differs(mut wrong, "gasUsed")
    }
    if root_or_zero(transactions) != blk.transactions_root {
        differs(mut wrong, "transactionsRoot")
    }
    if root_or_zero(receipts) != blk.receipt_root {
        differs(mut wrong, "receiptsRoot")
    }
    if output.logs_bloom.words != blk.bloom.words {
        differs(mut wrong, "logsBloom")
    }
    if root_or_zero(withdrawals_trie) != blk.withdrawals_root {
        differs(mut wrong, "withdrawalsRoot")
    }
    if output.blob_gas_used != blk.blob_gas_used {
        differs(mut wrong, "blobGasUsed")
    }
    if output.requests_hash != blk.requests_hash {
        differs(mut wrong, "requestsHash")
    }
    let end = evm.into_world()
    // The code that ran, by the account holding it.
    var code = WorldState::empty()
    var contracts: u64 = 0
    var code_bytes: u64 = 0
    var chunks: u64 = 0
    for e in 0 .. watch.chunks.storage_slots() {
        let entry = watch.chunks.storage_at(e)
        if !entry.occupied || watch.created.exists(entry.address) {
            continue
        }
        let owner = match end.delegate(entry.address) {
            Option::Some(delegate) => delegate,
            Option::None => entry.address,
        }
        if !code.exists(owner) {
            let _ = code.ensure_account(owner)
            contracts += 1
            code_bytes += end.code_size(owner).downcast_unchecked()
        }
        if code.storage_load(owner, entry.slot) == 0 {
            let _ = code.storage_store(owner, entry.slot, 1)
            chunks += 1
        }
    }
    let computed = stateless::state_root(end, parent_root, proofs, keys, code_unknown)
    if computed.root != blk.state_root {
        differs(mut wrong, "stateRoot")
    }
    if wrong == 0 {
        println!(
            "fevm_chain: the header is valid against its parent; ",
            decoded,
            " transactions decoded from their bytes, each to its hash and the sender its signature recovers; fevm::Block ran the system calls, transactions, withdrawals and request contracts; gasUsed, transactionsRoot, receiptsRoot, logsBloom, withdrawalsRoot, blobGasUsed, requestsHash and, from the witness, stateRoot agree with the header",
        )
        return Crosschecked { agreed: true, code, contracts, code_bytes, chunks, tx_gas, charges }
    }
    println!(
        "  (",
        decoded,
        " decoded, ",
        undecoded,
        " not, ",
        rejected,
        " rejected, ",
        senders,
        " to their hash and sender)",
    )
    Crosschecked { agreed: false, code, contracts, code_bytes, chunks, tx_gas, charges }
}
