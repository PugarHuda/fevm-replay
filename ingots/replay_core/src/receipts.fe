//! The receipts trie of a block, built from what fevm produced: each
//! transaction's status, cumulative gas, logs bloom and logs, encoded as
//! Ethereum encodes receipts (EIP-2718 typed), put in a Merkle-Patricia
//! trie under `rlp(index)`. Its root must equal the header's
//! `receiptsRoot`: then every status, gas figure and log fevm produced is
//! what the chain committed to, whatever the node sent. Like `proof`, this
//! reaches neither the network nor the disk.

use core::{MemBuffer, MemSpan, MemVec}
use core::hash::keccak256_word
use std::io::Display
use fevm::LogBuffer

// RLP: a string's encoding into `out`.
pub fn put_string(_ out: mut MemBuffer, _ bytes: MemSpan) {
    let len = bytes.len()
    if len == 1 && bytes[0] < 0x80 {
        out.push(bytes[0])
        return
    }
    put_header(mut out, 0x80, len)
    for i in 0 .. len {
        out.push(bytes[i])
    }
}

// RLP: the header of a string (`base` 0x80) or a list (`base` 0xc0) of
// `len` payload bytes.
pub fn put_header(_ out: mut MemBuffer, _ base: u8, _ len: usize) {
    if len < 56 {
        out.push(base + len.downcast_truncate())
        return
    }
    var size: usize = 0
    var rest = len
    while rest > 0 {
        size += 1
        rest = rest >> 8
    }
    out.push(base + 55 + size.downcast_truncate())
    var shift = size
    while shift > 0 {
        shift -= 1
        out.push(((len >> (shift * 8)) & 0xff).downcast_truncate())
    }
}

// RLP: a list of the already encoded `payload`.
pub fn put_list(_ out: mut MemBuffer, _ payload: MemSpan) {
    put_header(mut out, 0xc0, payload.len())
    for i in 0 .. payload.len() {
        out.push(payload[i])
    }
}

// The big-endian bytes of `value`: `width` bytes, or with `width` 0 as few
// as it takes (none for zero), as RLP integers are.
pub fn word_bytes(_ value: u256, width: usize) -> MemBuffer {
    var size = width
    if size == 0 {
        var rest = value
        while rest > 0 {
            size += 1
            rest = rest >> 8
        }
    }
    var out = MemBuffer::empty()
    var i = size
    while i > 0 {
        i -= 1
        out.push(((value >> (i * 8) as u256) & 0xff).downcast_truncate())
    }
    out
}

pub fn put_word(_ out: mut MemBuffer, _ value: u256, width: usize) {
    put_string(mut out, word_bytes(value, width).span())
}

// Sets the three bloom bits of `bytes` (EIP: the low 11 bits of the first
// three byte pairs of its keccak).
fn bloom_add(_ bloom: mut [u8; 256], _ bytes: MemSpan) {
    let hash = keccak256_word(bytes)
    for k in 0 .. 3 {
        let shift: u256 = (240 - 16 * k) as u256
        let bit: usize = ((hash >> shift) & 0x7ff).downcast_unchecked()
        let at = 255 - bit / 8
        let mask: u8 = (1 << (bit % 8)).downcast_truncate()
        bloom[at] = bloom[at] | mask
    }
}

/// A receipt as the chain encodes it: `type || rlp([status, cumulative
/// gas, bloom, logs])`, without the type byte for a legacy transaction.
/// Its bloom is also added to `block_bloom`, the header's `logsBloom`.
pub fn encode(
    tx_type: u256,
    success: bool,
    cumulative_gas: u256,
    _ logs: LogBuffer,
    block_bloom: mut [u8; 256],
) -> MemBuffer {
    var bloom: [u8; 256] = [0; 256]
    var all_logs = MemBuffer::empty()
    var index: u64 = 0
    while index < logs.len() {
        let entry = logs.entry(index)
        let address = word_bytes(entry.address, width: 20)
        bloom_add(mut bloom, address.span())
        var topics = MemBuffer::empty()
        let topic_count: usize = entry.topic_count.downcast_unchecked()
        for t in 0 .. topic_count {
            let topic = word_bytes(entry.topics[t], width: 32)
            bloom_add(mut bloom, topic.span())
            put_string(mut topics, topic.span())
        }
        var log = MemBuffer::empty()
        put_string(mut log, address.span())
        put_list(mut log, topics.span())
        put_string(mut log, logs.payload(index))
        put_list(mut all_logs, log.span())
        index += 1
    }
    var fields = MemBuffer::empty()
    put_word(mut fields, if success { 1 } else { 0 }, width: 0)
    put_word(mut fields, cumulative_gas, width: 0)
    var bloom_bytes = MemBuffer::empty()
    for i in 0 .. 256 {
        bloom_bytes.push(bloom[i])
        block_bloom[i] = block_bloom[i] | bloom[i]
    }
    put_string(mut fields, bloom_bytes.span())
    put_list(mut fields, all_logs.span())
    var out = MemBuffer::empty()
    if tx_type != 0 {
        out.push(tx_type.downcast_truncate())
    }
    put_list(mut out, fields.span())
    out
}

/// The root of a block's receipts (or transactions) trie: `values[i]` under
/// the key `rlp(i)`.
pub fn trie_root(_ values: MemVec<MemBuffer>) -> u256 {
    if values.len() == 0 {
        // keccak256(rlp("")): the empty trie.
        return 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421
    }
    // Each key's nibbles: rlp(i) is 0x80 for 0, the byte itself below 128,
    // then 0x81 nn, 0x82 nn nn. No key is a prefix of another.
    var keys: MemVec<MemBuffer> = MemVec::new()
    var members: MemVec<usize> = MemVec::new()
    for i in 0 .. values.len() {
        var key = MemBuffer::empty()
        put_word(mut key, i as u256, width: 0)
        var nibbles = MemBuffer::empty()
        for b in 0 .. key.len() {
            nibbles.push(key.span()[b] >> 4)
            nibbles.push(key.span()[b] & 0xf)
        }
        keys.push(nibbles)
        members.push(i)
    }
    let root = node(keys, values, members, depth: 0)
    keccak256_word(root.span())
}

/// The root of a trie holding `values[i]` under the nibbles `keys[i]`,
/// built from nothing; no key may be a prefix of another.
pub fn root_of(_ keys: MemVec<MemBuffer>, _ values: MemVec<MemBuffer>) -> u256 {
    if values.len() == 0 {
        return 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421
    }
    var members: MemVec<usize> = MemVec::new()
    for i in 0 .. values.len() {
        members.push(i)
    }
    keccak256_word(node(keys, values, members, depth: 0).span())
}

// The encoded node holding `members` (indices into `keys` and `values`),
// whose keys agree on their first `depth` nibbles.
fn node(
    _ keys: MemVec<MemBuffer>,
    _ values: MemVec<MemBuffer>,
    _ members: MemVec<usize>,
    depth: usize,
) -> MemBuffer {
    var out = MemBuffer::empty()
    if members.len() == 1 {
        let key = keys[members[0]].span()
        var path = MemBuffer::empty()
        hex_prefix(mut path, key, from: depth, leaf: true)
        var payload = MemBuffer::empty()
        put_string(mut payload, path.span())
        put_string(mut payload, values[members[0]].span())
        put_list(mut out, payload.span())
        return out
    }
    // How far every key agrees beyond `depth`.
    let first = keys[members[0]].span()
    var shared: usize = 0
    var agree = true
    while agree && depth + shared < first.len() {
        for m in 1 .. members.len() {
            let other = keys[members[m]].span()
            if depth + shared >= other.len() || other[depth + shared] != first[depth + shared] {
                agree = false
            }
        }
        if agree { shared += 1 }
    }
    if shared > 0 {
        var path = MemBuffer::empty()
        hex_prefix(
            mut path,
            first.slice(offset: 0, len: depth + shared),
            from: depth,
            leaf: false,
        )
        var payload = MemBuffer::empty()
        put_string(mut payload, path.span())
        put_child(
            mut payload,
            node(keys, values, members, depth: depth + shared).span(),
        )
        put_list(mut out, payload.span())
        return out
    }
    // A branch: one child per next nibble; no key ends here.
    var payload = MemBuffer::empty()
    for nibble in 0 .. 16 {
        var group: MemVec<usize> = MemVec::new()
        for m in 0 .. members.len() {
            if keys[members[m]].span()[depth] == nibble.downcast_truncate() {
                group.push(members[m])
            }
        }
        if group.len() == 0 {
            payload.push(0x80)
        } else {
            put_child(
                mut payload,
                node(keys, values, group, depth: depth + 1).span(),
            )
        }
    }
    payload.push(0x80)
    put_list(mut out, payload.span())
    out
}

// A child in its parent: inline under 32 bytes, otherwise its hash.
pub fn put_child(_ out: mut MemBuffer, _ child: MemSpan) {
    if child.len() < 32 {
        for i in 0 .. child.len() {
            out.push(child[i])
        }
    } else {
        put_word(mut out, keccak256_word(child), width: 32)
    }
}

// The hex-prefix encoding of `nibbles` from `from` on, flagged as a leaf's
// or an extension's path.
pub fn hex_prefix(_ out: mut MemBuffer, _ nibbles: MemSpan, from: usize, leaf: bool) {
    let count = nibbles.len() - from
    let odd = count % 2 == 1
    let flag: u8 = (if leaf { 2 } else { 0 }) + (if odd { 1 } else { 0 })
    var at = from
    if odd {
        out.push((flag << 4) | nibbles[at])
        at += 1
    } else {
        out.push(flag << 4)
    }
    while at < nibbles.len() {
        out.push((nibbles[at] << 4) | nibbles[at + 1])
        at += 2
    }
}

// RLP and the trie, against the Yellow Paper's encodings written out by
// hand: where a short form ends and a long one starts.
fn bytes_of(_ buf: MemBuffer) -> u256 {
    var out: u256 = 0
    for i in 0 .. buf.len() {
        out = (out << 8) | (buf.span()[i] as u256)
    }
    out
}

fn filled(_ len: usize) -> MemBuffer {
    var buf = MemBuffer::empty()
    for _ in 0 .. len {
        buf.push(0x61)
    }
    buf
}

#[test]
fn a_byte_under_0x80_is_its_own_encoding() {
    var low = MemBuffer::empty()
    put_word(mut low, 0x7f, width: 0)
    assert!(low.len() == 1 && bytes_of(low) == 0x7f)
    var high = MemBuffer::empty()
    put_word(mut high, 0x80, width: 0)
    assert!(high.len() == 2 && bytes_of(high) == 0x8180)
    // Zero is the empty string, not a zero byte.
    var zero = MemBuffer::empty()
    put_word(mut zero, 0, width: 0)
    assert!(zero.len() == 1 && bytes_of(zero) == 0x80)
}

#[test]
fn the_long_form_starts_at_56_bytes() {
    var short = MemBuffer::empty()
    put_string(mut short, filled(55).span())
    assert!(short.len() == 56 && short.span()[0] == 0xb7)
    var long = MemBuffer::empty()
    put_string(mut long, filled(56).span())
    assert!(
        long.len() == 58 && long.span()[0] == 0xb8 && long.span()[1] == 56,
    )
    var list = MemBuffer::empty()
    put_list(mut list, filled(56).span())
    assert!(list.span()[0] == 0xf8 && list.span()[1] == 56)
    var two = MemBuffer::empty()
    put_header(mut two, 0x80, 256)
    assert!(two.len() == 3 && bytes_of(two) == 0xb90100)
}

#[test]
fn hex_prefix_flags_leaves_extensions_and_odd_paths() {
    var nibbles = MemBuffer::empty()
    nibbles.push(1)
    nibbles.push(2)
    nibbles.push(3)
    var odd_leaf = MemBuffer::empty()
    hex_prefix(mut odd_leaf, nibbles.span(), from: 0, leaf: true)
    assert!(bytes_of(odd_leaf) == 0x3123)
    var even_leaf = MemBuffer::empty()
    hex_prefix(mut even_leaf, nibbles.span(), from: 1, leaf: true)
    assert!(bytes_of(even_leaf) == 0x2023)
    var odd_extension = MemBuffer::empty()
    hex_prefix(mut odd_extension, nibbles.span(), from: 2, leaf: false)
    assert!(bytes_of(odd_extension) == 0x13)
    var even_extension = MemBuffer::empty()
    hex_prefix(mut even_extension, nibbles.span(), from: 1, leaf: false)
    assert!(bytes_of(even_extension) == 0x0023)
}

#[test]
fn a_trie_of_nothing_is_the_empty_root() {
    let none: MemVec<MemBuffer> = MemVec::new()
    assert!(
        trie_root(none) == 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421,
    )
}

#[test]
fn a_trie_of_one_value_is_its_leaf() {
    // "abc" under rlp(0) = 0x80: the leaf [0x2080, "abc"], encoded as
    // c7 82 2080 83 616263, and the root is its hash.
    var values: MemVec<MemBuffer> = MemVec::new()
    var abc = MemBuffer::empty()
    abc.push(0x61)
    abc.push(0x62)
    abc.push(0x63)
    values.push(abc)
    var leaf = MemBuffer::empty()
    let bytes: [u8; 8] = [0xc7, 0x82, 0x20, 0x80, 0x83, 0x61, 0x62, 0x63]
    for i in 0 .. 8 {
        leaf.push(bytes[i])
    }
    assert!(trie_root(values) == keccak256_word(leaf.span()))
}

fn same_bytes(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn as_std(_ value: u256) -> bool {
    var ours = MemBuffer::empty()
    put_word(mut ours, value, width: 0)
    same_bytes(ours.span(), std::evm::rlp::encode_uint(value).span())
}

// Our encoder against Fe's own `std::evm::rlp`, byte for byte. We keep
// ours because the tries build variable-length lists into one buffer, and
// std's `encode_list` takes a fixed-size array of items.
#[test]
fn integers_encode_as_std_rlp_does() {
    var value: u256 = 0
    while value < 600 {
        assert!(as_std(value))
        value += 1
    }
    var shift: u256 = 0
    while shift < 256 {
        let edge: u256 = 1 << shift
        assert!(as_std(edge - 1) && as_std(edge) && as_std(edge + 1))
        shift += 1
    }
}

#[test]
fn strings_encode_as_std_rlp_does() {
    var len: usize = 0
    while len < 300 {
        let data = filled(len)
        var ours = MemBuffer::empty()
        put_string(mut ours, data.span())
        assert!(
            same_bytes(
                ours.span(),
                std::evm::rlp::encode_bytes(data.span()).span(),
            ),
        )
        len += 1
    }
    var one = MemBuffer::empty()
    one.push(0x05)
    var ours = MemBuffer::empty()
    put_string(mut ours, one.span())
    assert!(
        same_bytes(
            ours.span(),
            std::evm::rlp::encode_bytes(one.span()).span(),
        ),
    )
}
