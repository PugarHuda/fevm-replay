// Run with `fe test --backend native .` on Linux or macOS.

use json::parse
use ingot::load::{field, hex_bytes, hex_word}

#[test]
fn hex_word_reads_quantities_and_numbers() {
    let doc = parse("{\"a\":\"0x2a\",\"b\":42,\"c\":\"0x2A\"}".span()).unwrap()
    assert!(hex_word(doc["a"]) == 42)
    // The prestate tracer writes nonces as JSON numbers.
    assert!(hex_word(doc["b"]) == 42)
    assert!(hex_word(doc["c"]) == 42)
}

#[test]
fn missing_fields_read_as_zero() {
    let doc = parse("{\"gas\":\"0x5208\"}".span()).unwrap()
    assert!(field(doc, "gas") == 21000)
    // A legacy transaction has no maxPriorityFeePerGas.
    assert!(field(doc, "maxPriorityFeePerGas") == 0)
}

#[test]
fn hex_bytes_decodes_with_and_without_prefix() {
    let bytes = hex_bytes("0x00ffA0".span())
    assert!(bytes.len() == 3)
    assert!(
        bytes.span()[0] == 0x00 && bytes.span()[1] == 0xff && bytes.span()[2] == 0xa0,
    )
    assert!(hex_bytes("0x".span()).len() == 0)
    assert!(hex_bytes("beef".span()).len() == 2)
}

#[cfg(target_family = "unix")]
#[test]
fn blob_base_fee_matches_the_node() {
    // Mainnet block 26393604: excessBlobGas 0xb58bccf under BPO2; the node's
    // blob gas price for its blob transactions was 0xb58b03.
    assert!(
        ingot::fetch::blob_base_fee(excess: 0xb58bccf, fraction: 11684671) == 0xb58b03,
    )
    // No excess blob gas: the minimum price of one wei.
    assert!(
        ingot::fetch::blob_base_fee(excess: 0, fraction: 11684671) == 1,
    )
}

#[cfg(target_family = "unix")]
#[test]
fn delegation_targets_missing_from_the_prestate_are_collected() {
    // An EIP-7702 transaction whose authorization delegates to 0x...490a, and
    // a prestate holding another account already delegated to 0x...beef, but
    // neither target: the prestate tracer leaves them out.
    let tx = parse(
        "{\"authorizationList\":[{\"address\":\"0x000000000000000000000000000000000000490a\"}]}"
            .span(),
    )
        .unwrap()
    let prestate = parse(
        "{\"0x00000000000000000000000000000000000000aa\":{\"balance\":\"0x0\",\"code\":\"0xef0100000000000000000000000000000000000000beef\"}}"
            .span(),
    )
        .unwrap()
    var targets: core::MemVec<u256> = core::MemVec::new()
    ingot::fetch::collect_delegates(tx, prestate, mut targets)
    assert!(targets.len() == 2)
    assert!(targets[0] == 0x490a && targets[1] == 0xbeef)

    // A target the prestate already holds is not fetched again.
    let held = parse(
        "{\"0x000000000000000000000000000000000000490a\":{\"balance\":\"0x0\"}}".span(),
    )
        .unwrap()
    var again: core::MemVec<u256> = core::MemVec::new()
    ingot::fetch::collect_delegates(tx, held, mut again)
    assert!(again.len() == 0)
}

#[test]
fn delegation_designators_are_recognized() {
    let designator = hex_bytes("0xef0100490aac77c960b0569c8e446ac7e12490bd44ca1d".span())
    assert!(
        ingot::load::delegation_target(designator.span())
            == 0x490aac77c960b0569c8e446ac7e12490bd44ca1d,
    )
    let plain = hex_bytes("0x6080604052".span())
    assert!(ingot::load::delegation_target(plain.span()) == 0)
}

// Code fuzzed against itself never differs; code that reverts where the
// other stops differs on the first call.
#[test]
fn fuzz_finds_a_difference_only_where_there_is_one() {
    let stop = hex_bytes("0x00".span())
    let revert = hex_bytes("0x60006000fd".span())
    var same = ingot::fuzz::Findings::new()
    ingot::fuzz::fuzz(
        stop.span(),
        stop.span(),
        token: core::MemBuffer::empty().span(),
        runs: 3,
        steps: 5,
        seed: 1,
        mut same,
    )
    assert!(same.first_step == 0)
    var differ = ingot::fuzz::Findings::new()
    ingot::fuzz::fuzz(
        stop.span(),
        revert.span(),
        token: core::MemBuffer::empty().span(),
        runs: 3,
        steps: 5,
        seed: 1,
        mut differ,
    )
    assert!(differ.first_step == 1 && differ.first_what == 1)
}
