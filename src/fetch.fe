#![cfg(target_family = "unix")]
//! Builds a fixture from a JSON-RPC node. The requests go out through `curl`,
//! which this module starts with `Spawn`: the only code in fevm-replay that
//! may reach the network is code that declares `proc: mut Spawn`.

use core::{MemBuffer, MemVec}
use core::text::parse_hex_uint
use std::fs::Fs
use std::io::Display
use std::evm::units::{Timestamp, Wei, wei}
use std::process::{Command, Redirect, Spawn}
use json::{Value, parse}
use ingot::load::{delegation_target, field, hex_bytes}

/// The blob base fee, per unit of blob gas, for `excess` blob gas under the
/// schedule's update fraction: EIP-4844's `fake_exponential(1, excess,
/// fraction)`. A `const fn`, so the compiler can check it against mainnet
/// below.
pub const fn blob_base_fee(excess: u256, fraction: u256) -> Wei {
    var output: u256 = 0
    var accumulator: u256 = fraction
    var i: u256 = 1
    while accumulator > 0 {
        output += accumulator
        accumulator = accumulator * excess / (fraction * i)
        i += 1
    }
    wei(output / fraction)
}

/// Mainnet's blob schedule (`eth_config`): Prague's update fraction until
/// BPO1 (9 Dec 2025), BPO1's until BPO2 (7 Jan 2026), then BPO2's.
pub const PRAGUE_UPDATE_FRACTION: u256 = 5007716
pub const BPO1_UPDATE_FRACTION: u256 = 8346193
pub const BPO2_UPDATE_FRACTION: u256 = 11684671
pub const BPO1: Timestamp = Timestamp::from_seconds(1765290071)
pub const BPO2: Timestamp = Timestamp::from_seconds(1767747671)

/// The blob base fee update fraction mainnet used at `at`.
pub const fn update_fraction(_ at: Timestamp) -> u256 {
    if at.as_seconds() < BPO1.as_seconds() {
        PRAGUE_UPDATE_FRACTION
    } else if at.as_seconds() < BPO2.as_seconds() {
        BPO1_UPDATE_FRACTION
    } else {
        BPO2_UPDATE_FRACTION
    }
}

// Checked at compile time, against the chain. Block 26,393,604 (BPO2) had
// 0xb58bccf excess blob gas, and the node priced its blobs at 0xb58b03 wei.
static_assert(blob_base_fee(excess: 0xb58bccf, fraction: BPO2_UPDATE_FRACTION).as_wei() == 0xb58b03)
// No excess: the minimum, one wei.
static_assert(blob_base_fee(excess: 0, fraction: BPO2_UPDATE_FRACTION).as_wei() == 1)
// The forks come in order, each raising the fraction (blob fees move slower).
static_assert(BPO1.as_seconds() < BPO2.as_seconds())
static_assert(PRAGUE_UPDATE_FRACTION < BPO1_UPDATE_FRACTION)
static_assert(BPO1_UPDATE_FRACTION < BPO2_UPDATE_FRACTION)
static_assert(update_fraction(BPO1) == BPO1_UPDATE_FRACTION)
static_assert(update_fraction(BPO2) == BPO2_UPDATE_FRACTION)
static_assert(update_fraction(Timestamp::from_seconds(1765290070)) == PRAGUE_UPDATE_FRACTION)

/// The blob base fee of a block, from its header.
pub fn header_blob_fee(_ header: Value) -> Wei {
    blob_base_fee(
        excess: field(header, "excessBlobGas"),
        fraction: update_fraction(Timestamp::from_seconds(field(header, "timestamp"))),
    )
}

/// One JSON-RPC call; `params` is the JSON text of the parameter array.
/// curl retries rate-limit answers (HTTP 429), which free endpoints send often.
fn call<U: Display, M: Display, P: Display>(_ url: U, _ method: M, _ params: P) -> Option<Value>
uses (proc: mut Spawn)
{
    var body = MemBuffer::empty()
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"".fmt(mut body)
    method.fmt(mut body)
    "\",\"params\":".fmt(mut body)
    params.fmt(mut body)
    "}".fmt(mut body)
    let command = Command::new("curl")
        .arg("-sS")
        .arg("--retry")
        .arg("8")
        .arg("--retry-all-errors")
        .arg("--retry-delay")
        .arg("2")
        .arg("-H")
        .arg("content-type: application/json")
        .arg("--data-binary")
        .arg(body)
        .arg(url)
        .stdout(Redirect::Capture)
    let Result::Ok(output) = proc.output(command) else {
        return Option::None
    }
    if !output.status.success() {
        return Option::None
    }
    let Result::Ok(doc) = parse(output.stdout.span()) else {
        return Option::None
    }
    if !doc.has("result") || doc["result"].is_null() {
        return Option::None
    }
    Option::Some(doc)
}

/// The accounts and slots a call would touch at the end of block `number`
/// (`eth_createAccessList`): the response, whose `result.accessList` lists
/// them, or None.
pub fn access_list<U: Display>(
    _ url: U,
    from: u256,
    to: u256,
    data: MemSpan,
    value: u256,
    gas: u256,
    number: u256,
) -> Option<Value>
uses (proc: mut Spawn)
{
    var params = MemBuffer::empty()
    "[{\"from\":\"0x".fmt(mut params)
    core::text::hex(from, 20).fmt(mut params)
    "\",\"to\":\"0x".fmt(mut params)
    core::text::hex(to, 20).fmt(mut params)
    "\",\"value\":\"".fmt(mut params)
    quantity(value).fmt(mut params)
    "\",\"gas\":\"".fmt(mut params)
    quantity(gas).fmt(mut params)
    "\",\"data\":\"0x".fmt(mut params)
    for i in 0 .. data.len() {
        core::text::hex(data[i] as u256, 1).fmt(mut params)
    }
    "\"},\"".fmt(mut params)
    quantity(number).fmt(mut params)
    "\"]".fmt(mut params)
    // The whole response: its `result.accessList` is the list.
    call(url, "eth_createAccessList", params)
}

/// The word a node returns for `method` with `params` (a JSON array as
/// text): a balance, a nonce or a storage value.
pub fn word_at<U: Display, M: Display, P: Display>(_ url: U, _ method: M, _ params: P) -> Option<
    u256,
>
uses (proc: mut Spawn)
{
    match call(url, method, params) {
        Option::Some(doc) => Option::Some(field(doc, "result")),
        Option::None => Option::None,
    }
}

/// The code at `address` at the end of block `number`.
pub fn code_at<U: Display>(_ url: U, _ address: u256, number: u256) -> Option<MemBuffer>
uses (proc: mut Spawn)
{
    var params = MemBuffer::empty()
    "[\"0x".fmt(mut params)
    core::text::hex(address, 20).fmt(mut params)
    "\",\"".fmt(mut params)
    quantity(number).fmt(mut params)
    "\"]".fmt(mut params)
    match call(url, "eth_getCode", params) {
        Option::Some(doc) => Option::Some(hex_bytes(doc["result"].text())),
        Option::None => Option::None,
    }
}

/// The balance of `address` at the end of block `number`, as the node at
/// `url` reports it.
pub fn balance_at<U: Display>(_ url: U, _ address: u256, number: u256) -> Option<u256>
uses (proc: mut Spawn)
{
    var params = MemBuffer::empty()
    "[\"0x".fmt(mut params)
    core::text::hex(address, 20).fmt(mut params)
    "\",\"".fmt(mut params)
    quantity(number).fmt(mut params)
    "\"]".fmt(mut params)
    match call(url, "eth_getBalance", params) {
        Option::Some(doc) => Option::Some(field(doc, "result")),
        Option::None => Option::None,
    }
}

/// The fixture for transaction `hash` (with its `0x`) as JSON text in `out`,
/// or false if the node could not answer.
pub fn fetch<U: Display, H: Display>(_ url: U, _ hash: H, _ out: mut MemBuffer) -> bool
uses (proc: mut Spawn)
{
    var by_hash = MemBuffer::empty()
    "[\"".fmt(mut by_hash)
    hash.fmt(mut by_hash)
    "\"]".fmt(mut by_hash)
    let Option::Some(tx) = call(url, "eth_getTransactionByHash", by_hash) else {
        return false
    }

    var by_number = MemBuffer::empty()
    "[\"".fmt(mut by_number)
    tx["result"]["blockNumber"].text().fmt(mut by_number)
    "\",false]".fmt(mut by_number)
    let Option::Some(block) = call(url, "eth_getBlockByNumber", by_number) else {
        return false
    }
    let Option::Some(receipt) = call(url, "eth_getTransactionReceipt", by_hash) else {
        return false
    }

    var traced = MemBuffer::empty()
    "[\"".fmt(mut traced)
    hash.fmt(mut traced)
    "\",{\"tracer\":\"prestateTracer\"}]".fmt(mut traced)
    let Option::Some(prestate) = call(url, "debug_traceTransaction", traced) else {
        return false
    }

    var diffed = MemBuffer::empty()
    "[\"".fmt(mut diffed)
    hash.fmt(mut diffed)
    "\",{\"tracer\":\"prestateTracer\",\"tracerConfig\":{\"diffMode\":true}}]".fmt(mut diffed)
    let Option::Some(diff) = call(url, "debug_traceTransaction", diffed) else {
        return false
    }

    let Option::Some(chain) = call(url, "eth_chainId", "[]") else {
        return false
    }
    var targets: MemVec<u256> = MemVec::new()
    collect_delegates(tx["result"], prestate["result"], mut targets)
    let parent = quantity(field(block["result"], "number") - 1)
    var delegates = MemBuffer::empty()
    if !write_delegates(url, targets, parent: parent.span(), mut delegates) {
        return false
    }
    let fee = header_blob_fee(block["result"]).as_wei()
    "{\"chainId\":\"".fmt(mut out)
    chain["result"].text().fmt(mut out)
    "\",\"blobBaseFee\":\"0x".fmt(mut out)
    core::text::hex(fee, 32).fmt(mut out)
    "\",\"block\":".fmt(mut out)
    block["result"].write(mut out)
    ",\"tx\":".fmt(mut out)
    tx["result"].write(mut out)
    ",\"receipt\":".fmt(mut out)
    receipt["result"].write(mut out)
    ",\"prestate\":".fmt(mut out)
    prestate["result"].write(mut out)
    ",\"diff\":".fmt(mut out)
    diff["result"].write(mut out)
    ",\"delegates\":".fmt(mut out)
    delegates.span().fmt(mut out)
    "}\n".fmt(mut out)
    true
}

/// `0x` and the hex digits of `value`, without leading zeros: a JSON-RPC
/// quantity.
pub fn quantity(_ value: u256) -> MemBuffer {
    var digits = MemBuffer::empty()
    var rest = value
    if rest == 0 {
        digits.push(0x30)
    }
    while rest > 0 {
        let nibble: u8 = (rest & 0xf).downcast_truncate()
        digits.push(if nibble < 10 {
                    0x30 + nibble
                } else {
                    0x57 + nibble
                })
        rest = rest >> 4
    }
    var text = MemBuffer::empty()
    "0x".fmt(mut text)
    var i = digits.len()
    while i > 0 {
        i -= 1
        text.push(digits.span()[i])
    }
    text
}

fn has_account(_ prestate: Value, _ address: u256) -> bool {
    for ref member in prestate.members() {
        if parse_hex_uint(member.key.span()).unwrap_or(default: 0) == address {
            return true
        }
    }
    false
}

fn add_target(_ targets: mut MemVec<u256>, _ target: u256) {
    for i in 0 .. targets.len() {
        if targets[i] == target {
            return
        }
    }
    targets.push(target)
}

/// The EIP-7702 delegation targets of transaction `tx` missing from its
/// `prestate`: those its authorizations name, and those the designators in
/// its pre-state point to. Running a delegated account runs the target's
/// code, yet the prestate tracer does not report the target.
pub fn collect_delegates(_ tx: Value, _ prestate: Value, _ targets: mut MemVec<u256>) {
    if tx.has("authorizationList") {
        for ref auth in tx["authorizationList"].items() {
            let target = field(auth, "address")
            if target != 0 && !has_account(prestate, target) {
                add_target(mut targets, target)
            }
        }
    }
    for ref member in prestate.members() {
        if member.value.has("code") {
            let code = hex_bytes(member.value["code"].text())
            let target = delegation_target(code.span())
            if target != 0 && !has_account(prestate, target) {
                add_target(mut targets, target)
            }
        }
    }
}

/// The code of each of `targets` at block `parent`, as a JSON object from
/// address to code, in `out`.
fn write_delegates<U: Display>(
    _ url: U,
    _ targets: MemVec<u256>,
    parent: MemSpan,
    _ out: mut MemBuffer,
) -> bool
uses (proc: mut Spawn)
{
    "{".fmt(mut out)
    for i in 0 .. targets.len() {
        var params = MemBuffer::empty()
        "[\"0x".fmt(mut params)
        core::text::hex(targets[i], 20).fmt(mut params)
        "\",\"".fmt(mut params)
        parent.fmt(mut params)
        "\"]".fmt(mut params)
        let Option::Some(code) = call(url, "eth_getCode", params) else {
            return false
        }
        if i > 0 { ",".fmt(mut out) }
        "\"0x".fmt(mut out)
        core::text::hex(targets[i], 20).fmt(mut out)
        "\":".fmt(mut out)
        code["result"].write(mut out)
    }
    "}".fmt(mut out)
    true
}

/// The code deployed at `address` (a `0x` hex string), as hex text in `out`.
pub fn fetch_code<U: Display, A: Display>(_ url: U, _ address: A, _ out: mut MemBuffer) -> bool
uses (proc: mut Spawn)
{
    var params = MemBuffer::empty()
    "[\"".fmt(mut params)
    address.fmt(mut params)
    "\",\"latest\"]".fmt(mut params)
    let Option::Some(code) = call(url, "eth_getCode", params) else {
        return false
    }
    code["result"].text().fmt(mut out)
    "
".fmt(mut out)
    true
}

// `dir/name` as a path.
pub fn join<D: Display>(_ dir: D, _ name: String<16>) -> MemBuffer {
    var path = MemBuffer::empty()
    dir.fmt(mut path)
    "/".fmt(mut path)
    name.fmt(mut path)
    path
}

/// One JSON-RPC call whose whole response goes to the file `path`. Block
/// traces run to tens of megabytes, which curl writes straight to disk.
fn call_to_file<U: Display, M: Display, P: Display>(
    _ url: U,
    _ method: M,
    _ params: P,
    _ path: MemBuffer,
) -> bool
uses (proc: mut Spawn)
{
    var body = MemBuffer::empty()
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"".fmt(mut body)
    method.fmt(mut body)
    "\",\"params\":".fmt(mut body)
    params.fmt(mut body)
    "}".fmt(mut body)
    let command = Command::new("curl")
        .arg("-sS")
        .arg("--fail")
        .arg("--retry")
        .arg("8")
        .arg("--retry-all-errors")
        .arg("--retry-delay")
        .arg("2")
        .arg("--max-time")
        .arg("600")
        .arg("-H")
        .arg("content-type: application/json")
        .arg("--data-binary")
        .arg(body)
        .arg("-o")
        .arg(path)
        .arg(url)
    let Result::Ok(output) = proc.output(command) else {
        return false
    }
    output.status.success()
}

/// Saves the node's answers about every transaction of block `number` (a
/// `0x` quantity) in `dir`: the block with its transactions, the receipts,
/// both prestate traces and the chain ID. Four calls cover the whole block.
pub fn fetch_block<U: Display, N: Display, D: Display>(_ url: U, _ number: N, _ dir: D) -> bool
uses (proc: mut Spawn, fs: mut Fs)
{
    var at = MemBuffer::empty()
    "[\"".fmt(mut at)
    number.fmt(mut at)
    "\"".fmt(mut at)
    var block_params = MemBuffer::empty()
    at.span().fmt(mut block_params)
    ",true]".fmt(mut block_params)
    var receipt_params = MemBuffer::empty()
    at.span().fmt(mut receipt_params)
    "]".fmt(mut receipt_params)
    var pre_params = MemBuffer::empty()
    at.span().fmt(mut pre_params)
    ",{\"tracer\":\"prestateTracer\",\"timeout\":\"600s\"}]".fmt(mut pre_params)
    var diff_params = MemBuffer::empty()
    at.span().fmt(mut diff_params)
    ",{\"tracer\":\"prestateTracer\",\"timeout\":\"600s\",\"tracerConfig\":{\"diffMode\":true}}]"
        .fmt(mut diff_params)
    call_to_file(url, "eth_chainId", "[]", join(dir, "chain.json"))
        && call_to_file(
            url,
            "eth_getBlockByNumber",
            block_params,
            join(dir, "block.json"),
        )
        && call_to_file(
            url,
            "eth_getBlockReceipts",
            receipt_params,
            join(dir, "receipts.json"),
        )
        && call_to_file(
            url,
            "debug_traceBlockByNumber",
            pre_params,
            join(dir, "prestate.json"),
        )
        && call_to_file(
            url,
            "debug_traceBlockByNumber",
            diff_params,
            join(dir, "diff.json"),
        )
        && fetch_block_delegates(url, number, dir)
}

/// Saves `dir/delegates.json`: the EIP-7702 delegation targets the block's
/// transactions need but its prestate traces leave out (see
/// `collect_delegates`), as `{"delegates": {address: code}}`.
fn fetch_block_delegates<U: Display, N: Display, D: Display>(
    _ url: U,
    _ number: N,
    _ dir: D,
) -> bool
uses (proc: mut Spawn, fs: mut Fs)
{
    let Result::Ok(block_bytes) = fs.read(join(dir, "block.json")) else {
        return false
    }
    let Result::Ok(block) = parse(block_bytes.span()) else {
        return false
    }
    let Result::Ok(pre_bytes) = fs.read(join(dir, "prestate.json")) else {
        return false
    }
    let Result::Ok(prestates) = parse(pre_bytes.span()) else {
        return false
    }
    var targets: MemVec<u256> = MemVec::new()
    let txs = block["result"]["transactions"].items()
    for index in 0 .. txs.len() {
        collect_delegates(
            txs[index],
            prestates["result"][index]["result"],
            mut targets,
        )
    }
    var at = MemBuffer::empty()
    number.fmt(mut at)
    let parent = quantity(parse_hex_uint(at.span()).unwrap_or(default: 1) - 1)
    var delegates = MemBuffer::empty()
    if !write_delegates(url, targets, parent: parent.span(), mut delegates) {
        return false
    }
    var text = MemBuffer::empty()
    "{\"delegates\":".fmt(mut text)
    delegates.span().fmt(mut text)
    "}
".fmt(mut text)
    let Result::Ok(_) = fs.write(join(dir, "delegates.json"), text.span()) else {
        return false
    }
    true
}

/// One JSON-RPC batch asking for the headers of blocks `first` to
/// `first + count - 1`.
fn headers<U: Display>(_ url: U, first: u256, count: u256) -> Option<Value>
uses (proc: mut Spawn)
{
    var body = MemBuffer::empty()
    "[".fmt(mut body)
    var i: u256 = 0
    while i < count {
        if i > 0 { ",".fmt(mut body) }
        "{\"jsonrpc\":\"2.0\",\"id\":".fmt(mut body)
        core::text::decimal(i).fmt(mut body)
        ",\"method\":\"eth_getBlockByNumber\",\"params\":[\"".fmt(mut body)
        quantity(first + i).span().fmt(mut body)
        "\",false]}".fmt(mut body)
        i += 1
    }
    "]".fmt(mut body)
    let command = Command::new("curl")
        .arg("-sS")
        .arg("--fail")
        .arg("--retry")
        .arg("8")
        .arg("--retry-all-errors")
        .arg("--retry-delay")
        .arg("2")
        .arg("-H")
        .arg("content-type: application/json")
        .arg("--data-binary")
        .arg(body)
        .arg(url)
        .stdout(Redirect::Capture)
    let Result::Ok(output) = proc.output(command) else {
        return Option::None
    }
    if !output.status.success() {
        return Option::None
    }
    let Result::Ok(doc) = parse(output.stdout.span()) else {
        return Option::None
    }
    if !doc.as_array().is_some() || doc.items().len() as u256 != count {
        return Option::None
    }
    Option::Some(doc)
}

/// Adds the hashes of the 256 blocks before block `number` to
/// `dir/delegates.json` as `blockHashes`, so a replay answers BLOCKHASH
/// for any block it may ask about. Free endpoints take three requests a
/// batch, so this costs 86 calls; `range` makes them only for blocks whose
/// transactions ran BLOCKHASH.
pub fn fetch_hashes<U: Display, D: Display>(_ url: U, number: u256, _ dir: D) -> bool
uses (proc: mut Spawn, fs: mut Fs)
{
    var hashes = MemBuffer::empty()
    "\"blockHashes\":{".fmt(mut hashes)
    var n = if number > 256 { number - 256 } else { 0 }
    var first = true
    while n < number {
        let count: u256 = if number - n < 3 { number - n } else { 3 }
        let Option::Some(doc) = headers(url, first: n, count) else {
            return false
        }
        for ref answer in doc.items() {
            if !answer.has("result") || !answer["result"].as_object().is_some() {
                return false
            }
            if !first {
                ",".fmt(mut hashes)
            }
            first = false
            "\"".fmt(mut hashes)
            answer["result"]["number"].text().fmt(mut hashes)
            "\":\"".fmt(mut hashes)
            answer["result"]["hash"].text().fmt(mut hashes)
            "\"".fmt(mut hashes)
        }
        n += count
    }
    "}".fmt(mut hashes)
    // Into delegates.json: `{"delegates": {...}}` gains a second member.
    let path = join(dir, "delegates.json")
    var text = MemBuffer::empty()
    match fs.read(path) {
        Result::Ok(bytes) => {
            var end = bytes.len()
            while end > 0 && bytes.span()[end - 1] != 0x7d {
                end -= 1
            }
            if end == 0 { return false }
            for i in 0 .. end - 1 {
                text.push(bytes.span()[i])
            }
            // No comma after an empty object's brace.
            var last = text.len()
            while last > 0 && (text.span()[last - 1] == 0x20 || text.span()[last - 1] == 0x0a) {
                last -= 1
            }
            if last > 0 && text.span()[last - 1] != 0x7b {
                ",".fmt(mut text)
            }
            hashes.span().fmt(mut text)
            "}".fmt(mut text)
        },
        Result::Err(_) => {
            "{".fmt(mut text)
            hashes.span().fmt(mut text)
            "}".fmt(mut text)
        },
    }
    match fs.write(path, text.span()) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}
