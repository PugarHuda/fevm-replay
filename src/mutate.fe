//! Mainnet-seeded fuzzing: a real transaction, mutated, run on its own
//! mainnet pre-state twice, once with the deployed code and once with the
//! port, and the two compared. Shadow replay covers what mainnet did; this
//! covers what it nearly did, against real tokens, routers and bots.
//!
//! Each mutation either changes the transaction's own calldata, which
//! exercises whatever router or bot sent it, or sends the shadowed contract
//! one of the calls it really received in that transaction, changed, from
//! the same sender. Gas is free (base fee and price zero), so the two runs
//! differ only by what the code does. Accounts and slots the original
//! transaction did not touch are absent from the pre-state and read as
//! empty in both runs: a mutation that wanders off is still compared fairly.

use core::{MemBuffer, MemSpan, MemVec}
use json::Value
use fevm::{BlockEnv, Buffers, Config, InputData, OK, TxEnv, TxRequest, WorldState, transact}
use fevm::trace::{CallEnd, CallStart, Tracer}
use ingot::fuzz::{same_bytes, same_logs, same_reason, same_state_except, same_status}
use ingot::load::{field, hex_bytes, load_tx_with, load_world}
use ingot::replay::{build_world, shadow_targets}
use ingot::watch::GasWatch

/// What mutating a block's transactions found.
pub struct Mutations {
    /// Transactions whose pre-state holds the shadowed code.
    pub transactions: u64,
    pub runs: u64,
    pub identical: u64,
    /// Runs that differ where other code read the gas left or code hashes.
    pub sensitive: u64,
    pub differ: u64,
    /// Runs that differ after a word shaped like an address (upper twelve
    /// bytes zero) got upper bits: Fe's decoder rejects what solc cleaned.
    pub dirtied: u64,
    /// Runs of each kind: the transaction's calldata changed, or a direct
    /// call into the shadowed contract.
    pub tx_runs: u64,
    pub direct_runs: u64,
    /// The first difference: the transaction's index plus one (0 for none),
    /// the run's kind, target, calldata and outcome on each side.
    pub first_tx: u64,
    pub first_direct: bool,
    pub first_to: u256,
    pub first_data: MemBuffer,
    pub first_what: u8,
    pub first_deployed: [i32; 2],
    pub first_port: [i32; 2],
}

impl Mutations {
    pub fn new() -> Self {
        Mutations {
            transactions: 0,
            runs: 0,
            identical: 0,
            sensitive: 0,
            differ: 0,
            dirtied: 0,
            tx_runs: 0,
            direct_runs: 0,
            first_tx: 0,
            first_direct: false,
            first_to: 0,
            first_data: MemBuffer::empty(),
            first_what: 0,
            first_deployed: [0, 0],
            first_port: [0, 0],
        }
    }
}

// xorshift64*, as in `fuzz`.
struct Rng { state: u64 }

impl Rng {
    fn next(mut self) -> u64 {
        var x = self.state
        x ^= x >> 12
        x ^= x << 25
        x ^= x >> 27
        self.state = x
        x.wrapping_mul(0x2545f4914f6cdd1d)
    }

    fn below(mut self, _ n: u64) -> u64 {
        self.next() % n
    }

    // A position below `n`, for indexing.
    fn index(mut self, _ n: usize) -> usize {
        let m: u64 = n.downcast_unchecked()
        (self.next() % m).downcast_unchecked()
    }
}

// A call into shadowed code seen in a run: where its calldata sits in
// `Recorder.inputs`.
struct Seen { to: u256, start: usize, len: usize }

impl Copy for Seen {}

// Records the calls into the shadowed accounts, up to eight.
struct Recorder { targets: MemVec<u256>, seen: MemVec<Seen>, inputs: MemBuffer }

impl Tracer for Recorder {
    fn enter(mut self, _ call: CallStart, input: MemSpan) {
        if self.seen.len() >= 8 {
            return
        }
        for i in 0 .. self.targets.len() {
            if self.targets[i] == call.to {
                let start = self.inputs.len()
                for j in 0 .. input.len() {
                    self.inputs.push(input[j])
                }
                self.seen.push(Seen { to: call.to, start, len: input.len() })
                return
            }
        }
    }
}

fn copy_list(_ list: MemVec<u256>) -> MemVec<u256> {
    var out: MemVec<u256> = MemVec::new()
    for i in 0 .. list.len() {
        out.push(list[i])
    }
    out
}

/// Runs `count` mutations of transaction `index` of a block (`tx` and its
/// `prestate`) with every account running `deployed` shadowed by `port`.
/// The first run is the transaction unchanged, as a control.
pub fn mutate_tx(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ prestate: Value,
    index: u64,
    deployed: MemSpan,
    port: MemSpan,
    count: u64,
    seed: u64,
    _ found: mut Mutations,
) {
    // Blob transactions need a blob fee; they never reach a pair anyway.
    if field(tx, "type") == 3 {
        return
    }
    let targets = shadow_targets(load_world(prestate), 0, deployed)
    if targets.len() == 0 {
        return
    }
    found.transactions += 1
    var free = block
    free.basefee = 0
    let original = hex_bytes(tx["input"].text())
    // The calls the shadowed accounts really received.
    var recorder = Recorder {
        targets: copy_list(targets),
        seen: MemVec::new(),
        inputs: MemBuffer::empty(),
    }
    var buffers = Buffers::new()
    transact(
        build_world(
            prestate,
            block,
            parent_hash,
            extras,
            MemVec::new(),
            deployed,
        ),
        load_tx_with(tx, input: original.span(), priced: false),
        free,
        Config::osaka(),
        mut buffers,
        mut recorder,
    )
    var rng = Rng { state: (seed + index).wrapping_mul(0x9e3779b97f4a7c15) | 1 }
    var run: u64 = 0
    while run < count {
        let direct = run > 0 && recorder.seen.len() > 0 && rng.below(2) == 0
        var data = MemBuffer::empty()
        var to: u256 = 0
        var dirtied = false
        if direct {
            let seen = recorder.seen[rng.index(recorder.seen.len())]
            to = seen.to
            for i in 0 .. seen.len {
                data.push(recorder.inputs.span()[seen.start + i])
            }
            dirtied = mutate(mut rng, mut data)
            found.direct_runs += 1
        } else {
            data = MemBuffer::from_span(original.span())
            if run > 0 {
                dirtied = mutate(mut rng, mut data)
            }
            found.tx_runs += 1
        }
        let what = compare_run(
            free,
            parent_hash,
            extras,
            tx,
            prestate,
            targets,
            port,
            direct,
            to,
            data.span(),
            mut found,
        )
        found.runs += 1
        run += 1
        if what == 0 {
            found.identical += 1
        } else if what < 10 && dirtied {
            found.dirtied += 1
        } else if what < 10 {
            found.differ += 1
            if found.first_tx == 0 {
                found.first_tx = index + 1
                found.first_direct = direct
                found.first_to = if direct { to } else { field(tx, "to") }
                found.first_data = MemBuffer::from_span(data.span())
                found.first_what = what
            }
        } else {
            found.sensitive += 1
        }
    }
}

// Runs one mutation on both codes: 0 if identical, 1 to 4 (status, return
// data, logs, state) if not, 10 plus that if other code read the gas left
// or code hashes, which differ by design.
fn compare_run(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ prestate: Value,
    _ targets: MemVec<u256>,
    _ port: MemSpan,
    _ direct: bool,
    _ to: u256,
    _ data: MemSpan,
    _ found: mut Mutations,
) -> u8 {
    var watch_a = GasWatch::new(shadows: targets)
    var watch_b = GasWatch::new(shadows: targets)
    var buffers_a = Buffers::new()
    var buffers_b = Buffers::new()
    let ran_a = transact(
        build_world(prestate, block, parent_hash, extras, MemVec::new(), port),
        request(tx, direct, to, data),
        block,
        Config::osaka(),
        mut buffers_a,
        mut watch_a,
    )
    let ran_b = transact(
        build_world(
            prestate,
            block,
            parent_hash,
            extras,
            copy_list(targets),
            port,
        ),
        request(tx, direct, to, data),
        block,
        Config::osaka(),
        mut buffers_b,
        mut watch_b,
    )
    let what: u8 = if ran_a.receipt.invalid != ran_b.receipt.invalid
        || !same_status(ran_a.receipt.status, ran_b.receipt.status) {
        1
    } else if !same_bytes(ran_a.receipt.output.span(), ran_b.receipt.output.span())
        && !same_reason(ran_a.receipt.output.span(), ran_b.receipt.output.span()) {
        2
    } else if !same_logs(ran_a.receipt.logs, ran_b.receipt.logs) {
        3
    } else if !same_state_except(ran_a.state, ran_b.state, copy_list(targets)) {
        4
    } else {
        0
    }
    if what == 0 { return 0 }
    if watch_b.observed || watch_a.read_code || watch_b.read_code {
        return what + 10
    }
    if found.first_tx == 0 {
        found.first_deployed = [ran_a.receipt.invalid, ran_a.receipt.status]
        found.first_port = [ran_b.receipt.invalid, ran_b.receipt.status]
    }
    what
}

// The transaction with `data` for calldata, or a direct call to `to` from
// its sender; either way paying nothing for gas.
fn request(_ tx: Value, _ direct: bool, _ to: u256, _ data: MemSpan) -> TxRequest {
    if !direct {
        return load_tx_with(tx, input: data, priced: false)
    }
    let env = TxEnv {
        kind: 2,
        chain_id: Option::Some(1),
        sender: field(tx, "from"),
        to,
        creates: false,
        nonce: field(tx, "nonce"),
        gas_limit: field(tx, "gas").downcast_truncate(),
        gas_price: 0,
        max_priority_fee_per_gas: 0,
        max_fee_per_blob_gas: 0,
        value: 0,
    }
    TxRequest::new(
        env,
        data: InputData::new(MemBuffer::from_span(data), status: OK),
    )
}

// One change to calldata past its selector: an argument word set to an edge
// value or nudged, a byte flipped, or the calldata cut short. True if it
// gave upper bits to a word shaped like an address.
fn mutate(_ rng: mut Rng, _ data: mut MemBuffer) -> bool {
    if data.len() < 4 {
        data.push((rng.next() & 0xff).downcast_truncate())
        return false
    }
    let words = (data.len() - 4) / 32
    let pick = rng.below(9)
    if words == 0 || pick == 7 {
        if data.len() > 4 {
            let at = 4 + rng.index(data.len() - 4)
            let flip: u8 = (rng.next() & 0xff).downcast_truncate()
            let word_at = 4 + (at - 4) / 32 * 32
            let shaped = word_at + 32 <= data.len() && read_word(data.span(), word_at) >> 160 == 0
            data.span()[at] = data.span()[at] ^ (flip | 1)
            return shaped && at < word_at + 12
        }
        return false
    }
    if pick == 8 {
        let keep = 4 + rng.index(data.len() - 4)
        var cut = MemBuffer::empty()
        for i in 0 .. keep {
            cut.push(data.span()[i])
        }
        data = cut
        return false
    }
    let at = 4 + rng.index(words) * 32
    let word = read_word(data.span(), at)
    let changed: u256 = match pick {
        0 => 0,
        1 => 1,
        2 => word.wrapping_add(1),
        3 => word.wrapping_sub(1),
        4 => word / 2,
        5 => word.wrapping_mul(2),
        _ => u256::max(),
    }
    write_word(mut data, at, changed)
    word >> 160 == 0 && changed >> 160 != 0
}

fn read_word(_ data: MemSpan, _ at: usize) -> u256 {
    var word: u256 = 0
    for i in 0 .. 32 {
        word = (word << 8) | data[at + i] as u256
    }
    word
}

fn write_word(_ data: mut MemBuffer, _ at: usize, _ word: u256) {
    for i in 0 .. 32 {
        data.span()[at + i] = ((word >> ((31 - i) * 8) as u256) & 0xff).downcast_truncate()
    }
}
