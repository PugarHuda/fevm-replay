//! Mainnet-seeded fuzzing: a real transaction, mutated, run on its own
//! mainnet pre-state twice, once with the deployed code and once with the
//! port, and the two compared. Shadow replay covers what mainnet did; this
//! covers what it nearly did, against real tokens, routers and bots.
//!
//! Each mutation either changes the transaction's own calldata, which
//! exercises whatever router or bot sent it, or changes one of the calls the
//! shadowed contract really received, in flight: the contract's account
//! runs a small proxy that patches one word of its calldata and delegates
//! to the real code (deployed or port) at another address. The transaction
//! then runs unchanged, so the mutated call lands at the moment it did on
//! chain, with the tokens a router sent ahead of a swap already there and
//! the real caller as `msg.sender`. Gas is free (base fee and price zero),
//! so the two runs differ only by what the code does. Accounts and slots the original
//! transaction did not touch are absent from the pre-state and read as
//! empty in both runs: a mutation that wanders off is still compared fairly.

use core::{MemBuffer, MemSpan, MemVec}
use json::Value
use fevm::{BlockEnv, Buffers, Config, WorldState, transact}
use fevm::trace::{CallEnd, CallStart, Tracer}
use fevm::status::{ERR_OUT_OF_GAS, OK}
use ingot::fuzz::{same_bytes, same_logs, same_reason, same_state_except, same_status}
use ingot::load::{field, hex_bytes, load_tx_with, load_world}
use ingot::replay::{build_world, shadow_targets}
use ingot::watch::{GasWatch, differing_owner, explain_gas, first_parting, merge_coverage}

/// A contract that read the gas left where two runs part, and in how many
/// runs.
pub struct Reader { pub address: u256, pub runs: u64 }

impl Copy for Reader {}

/// Counts one more run for `address` in `readers`.
pub fn add_reader(_ readers: mut MemVec<Reader>, _ address: u256, runs: u64) {
    for i in 0 .. readers.len() {
        if readers[i].address == address {
            readers[i].runs += runs
            return
        }
    }
    readers.push(Reader { address, runs })
}

/// What mutating a block's transactions found.
pub struct Mutations {
    /// Transactions whose pre-state holds the shadowed code.
    pub transactions: u64,
    pub runs: u64,
    pub identical: u64,
    /// Runs that differ where other code read the gas left or code hashes.
    pub sensitive: u64,
    /// Of those, the runs where code read code hashes.
    pub code_sensitive: u64,
    /// Of those where code read the gas left, the runs that part at or
    /// under a call whose code read it (see `watch::gas_reader`), and which
    /// contracts those were.
    pub gas_explained: u64,
    pub readers: MemVec<Reader>,
    /// The first run where code read the gas left but the runs part
    /// elsewhere: its transaction's index plus one (0 for none), and the
    /// parting call's index, target and status on each side (-1 for none).
    pub unexplained_tx: u64,
    pub unexplained_at: u64,
    pub unexplained_to: u256,
    pub unexplained_deployed: i32,
    pub unexplained_port: i32,
    pub unexplained_what: u8,
    /// The program counters the port ran, over every run (see
    /// `GasWatch::covered`).
    pub covered: MemVec<u8>,
    /// In-flight runs whose changed call succeeded on the deployed code:
    /// how far the changes got past the contract's own checks.
    pub flight_succeeded: u64,
    pub differ: u64,
    /// Runs where the deployed code, which costs more, ran out of gas and the
    /// port did not: in flight, both agree given twice the gas; otherwise the
    /// runs part at a call, same calldata, that ran out of gas only on the
    /// deployed code (its caller gave it a fixed amount).
    pub cheaper: u64,
    /// Runs that differ after a word shaped like an address (upper twelve
    /// bytes zero) got upper bits: Fe's decoder rejects what solc cleaned.
    pub dirtied: u64,
    /// Runs of each kind: the transaction's calldata changed, or a call
    /// into the shadowed contract changed in flight.
    pub tx_runs: u64,
    pub direct_runs: u64,
    /// The first difference: the transaction's index plus one (0 for none),
    /// the run's kind, target, calldata and outcome on each side.
    pub first_tx: u64,
    pub first_direct: bool,
    pub first_to: u256,
    pub first_data: MemBuffer,
    pub first_what: u8,
    pub first_deployed: [i32; 2],
    pub first_port: [i32; 2],
    /// In flight, the changed call's output on each side; otherwise the
    /// transaction's.
    pub first_deployed_output: MemBuffer,
    pub first_port_output: MemBuffer,
    /// Where the two runs part (see `watch::first_parting`): the call's
    /// index, target and selector, and its status on each side (-1 if that
    /// side made no such call).
    pub parting: u64,
    pub parting_to: u256,
    pub parting_selector: u32,
    pub parting_deployed: i32,
    pub parting_port: i32,
}

impl Mutations {
    pub fn new() -> Self {
        Mutations {
            transactions: 0,
            runs: 0,
            identical: 0,
            sensitive: 0,
            code_sensitive: 0,
            gas_explained: 0,
            readers: MemVec::new(),
            unexplained_tx: 0,
            unexplained_at: 0,
            unexplained_to: 0,
            unexplained_deployed: -1,
            unexplained_port: -1,
            unexplained_what: 0,
            covered: MemVec::new(),
            flight_succeeded: 0,
            differ: 0,
            cheaper: 0,
            dirtied: 0,
            tx_runs: 0,
            direct_runs: 0,
            first_tx: 0,
            first_direct: false,
            first_to: 0,
            first_data: MemBuffer::empty(),
            first_what: 0,
            first_deployed: [0, 0],
            first_port: [0, 0],
            first_deployed_output: MemBuffer::empty(),
            first_port_output: MemBuffer::empty(),
            parting: 0,
            parting_to: 0,
            parting_selector: 0,
            parting_deployed: -1,
            parting_port: -1,
        }
    }
}

// xorshift64*, as in `fuzz`.
struct Rng { state: u64 }

impl Rng {
    fn next(mut self) -> u64 {
        var x = self.state
        x ^= x >> 12
        x ^= x << 25
        x ^= x >> 27
        self.state = x
        x.wrapping_mul(0x2545f4914f6cdd1d)
    }

    fn below(mut self, _ n: u64) -> u64 {
        self.next() % n
    }

    // A position below `n`, for indexing.
    fn index(mut self, _ n: usize) -> usize {
        let m: u64 = n.downcast_unchecked()
        (self.next() % m).downcast_unchecked()
    }
}

// A call into shadowed code seen in a run: where its calldata sits in
// `Recorder.inputs`.
struct Seen { to: u256, start: usize, len: usize }

impl Copy for Seen {}

// Records the calls into the shadowed accounts, up to eight.
struct Recorder { targets: MemVec<u256>, seen: MemVec<Seen>, inputs: MemBuffer }

impl Tracer for Recorder {
    fn enter(mut self, _ call: CallStart, input: MemSpan) {
        if self.seen.len() >= 8 {
            return
        }
        for i in 0 .. self.targets.len() {
            if self.targets[i] == call.to {
                let start = self.inputs.len()
                for j in 0 .. input.len() {
                    self.inputs.push(input[j])
                }
                self.seen.push(Seen { to: call.to, start, len: input.len() })
                return
            }
        }
    }
}

fn copy_list(_ list: MemVec<u256>) -> MemVec<u256> {
    var out: MemVec<u256> = MemVec::new()
    for i in 0 .. list.len() {
        out.push(list[i])
    }
    out
}

/// Runs `count` mutations of transaction `index` of a block (`tx` and its
/// `prestate`) with every account running `deployed` shadowed by `port`.
/// The first run is the transaction unchanged, as a control.
pub fn mutate_tx(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ prestate: Value,
    index: u64,
    deployed: MemSpan,
    port: MemSpan,
    count: u64,
    seed: u64,
    _ found: mut Mutations,
) {
    // Blob transactions need a blob fee; they never reach a pair anyway.
    if field(tx, "type") == 3 {
        return
    }
    let targets = shadow_targets(load_world(prestate), 0, deployed)
    if targets.len() == 0 {
        return
    }
    found.transactions += 1
    var free = block
    free.basefee = 0
    let original = hex_bytes(tx["input"].text())
    var ported = copy_list(targets)
    ported.push(IMPL)
    // The calls the shadowed accounts really received.
    var recorder = Recorder {
        targets: copy_list(targets),
        seen: MemVec::new(),
        inputs: MemBuffer::empty(),
    }
    var buffers = Buffers::new()
    transact(
        build_world(
            prestate,
            block,
            parent_hash,
            extras,
            MemVec::new(),
            deployed,
        ),
        load_tx_with(tx, input: original.span(), priced: false),
        free,
        Config::osaka(),
        mut buffers,
        mut recorder,
    )
    var rng = Rng { state: (seed + index).wrapping_mul(0x9e3779b97f4a7c15) | 1 }
    var run: u64 = 0
    while run < count {
        let direct = run > 0 && recorder.seen.len() > 0 && rng.below(2) == 0
        var data = MemBuffer::empty()
        var to: u256 = 0
        var dirtied = false
        var patch = Patch { at: 0, word: 0, len: 0, replaces: false }
        if direct {
            let seen = recorder.seen[rng.index(recorder.seen.len())]
            to = seen.to
            var received = MemBuffer::empty()
            for i in 0 .. seen.len {
                received.push(recorder.inputs.span()[seen.start + i])
            }
            data = MemBuffer::from_span(received.span())
            dirtied = mutate(mut rng, mut data)
            patch = patch_between(received.span(), data.span())
            found.direct_runs += 1
        } else {
            data = MemBuffer::from_span(original.span())
            if run > 0 {
                dirtied = mutate(mut rng, mut data)
            }
            found.tx_runs += 1
        }
        // In flight, the transaction itself runs unchanged.
        let input = if direct {
            MemBuffer::from_span(original.span())
        } else {
            MemBuffer::from_span(data.span())
        }
        let what = compare_run(
            free,
            parent_hash,
            extras,
            tx,
            prestate,
            targets,
            ported,
            deployed,
            port,
            direct,
            to,
            patch,
            input.span(),
            index,
            more_gas: false,
            mut found,
        )
        found.runs += 1
        run += 1
        if what == 0 {
            found.identical += 1
        } else if what == CHEAPER {
            found.cheaper += 1
        } else if what < 10 && dirtied {
            found.dirtied += 1
        } else if what < 10 {
            found.differ += 1
            if found.first_tx == 0 {
                found.first_tx = index + 1
                found.first_direct = direct
                found.first_to = if direct { to } else { field(tx, "to") }
                found.first_data = MemBuffer::from_span(data.span())
                found.first_what = what
            }
        } else {
            found.sensitive += 1
        }
    }
}

// Runs one mutation on both codes: 0 if identical, 1 to 4 (status, return
// data, logs, state) if not, 10 plus that if other code read the gas left
// or code hashes, which differ by design, and CHEAPER if the port succeeded
// where the deployed code did not but both agree given twice the gas.
fn compare_run(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ prestate: Value,
    _ targets: MemVec<u256>,
    _ ported: MemVec<u256>,
    _ deployed: MemSpan,
    _ port: MemSpan,
    _ direct: bool,
    _ to: u256,
    _ patch: Patch,
    _ data: MemSpan,
    index: u64,
    more_gas: bool,
    _ found: mut Mutations,
) -> u8 {
    // The code under test runs at the targets, or behind a proxy at IMPL.
    var watch_a = GasWatch::new(shadows: ported)
    var watch_b = GasWatch::new(shadows: ported)
    if direct {
        watch_a.focus = to
        watch_b.focus = to
        watch_b.cover.push(IMPL)
    } else {
        watch_b.cover = copy_list(targets)
    }
    var buffers_a = Buffers::new()
    var buffers_b = Buffers::new()
    var world_a = build_world(prestate, block, parent_hash, extras, MemVec::new(), port)
    var world_b = build_world(
        prestate,
        block,
        parent_hash,
        extras,
        copy_list(targets),
        port,
    )
    if direct {
        let wrapper = proxy(patch)
        world_a.set_code(address: to, code: wrapper.span())
        world_a.set_code(address: IMPL, code: deployed)
        world_b.set_code(address: to, code: wrapper.span())
        world_b.set_code(address: IMPL, code: port)
    }
    var request_a = load_tx_with(tx, input: data, priced: false)
    var request_b = load_tx_with(tx, input: data, priced: false)
    if more_gas {
        request_a.env.gas_limit *= 2
        request_b.env.gas_limit *= 2
    }
    let ran_a = transact(
        world_a,
        request_a,
        block,
        Config::osaka(),
        mut buffers_a,
        mut watch_a,
    )
    let ran_b = transact(
        world_b,
        request_b,
        block,
        Config::osaka(),
        mut buffers_b,
        mut watch_b,
    )
    let what: u8 = if ran_a.receipt.invalid != ran_b.receipt.invalid
        || !same_status(ran_a.receipt.status, ran_b.receipt.status) {
        1
    } else if !same_bytes(ran_a.receipt.output.span(), ran_b.receipt.output.span())
        && !same_reason(ran_a.receipt.output.span(), ran_b.receipt.output.span()) {
        2
    } else if !same_logs(ran_a.receipt.logs, ran_b.receipt.logs) {
        3
    } else if !same_state_except(ran_a.state, ran_b.state, copy_list(ported)) {
        4
    } else {
        0
    }
    if !more_gas && direct && watch_a.focused && watch_a.focus_status == 0 {
        found.flight_succeeded += 1
    }
    merge_coverage(mut found.covered, watch_b.covered)
    if what == 0 { return 0 }
    // In flight, the changed call's own outcome decides: if it differs, the
    // code under test behaved differently, whatever its callers read.
    let call_differs = direct
        && watch_a.focused
        && watch_b.focused
        && (!same_status(watch_a.focus_status, watch_b.focus_status)
            || (!same_bytes(watch_a.focus_output.span(), watch_b.focus_output.span())
                && !same_reason(watch_a.focus_output.span(), watch_b.focus_output.span())))
    // The port succeeded where the deployed code did not (behind the proxy,
    // the deployed code running out of gas shows as a revert): a cost, not a
    // behavior, if both agree once given twice the gas. The port failing
    // where the deployed code succeeds stays a difference.
    if call_differs && !more_gas && watch_b.focus_status == 0 {
        let again = compare_run(
            block,
            parent_hash,
            extras,
            tx,
            prestate,
            targets,
            ported,
            deployed,
            port,
            direct,
            to,
            patch,
            data,
            index,
            more_gas: true,
            mut found,
        )
        if again == 0 {
            return CHEAPER
        }
    }
    // Or a caller gave a fixed amount of gas: the runs part where, with the
    // same calldata, the deployed code ran out and the port did not.
    if !more_gas && ran_out_first(watch_a, watch_b) {
        return CHEAPER
    }
    if !call_differs && (watch_a.read_code || watch_b.read_code) {
        found.code_sensitive += 1
        return what + 10
    }
    if !call_differs && watch_b.observed {
        match explain_gas(
            watch_a,
            watch_b,
            ran_a.receipt.logs,
            ran_b.receipt.logs,
            ran_a.state,
            ran_b.state,
        ) {
            Option::Some(reader) => {
                found.gas_explained += 1
                add_reader(mut found.readers, reader, runs: 1)
            },
            Option::None => {
                if found.unexplained_tx == 0 {
                    found.unexplained_tx = index + 1
                    found.unexplained_what = what
                    match first_parting(watch_a, watch_b) {
                        Option::Some(k) => {
                            found.unexplained_at = k.downcast_unchecked()
                            if k < watch_a.ended.len() {
                                found.unexplained_to = watch_a.calls[watch_a.ended[k]].to
                                found.unexplained_deployed = watch_a.calls[watch_a.ended[k]].status
                            }
                            if k < watch_b.ended.len() {
                                found.unexplained_to = watch_b.calls[watch_b.ended[k]].to
                                found.unexplained_port = watch_b.calls[watch_b.ended[k]].status
                            }
                        },
                        Option::None => {
                            found.unexplained_at = 0xffff
                            found.unexplained_to = differing_owner(
                                ran_a.receipt.logs,
                                ran_b.receipt.logs,
                                ran_a.state,
                                ran_b.state,
                            )
                        },
                    }
                }
            },
        }
        return what + 10
    }
    if found.first_tx == 0 {
        found.first_deployed = [ran_a.receipt.invalid, ran_a.receipt.status]
        found.first_port = [ran_b.receipt.invalid, ran_b.receipt.status]
        match first_parting(watch_a, watch_b) {
            Option::Some(k) => {
                found.parting = k.downcast_unchecked()
                if k < watch_a.ended.len() {
                    let call = watch_a.calls[watch_a.ended[k]]
                    found.parting_to = call.to
                    found.parting_selector = call.selector
                    found.parting_deployed = call.status
                }
                if k < watch_b.ended.len() {
                    let call = watch_b.calls[watch_b.ended[k]]
                    found.parting_to = call.to
                    found.parting_selector = call.selector
                    found.parting_port = call.status
                }
            },
            Option::None => {},
        }
        if direct && watch_a.focused && watch_b.focused {
            found.first_deployed = [0, watch_a.focus_status]
            found.first_port = [0, watch_b.focus_status]
            found.first_deployed_output = MemBuffer::from_span(watch_a.focus_output.span())
            found.first_port_output = MemBuffer::from_span(watch_b.focus_output.span())
        } else {
            found.first_deployed_output = MemBuffer::from_span(ran_a.receipt.output.span())
            found.first_port_output = MemBuffer::from_span(ran_b.receipt.output.span())
        }
    }
    what
}

// Whether the runs part at a call, with the same target and calldata, that
// ran out of gas on the deployed code and succeeded on the port.
pub fn ran_out_first(_ a: GasWatch, _ b: GasWatch) -> bool {
    match first_parting(a, b) {
        Option::Some(k) => {
            if k >= a.ended.len() || k >= b.ended.len() {
                return false
            }
            let x = a.calls[a.ended[k]]
            let y = b.calls[b.ended[k]]
            x.to == y.to && x.input == y.input && x.status == ERR_OUT_OF_GAS && y.status == OK
        },
        Option::None => false,
    }
}

// Where the code under test runs when a proxy stands in front of it.
const IMPL: u256 = 0xfe11ed

const CHEAPER: u8 = 20

// A change to a call's calldata as a proxy applies it: `word` written at
// `at` (when `replaces`), and `len` bytes passed on.
struct Patch { at: usize, word: u256, len: usize, replaces: bool }

impl Copy for Patch {}

// The patch that turns `before` into `after`, which differ in one word or
// in length (see `mutate`).
fn patch_between(_ before: MemSpan, _ after: MemSpan) -> Patch {
    let shorter = if before.len() < after.len() {
        before.len()
    } else {
        after.len()
    }
    for i in 0 .. shorter {
        if before[i] != after[i] && i >= 4 {
            let at = 4 + (i - 4) / 32 * 32
            if at + 32 <= after.len() {
                return Patch { at, word: read_word(after, at), len: after.len(), replaces: true }
            }
        }
    }
    Patch { at: 0, word: 0, len: after.len(), replaces: false }
}

// Code that copies its calldata, applies `patch`, DELEGATECALLs `IMPL` with
// all its gas and returns or reverts with what that returned. Storage,
// caller and value stay the account's own.
fn proxy(_ patch: Patch) -> MemBuffer {
    var code = MemBuffer::empty()
    // CALLDATACOPY(0, 0, CALLDATASIZE)
    push_bytes(mut code, 0x366000600037, 6)
    if patch.replaces {
        // PUSH32 word PUSH2 at MSTORE
        code.push(0x7f)
        push_bytes(mut code, patch.word, 32)
        code.push(0x61)
        push_bytes(mut code, patch.at as u256, 2)
        code.push(0x52)
    }
    // DELEGATECALL(GAS, IMPL, 0, len, 0, 0)
    push_bytes(mut code, 0x60006000, 4)
    code.push(0x61)
    push_bytes(mut code, patch.len as u256, 2)
    push_bytes(mut code, 0x6000, 2)
    code.push(0x73)
    push_bytes(mut code, IMPL, 20)
    push_bytes(mut code, 0x5af4, 2)
    // RETURNDATACOPY(0, 0, RETURNDATASIZE), then JUMPI on the call's result
    push_bytes(mut code, 0x3d600060003e, 6)
    let ok: u256 = (code.len() + 3 + 4) as u256
    code.push(0x60)
    push_bytes(mut code, ok, 1)
    code.push(0x57)
    // REVERT(0, RETURNDATASIZE); ok: RETURN(0, RETURNDATASIZE)
    push_bytes(mut code, 0x3d6000fd, 4)
    push_bytes(mut code, 0x5b3d6000f3, 5)
    code
}

// The low `n` bytes of `value`, most significant first.
fn push_bytes(_ code: mut MemBuffer, _ value: u256, _ n: usize) {
    for i in 0 .. n {
        code.push(
            ((value >> ((n - 1 - i) * 8) as u256) & 0xff).downcast_truncate(),
        )
    }
}

// One change to calldata past its selector: an argument word set to an edge
// value or nudged, a byte flipped, or the calldata cut short. True if it
// gave upper bits to a word shaped like an address.
fn mutate(_ rng: mut Rng, _ data: mut MemBuffer) -> bool {
    if data.len() < 4 {
        data.push((rng.next() & 0xff).downcast_truncate())
        return false
    }
    let words = (data.len() - 4) / 32
    let pick = rng.below(9)
    if words == 0 || pick == 7 {
        if data.len() > 4 {
            let at = 4 + rng.index(data.len() - 4)
            let flip: u8 = (rng.next() & 0xff).downcast_truncate()
            let word_at = 4 + (at - 4) / 32 * 32
            let shaped = word_at + 32 <= data.len() && read_word(data.span(), word_at) >> 160 == 0
            data.span()[at] = data.span()[at] ^ (flip | 1)
            return shaped && at < word_at + 12
        }
        return false
    }
    if pick == 8 {
        let keep = 4 + rng.index(data.len() - 4)
        var cut = MemBuffer::empty()
        for i in 0 .. keep {
            cut.push(data.span()[i])
        }
        data = cut
        return false
    }
    let at = 4 + rng.index(words) * 32
    let word = read_word(data.span(), at)
    let changed: u256 = match pick {
        0 => 0,
        1 => 1,
        2 => word.wrapping_add(1),
        3 => word.wrapping_sub(1),
        4 => word / 2,
        5 => word.wrapping_mul(2),
        _ => u256::max(),
    }
    write_word(mut data, at, changed)
    word >> 160 == 0 && changed >> 160 != 0
}

fn read_word(_ data: MemSpan, _ at: usize) -> u256 {
    var word: u256 = 0
    for i in 0 .. 32 {
        word = (word << 8) | data[at + i] as u256
    }
    word
}

fn write_word(_ data: mut MemBuffer, _ at: usize, _ word: u256) {
    for i in 0 .. 32 {
        data.span()[at + i] = ((word >> ((31 - i) * 8) as u256) & 0xff).downcast_truncate()
    }
}
