//! Shadow fuzzing: random calls against two copies of one world, one running
//! the deployed contract's code and one running its Fe port, compared after
//! every call. Shadow replay covers the calls mainnet happened to make; this
//! covers the ones it has not made yet.
//!
//! The calls target an ERC-20 wrapper with WETH9's interface. Actors are
//! three accounts and two forwarder contracts, one accepting ETH and one
//! rejecting it, so withdrawals into contract fallbacks are exercised. Gas
//! is priced at zero, so a port that costs different gas leaves every
//! balance as the original does; what is compared is status, return data,
//! logs and all state. Everything follows from the seed.

use core::{MemBuffer, MemSpan, MemVec}
use keccak::Keccak256
use ingot::watch::{GasWatch, merge_coverage}
use fevm::{
    BlockEnv,
    Buffers,
    Config,
    InputData,
    LogBuffer,
    OK,
    TxEnv,
    TxRequest,
    WorldState,
    transact,
}
use fevm::status::exceptional

/// Where the contract under test lives in the fuzzed world.
pub const TARGET: u256 = 0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2

const FORWARDER_ACCEPTS: u256 = 0x2000
// The USDT scenario: the token at its mainnet address, and successors a
// deprecated token forwards to: one answering every call with a word, one
// reverting every call.
pub const USDT: u256 = 0xdac17f958d2ee523a2206206994597c13d831ec7
const SUCCESSOR_ANSWERS: u256 = 0x3010
const SUCCESSOR_REVERTS: u256 = 0x3011
const FORWARDER_REJECTS: u256 = 0x2001
const ETHER: u256 = 1_000_000_000_000_000_000

// Categories of calls, reported apart: well-formed calls, calls whose
// calldata ends before their arguments do, and calls whose address
// arguments carry nonzero upper bits.
pub const WELL_FORMED: u8 = 0
pub const SHORT_CALLDATA: u8 = 1
pub const DIRTY_ADDRESS: u8 = 2

/// What a fuzzing session found, per category.
pub struct Findings {
    /// The program counters the port ran (see `GasWatch::covered`).
    pub covered: MemVec<u8>,
    pub calls: [u64; 3],
    pub identical: [u64; 3],
    /// Calls whose `Error(string)` reasons agree but whose padding after
    /// the reason does not: solc 0.5 pads with whatever memory held.
    pub dirty_padding: u64,
    /// Identical well-formed calls that succeeded, per selector: what the
    /// fuzzing reached beyond reverts.
    pub succeeded: MemVec<SelectorCount>,
    /// The first difference's run cut down to the calls it needs, their
    /// calldata in `shrunk_inputs`.
    pub shrunk: MemVec<Sent>,
    pub shrunk_inputs: MemBuffer,
    /// Pair runs only: calls after which the port broke an invariant of
    /// Uniswap V2 (see `check_invariants`), and the first: run seed, call
    /// and which invariant (1 lock held, 2 k fell in a swap, 3 supply
    /// below the minimum liquidity).
    pub invariant_breaks: u64,
    pub invariant_seed: u64,
    pub invariant_step: u64,
    pub invariant_kind: u8,
    /// The first difference: its seed, step and category, or `step` 0
    /// when there was none.
    pub first_seed: u64,
    pub first_step: u64,
    pub first_category: u8,
    pub first_selector: u32,
    /// What differed first: 1 status, 2 return data, 3 logs, 4 state.
    pub first_what: u8,
    /// The transaction that showed it.
    pub first_from: u256,
    pub first_to: u256,
    pub first_value: u256,
    pub first_data: MemBuffer,
    /// Its outcome on each side: `invalid`, then `status`, as fevm reports them.
    pub first_deployed: [i32; 2],
    pub first_port: [i32; 2],
    /// Its return or revert data on each side.
    pub first_deployed_output: MemBuffer,
    pub first_port_output: MemBuffer,
}

impl Findings {
    pub fn new() -> Self {
        Findings {
            covered: MemVec::new(),
            calls: [0, 0, 0],
            identical: [0, 0, 0],
            dirty_padding: 0,
            succeeded: MemVec::new(),
            shrunk: MemVec::new(),
            shrunk_inputs: MemBuffer::empty(),
            invariant_breaks: 0,
            invariant_seed: 0,
            invariant_step: 0,
            invariant_kind: 0,
            first_seed: 0,
            first_step: 0,
            first_category: 0,
            first_selector: 0,
            first_what: 0,
            first_from: 0,
            first_to: 0,
            first_value: 0,
            first_data: MemBuffer::empty(),
            first_deployed: [0, 0],
            first_port: [0, 0],
            first_deployed_output: MemBuffer::empty(),
            first_port_output: MemBuffer::empty(),
        }
    }
}

pub struct SelectorCount { pub selector: u32, pub calls: u64 }

impl Copy for SelectorCount {}

fn count(_ counts: mut MemVec<SelectorCount>, _ selector: u32) {
    for i in 0 .. counts.len() {
        if counts[i].selector == selector {
            counts[i].calls += 1
            return
        }
    }
    counts.push(SelectorCount { selector, calls: 1 })
}

// xorshift64*: small, fast and reproducible from its seed.
struct Rng { state: u64 }

impl Rng {
    fn next(mut self) -> u64 {
        var x = self.state
        x ^= x >> 12
        x ^= x << 25
        x ^= x >> 27
        self.state = x
        x.wrapping_mul(0x2545f4914f6cdd1d)
    }

    fn below(mut self, _ n: u64) -> u64 {
        self.next() % n
    }
}

/// A contract that forwards its calldata and value to `target` and reverts
/// if that call fails; when `target` itself calls it (a withdrawal paying
/// out), it either accepts the ETH, spending one gas, or reverts.
pub fn forwarder(_ target: u256, accepts: bool) -> MemBuffer {
    var code = MemBuffer::empty()
    // CALLER PUSH20 target EQ PUSH1 accept JUMPI
    code.push(0x33)
    push_address(mut code, target)
    code.push(0x14)
    code.push(0x60)
    code.push(73)
    code.push(0x57)
    // CALLDATACOPY(0, 0, CALLDATASIZE)
    code.push(0x36)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0x37)
    // CALL(GAS, target, CALLVALUE, 0, CALLDATASIZE, 0, 0)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0x36)
    code.push(0x60)
    code.push(0x00)
    code.push(0x34)
    push_address(mut code, target)
    code.push(0x5a)
    code.push(0xf1)
    // PUSH1 ok JUMPI REVERT(0, 0)
    code.push(0x60)
    code.push(71)
    code.push(0x57)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0xfd)
    // ok (71): JUMPDEST STOP
    code.push(0x5b)
    code.push(0x00)
    // accept (73): JUMPDEST, then STOP or REVERT(0, 0)
    code.push(0x5b)
    if accepts {
        code.push(0x00)
    } else {
        code.push(0x60)
        code.push(0x00)
        code.push(0x60)
        code.push(0x00)
        code.push(0xfd)
    }
    code
}

fn push_address(_ code: mut MemBuffer, _ address: u256) {
    code.push(0x73)
    var i: u256 = 20
    while i > 0 {
        i -= 1
        code.push(((address >> (i * 8)) & 0xff).downcast_truncate())
    }
}

fn push_word(_ data: mut MemBuffer, _ word: u256) {
    var i: u256 = 32
    while i > 0 {
        i -= 1
        data.push(((word >> (i * 8)) & 0xff).downcast_truncate())
    }
}

fn push_selector(_ data: mut MemBuffer, _ selector: u32) {
    data.push((selector >> 24).downcast_truncate())
    data.push(((selector >> 16) & 0xff).downcast_truncate())
    data.push(((selector >> 8) & 0xff).downcast_truncate())
    data.push((selector & 0xff).downcast_truncate())
}

fn eoa(_ index: u64) -> u256 {
    0x1000 + index as u256
}

/// The fuzzed world: the contract under test, the two forwarders and three
/// funded accounts.
pub fn genesis(_ code: MemSpan) -> WorldState {
    var world = WorldState::empty()
    world.set_code(address: TARGET, code: code)
    let accepting = forwarder(TARGET, accepts: true)
    let rejecting = forwarder(TARGET, accepts: false)
    world.set_code(address: FORWARDER_ACCEPTS, code: accepting.span())
    world.set_code(address: FORWARDER_REJECTS, code: rejecting.span())
    world.set_balance(eoa(0), 1000 * ETHER)
    world.set_balance(eoa(1), 1000 * ETHER)
    world.set_balance(eoa(2), 1000 * ETHER)
    world
}

fn amount(_ rng: mut Rng) -> u256 {
    match rng.below(9) {
        0 => 0,
        1 => 1,
        2 => 2,
        3 => ETHER,
        4 => ETHER / 2,
        5 => 1 << 128,
        6 => u256::max(),
        7 => 3 * ETHER,
        _ => rng.next() as u256,
    }
}

fn actor(_ rng: mut Rng) -> u256 {
    match rng.below(7) {
        0 => eoa(0),
        1 => eoa(1),
        2 => eoa(2),
        3 => FORWARDER_ACCEPTS,
        4 => FORWARDER_REJECTS,
        5 => TARGET,
        _ => 0,
    }
}

// An address argument, with garbage in its upper twelve bytes when `dirty`.
fn address_word(_ address: u256, dirty: bool, _ rng: mut Rng) -> u256 {
    if dirty {
        address | ((rng.next() as u256 | 1) << 200)
    } else {
        address
    }
}

// One random call: its calldata in `data`, its target, value, category and
// selector.
struct Call { to: u256, value: u256, category: u8, selector: u32 }

impl Copy for Call {}

// A call to WETH9's interface, made directly or through a forwarder.
/// Whether `token` selects the USDT scenario: the one byte `U`.
pub fn is_usdt(_ token: MemSpan) -> bool {
    token.len() == 1 && token[0] == 0x55
}

// USDT as deployed, owned by the first account, each account holding
// 100,000,000 USDT (six decimals), and two successors to deprecate to.
fn usdt_genesis(_ code: MemSpan) -> WorldState {
    var world = WorldState::empty()
    world.set_code(address: USDT, code: code)
    world.storage_store(USDT, 0, eoa(0))
    world.storage_store(USDT, 1, 3 * 100_000_000_000_000)
    for i in 0 .. 3 {
        let who = eoa(i.downcast_unchecked())
        world.set_balance(who, 1000 * ETHER)
        world.storage_store(USDT, mapping_slot(who, 2), 100_000_000_000_000)
    }
    world.storage_store(
            USDT,
            7,
            0x5465746865722055534400000000000000000000000000000000000000000014,
        )
    world.storage_store(
            USDT,
            8,
            0x5553445400000000000000000000000000000000000000000000000000000008,
        )
    world.storage_store(USDT, 9, 6)
    // PUSH1 42 PUSH1 0 MSTORE PUSH1 32 PUSH1 0 RETURN
    var answers = MemBuffer::empty()
    for b in [0x60, 0x2a, 0x60, 0x00, 0x52, 0x60, 0x20, 0x60, 0x00, 0xf3] {
        answers.push(b)
    }
    world.set_code(address: SUCCESSOR_ANSWERS, code: answers.span())
    // PUSH1 0 DUP1 REVERT
    var reverts = MemBuffer::empty()
    for b in [0x60, 0x00, 0x80, 0xfd] {
        reverts.push(b)
    }
    world.set_code(address: SUCCESSOR_REVERTS, code: reverts.span())
    world
}

fn usdt_actor(_ rng: mut Rng) -> u256 {
    match rng.below(7) {
        0 => eoa(0),
        1 => eoa(1),
        2 => eoa(2),
        3 => USDT,
        4 => SUCCESSOR_ANSWERS,
        5 => 0,
        _ => eoa(1),
    }
}

fn usdt_amount(_ rng: mut Rng) -> u256 {
    match rng.below(6) {
        0 => 0,
        1 => 1 + rng.below(1000) as u256,
        2 => (1 + rng.below(9)) as u256 * pow10(rng.below(15)),
        3 => 100_000_000_000_000,
        4 => u256::max(),
        _ => rng.next() as u256,
    }
}

// A call on USDT: transfers, approvals and views from any account, and the
// owner's functions (issue, redeem, fees, pausing, blacklisting,
// deprecating, ownership), which only the first account may run.
fn usdt_call(_ rng: mut Rng, _ data: mut MemBuffer) -> Call {
    let dirty = rng.below(10) == 0
    let short = !dirty && rng.below(12) == 0
    let category = if dirty {
        DIRTY_ADDRESS
    } else if short { SHORT_CALLDATA } else { WELL_FORMED }
    let value: u256 = if rng.below(30) == 0 { 1 } else { 0 }
    let op = rng.below(24)
    let selector: u32 = match op {
        0 => 0xa9059cbb,
        1 => 0xa9059cbb,
        2 => 0xa9059cbb,
        3 => 0xa9059cbb,
        4 => 0x23b872dd,
        5 => 0x23b872dd,
        6 => 0x095ea7b3,
        7 => 0x095ea7b3,
        8 => match rng.below(4) {
            0 => 0x70a08231,
            1 => 0x27e235e3,
            2 => 0xdd62ed3e,
            _ => 0x5c658165,
        },
        9 => match rng.below(13) {
            0 => 0x06fdde03,
            1 => 0x95d89b41,
            2 => 0x313ce567,
            3 => 0x18160ddd,
            4 => 0x3eaaf86b,
            5 => 0x8da5cb5b,
            6 => 0x893d20e8,
            7 => 0x5c975abb,
            8 => 0xdd644f72,
            9 => 0x35390714,
            10 => 0xe5b5019a,
            11 => 0x26976e3f,
            _ => 0x0e136b19,
        },
        10 => if rng.below(2) == 0 {
            0xe47d6060
        } else {
            0x59bf1abe
        },
        11 => 0xcc872b66,
        12 => 0xdb006a75,
        13 => 0xc0324c77,
        14 => if rng.below(2) == 0 {
            0x8456cb59
        } else {
            0x3f4ba83a
        },
        15 => 0x0ecb93c0,
        16 => 0xe4997dc5,
        17 => 0xf3bdc228,
        18 => 0x0753c30c,
        19 => 0xf2fde38b,
        20 => 0xa9059cbb,
        21 => 0x095ea7b3,
        22 => 0x23b872dd,
        _ => if rng.below(2) == 0 { 0x12345678 } else { 0 },
    }
    if selector != 0 {
        push_selector(mut data, selector)
    }
    if selector == 0xa9059cbb {
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
        push_word(mut data, usdt_amount(mut rng))
    } else if selector == 0x23b872dd {
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
        push_word(mut data, usdt_amount(mut rng))
    } else if selector == 0x095ea7b3 {
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
        push_word(
            mut data,
            if rng.below(3) == 0 {
                0
            } else {
                usdt_amount(mut rng)
            },
        )
    } else if selector == 0x70a08231
        || selector == 0x27e235e3
        || op == 10
        || op == 15
        || op == 16
        || op == 17
        || op == 19 {
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
    } else if selector == 0xdd62ed3e || selector == 0x5c658165 {
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
        push_word(
            mut data,
            address_word(usdt_actor(mut rng), dirty, mut rng),
        )
    } else if op == 11 || op == 12 {
        push_word(mut data, usdt_amount(mut rng))
    } else if op == 13 {
        push_word(mut data, rng.below(25) as u256)
        push_word(mut data, rng.below(60) as u256)
    } else if op == 18 {
        let successor = match rng.below(3) {
            0 => SUCCESSOR_ANSWERS,
            1 => SUCCESSOR_REVERTS,
            _ => eoa(2),
        }
        push_word(mut data, address_word(successor, dirty, mut rng))
    }
    if short {
        cut_short(mut rng, mut data)
    }
    Call { to: USDT, value, category, selector }
}

fn weth_call(_ rng: mut Rng, _ data: mut MemBuffer) -> Call {
    let call = random_call(mut rng, mut data)
    let pick = rng.below(5)
    let to = if pick == 3 {
        FORWARDER_ACCEPTS
    } else if pick == 4 { FORWARDER_REJECTS } else { TARGET }
    Call { to, value: call.value, category: call.category, selector: call.selector }
}

fn random_call(_ rng: mut Rng, _ data: mut MemBuffer) -> Call {
    let dirty = rng.below(8) == 0
    let short = !dirty && rng.below(10) == 0
    let category = if dirty {
        DIRTY_ADDRESS
    } else if short { SHORT_CALLDATA } else { WELL_FORMED }
    // Value goes mostly with deposits; elsewhere it should be refused.
    var value: u256 = if rng.below(6) == 0 {
        amount(mut rng) % (5 * ETHER)
    } else {
        0
    }
    let op = rng.below(12)
    let selector: u32 = match op {
        0 => 0xd0e30db0,
        1 => 0x2e1a7d4d,
        2 => 0xa9059cbb,
        3 => 0x23b872dd,
        4 => 0x095ea7b3,
        5 => 0x70a08231,
        6 => 0xdd62ed3e,
        7 => 0x18160ddd,
        8 => 0x313ce567,
        9 => 0,
        10 => 0x06fdde03,
        _ => 0x12345678,
    }
    if op == 0 || op == 9 {
        value = amount(mut rng) % (5 * ETHER)
    }
    if selector != 0 {
        push_selector(mut data, selector)
    }
    match op {
        1 => push_word(mut data, amount(mut rng)),
        2 => {
            push_word(mut data, address_word(actor(mut rng), dirty, mut rng))
            push_word(mut data, amount(mut rng))
        },
        3 => {
            push_word(mut data, address_word(actor(mut rng), dirty, mut rng))
            push_word(mut data, address_word(actor(mut rng), dirty, mut rng))
            push_word(mut data, amount(mut rng))
        },
        4 => {
            push_word(mut data, address_word(actor(mut rng), dirty, mut rng))
            push_word(mut data, amount(mut rng))
        },
        5 => push_word(mut data, address_word(actor(mut rng), dirty, mut rng)),
        6 => {
            push_word(mut data, address_word(actor(mut rng), dirty, mut rng))
            push_word(mut data, address_word(actor(mut rng), dirty, mut rng))
        },
        _ => {},
    }
    if short {
        cut_short(mut rng, mut data)
    }
    Call { to: TARGET, value, category, selector }
}

// Short calldata: cut into the last argument.
fn cut_short(_ rng: mut Rng, _ data: mut MemBuffer) {
    if data.len() > 4 {
        let keep = 4 + rng.below((data.len() - 4).downcast_unchecked()).downcast_unchecked()
        var cut = MemBuffer::empty()
        for i in 0 .. keep {
            cut.push(data.span()[i])
        }
        data = cut
    }
}

// The Uniswap V2 pair scenario: a pair of two tokens running WETH9's code,
// a factory whose `feeTo` is unset or set, and two flash-swap callees, one
// accepting and one reentering the pair.
pub const PAIR: u256 = 0x4000
const TOKEN0: u256 = 0x3000
const TOKEN1: u256 = 0x3001
const FACTORY_FEE_OFF: u256 = 0x3002
const FACTORY_FEE_ON: u256 = 0x3003
const CALLEE_ACCEPTS: u256 = 0x3004
const CALLEE_REENTERS: u256 = 0x3005
// A flash-swap callee that pays back what it borrowed, and a little more.
const CALLEE_PAYS: u256 = 0x3006
// A swap amount at or above this is resolved when the call runs (see
// `resolve`): the most the constant product allows, plus the excess.
const BOUNDARY: u256 = 1 << 255
// A swap amount from this up to `BOUNDARY` takes sixteenths of the reserve
// out: what a flash swap borrows (see `resolve`).
const SIXTEENTHS: u256 = 1 << 254
const FEE_TO: u256 = 0x1003

// Code answering any call with the word `value`.
fn returns_word(_ value: u256) -> MemBuffer {
    var code = MemBuffer::empty()
    push_address(mut code, value)
    // PUSH1 0 MSTORE PUSH1 32 PUSH1 0 RETURN
    code.push(0x60)
    code.push(0x00)
    code.push(0x52)
    code.push(0x60)
    code.push(0x20)
    code.push(0x60)
    code.push(0x00)
    code.push(0xf3)
    code
}

// A flash-swap callee that calls the pair's `sync()` back, which the pair's
// lock refuses, and reverts with the pair's revert data.
fn reentering_callee() -> MemBuffer {
    var code = MemBuffer::empty()
    // PUSH4 sync() PUSH1 224 SHL PUSH1 0 MSTORE
    code.push(0x63)
    push_selector(mut code, 0xfff6cae9)
    code.push(0x60)
    code.push(0xe0)
    code.push(0x1b)
    code.push(0x60)
    code.push(0x00)
    code.push(0x52)
    // CALL(GAS, PAIR, 0, 0, 4, 0, 0)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x04)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    push_address(mut code, PAIR)
    code.push(0x5a)
    code.push(0xf1)
    // PUSH1 ok JUMPI
    let ok = code.len() + 3 + 10
    code.push(0x60)
    code.push(ok.downcast_truncate())
    code.push(0x57)
    // RETURNDATACOPY(0, 0, RETURNDATASIZE) REVERT(0, RETURNDATASIZE)
    code.push(0x3d)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0x3e)
    code.push(0x3d)
    code.push(0x60)
    code.push(0x00)
    code.push(0xfd)
    // ok: JUMPDEST STOP
    code.push(0x5b)
    code.push(0x00)
    code
}

fn pair_genesis(_ pair: MemSpan, _ token: MemSpan, fee_on: bool) -> WorldState {
    var world = WorldState::empty()
    world.set_code(address: PAIR, code: pair)
    world.set_code(address: TOKEN0, code: token)
    world.set_code(address: TOKEN1, code: token)
    let off = returns_word(0)
    let on = returns_word(FEE_TO)
    world.set_code(address: FACTORY_FEE_OFF, code: off.span())
    world.set_code(address: FACTORY_FEE_ON, code: on.span())
    var stop = MemBuffer::empty()
    stop.push(0x00)
    world.set_code(address: CALLEE_ACCEPTS, code: stop.span())
    let reenters = reentering_callee()
    world.set_code(address: CALLEE_REENTERS, code: reenters.span())
    // The storage UniswapV2Factory's createPair leaves: DOMAIN_SEPARATOR,
    // factory, token0, token1 and `unlocked`.
    world.storage_store(PAIR, 3, 0xd0a1)
    world.storage_store(
            PAIR,
            5,
            if fee_on {
                FACTORY_FEE_ON
            } else {
                FACTORY_FEE_OFF
            },
        )
    world.storage_store(PAIR, 6, TOKEN0)
    world.storage_store(PAIR, 7, TOKEN1)
    world.storage_store(PAIR, 12, 1)
    for i in 0 .. 3 {
        world.set_balance(eoa(i.downcast_unchecked()), 1000 * ETHER)
    }
    // Every account wraps 100 ETH into each token.
    for i in 0 .. 3 {
        world = deposit(world, eoa(i.downcast_unchecked()), TOKEN0)
        world = deposit(world, eoa(i.downcast_unchecked()), TOKEN1)
    }
    // So does the paying callee, before it gets its code.
    world.set_balance(CALLEE_PAYS, 1000 * ETHER)
    world = deposit(world, CALLEE_PAYS, TOKEN0)
    world = deposit(world, CALLEE_PAYS, TOKEN1)
    let pays = paying_callee()
    world.set_code(address: CALLEE_PAYS, code: pays.span())
    world
}

// uniswapV2Call(sender, amount0, amount1, data): for each amount borrowed,
// transfers amount * 1004 / 1000 + 1 of that token back to the caller (the
// pair), which covers the 0.3% fee.
fn paying_callee() -> MemBuffer {
    var code = MemBuffer::empty()
    pay_back(mut code, 0x24, TOKEN0)
    pay_back(mut code, 0x44, TOKEN1)
    code.push(0x00)
    code
}

fn pay_back(_ code: mut MemBuffer, _ at: u8, _ token: u256) {
    // PUSH1 at CALLDATALOAD DUP1 ISZERO PUSH2 skip JUMPI
    let start = code.len()
    let skip = start + 59
    code.push(0x60)
    code.push(at)
    code.push(0x35)
    code.push(0x80)
    code.push(0x15)
    code.push(0x61)
    code.push((skip >> 8).downcast_truncate())
    code.push((skip & 0xff).downcast_truncate())
    code.push(0x57)
    // PUSH2 1004 MUL PUSH2 1000 SWAP1 DIV PUSH1 1 ADD
    code.push(0x61)
    code.push(0x03)
    code.push(0xec)
    code.push(0x02)
    code.push(0x61)
    code.push(0x03)
    code.push(0xe8)
    code.push(0x90)
    code.push(0x04)
    code.push(0x60)
    code.push(0x01)
    code.push(0x01)
    // transfer(CALLER, pay): PUSH4 sel PUSH1 224 SHL PUSH1 0 MSTORE
    code.push(0x63)
    push_selector(mut code, 0xa9059cbb)
    code.push(0x60)
    code.push(0xe0)
    code.push(0x1b)
    code.push(0x60)
    code.push(0x00)
    code.push(0x52)
    // CALLER PUSH1 4 MSTORE PUSH1 0x24 MSTORE
    code.push(0x33)
    code.push(0x60)
    code.push(0x04)
    code.push(0x52)
    code.push(0x60)
    code.push(0x24)
    code.push(0x52)
    // CALL(GAS, token, 0, 0, 0x44, 0, 0) POP
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x44)
    code.push(0x60)
    code.push(0x00)
    code.push(0x60)
    code.push(0x00)
    code.push(0x61)
    code.push(((token >> 8) & 0xff).downcast_truncate())
    code.push((token & 0xff).downcast_truncate())
    code.push(0x5a)
    code.push(0xf1)
    code.push(0x50)
    // PUSH2 next JUMP; skip: JUMPDEST POP; next: JUMPDEST
    let next = skip + 2
    code.push(0x61)
    code.push((next >> 8).downcast_truncate())
    code.push((next & 0xff).downcast_truncate())
    code.push(0x56)
    core::assert(code.len() == skip)
    code.push(0x5b)
    code.push(0x50)
    code.push(0x5b)
}

/// Resolves a swap's boundary amounts against `world`, the state the call
/// runs on: an amount out at or above `BOUNDARY` becomes the most the
/// constant product allows for what has been paid in, plus the excess
/// (0 is exactly at the boundary, 1 is one past it). Run on the deployed
/// code's world, which agrees with the port's until the runs differ.
pub fn resolve(_ world: WorldState, _ data: mut MemBuffer) {
    if data.len() < 68 || read_selector(data.span()) != 0x022c0d9f {
        return
    }
    let reserves = world.storage_load(PAIR, 8)
    let mask: u256 = (1 << 112) - 1
    let reserve0 = reserves & mask
    let reserve1 = (reserves >> 112) & mask
    let slot = mapping_slot(PAIR, 3)
    let balance0 = world.storage_load(TOKEN0, slot)
    let balance1 = world.storage_load(TOKEN1, slot)
    let in0 = if balance0 > reserve0 {
        balance0 - reserve0
    } else {
        0
    }
    let in1 = if balance1 > reserve1 {
        balance1 - reserve1
    } else {
        0
    }
    for side in 0 .. 2 {
        let at: usize = 4 + side * 32
        let word = word_at(data.span(), at)
        if word >= SIXTEENTHS && word < BOUNDARY {
            let reserve_out = if side == 0 { reserve0 } else { reserve1 }
            set_word(mut data, at, reserve_out * (word - SIXTEENTHS) / 16)
        } else if word >= BOUNDARY {
            let excess = word - BOUNDARY
            let out = if side == 0 {
                most_out(in1, reserve1, reserve0)
            } else {
                most_out(in0, reserve0, reserve1)
            }
            set_word(mut data, at, out + excess)
        }
    }
}

// UniswapV2Library.getAmountOut: the most `amount_in` buys at 0.3% fee.
fn most_out(_ amount_in: u256, _ reserve_in: u256, _ reserve_out: u256) -> u256 {
    if amount_in == 0 || reserve_in == 0 || reserve_out == 0 {
        return 0
    }
    let with_fee = amount_in * 997
    with_fee * reserve_out / (reserve_in * 1000 + with_fee)
}

fn read_selector(_ data: MemSpan) -> u32 {
    var selector: u32 = 0
    for i in 0 .. 4 {
        selector = (selector << 8) | data[i] as u32
    }
    selector
}

fn word_at(_ data: MemSpan, _ at: usize) -> u256 {
    var word: u256 = 0
    for i in 0 .. 32 {
        word = (word << 8) | data[at + i] as u256
    }
    word
}

fn set_word(_ data: mut MemBuffer, _ at: usize, _ word: u256) {
    for i in 0 .. 32 {
        data.span()[at + i] = ((word >> ((31 - i) * 8) as u256) & 0xff).downcast_truncate()
    }
}

fn deposit(_ world: own WorldState, _ sender: u256, _ token: u256) -> WorldState {
    var data = MemBuffer::empty()
    push_selector(mut data, 0xd0e30db0)
    let call = Call { to: token, value: 100 * ETHER, category: WELL_FORMED, selector: 0xd0e30db0 }
    let tx = request(world, sender, to: token, call, data.span())
    var buffers = Buffers::new()
    var none = ()
    transact(
        world,
        tx,
        block(0),
        Config::osaka(),
        mut buffers,
        mut none,
    ).state
}

// Amounts sized for pools of a few hundred ether of each token, with the
// edges: zero, one, 2**112 and the largest word.
fn pair_amount(_ rng: mut Rng) -> u256 {
    match rng.below(10) {
        0 => 0,
        1 => 1,
        2 => 1000,
        3 => (1 + rng.below(9)) as u256 * pow10(rng.below(22)),
        4 => (1 + rng.below(9)) as u256 * pow10(rng.below(22)),
        5 => (1 + rng.below(99)) as u256 * ETHER / 10,
        6 => 1 << 112,
        7 => u256::max(),
        _ => rng.next() as u256 % (10 * ETHER),
    }
}

// Amounts out of a swap, or of liquidity to burn: mostly small enough to
// succeed.
fn swap_amount(_ rng: mut Rng) -> u256 {
    match rng.below(4) {
        0 => 1 + rng.below(1000) as u256,
        1 => (1 + rng.below(9)) as u256 * pow10(rng.below(19)),
        _ => pair_amount(mut rng),
    }
}

fn pow10(_ n: u64) -> u256 {
    var x: u256 = 1
    var i: u64 = 0
    while i < n {
        x *= 10
        i += 1
    }
    x
}

fn pair_actor(_ rng: mut Rng) -> u256 {
    match rng.below(9) {
        0 => eoa(0),
        1 => eoa(1),
        2 => eoa(2),
        3 => PAIR,
        4 => TOKEN0,
        5 => CALLEE_ACCEPTS,
        6 => CALLEE_REENTERS,
        7 => FEE_TO,
        _ => 0,
    }
}

fn pair_call(_ rng: mut Rng, _ data: mut MemBuffer, step: u64) -> Call {
    let dirty = rng.below(10) == 0
    let short = !dirty && rng.below(12) == 0
    let category = if dirty {
        DIRTY_ADDRESS
    } else if short { SHORT_CALLDATA } else { WELL_FORMED }
    // Nothing on a pair is payable; now and then a call carries ETH anyway.
    let value: u256 = if rng.below(20) == 0 { 1 } else { 0 }
    var to = PAIR
    let op = rng.below(20)
    let selector: u32 = match op {
        0 => 0xa9059cbb,
        1 => 0xa9059cbb,
        2 => 0xa9059cbb,
        3 => 0xa9059cbb,
        4 => 0x6a627842,
        5 => 0x6a627842,
        6 => 0xa9059cbb,
        7 => 0x89afcb44,
        8 => 0x022c0d9f,
        9 => 0x022c0d9f,
        10 => 0x022c0d9f,
        11 => 0xbc25cf77,
        12 => 0xfff6cae9,
        13 => 0xa9059cbb,
        14 => if rng.below(2) == 0 {
            0x095ea7b3
        } else {
            0x23b872dd
        },
        15 => match rng.below(14) {
            0 => 0x06fdde03,
            1 => 0x95d89b41,
            2 => 0x313ce567,
            3 => 0x18160ddd,
            4 => 0x3644e515,
            5 => 0x30adf81f,
            6 => 0xba9a7a56,
            7 => 0xc45a0155,
            8 => 0x0dfe1681,
            9 => 0xd21220a7,
            10 => 0x0902f1ac,
            11 => 0x5909c0d5,
            12 => 0x5a3d5493,
            _ => 0x7464fc3d,
        },
        16 => match rng.below(3) {
            0 => 0x70a08231,
            1 => 0x7ecebe00,
            _ => 0xdd62ed3e,
        },
        17 => 0xd505accf,
        18 => 0x485cc955,
        _ => if rng.below(2) == 0 { 0x12345678 } else { 0 },
    }
    if selector != 0 {
        push_selector(mut data, selector)
    }
    if op < 4 {
        // Tokens into the pair, ahead of a mint, swap or skim.
        to = if op % 2 == 0 { TOKEN0 } else { TOKEN1 }
        push_word(mut data, address_word(PAIR, dirty, mut rng))
        push_word(mut data, pair_amount(mut rng))
    } else if op == 6 {
        // Liquidity tokens into the pair, ahead of a burn.
        push_word(mut data, address_word(PAIR, dirty, mut rng))
        push_word(mut data, swap_amount(mut rng))
    } else if op == 4 || op == 5 || op == 7 || op == 11 || op == 13 || op == 16 {
        push_word(
            mut data,
            address_word(pair_actor(mut rng), dirty, mut rng),
        )
        if op == 13 {
            push_word(mut data, pair_amount(mut rng))
        }
        if op == 16 && selector == 0xdd62ed3e {
            push_word(
                mut data,
                address_word(pair_actor(mut rng), dirty, mut rng),
            )
        }
    } else if op >= 8 && op <= 10 {
        swap_args(mut rng, mut data, dirty)
    } else if op == 14 {
        push_word(
            mut data,
            address_word(pair_actor(mut rng), dirty, mut rng),
        )
        if selector == 0x23b872dd {
            push_word(
                mut data,
                address_word(pair_actor(mut rng), dirty, mut rng),
            )
        }
        push_word(mut data, pair_amount(mut rng))
    } else if op == 17 {
        // permit(owner, spender, value, deadline, v, r, s) with a signature
        // that never verifies: expired, or signed by nobody.
        push_word(
            mut data,
            address_word(pair_actor(mut rng), dirty, mut rng),
        )
        push_word(
            mut data,
            address_word(pair_actor(mut rng), dirty, mut rng),
        )
        push_word(mut data, pair_amount(mut rng))
        // Expired, never, or exactly now: a deadline equal to the block's
        // timestamp has not passed.
        push_word(
            mut data,
            match rng.below(3) {
                0 => 0,
                1 => u256::max(),
                _ => block(step).timestamp,
            },
        )
        push_word(mut data, 27 + rng.below(2) as u256)
        push_word(mut data, rng.next() as u256)
        push_word(mut data, rng.next() as u256)
    } else if op == 18 {
        push_word(
            mut data,
            address_word(pair_actor(mut rng), dirty, mut rng),
        )
        push_word(
            mut data,
            address_word(pair_actor(mut rng), dirty, mut rng),
        )
    }
    if short {
        cut_short(mut rng, mut data)
    }
    Call { to, value, category, selector }
}

// swap(amount0Out, amount1Out, to, data): mostly one side out, to an
// account or a callee, with flash-swap data now and then.
fn swap_args(_ rng: mut Rng, _ data: mut MemBuffer, _ dirty: bool) {
    let side = rng.below(4)
    let flash = rng.below(3) == 0
    let callee = match rng.below(3) {
        0 => CALLEE_ACCEPTS,
        1 => CALLEE_REENTERS,
        _ => CALLEE_PAYS,
    }
    // A flash swap to the paying callee borrows a sixteenth to a quarter of
    // one reserve; a third of other one-sided swaps ask for the most the
    // reserves allow, or one more (see `resolve`).
    let borrows = flash && callee == CALLEE_PAYS && side < 2
    let boundary = !borrows && side < 2 && rng.below(3) == 0
    let edge = if borrows {
        SIXTEENTHS + 1 + rng.below(4) as u256
    } else {
        BOUNDARY + rng.below(2) as u256
    }
    let special = borrows || boundary
    push_word(
        mut data,
        if side == 1 {
            0
        } else if special { edge } else { swap_amount(mut rng) },
    )
    push_word(
        mut data,
        if side == 0 {
            0
        } else if special { edge } else { swap_amount(mut rng) },
    )
    let to = if flash { callee } else { pair_actor(mut rng) }
    push_word(mut data, address_word(to, dirty, mut rng))
    push_word(mut data, 0x80)
    let len: u64 = if flash { 1 + rng.below(40) } else { 0 }
    push_word(mut data, len as u256)
    var i: u64 = 0
    while i < (len + 31) / 32 * 32 {
        data.push(
            if i < len {
                (rng.next() & 0xff).downcast_truncate()
            } else {
                0
            },
        )
        i += 1
    }
}

// Each call lands twelve seconds after the last, so the pair's price
// accumulators move.
fn block(_ step: u64) -> BlockEnv {
    BlockEnv {
        coinbase: 0xc0ffee,
        timestamp: 1_800_000_000 + step as u256 * 12,
        number: 26_400_000,
        prevrandao: 0,
        gaslimit: 60_000_000,
        chainid: 1,
        basefee: 0,
        blobbasefee: 1,
    }
}

// The transaction for `call` from `sender` to `to`, priced at zero gas.
fn request(
    _ world: WorldState,
    sender: u256,
    to: u256,
    _ call: Call,
    _ data: MemSpan,
) -> TxRequest {
    let env = TxEnv {
        kind: 2,
        chain_id: Option::Some(1),
        sender,
        to,
        creates: false,
        nonce: world.nonce(sender),
        gas_limit: 2_000_000,
        gas_price: 0,
        max_priority_fee_per_gas: 0,
        max_fee_per_blob_gas: 0,
        value: call.value,
    }
    TxRequest::new(
        env,
        data: InputData::new(MemBuffer::from_span(data), status: OK),
    )
}

// Exceptional halts all end a call the same way: no return data and no gas
// back. solc 0.5 halts with INVALID on division by zero, where a Fe port
// runs out of gas.
pub fn same_status(_ a: i32, _ b: i32) -> bool {
    a == b || (exceptional(a) && exceptional(b))
}

// Whether `a` and `b` are the same `Error(string)` revert up to the padding
// after the reason.
pub fn same_reason(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len()
        || a.len() < 68
        || a[0] != 0x08
        || a[1] != 0xc3
        || a[2] != 0x79
        || a[3] != 0xa0 {
        return false
    }
    // A length beyond four bytes cannot fit the data anyway.
    for i in 36 .. 64 {
        if a[i] != 0 { return false }
    }
    var length: usize = 0
    for i in 64 .. 68 {
        length = (length << 8) | a[i] as usize
    }
    if 68 + length > a.len() {
        return false
    }
    for i in 0 .. 68 + length {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn contains(_ list: MemVec<u256>, _ x: u256) -> bool {
    for i in 0 .. list.len() {
        if list[i] == x {
            return true
        }
    }
    false
}

pub fn same_bytes(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

pub fn same_logs(_ a: LogBuffer, _ b: LogBuffer) -> bool {
    if a.len() != b.len() {
        return false
    }
    var i: u64 = 0
    while i < a.len() {
        let x = a.entry(i)
        let y = b.entry(i)
        if x.address != y.address || x.topic_count != y.topic_count {
            return false
        }
        for t in 0 .. 4 {
            if x.topics[t] != y.topics[t] {
                return false
            }
        }
        if !same_bytes(a.payload(i), b.payload(i)) {
            return false
        }
        i += 1
    }
    true
}

// Whether every balance, nonce, code (but the tested contract's) and slot
// agrees.
fn same_state(_ a: WorldState, _ b: WorldState) -> bool {
    var tested: MemVec<u256> = MemVec::new()
    tested.push(TARGET)
    tested.push(PAIR)
    tested.push(USDT)
    same_state_except(a, b, tested)
}

/// Whether every balance, nonce, code (but at `ported`, where the codes
/// differ by design) and storage slot of `a` and `b` agrees.
pub fn same_state_except(_ a: WorldState, _ b: WorldState, _ ported: MemVec<u256>) -> bool {
    for position in 0 .. a.account_count() {
        let address = a.account_at(position).address
        if a.balance(address) != b.balance(address) || a.nonce(address) != b.nonce(address) {
            return false
        }
        if !contains(ported, address) && !same_bytes(a.code(address), b.code(address)) {
            return false
        }
    }
    for position in 0 .. b.account_count() {
        let address = b.account_at(position).address
        if a.balance(address) != b.balance(address) || a.nonce(address) != b.nonce(address) {
            return false
        }
    }
    for slot in 0 .. a.storage_slots() {
        let entry = a.storage_at(slot)
        if entry.occupied && b.storage_load(entry.address, entry.slot) != entry.value {
            return false
        }
    }
    for slot in 0 .. b.storage_slots() {
        let entry = b.storage_at(slot)
        if entry.occupied && a.storage_load(entry.address, entry.slot) != entry.value {
            return false
        }
    }
    true
}

/// Runs `runs` sessions of `steps` random calls each, from seeds `seed`,
/// `seed + 1`, ..., against `deployed` and `port`. A session stops at its
/// first difference, since the two worlds no longer agree after it.
/// With `token` empty, the calls target WETH9's interface; otherwise a
/// Uniswap V2 pair between two tokens running `token`.
pub fn fuzz(
    _ deployed: MemSpan,
    _ port: MemSpan,
    token: MemSpan,
    runs: u64,
    steps: u64,
    seed: u64,
    _ found: mut Findings,
) {
    var run: u64 = 0
    while run < runs {
        var rng = Rng { state: (seed + run).wrapping_mul(0x9e3779b97f4a7c15) | 1 }
        let pair = token.len() > 1
        let usdt = is_usdt(token)
        let fee_on = pair && rng.below(2) == 0
        var a = if pair {
            pair_genesis(deployed, token, fee_on)
        } else if usdt {
            usdt_genesis(deployed)
        } else {
            genesis(deployed)
        }
        var b = if pair {
            pair_genesis(port, token, fee_on)
        } else if usdt {
            usdt_genesis(port)
        } else {
            genesis(port)
        }
        // The port's runs, watched for the code they cover.
        var watch = GasWatch::new(shadows: MemVec::new())
        watch.cover.push(if pair {
                    PAIR
                } else if usdt { USDT } else { TARGET })
        var step: u64 = 0
        while step < steps {
            step += 1
            var data = MemBuffer::empty()
            let call = if pair {
                pair_call(mut rng, mut data, step)
            } else {
                if usdt {
                    usdt_call(mut rng, mut data)
                } else {
                    weth_call(mut rng, mut data)
                }
            }
            let sender = eoa(rng.below(3))
            let to = call.to
            let k_before = if pair { k_of(b) } else { 0 }
            let p0_before = b.storage_load(PAIR, 9)
            let p1_before = b.storage_load(PAIR, 10)
            if pair {
                resolve(a, mut data)
            }
            let tx_a = request(a, sender, to, call, data.span())
            let tx_b = request(b, sender, to, call, data.span())
            var buffers_a = Buffers::new()
            var buffers_b = Buffers::new()
            var none_a = ()
            let ran_a = transact(
                a,
                tx_a,
                block(step),
                Config::osaka(),
                mut buffers_a,
                mut none_a,
            )
            let ran_b = transact(
                b,
                tx_b,
                block(step),
                Config::osaka(),
                mut buffers_b,
                mut watch,
            )
            found.calls[call.category as usize] += 1
            let what: u8 = if ran_a.receipt.invalid != ran_b.receipt.invalid
                || !same_status(ran_a.receipt.status, ran_b.receipt.status) {
                1
            } else if !same_bytes(ran_a.receipt.output.span(), ran_b.receipt.output.span())
                && !same_reason(ran_a.receipt.output.span(), ran_b.receipt.output.span()) {
                2
            } else if !same_logs(ran_a.receipt.logs, ran_b.receipt.logs) {
                3
            } else if !same_state(ran_a.state, ran_b.state) {
                4
            } else {
                0
            }
            a = ran_a.state
            b = ran_b.state
            if what != 0 {
                if found.first_step == 0
                    || (call.category == WELL_FORMED && found.first_category != WELL_FORMED) {
                    found.first_seed = seed + run
                    found.first_step = step
                    found.first_category = call.category
                    found.first_selector = call.selector
                    found.first_what = what
                    found.first_from = sender
                    found.first_to = to
                    found.first_value = call.value
                    found.first_data = MemBuffer::from_span(data.span())
                    found.first_deployed = [ran_a.receipt.invalid, ran_a.receipt.status]
                    found.first_port = [ran_b.receipt.invalid, ran_b.receipt.status]
                    found.first_deployed_output = MemBuffer::from_span(ran_a.receipt.output.span())
                    found.first_port_output = MemBuffer::from_span(ran_b.receipt.output.span())
                }
                break
            }
            found.identical[call.category as usize] += 1
            if !same_bytes(ran_a.receipt.output.span(), ran_b.receipt.output.span()) {
                found.dirty_padding += 1
            }
            let succeeded = ran_a.receipt.invalid == 0 && ran_a.receipt.status == OK
            if call.category == WELL_FORMED && succeeded {
                count(mut found.succeeded, call.selector)
            }
            if pair {
                let broken = check_invariants(
                    b,
                    selector: if succeeded { call.selector } else { 0 },
                    fee_on,
                    k_before,
                    p0_before,
                    p1_before,
                )
                if broken != 0 {
                    found.invariant_breaks += 1
                    if found.invariant_step == 0 {
                        found.invariant_seed = seed + run
                        found.invariant_step = step
                        found.invariant_kind = broken
                    }
                }
            }
        }
        merge_coverage(mut found.covered, watch.covered)
        run += 1
    }
    if found.first_step != 0 {
        shrink(deployed, port, token, mut found)
    }
}

// reserve0 * reserve1 of the pair in `world`.
fn k_of(_ world: WorldState) -> u256 {
    let reserves = world.storage_load(PAIR, 8)
    let mask: u256 = (1 << 112) - 1
    (reserves & mask) * ((reserves >> 112) & mask)
}

// Invariants of a Uniswap V2 pair after a top-level call, which succeeded
// as `selector` (0 if it failed): 1 if the lock is still held, 2 if a swap
// left k lower than before it, 3 if the supply is positive but below the
// 1,000 locked at the first deposit, 4 if the pair holds less of a token
// than its reserve, 5 if a cumulative price fell, 6 if `kLast` disagrees
// with the fee: zero with the fee off, the reserves' product after a mint
// or burn with it on.
fn check_invariants(
    _ world: WorldState,
    selector: u32,
    fee_on: bool,
    _ k_before: u256,
    _ p0_before: u256,
    _ p1_before: u256,
) -> u8 {
    if world.storage_load(PAIR, 12) != 1 {
        return 1
    }
    if selector == 0x022c0d9f && k_of(world) < k_before {
        return 2
    }
    let supply = world.storage_load(PAIR, 0)
    if supply != 0 && supply < 1000 {
        return 3
    }
    let reserves = world.storage_load(PAIR, 8)
    let mask: u256 = (1 << 112) - 1
    // WETH9 keeps balanceOf in slot 3.
    let slot = mapping_slot(PAIR, 3)
    if world.storage_load(TOKEN0, slot) < (reserves & mask)
        || world.storage_load(TOKEN1, slot) < ((reserves >> 112) & mask) {
        return 4
    }
    if world.storage_load(PAIR, 9) < p0_before || world.storage_load(PAIR, 10) < p1_before {
        return 5
    }
    let k_last = world.storage_load(PAIR, 11)
    if !fee_on && k_last != 0 {
        return 6
    }
    if fee_on && (selector == 0x6a627842 || selector == 0x89afcb44) && k_last != k_of(world) {
        return 6
    }
    0
}

/// The Keccak-256 hash of `bytes`: a code hash, for one.
pub fn keccak(_ bytes: MemBuffer) -> u256 {
    var hash = Keccak256::new()
    if bytes.len() > 0 {
        hash.update(bytes, offset: 0, len: bytes.len())
    }
    hash.finish_word()
}

// The storage slot of `key` in a Solidity mapping at `slot`.
pub fn mapping_slot(_ key: u256, _ slot: u256) -> u256 {
    var words = MemBuffer::with_capacity(64)
    words.write_word(offset: 0, value: key)
    words.write_word(offset: 32, value: slot)
    var hash = Keccak256::new()
    hash.update(words, offset: 0, len: 64)
    hash.finish_word()
}

/// One call of a fuzzing run: its sender, target, value, step number (for
/// the block's timestamp) and where its calldata sits.
pub struct Sent {
    pub sender: u256,
    pub to: u256,
    pub value: u256,
    pub step: u64,
    pub start: usize,
    pub len: usize,
}

impl Copy for Sent {}

// The calls of the first difference's run, regenerated from its seed, then
// cut down: each call but the last is dropped if the run still differs
// without it, until no more can go.
fn shrink(_ deployed: MemSpan, _ port: MemSpan, _ token: MemSpan, _ found: mut Findings) {
    let pair = token.len() > 1
    let usdt = is_usdt(token)
    var rng = Rng { state: found.first_seed.wrapping_mul(0x9e3779b97f4a7c15) | 1 }
    let fee_on = pair && rng.below(2) == 0
    var calls: MemVec<Sent> = MemVec::new()
    var inputs = MemBuffer::empty()
    var step: u64 = 0
    while step < found.first_step {
        step += 1
        var data = MemBuffer::empty()
        let call = if pair {
            pair_call(mut rng, mut data, step)
        } else {
            if usdt {
                usdt_call(mut rng, mut data)
            } else {
                weth_call(mut rng, mut data)
            }
        }
        let sender = eoa(rng.below(3))
        let start = inputs.len()
        for i in 0 .. data.len() {
            inputs.push(data.span()[i])
        }
        calls.push(
                Sent { sender, to: call.to, value: call.value, step, start, len: data.len() },
            )
    }
    var keep: MemVec<bool> = MemVec::new()
    for _ in 0 .. calls.len() {
        keep.push(true)
    }
    var dropped = true
    while dropped {
        dropped = false
        for i in 0 .. calls.len() - 1 {
            if keep[i] {
                keep[i] = false
                if diverges(
                    deployed,
                    port,
                    token,
                    fee_on,
                    calls,
                    inputs.span(),
                    keep,
                ) {
                    dropped = true
                } else {
                    keep[i] = true
                }
            }
        }
    }
    for i in 0 .. calls.len() {
        if keep[i] {
            let call = calls[i]
            let start = found.shrunk_inputs.len()
            for j in 0 .. call.len {
                found.shrunk_inputs.push(inputs.span()[call.start + j])
            }
            found
                .shrunk
                .push(
                    Sent {
                        sender: call.sender,
                        to: call.to,
                        value: call.value,
                        step: call.step,
                        start,
                        len: call.len,
                    },
                )
        }
    }
}

// Whether running the kept `calls` from genesis on both codes makes them
// differ at some call.
fn diverges(
    _ deployed: MemSpan,
    _ port: MemSpan,
    _ token: MemSpan,
    _ fee_on: bool,
    _ calls: MemVec<Sent>,
    _ inputs: MemSpan,
    _ keep: MemVec<bool>,
) -> bool {
    let pair = token.len() > 1
    let usdt = is_usdt(token)
    var a = if pair {
        pair_genesis(deployed, token, fee_on)
    } else if usdt {
        usdt_genesis(deployed)
    } else {
        genesis(deployed)
    }
    var b = if pair {
        pair_genesis(port, token, fee_on)
    } else if usdt {
        usdt_genesis(port)
    } else {
        genesis(port)
    }
    for i in 0 .. calls.len() {
        if !keep[i] { continue }
        let sent = calls[i]
        var data = MemBuffer::empty()
        for j in 0 .. sent.len {
            data.push(inputs[sent.start + j])
        }
        let call = Call { to: sent.to, value: sent.value, category: WELL_FORMED, selector: 0 }
        if pair {
            resolve(a, mut data)
        }
        let tx_a = request(a, sender: sent.sender, to: sent.to, call, data.span())
        let tx_b = request(b, sender: sent.sender, to: sent.to, call, data.span())
        var buffers_a = Buffers::new()
        var buffers_b = Buffers::new()
        var none_a = ()
        var none_b = ()
        let ran_a = transact(
            a,
            tx_a,
            block(sent.step),
            Config::osaka(),
            mut buffers_a,
            mut none_a,
        )
        let ran_b = transact(
            b,
            tx_b,
            block(sent.step),
            Config::osaka(),
            mut buffers_b,
            mut none_b,
        )
        let differs = ran_a.receipt.invalid != ran_b.receipt.invalid
            || !same_status(ran_a.receipt.status, ran_b.receipt.status)
            || (!same_bytes(ran_a.receipt.output.span(), ran_b.receipt.output.span())
                && !same_reason(ran_a.receipt.output.span(), ran_b.receipt.output.span()))
            || !same_logs(ran_a.receipt.logs, ran_b.receipt.logs)
            || !same_state(ran_a.state, ran_b.state)
        if differs { return true }
        a = ran_a.state
        b = ran_b.state
    }
    false
}
