//! One replay: the node's answers about a transaction in, a verdict out.
//!
//! A single-transaction fixture is one JSON object bundling them: `block`
//! (eth_getBlockByNumber), `tx` (eth_getTransactionByHash), `receipt`
//! (eth_getTransactionReceipt), `prestate` and `diff` (debug_traceTransaction
//! with the prestate tracer, without and with `diffMode`), plus `chainId`
//! and `blobBaseFee`. A block directory holds the same answers for every
//! transaction of a block (see `fetch::fetch_block`).

use core::MemBuffer
use std::io::Display
use fevm::status::status_name
use json::Value
use fevm::{BlockEnv, Buffers, Config, WorldState, transact}
use ingot::compare::{Mismatches, apply_diff, compare}
use ingot::load::{add_extras, field, load_block, load_tx, load_world}
use core::MemVec
use ingot::watch::{GasWatch, SelectorGas, add_profile, explain_gas, first_parting}
use ingot::fuzz::{same_logs, same_state_except, same_status}

/// Replays transaction `tx` in fevm against its `prestate`, in the block
/// `block` whose parent's hash is `parent_hash`, and compares the outcome
/// with the chain's `receipt` and `diff`, writing a line per difference.
/// `extras` holds what the node knows but its traces leave out (see
/// `load::add_extras`).
/// Nothing here touches the host: the verdict depends on the node's answers
/// alone.
///
/// Shadow replay: when `shadow_address` is nonzero and the transaction
/// touches it, its code is replaced by `shadow_code` (in both worlds), such
/// as a Fe port of the Solidity contract deployed there. With `shadow_like`
/// set, so is the code of every account in the prestate whose code is
/// `shadow_like`: every Uniswap V2 pair runs the same code, for one. The port must then
/// leave every log, balance, nonce and slot as the original did. Only gas may
/// differ, and with it what the sender paid and the coinbase earned, so
/// those two balances are adjusted by the gas difference before comparing.
/// A shadowed transaction also runs once more on the deployed code, and when
/// the port leaves it identical, the gas each function used under both is
/// added to `deployed_gas` and `shadow_gas`.
pub fn replay_tx(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ receipt: Value,
    _ prestate: Value,
    _ diff: Value,
    shadow_address: u256,
    shadow_code: MemSpan,
    shadow_like: MemSpan,
    deployed_gas: mut MemVec<SelectorGas>,
    shadow_gas: mut MemVec<SelectorGas>,
) -> Mismatches
uses (text: mut MemBuffer)
{
    var expected = load_world(prestate)
    add_extras(mut expected, extras)
    apply_diff(mut expected, diff)
    let targets = shadow_targets(load_world(prestate), shadow_address, shadow_like)
    let shadowed = targets.len() > 0
    for i in 0 .. targets.len() {
        expected.set_code(address: targets[i], code: shadow_code)
    }
    let world = build_world(prestate, block, parent_hash, extras, targets, shadow_code)
    var buffers = Buffers::new()
    // A plain replay passes `()`, which compiles to an interpreter without
    // tracing hooks; a shadow replay watches for code reading the gas left.
    var watch = GasWatch::new(shadows: targets)
    let applied = if shadowed {
        transact(
            world,
            load_tx(tx),
            block,
            Config::osaka(),
            mut buffers,
            mut watch,
        )
    } else {
        var tracer = ()
        transact(
            world,
            load_tx(tx),
            block,
            Config::osaka(),
            mut buffers,
            mut tracer,
        )
    }
    // Code read the gas left after the port ran: the same transaction on the
    // deployed code tells whether that reading explains any difference.
    var reader: u256 = 0
    if shadowed && watch.observed {
        var deployed = GasWatch::new(shadows: targets)
        var again = Buffers::new()
        let ran = transact(
            build_world(
                prestate,
                block,
                parent_hash,
                extras,
                MemVec::new(),
                shadow_code,
            ),
            load_tx(tx),
            block,
            Config::osaka(),
            mut again,
            mut deployed,
        )
        match explain_gas(
            deployed,
            watch,
            ran.receipt.logs,
            applied.receipt.logs,
            ran.state,
            applied.state,
        ) {
            Option::Some(address) => {
                reader = address
            },
            Option::None => {},
        }
    }
    if shadowed {
        settle_gas_difference(
            mut expected,
            sender: field(tx, "from"),
            coinbase: block.coinbase,
            price: field(receipt, "effectiveGasPrice"),
            basefee: block.basefee,
            chain_gas: field(receipt, "gasUsed"),
            fevm_gas: applied.receipt.gas_used as u256,
        )
    }
    var found = compare(
        applied.receipt,
        applied.state,
        receipt,
        expected,
        gas_must_match: !shadowed,
    )
    found.gas_observed = watch.observed
    found.gas_reader = reader
    found.shadow_ran = watch.shadow_ran
    // Code read code hashes: find the accounts whose hash it checked by
    // running the port at one target at a time (see `code_targets`).
    if shadowed && watch.read_code && found.total() > 0 {
        let (first, count) = code_targets(
            block,
            parent_hash,
            extras,
            tx,
            prestate,
            targets,
            shadow_code,
        )
        found.code_target = first
        found.code_targets = count
        found.shadow_targets = targets.len().downcast_unchecked()
    }
    found.code_observed = watch.read_code
    found.read_blockhash = watch.read_blockhash
    // A behavior difference: the same transaction on the deployed code,
    // compared call by call, shows where the two runs part.
    if shadowed && found.total() > 0 && !watch.observed && !watch.read_code {
        var deployed = GasWatch::new(shadows: targets)
        var again = Buffers::new()
        transact(
            build_world(
                prestate,
                block,
                parent_hash,
                extras,
                MemVec::new(),
                shadow_code,
            ),
            load_tx(tx),
            block,
            Config::osaka(),
            mut again,
            mut deployed,
        )
        match first_parting(deployed, watch) {
            Option::Some(k) => {
                "  runs part at a call".fmt(mut text)
                if k < deployed.ended.len() {
                    let call = deployed.calls[deployed.ended[k]]
                    " (depth ".fmt(mut text)
                    call.depth.fmt(mut text)
                    ", to 0x".fmt(mut text)
                    core::text::hex(call.to, 20).fmt(mut text)
                    ", selector 0x".fmt(mut text)
                    core::text::hex(call.selector as u256, 4).fmt(mut text)
                    "): deployed ".fmt(mut text)
                    status_name(call.status).fmt(mut text)
                }
                if k >= watch.ended.len() {
                    ", and the shadow run made no such call".fmt(mut text)
                } else if k >= deployed.ended.len() {
                    " (the deployed run made no such call)".fmt(mut text)
                } else {
                    let ours = deployed.calls[deployed.ended[k]]
                    let theirs = watch.calls[watch.ended[k]]
                    ", shadow ".fmt(mut text)
                    status_name(theirs.status).fmt(mut text)
                    if theirs.to != ours.to {
                        " (a different call)".fmt(mut text)
                    } else if theirs.input != ours.input {
                        " (different calldata)".fmt(mut text)
                    } else if theirs.output != ours.output {
                        " (different output)".fmt(mut text)
                    }
                }
                "\n".fmt(mut text)
            },
            Option::None => {},
        }
    }
    // The same transaction on the deployed code, for its gas per function.
    if shadowed && found.total() == 0 {
        var deployed = GasWatch::new(shadows: targets)
        var again = Buffers::new()
        transact(
            build_world(
                prestate,
                block,
                parent_hash,
                extras,
                MemVec::new(),
                shadow_code,
            ),
            load_tx(tx),
            block,
            Config::osaka(),
            mut again,
            mut deployed,
        )
        add_profile(mut deployed_gas, deployed.profile)
        add_profile(mut shadow_gas, watch.profile)
    }
    // A plain replay that differs runs again under the watch, to tell
    // whether it read a block hash the replay does not hold.
    if !shadowed && found.total() > 0 {
        var probe = GasWatch::new(shadows: MemVec::new())
        var more = Buffers::new()
        transact(
            build_world(
                prestate,
                block,
                parent_hash,
                extras,
                MemVec::new(),
                shadow_code,
            ),
            load_tx(tx),
            block,
            Config::osaka(),
            mut more,
            mut probe,
        )
        found.read_blockhash = probe.read_blockhash
    }
    found
}

/// Runs transaction `tx` on the deployed code and with the shadow code (see
/// `replay_tx`) and writes both runs' calls as JSON to `text`: for each run,
/// every call in the order it began, with its depth, opcode, the account it
/// runs as, target, gas given and used, status, the first bytes of its
/// calldata and output, and its place in the order calls ended; and where
/// the runs part (see `watch::first_parting`), as that place, or null.
pub fn trace_tx(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ prestate: Value,
    shadow_address: u256,
    shadow_code: MemSpan,
    shadow_like: MemSpan,
)
uses (text: mut MemBuffer)
{
    let targets = shadow_targets(load_world(prestate), shadow_address, shadow_like)
    var deployed = GasWatch::new(shadows: targets)
    deployed.keep = true
    var shadow = GasWatch::new(shadows: targets)
    shadow.keep = true
    var buffers = Buffers::new()
    transact(
        build_world(
            prestate,
            block,
            parent_hash,
            extras,
            MemVec::new(),
            shadow_code,
        ),
        load_tx(tx),
        block,
        Config::osaka(),
        mut buffers,
        mut deployed,
    )
    var more = Buffers::new()
    transact(
        build_world(
            prestate,
            block,
            parent_hash,
            extras,
            targets,
            shadow_code,
        ),
        load_tx(tx),
        block,
        Config::osaka(),
        mut more,
        mut shadow,
    )
    "{\"hash\":\"".fmt(mut text)
    tx["hash"].text().fmt(mut text)
    "\",\"shadowed\":[".fmt(mut text)
    for i in 0 .. targets.len() {
        if i > 0 { ",".fmt(mut text) }
        "\"0x".fmt(mut text)
        core::text::hex(targets[i], 20).fmt(mut text)
        "\"".fmt(mut text)
    }
    "],\"parting\":".fmt(mut text)
    match first_parting(deployed, shadow) {
        Option::Some(k) => {
            k.fmt(mut text)
        },
        Option::None => {
            "null".fmt(mut text)
        },
    }
    ",\"deployed\":".fmt(mut text)
    write_calls(deployed)
    ",\"shadow\":".fmt(mut text)
    write_calls(shadow)
    "}\n".fmt(mut text)
}

fn write_calls(_ run: GasWatch) uses (text: mut MemBuffer) {
    "[".fmt(mut text)
    for i in 0 .. run.calls.len() {
        let call = run.calls[i]
        if i > 0 { ",".fmt(mut text) }
        "{\"depth\":".fmt(mut text)
        call.depth.fmt(mut text)
        ",\"kind\":".fmt(mut text)
        call.kind.fmt(mut text)
        ",\"as\":\"0x".fmt(mut text)
        core::text::hex(call.context, 20).fmt(mut text)
        "\",\"to\":\"0x".fmt(mut text)
        core::text::hex(call.to, 20).fmt(mut text)
        "\",\"value\":\"".fmt(mut text)
        call.value.fmt(mut text)
        "\",\"gas\":".fmt(mut text)
        call.gas.fmt(mut text)
        ",\"used\":".fmt(mut text)
        call.used.fmt(mut text)
        ",\"status\":\"".fmt(mut text)
        status_name(call.status).fmt(mut text)
        "\",\"input\":\"0x".fmt(mut text)
        write_bytes(run.bytes.span(), at: call.input_at, len: call.input_len)
        "\",\"output\":\"0x".fmt(mut text)
        write_bytes(run.bytes.span(), at: call.output_at, len: call.output_len)
        "\",\"ended\":".fmt(mut text)
        var ended: usize = 0
        for k in 0 .. run.ended.len() {
            if run.ended[k] == i {
                ended = k
            }
        }
        ended.fmt(mut text)
        "}".fmt(mut text)
    }
    "]".fmt(mut text)
}

fn write_bytes(_ bytes: MemSpan, at: usize, len: usize)
uses (text: mut MemBuffer)
{
    for i in 0 .. len {
        core::text::hex(bytes[at + i] as u256, 1).fmt(mut text)
    }
}

// Which targets' code hashes the transaction checks: each target in turn
// runs `shadow_code` alone, the rest the deployed code. Returns the first
// target whose port alone changes the transaction (status, logs or state)
// and how many do; a target whose port alone leaves it as deployed is shown
// to behave identically there.
fn code_targets(
    _ block: BlockEnv,
    parent_hash: u256,
    _ extras: Value,
    _ tx: Value,
    _ prestate: Value,
    _ targets: MemVec<u256>,
    _ shadow_code: MemSpan,
) -> (u256, u64) {
    var none = ()
    var buffers = Buffers::new()
    let deployed = transact(
        build_world(
            prestate,
            block,
            parent_hash,
            extras,
            MemVec::new(),
            shadow_code,
        ),
        load_tx(tx),
        block,
        Config::osaka(),
        mut buffers,
        mut none,
    )
    var first: u256 = 0
    var count: u64 = 0
    for i in 0 .. targets.len() {
        var alone: MemVec<u256> = MemVec::new()
        alone.push(targets[i])
        var tracer = ()
        var more = Buffers::new()
        let ran = transact(
            build_world(prestate, block, parent_hash, extras, alone, shadow_code),
            load_tx(tx),
            block,
            Config::osaka(),
            mut more,
            mut tracer,
        )
        let same = ran.receipt.invalid == deployed.receipt.invalid
            && same_status(ran.receipt.status, deployed.receipt.status)
            && same_logs(ran.receipt.logs, deployed.receipt.logs)
            && same_state_except(ran.state, deployed.state, targets)
        if !same {
            if count == 0 {
                first = targets[i]
            }
            count += 1
        }
    }
    (first, count)
}

// The accounts of `world` to shadow: `address` if present, and every account
// whose code is `like` (when `like` is not empty).
pub fn shadow_targets(_ world: WorldState, _ address: u256, _ like: MemSpan) -> MemVec<u256> {
    var targets: MemVec<u256> = MemVec::new()
    if address != 0 && world.exists(address) {
        targets.push(address)
    }
    if like.len() > 0 {
        for i in 0 .. world.account_count() {
            let account = world.account_at(i).address
            if account != address && same_bytes(world.code(account), like) {
                targets.push(account)
            }
        }
    }
    targets
}

fn same_bytes(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

// The prestate as an fevm world, with the shadow code at `targets` and what
// the node knows beyond its traces.
pub fn build_world(
    _ prestate: Value,
    _ block: BlockEnv,
    _ parent_hash: u256,
    _ extras: Value,
    _ targets: MemVec<u256>,
    _ shadow_code: MemSpan,
) -> WorldState {
    var world = load_world(prestate)
    for i in 0 .. targets.len() {
        world.set_code(address: targets[i], code: shadow_code)
    }
    // BLOCKHASH reads the client's block hashes, not state, so the prestate
    // tracer cannot see them. The parent's comes with the header; a fixture
    // may bring older ones as `blockHashes`.
    world.set_block_hash(block.number - 1, parent_hash)
    add_extras(mut world, extras)
    world
}

// Moves the fee for the gas fevm used instead of the chain's: the sender pays
// `price` per unit and the coinbase earns the tip above `basefee`.
fn settle_gas_difference(
    _ expected: mut WorldState,
    sender: u256,
    coinbase: u256,
    price: u256,
    basefee: u256,
    chain_gas: u256,
    fevm_gas: u256,
) {
    let tip = if price > basefee { price - basefee } else { 0 }
    if fevm_gas > chain_gas {
        let more = fevm_gas - chain_gas
        expected.set_balance(sender, expected.balance(sender) - more * price)
        expected.set_balance(coinbase, expected.balance(coinbase) + more * tip)
    } else {
        let less = chain_gas - fevm_gas
        expected.set_balance(sender, expected.balance(sender) + less * price)
        expected.set_balance(coinbase, expected.balance(coinbase) - less * tip)
    }
}

/// Replays a single-transaction fixture, which may carry `blockHashes`
/// and `delegates` as extras.
pub fn replay(_ doc: Value) -> Mismatches uses (text: mut MemBuffer) {
    var unused_a: MemVec<SelectorGas> = MemVec::new()
    var unused_b: MemVec<SelectorGas> = MemVec::new()
    let block = load_block(
        doc["block"],
        chain_id: field(doc, "chainId"),
        blobbasefee: field(doc, "blobBaseFee"),
    )
    replay_tx(
        block,
        parent_hash: field(doc["block"], "parentHash"),
        doc,
        doc["tx"],
        doc["receipt"],
        doc["prestate"],
        doc["diff"],
        shadow_address: 0,
        shadow_code: MemBuffer::empty().span(),
        shadow_like: MemBuffer::empty().span(),
        deployed_gas: mut unused_a,
        shadow_gas: mut unused_b,
    )
}
