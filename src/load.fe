//! Turns JSON-RPC results into fevm inputs: a `prestateTracer` result into a
//! `WorldState`, and a block header into a `BlockEnv`.

use core::{MemBuffer, MemSpan}
use core::text::parse_hex_uint
use json::{Key, Value}
use fevm::{Authorization, BlockEnv, InputData, OK, TxEnv, TxRequest, WorldState}
use fevm::processor::{TX_ACCESS_LIST, TX_LEGACY}

/// A `0x`-prefixed hex quantity or a JSON number (the prestate tracer writes
/// nonces as numbers) as a word. A missing or malformed field reads as zero.
pub fn hex_word(_ value: Value) -> u256 {
    match value.as_string() {
        Option::Some(text) => match parse_hex_uint(text) {
            Option::Some(word) => word,
            Option::None => 0,
        },
        Option::None => match value.as_u256() {
            Option::Some(word) => word,
            Option::None => 0,
        },
    }
}

/// The quantity `object[key]`, or zero when the node leaves the field out (a
/// legacy transaction has no `maxPriorityFeePerGas`, for one).
pub fn field<K: Key>(_ object: Value, _ key: K) -> u256 {
    match object.get(key) {
        Option::Some(ref value) => hex_word(value),
        Option::None => 0,
    }
}

/// A `0x`-prefixed hex string as bytes. A digit that is not hex reads as
/// zero; the RPC node is trusted to send well-formed hex.
pub fn hex_bytes(_ text: MemSpan) -> MemBuffer {
    var bytes = MemBuffer::empty()
    var at: usize = if text.len() >= 2 && text[1] == 0x78 {
        2
    } else {
        0
    }
    while at + 1 < text.len() {
        bytes.push((nibble(text[at]) << 4) | nibble(text[at + 1]))
        at += 2
    }
    bytes
}

fn nibble(_ digit: u8) -> u8 {
    if digit >= 0x30 && digit <= 0x39 {
        digit - 0x30
    } else if digit >= 0x61 && digit <= 0x66 {
        digit - 0x57
    } else if digit >= 0x41 && digit <= 0x46 {
        digit - 0x37
    } else {
        0
    }
}

/// The block values a transaction sees, from an `eth_getBlockByNumber` result.
/// `blobbasefee` is passed in, since it depends on the fork's blob schedule.
pub fn load_block(_ header: Value, chain_id: u256, blobbasefee: u256) -> BlockEnv {
    BlockEnv {
        coinbase: field(header, "miner"),
        timestamp: field(header, "timestamp"),
        number: field(header, "number"),
        prevrandao: field(header, "mixHash"),
        gaslimit: field(header, "gasLimit"),
        chainid: chain_id,
        basefee: field(header, "baseFeePerGas"),
        blobbasefee,
    }
}

/// The accounts of a `prestateTracer` result (not diff mode) as a world.
pub fn load_world(_ prestate: Value) -> WorldState {
    var world = WorldState::empty()
    add_prestate(mut world, prestate)
    world
}

/// Sets every account and slot `prestate` lists in `world`, over what it
/// held. Adding a block's prestates from its last transaction to its first
/// leaves each at its value when the block began: the first transaction to
/// touch it saw that value.
pub fn add_prestate(_ world: mut WorldState, _ prestate: Value) {
    for ref member in prestate.members() {
        let address = parse_hex_uint(member.key.span()).unwrap_or(default: 0)
        let account = ref member.value
        world.set_balance(address, field(account, "balance"))
        world.set_nonce(address, field(account, "nonce"))
        // The tracer leaves out empty code: an account without it has none,
        // though a later transaction's prestate may have set some.
        if account.has("code") {
            let code = hex_bytes(account["code"].text())
            world.set_code(address: address, code: code.span())
        } else {
            world.set_code(address: address, code: MemBuffer::empty().span())
        }
        if account.has("storage") {
            for ref slot in account["storage"].members() {
                world
                    .storage_store(
                        address,
                        parse_hex_uint(slot.key.span()).unwrap_or(default: 0),
                        hex_word(slot.value),
                    )
            }
        }
    }
}

/// After `add_prestate` of one transaction's `prestate`: whatever its state
/// `diff` writes that the prestate does not list did not exist before it
/// (the prestate tracer leaves out absent accounts and empty slots), so it
/// is cleared. Going from the last transaction to the first, a later
/// transaction's prestate (which saw the write) cannot pass for the
/// block's start.
pub fn clear_created(_ world: mut WorldState, _ prestate: Value, _ diff: Value) {
    for ref member in diff["post"].members() {
        let address = parse_hex_uint(member.key.span()).unwrap_or(default: 0)
        if !prestate.has(member.key.span()) {
            world.set_balance(address, 0)
            world.set_nonce(address, 0)
            world.set_code(address: address, code: MemBuffer::empty().span())
        }
        if member.value.has("storage") {
            for ref slot in member.value["storage"].members() {
                if !lists_slot(prestate, member.key.span(), slot.key.span()) {
                    world
                        .storage_store(
                            address,
                            parse_hex_uint(slot.key.span()).unwrap_or(default: 0),
                            0,
                        )
                }
            }
        }
    }
}

// Whether `prestate` lists storage slot `slot` of account `account`.
fn lists_slot(_ prestate: Value, _ account: MemSpan, _ slot: MemSpan) -> bool {
    for ref member in prestate.members() {
        if same_text(member.key.span(), account) {
            if !member.value.has("storage") {
                return false
            }
            return member.value["storage"].has(slot)
        }
    }
    false
}

fn same_text(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

/// How many balances, nonces, codes and slots `prestate` lists that `world`
/// holds differently.
pub fn prestate_mismatches(_ world: WorldState, _ prestate: Value) -> u64 {
    var off: u64 = 0
    for ref member in prestate.members() {
        let address = parse_hex_uint(member.key.span()).unwrap_or(default: 0)
        let account = ref member.value
        if world.balance(address) != field(account, "balance") {
            off += 1
        }
        if world.nonce(address) != field(account, "nonce") {
            off += 1
        }
        let code = if account.has("code") {
            hex_bytes(account["code"].text())
        } else {
            MemBuffer::empty()
        }
        if !same_text(world.code(address), code.span()) {
            off += 1
        }
        if account.has("storage") {
            for ref slot in account["storage"].members() {
                let key = parse_hex_uint(slot.key.span()).unwrap_or(default: 0)
                if world.storage_load(address, key) != hex_word(slot.value) {
                    off += 1
                }
            }
        }
    }
    off
}

/// An `eth_getTransactionByHash` result as an fevm request. fevm takes the
/// recovered sender, which the node reports as `from`.
pub fn load_tx(_ tx: Value) -> TxRequest {
    load_tx_with(
        tx,
        input: hex_bytes(tx["input"].text()).span(),
        priced: true,
    )
}

/// `tx` with `input` for its calldata, and when not `priced`, paying nothing
/// for gas (for a block whose base fee is zero).
pub fn load_tx_with(_ tx: Value, input: MemSpan, priced: bool) -> TxRequest {
    let kind: u8 = field(tx, "type").downcast_truncate()
    let creates = !tx.has("to") || tx["to"].is_null()
    let env = TxEnv {
        kind,
        chain_id: if tx.has("chainId") {
            Option::Some(field(tx, "chainId"))
        } else {
            Option::None
        },
        sender: field(tx, "from"),
        to: if creates { 0 } else { field(tx, "to") },
        creates,
        nonce: field(tx, "nonce"),
        gas_limit: field(tx, "gas").downcast_truncate(),
        // Legacy and EIP-2930 transactions name one price; later kinds a maximum.
        gas_price: if !priced {
            0
        } else if kind == TX_LEGACY || kind == TX_ACCESS_LIST {
            field(tx, "gasPrice")
        } else {
            field(tx, "maxFeePerGas")
        },
        max_priority_fee_per_gas: if priced {
            field(tx, "maxPriorityFeePerGas")
        } else {
            0
        },
        max_fee_per_blob_gas: field(tx, "maxFeePerBlobGas"),
        value: field(tx, "value"),
    }
    var request = TxRequest::new(
        env,
        data: InputData::new(MemBuffer::from_span(input), status: OK),
    )
    if tx.has("accessList") {
        for ref entry in tx["accessList"].items() {
            let address = field(entry, "address")
            request.add_access_account(address)
            for ref key in entry["storageKeys"].items() {
                request.add_access_key(address: address, slot: hex_word(key))
            }
        }
    }
    if tx.has("blobVersionedHashes") {
        for ref hash in tx["blobVersionedHashes"].items() {
            request.add_blob_hash(hex_word(hash))
        }
    }
    if tx.has("authorizationList") {
        for ref auth in tx["authorizationList"].items() {
            request
                .add_authorization(
                    Authorization {
                        chain_id: field(auth, "chainId"),
                        address: field(auth, "address"),
                        nonce: field(auth, "nonce"),
                        y_parity: field(auth, "yParity"),
                        r: field(auth, "r"),
                        s: field(auth, "s"),
                    },
                )
        }
    }
    request
}

/// The account an EIP-7702 delegation designator (`0xef0100` and an
/// address) points to, or zero for any other code.
pub fn delegation_target(_ code: MemSpan) -> u256 {
    if code.len() != 23 || code[0] != 0xef || code[1] != 0x01 || code[2] != 0x00 {
        return 0
    }
    var target: u256 = 0
    for i in 3 .. 23 {
        target = (target << 8) | code[i] as u256
    }
    target
}

/// The node's answers that are not state but that a replay needs, from an
/// object that may hold them: `blockHashes` (numbers to hashes, for
/// BLOCKHASH) and `delegates` (addresses to code). The prestate tracer
/// leaves out the account an EIP-7702 delegation points to, although running
/// the delegated account runs its code; `fetch` adds it as a delegate.
pub fn add_extras(_ world: mut WorldState, _ extras: Value) {
    if extras.has("blockHashes") {
        for ref entry in extras["blockHashes"].members() {
            world
                .set_block_hash(
                    parse_hex_uint(entry.key.span()).unwrap_or(default: 0),
                    hex_word(entry.value),
                )
        }
    }
    if extras.has("delegates") {
        for ref entry in extras["delegates"].members() {
            let address = parse_hex_uint(entry.key.span()).unwrap_or(default: 0)
            if !world.exists(address) {
                let code = hex_bytes(entry.value.text())
                world.set_code(address: address, code: code.span())
            }
        }
    }
}
