//! fevm-replay: replay Ethereum mainnet transactions in fevm and check the
//! result against the chain.

use core::MemBuffer
use std::env::Args
use std::io::Stdout
use json::parse

pub use compare::{Mismatches, apply_diff, compare}
pub use load::{hex_bytes, hex_word, load_block, load_tx, load_world}
pub use replay::replay

/// `fevm-replay <fixture.json>...` replays each fixture and prints MATCH or
/// DIFF with the differences. The exit status is the number of fixtures that
/// did not match.
// `std::fs` exists on Unix hosts only, as does fevm's native build.
#[cfg(target_family = "unix")]
pub fn main() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() < 2 {
        println!("usage: fevm-replay <fixture.json>...")
        return 2
    }
    var failed: i32 = 0
    for index in 1..args.count() {
        let path = args.get(index)
        let Result::Ok(bytes) = fs.read(path) else {
            println!("ERROR {path}: cannot read")
            failed += 1
            continue
        }
        let Result::Ok(doc) = parse(bytes.span()) else {
            println!("ERROR {path}: not JSON")
            failed += 1
            continue
        }
        var text = MemBuffer::empty()
        let found = with (mut text) { replay(doc) }
        if found.total() == 0 {
            println!("MATCH {path}")
        } else {
            println!("DIFF  {path}")
            print!(text)
            failed += 1
        }
    }
    failed
}
