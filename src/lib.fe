//! fevm-replay: replay Ethereum mainnet transactions in fevm and check the
//! result against the chain.

use core::MemBuffer
use certify::Check
use core::fixed::UFixed
use std::env::{Arg, Args}
use std::io::{Display, Stdout}
use json::{Value, parse}

pub use check::{fixture_ok, transaction_ok}
pub use compare::{Mismatches, apply_diff, compare}
pub use load::{field, hex_bytes, hex_word, load_block, load_tx, load_world}
pub use replay::{replay, replay_tx}
pub use watch::{SelectorGas, add_profile}

const DEFAULT_RPC: String<21> = "https://eth.drpc.org"

// `proxy:<file>`: the proxy scenario, with the implementation's code read
// from the file.
fn starts_with_proxy(_ arg: Arg) -> bool {
    let bytes = arg.span()
    let prefix: [u8; 6] = [0x70, 0x72, 0x6f, 0x78, 0x79, 0x3a]
    if bytes.len() <= 6 {
        return false
    }
    for i in 0 .. 6 {
        if bytes[i] != prefix[i] {
            return false
        }
    }
    true
}

#[cfg(target_family = "unix")]
fn read_proxy_token(_ arg: Arg) -> Option<MemBuffer>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    var path = MemBuffer::empty()
    let bytes = arg.span()
    for i in 6 .. bytes.len() {
        path.push(bytes[i])
    }
    let Result::Ok(hex) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    var token = MemBuffer::empty()
    token.push(0x50)
    let code = hex_bytes(hex.span())
    for i in 0 .. code.len() {
        token.push(code.span()[i])
    }
    Option::Some(token)
}

fn is_word<const N: usize>(_ arg: Arg, _ word: [u8; N]) -> bool {
    let bytes = arg.span()
    if bytes.len() != N {
        return false
    }
    for i in 0 .. N {
        if bytes[i] != word[i] {
            return false
        }
    }
    true
}

/// `fevm-replay <fixture.json>...` replays each fixture and prints MATCH or
/// DIFF with the differences; the exit status is the number of fixtures
/// that did not match.
/// `fevm-replay fetch <txhash> <fixture.json> [rpc-url]` writes the fixture
/// for one mainnet transaction.
/// `fevm-replay fetch-block <0x-number> <dir> [rpc-url]` saves the node's
/// answers for a whole block, and `fevm-replay block <dir>` replays every
/// transaction in it.
#[cfg(target_family = "unix")]
pub fn main() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 2 {
        println!("usage: fevm-replay <fixture.json>...")
        println!(
            "       fevm-replay fetch <txhash> <fixture.json> [rpc-url]",
        )
        println!(
            "       fevm-replay fetch-block <0x-number> <dir> [rpc-url]",
        )
        println!(
            "       fevm-replay block <dir> [<shadow-address>|<deployed.hex> <runtime.bin>]",
        )
        println!(
            "       fevm-replay range <first-block> <count> <dir> [<shadow-address>|<deployed.hex> <runtime.bin>]",
        )
        println!("       fevm-replay fetch-code <address> <file> [rpc-url]")
        println!(
            "       fevm-replay system <dir> <BeaconRoots.runtime.bin> <HistoryStorage.runtime.bin> [<WithdrawalRequests.runtime.bin> <ConsolidationRequests.runtime.bin>]",
        )
        println!("       fevm-replay mutants-system <port-dir> <dir>...")
        println!(
            "       fevm-replay certify-system <out-dir> <certificate.html> <dir>...",
        )
        println!(
            "       fevm-replay fuzz <deployed.hex> <port.bin> [runs] [steps] [seed]",
        )
        return 2
    }
    // "fetch-block"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x62, 0x6c, 0x6f, 0x63, 0x6b],
    ) {
        return fetch_block_command()
    }
    // "fuzz"
    if is_word(args.get(1), [0x66, 0x75, 0x7a, 0x7a]) {
        return fuzz_command(pair: false)
    }
    // "fetch-hashes"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x68, 0x61, 0x73, 0x68, 0x65, 0x73],
    ) {
        return fetch_hashes_command()
    }
    // "fetch-proofs"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x70, 0x72, 0x6f, 0x6f, 0x66, 0x73],
    ) {
        return fetch_proofs_command()
    }
    // "follow"
    if is_word(args.get(1), [0x66, 0x6f, 0x6c, 0x6c, 0x6f, 0x77]) {
        return follow::follow_command()
    }
    // "chain"
    if is_word(args.get(1), [0x63, 0x68, 0x61, 0x69, 0x6e]) {
        return chain_command()
    }
    // "certify-system"
    if is_word(
        args.get(1),
        [0x63, 0x65, 0x72, 0x74, 0x69, 0x66, 0x79, 0x2d, 0x73, 0x79, 0x73, 0x74, 0x65, 0x6d],
    ) {
        return certify_system_command()
    }
    // "mutants-system"
    if is_word(
        args.get(1),
        [0x6d, 0x75, 0x74, 0x61, 0x6e, 0x74, 0x73, 0x2d, 0x73, 0x79, 0x73, 0x74, 0x65, 0x6d],
    ) {
        return mutants_system_command()
    }
    // "system"
    if is_word(args.get(1), [0x73, 0x79, 0x73, 0x74, 0x65, 0x6d]) {
        return system_command()
    }
    // "certify"
    if is_word(args.get(1), [0x63, 0x65, 0x72, 0x74, 0x69, 0x66, 0x79]) {
        return certify_command()
    }
    // "mutants"
    if is_word(args.get(1), [0x6d, 0x75, 0x74, 0x61, 0x6e, 0x74, 0x73]) {
        return mutants_command()
    }
    // "opgas"
    if is_word(args.get(1), [0x6f, 0x70, 0x67, 0x61, 0x73]) {
        return opgas_command()
    }
    // "trace"
    if is_word(args.get(1), [0x74, 0x72, 0x61, 0x63, 0x65]) {
        return trace_command()
    }
    // "fuzz-block"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x62, 0x6c, 0x6f, 0x63, 0x6b],
    ) {
        return fuzz_block_command()
    }
    // "fuzz-pair"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x70, 0x61, 0x69, 0x72],
    ) {
        return fuzz_command(pair: true)
    }
    // "fuzz-proxy"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x70, 0x72, 0x6f, 0x78, 0x79],
    ) {
        return fuzz_command(pair: true)
    }
    // "fuzz-dai"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x64, 0x61, 0x69],
    ) {
        return fuzz_command(pair: false)
    }
    // "fuzz-usdt"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x75, 0x73, 0x64, 0x74],
    ) {
        return fuzz_command(pair: false)
    }
    // "fetch-code"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x63, 0x6f, 0x64, 0x65],
    ) {
        return fetch_code_command()
    }
    // "range"
    if is_word(args.get(1), [0x72, 0x61, 0x6e, 0x67, 0x65]) {
        return range_command()
    }
    // "block"
    if is_word(args.get(1), [0x62, 0x6c, 0x6f, 0x63, 0x6b]) {
        return block_command()
    }
    // "fetch"
    if is_word(args.get(1), [0x66, 0x65, 0x74, 0x63, 0x68]) {
        return fetch_command()
    }
    replay_command()
}

#[cfg(target_family = "unix")]
fn fetch_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 4 && args.count() != 5 {
        println!(
            "usage: fevm-replay fetch <txhash> <fixture.json> [rpc-url]",
        )
        return 2
    }
    var text = MemBuffer::empty()
    let fetched = if args.count() == 5 {
        fetch::fetch(args.get(4), args.get(2), mut text)
    } else {
        fetch::fetch(DEFAULT_RPC, args.get(2), mut text)
    }
    if !fetched {
        println!("ERROR ", args.get(2), ": the node did not answer")
        return 1
    }
    let Result::Ok(_) = fs.write(args.get(3), text.span()) else {
        println!("ERROR ", args.get(3), ": cannot write")
        return 1
    }
    println!("wrote ", args.get(3))
    0
}

#[cfg(target_family = "unix")]
fn replay_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    var failed: i32 = 0
    for index in 1 .. args.count() {
        let path = args.get(index)
        let Result::Ok(bytes) = fs.read(path) else {
            println!("ERROR ", path, ": cannot read")
            failed += 1
            continue
        }
        let Result::Ok(doc) = parse(bytes.span()) else {
            println!("ERROR ", path, ": not JSON")
            failed += 1
            continue
        }
        var problem = MemBuffer::empty()
        if !fixture_ok(doc, mut problem) {
            println!("ERROR ", path, ": ", problem)
            failed += 1
            continue
        }
        var text = MemBuffer::empty()
        let found = with (mut text) {
            replay(doc)
        }
        if found.total() == 0 {
            println!("MATCH ", path)
        } else {
            println!("DIFF  ", path)
            print!(text)
            failed += 1
        }
    }
    failed
}

#[cfg(target_family = "unix")]
fn fetch_block_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 4 && args.count() != 5 {
        println!(
            "usage: fevm-replay fetch-block <0x-number> <dir> [rpc-url]",
        )
        return 2
    }
    let Result::Ok(_) = fs.create_dir_all(args.get(3)) else {
        println!("ERROR ", args.get(3), ": cannot create")
        return 1
    }
    let fetched = if args.count() == 5 {
        fetch::fetch_block(args.get(4), args.get(2), args.get(3))
    } else {
        fetch::fetch_block(DEFAULT_RPC, args.get(2), args.get(3))
    }
    if !fetched {
        println!("ERROR block ", args.get(2), ": the node did not answer")
        return 1
    }
    println!("saved block ", args.get(2), " in ", args.get(3))
    0
}

// Whether `list` is a JSON array of `count` entries.
fn same_length(_ list: Value, _ count: usize) -> bool {
    match list.as_array() {
        Option::Some(ref items) => items.len() == count,
        Option::None => false,
    }
}

// The JSON document saved in `dir/name`.
#[cfg(target_family = "unix")]
fn load_json<D: Display>(_ dir: D, _ name: String<16>) -> Option<json::Value>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let path = fetch::join(dir, name)
    let Result::Ok(bytes) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    let Result::Ok(doc) = parse(bytes.span()) else {
        println!("ERROR ", path, ": not JSON")
        return Option::None
    }
    Option::Some(doc)
}

// The JSON-RPC response saved in `dir/name`, which must hold a `result`.
#[cfg(target_family = "unix")]
fn load_response<D: Display>(_ dir: D, _ name: String<16>) -> Option<json::Value>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let Option::Some(doc) = load_json(dir, name) else {
        return Option::None
    }
    if !doc.has("result") {
        println!("ERROR ", dir, "/", name, ": no result")
        return Option::None
    }
    Option::Some(doc)
}

/// What a run of blocks found.
pub struct Totals {
    pub blocks: u64,
    pub transactions: u64,
    pub matched: u64,
    /// Differences in transactions that ran BLOCKHASH.
    pub old_hashes: u64,
    pub shadowed: u64,
    /// Shadowed transactions that differ where code read the gas left.
    pub gas_sensitive: u64,
    /// Of those, the ones a gas reading explains (see `watch::explain_gas`).
    pub gas_explained: u64,
    /// Shadowed transactions that differ where code read a code hash.
    pub code_sensitive: u64,
    /// Shadowed transactions where only the deployed code ran out of gas.
    pub cheaper: u64,
    /// Shadowed transactions that differ without reading the gas left.
    pub behavior: u64,
    pub chain_gas: u64,
    pub shadow_gas: u64,
    /// Gas per function of the shadowed contract in identical transactions,
    /// on the deployed code and on the shadow code.
    pub deployed_profile: core::MemVec<SelectorGas>,
    pub shadow_profile: core::MemVec<SelectorGas>,
}

// Whether `dir/delegates.json` already holds older block hashes.
#[cfg(target_family = "unix")]
fn has_block_hashes(_ dir: MemSpan) -> bool uses (fs: mut std::fs::Fs) {
    let Result::Ok(bytes) = fs.read(fetch::join(dir, "delegates.json")) else {
        return false
    }
    match parse(bytes.span()) {
        Result::Ok(doc) => doc.has("blockHashes"),
        Result::Err(_) => false,
    }
}

fn add_totals(_ into: mut Totals, _ from: Totals) {
    into.blocks += from.blocks
    into.transactions += from.transactions
    into.matched += from.matched
    into.old_hashes += from.old_hashes
    into.shadowed += from.shadowed
    into.gas_sensitive += from.gas_sensitive
    into.gas_explained += from.gas_explained
    into.code_sensitive += from.code_sensitive
    into.cheaper += from.cheaper
    into.behavior += from.behavior
    into.chain_gas += from.chain_gas
    into.shadow_gas += from.shadow_gas
    add_profile(mut into.deployed_profile, from.deployed_profile)
    add_profile(mut into.shadow_profile, from.shadow_profile)
}

impl Totals {
    pub fn new() -> Self {
        Totals {
            blocks: 0,
            transactions: 0,
            matched: 0,
            old_hashes: 0,
            shadowed: 0,
            gas_sensitive: 0,
            gas_explained: 0,
            code_sensitive: 0,
            cheaper: 0,
            behavior: 0,
            chain_gas: 0,
            shadow_gas: 0,
            deployed_profile: core::MemVec::new(),
            shadow_profile: core::MemVec::new(),
        }
    }
}

fn print_share(_ matched: u64, _ total: u64) uses (out: mut Stdout) {
    // Nothing to replay matched in full.
    let share = if total == 0 {
        UFixed<1>::from_int(100)
    } else {
        certify::share(matched, total)
    }
    println!(matched, "/", total, " transactions MATCH (", share, "%)")
}

fn read_shadow(_ path: Arg) -> Option<MemBuffer>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let Result::Ok(hex) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    Option::Some(hex_bytes(hex.span()))
}

// A shadow target: a `0x` address, or a hex file of deployed code, read into
// `like`, whose every copy is shadowed (then the address is 0).
#[cfg(target_family = "unix")]
fn shadow_target(_ arg: Arg, _ like: mut MemBuffer) -> Option<u256>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let text = arg.span()
    if text.len() > 1 && text[0] == 0x30 && text[1] == 0x78 {
        return Option::Some(core::text::parse_hex_uint(text).unwrap_or(default: 0))
    }
    let Option::Some(code) = read_shadow(arg) else {
        return Option::None
    }
    like = code
    Option::Some(0)
}

/// Replays every transaction of the block saved in `dir`, printing each
/// difference and the block's share of matches, and adds to `totals`.
/// False if the saved answers cannot be used.
#[cfg(target_family = "unix")]
fn replay_block<D: Display>(
    _ dir: D,
    shadow_address: u256,
    shadow_code: MemSpan,
    shadow_like: MemSpan,
    _ totals: mut Totals,
) -> bool
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return false
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return false
    }
    let Option::Some(receipts) = load_response(dir, "receipts.json") else {
        return false
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return false
    }
    let Option::Some(diffs) = load_response(dir, "diff.json") else {
        return false
    }
    let header = ref block["result"]
    var problem = MemBuffer::empty()
    if !check::header_ok(header, mut problem) || !header["transactions"].as_array().is_some() {
        println!(
            "ERROR ",
            dir,
            "/block.json: ",
            problem,
            " (or no transaction list)",
        )
        return false
    }
    let count = header["transactions"].items().len()
    if !same_length(receipts["result"], count)
        || !same_length(prestates["result"], count)
        || !same_length(diffs["result"], count) {
        println!(
            "ERROR ",
            dir,
            ": the receipts and traces do not list one entry per transaction; fetch again",
        )
        return false
    }
    // A load-balanced endpoint may answer the calls from nodes at
    // different heights; around a reorg they can describe different blocks.
    let first = receipts["result"].items()
    if first.len() > 0 && field(first[0], "blockHash") != field(header, "hash") {
        println!(
            "ERROR ",
            dir,
            ": the receipts belong to another block than the header; fetch again",
        )
        return false
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    // Saved by `fetch-block` since EIP-7702 delegates were added; older
    // block directories have none.
    let has_delegates = match fs.metadata(fetch::join(dir, "delegates.json")) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
    let extras = if has_delegates {
        let Option::Some(doc) = load_json(dir, "delegates.json") else {
            return false
        }
        doc
    } else {
        Value::object()
    }
    if !check::extras_ok(extras, mut problem) {
        println!("ERROR ", dir, "/delegates.json: ", problem)
        return false
    }
    let txs = header["transactions"].items()
    var matched: u64 = 0
    for index in 0 .. txs.len() {
        let trace_ok = prestates["result"][index].as_object().is_some()
            && prestates["result"][index].has("result")
            && diffs["result"][index].as_object().is_some()
            && diffs["result"][index].has("result")
        var bad = MemBuffer::empty()
        if !trace_ok
            || !transaction_ok(
                txs[index],
                receipts["result"][index],
                prestates["result"][index]["result"],
                diffs["result"][index]["result"],
                mut bad,
            ) {
            if !trace_ok {
                "a trace has no result".fmt(mut bad)
            }
            println!("ERROR tx ", index, " ", dir, ": ", bad)
            continue
        }
        var text = MemBuffer::empty()
        let found = with (mut text) {
            replay_tx(
                env,
                parent_hash: field(header, "parentHash"),
                extras,
                txs[index],
                receipts["result"][index],
                prestates["result"][index]["result"],
                diffs["result"][index]["result"],
                shadow_address,
                shadow_code,
                shadow_like,
                deployed_gas: mut totals.deployed_profile,
                shadow_gas: mut totals.shadow_profile,
            )
        }
        if found.shadowed {
            totals.shadowed += 1
            totals.chain_gas += found.chain_gas
            totals.shadow_gas += found.fevm_gas
        }
        if found.total() == 0 {
            matched += 1
            continue
        }
        if found.shadowed && found.gas_observed {
            totals.gas_sensitive += 1
            if found.gas_reader != 0 {
                totals.gas_explained += 1
                println!(
                    "DIFF  tx ",
                    index,
                    " ",
                    txs[index]["hash"].text(),
                    " (reads gas after the shadow code ran: 0x",
                    core::text::hex(found.gas_reader, 20),
                    " read it where the runs part)",
                )
            } else {
                println!(
                    "DIFF  tx ",
                    index,
                    " ",
                    txs[index]["hash"].text(),
                    " (reads gas after the shadow code ran, but the runs part elsewhere)",
                )
            }
        } else if found.shadowed && found.code_observed {
            totals.code_sensitive += 1
            print!(
                "DIFF  tx ",
                index,
                " ",
                txs[index]["hash"].text(),
                " (reads code hashes, and the shadow code is other code",
            )
            if !found.shadow_ran {
                print!("; it stops before calling the port")
            }
            if found.code_target != 0 {
                print!(
                    "; the port alone changes it at ",
                    found.code_targets,
                    " of ",
                    found.shadow_targets,
                    " pairs, first 0x",
                    core::text::hex(found.code_target, 20),
                )
            }
            println!(")")
        } else if found.read_blockhash {
            totals.old_hashes += 1
            println!(
                "DIFF  tx ",
                index,
                " ",
                txs[index]["hash"].text(),
                " (ran BLOCKHASH; a hash before the parent's is not in the node's traces)",
            )
        } else if found.shadowed && found.cheaper {
            totals.cheaper += 1
            println!(
                "DIFF  tx ",
                index,
                " ",
                txs[index]["hash"].text(),
                " (the deployed code ran out of gas where the shadow code, cheaper, did not)",
            )
        } else {
            if found.shadowed {
                totals.behavior += 1
            }
            println!("DIFF  tx ", index, " ", txs[index]["hash"].text())
        }
        print!(text)
    }
    let total: u64 = txs.len().downcast_unchecked()
    totals.blocks += 1
    totals.transactions += total
    totals.matched += matched
    print!("block ", header["number"].text(), ": ")
    print_share(matched, total)
    true
}

#[cfg(target_family = "unix")]
fn print_totals(_ totals: Totals, shadowing: bool) uses (out: mut Stdout) {
    print!(totals.blocks, " blocks: ")
    print_share(totals.matched, totals.transactions)
    if totals.old_hashes > 0 {
        println!(
            "  of the differences, ",
            totals.old_hashes,
            " ran BLOCKHASH (see `blockHashes` in the README)",
        )
    }
    if shadowing {
        println!(
            "shadow: ",
            totals.shadowed,
            " transactions ran the shadow code, ",
            totals.shadowed -
                totals.gas_sensitive -
                totals.code_sensitive -
                totals.cheaper -
                totals.behavior,
            " identical, ",
            totals.gas_sensitive,
            " differ where code reads the gas left, ",
            totals.code_sensitive,
            " where code reads code hashes, ",
            totals.behavior,
            " behave differently; gas used chain ",
            totals.chain_gas,
            ", shadow ",
            totals.shadow_gas,
        )
        if totals.cheaper > 0 {
            println!(
                "  ",
                totals.cheaper,
                " more differ where only the deployed code ran out of gas",
            )
        }
        if totals.gas_sensitive > 0 {
            println!(
                "  of the ",
                totals.gas_sensitive,
                " where code reads the gas left, ",
                totals.gas_explained,
                " part at or under a call whose code read it",
            )
        }
        print_profile(totals.deployed_profile, totals.shadow_profile)
    }
}

// The name of a standard ERC-20 or WETH9 function, or nothing.
fn function_name(_ selector: u32) -> String<20> {
    match selector {
        0 => "fallback",
        0xd0e30db0 => "deposit",
        0x2e1a7d4d => "withdraw",
        0xa9059cbb => "transfer",
        0x23b872dd => "transferFrom",
        0x095ea7b3 => "approve",
        0x70a08231 => "balanceOf",
        0xdd62ed3e => "allowance",
        0x18160ddd => "totalSupply",
        0x313ce567 => "decimals",
        0x06fdde03 => "name",
        0x95d89b41 => "symbol",
        0x022c0d9f => "swap",
        0x6a627842 => "mint",
        0x89afcb44 => "burn",
        0xbc25cf77 => "skim",
        0xfff6cae9 => "sync",
        0x0902f1ac => "getReserves",
        0x0dfe1681 => "token0",
        0xd21220a7 => "token1",
        0xc45a0155 => "factory",
        0xd505accf => "permit",
        0x485cc955 => "initialize",
        0x7ecebe00 => "nonces",
        0x3644e515 => "DOMAIN_SEPARATOR",
        0x30adf81f => "PERMIT_TYPEHASH",
        0xba9a7a56 => "MINIMUM_LIQUIDITY",
        0x5909c0d5 => "price0Cumulative",
        0x5a3d5493 => "price1Cumulative",
        0x7464fc3d => "kLast",
        _ => "",
    }
}

// Average gas per call of each function, deployed against shadow, over the
// transactions the shadow code left identical.
#[cfg(target_family = "unix")]
fn print_profile(_ deployed: core::MemVec<SelectorGas>, _ shadow: core::MemVec<SelectorGas>)
uses (out: mut Stdout)
{
    if deployed.len() == 0 {
        return
    }
    println!(
        "gas per call in identical transactions (deployed -> shadow):",
    )
    for i in 0 .. deployed.len() {
        let d = deployed[i]
        var s_gas = watch::Gas::of(0)
        var s_calls: u64 = 0
        for j in 0 .. shadow.len() {
            if shadow[j].selector == d.selector {
                s_gas = shadow[j].gas
                s_calls = shadow[j].calls
            }
        }
        if d.calls == 0 || s_calls == 0 {
            continue
        }
        let before = d.gas / d.calls
        let after = s_gas / s_calls
        // The certificate's cell, as terminal text.
        var html = MemBuffer::empty()
        with (mut html) {
            certify::signed_change(before, after)
        }
        println!(
            "  0x",
            core::text::hex(d.selector as u256, 4),
            " ",
            function_name(d.selector),
            ": ",
            d.calls,
            " calls, ",
            before,
            " -> ",
            after,
            " (",
            html.span(),
            ")",
        )
    }
}

/// `fetch-proofs <dir> [rpc-url]`: for a block saved by `fetch-block`, the
/// Merkle proofs (`eth_getProof`) of every account and slot it touched, at
/// the end of the parent block and of the block itself, and the parent's
/// header, into `dir/proofs.json`. `chain` then checks the block's
/// pre-state and its replayed end state against the two state roots,
/// offline. Run it within about 128 blocks of the block: nodes keep no
/// older state for proofs.
#[cfg(target_family = "unix")]
fn fetch_proofs_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 3 && args.count() != 4 {
        println!("usage: fevm-replay fetch-proofs <dir> [rpc-url]")
        return 2
    }
    let dir = args.get(2)
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return 1
    }
    let Option::Some(diffs) = load_response(dir, "diff.json") else {
        return 1
    }
    let header = ref block["result"]
    let number = field(header, "number")
    var keys = proof::touched(
        prestates["result"],
        diffs["result"],
        header,
        recipients: true,
    )
    // The request contracts the end-of-block system calls run, whether or
    // not a transaction touched them.
    proof::add_request_keys(mut keys)
    // And the slots the block's first system calls write.
    proof::add_system_keys(mut keys, header)
    // And the queue entries their system calls read, as the node says the
    // queues stood at the parent; `chain` proves what it uses.
    var requests_at: u256 = proof::WITHDRAWAL_REQUESTS
    for c in 0 .. 2 {
        if c == 1 {
            requests_at = proof::CONSOLIDATION_REQUESTS
        }
        let (head, tail) = if args.count() == 4 {
            (
                fetch::storage_at(args.get(3), requests_at, slot: 2, number: number - 1),
                fetch::storage_at(args.get(3), requests_at, slot: 3, number: number - 1),
            )
        } else {
            (
                fetch::storage_at(DEFAULT_RPC, requests_at, slot: 2, number: number - 1),
                fetch::storage_at(DEFAULT_RPC, requests_at, slot: 3, number: number - 1),
            )
        }
        let (Option::Some(head), Option::Some(tail)) = (head, tail) else {
            println!("ERROR the node did not send the request queues")
            return 1
        }
        proof::add_queue_keys(mut keys, address: requests_at, head, tail)
    }
    var text = MemBuffer::empty()
    "{\"parent\":".fmt(mut text)
    let parent = if args.count() == 4 {
        fetch::header(args.get(3), number: number - 1)
    } else {
        fetch::header(DEFAULT_RPC, number: number - 1)
    }
    let Option::Some(parent) = parent else {
        println!("ERROR the node did not send the parent's header")
        return 1
    }
    parent["result"].write(mut text)
    var slots: u64 = 0
    for position in 0 .. keys.storage_slots() {
        if keys.storage_at(position).occupied {
            slots += 1
        }
    }
    // The same accounts at both ends, the parent's first: it is the older.
    for end in 0 .. 2 {
        if end == 0 {
            ",\"pre\":[".fmt(mut text)
        } else {
            "],\"post\":[".fmt(mut text)
        }
        let at = if end == 0 { number - 1 } else { number }
        var k: usize = 0
        while k < keys.account_count() {
            let count = if keys.account_count() - k < 12 {
                keys.account_count() - k
            } else {
                12
            }
            // A load-balanced endpoint can route a request to a node that
            // keeps less state and answers with an error: ask again.
            var answers: Option<MemBuffer> = Option::None
            var tries: u8 = 0
            while answers.is_none() && tries < 20 {
                tries += 1
                answers = if args.count() == 4 {
                    fetch::proofs(args.get(3), keys, first: k, count, number: at, dir)
                } else {
                    fetch::proofs(DEFAULT_RPC, keys, first: k, count, number: at, dir)
                }
            }
            let Option::Some(answers) = answers else {
                println!(
                    "ERROR no proofs for accounts ",
                    k,
                    " to ",
                    k + count,
                    " at block ",
                    at,
                    " (nodes keep about 128 blocks of state)",
                )
                return 1
            }
            if k > 0 { ",".fmt(mut text) }
            answers.span().fmt(mut text)
            k += count
            if k % 120 == 0 || k == keys.account_count() {
                println!(
                    "  block ",
                    at,
                    ": ",
                    k,
                    " of ",
                    keys.account_count(),
                    " accounts",
                )
            }
        }
    }
    // Their code, at the parent: `chain` checks it against the code hash
    // the parent's proofs prove.
    "],\"code\":".fmt(mut text)
    var contracts: core::MemVec<u256> = core::MemVec::new()
    contracts.push(proof::WITHDRAWAL_REQUESTS)
    contracts.push(proof::CONSOLIDATION_REQUESTS)
    contracts.push(proof::BEACON_ROOTS)
    contracts.push(proof::HISTORY)
    let at = fetch::quantity(number - 1)
    let fetched = if args.count() == 4 {
        fetch::write_delegates(args.get(3), contracts, parent: at.span(), mut text)
    } else {
        fetch::write_delegates(DEFAULT_RPC, contracts, parent: at.span(), mut text)
    }
    if !fetched {
        println!("ERROR the node did not send the request contracts' code")
        return 1
    }
    "}".fmt(mut text)
    let path = fetch::join(dir, "proofs.json")
    let Result::Ok(_) = fs.write(path, text.span()) else {
        println!("ERROR ", path, ": cannot write")
        return 1
    }
    println!(
        "saved proofs of ",
        keys.account_count(),
        " accounts and ",
        slots,
        " slots at blocks ",
        number - 1,
        " and ",
        number,
        " in ",
        path,
    )
    0
}

#[cfg(target_family = "unix")]
/// `chain <dir> [rpc-url]`: replays the saved block as a chain. The world
/// starts as the block's pre-state (every prestate, last transaction
/// first) and each transaction runs on what the one before it left, checked
/// against the chain's receipt and state diff. After the last, the block's
/// withdrawals (EIP-4895) credit their recipients; with an RPC URL, every
/// recipient's balance is checked against the node's for the end of the
/// block.
#[cfg(target_family = "unix")]
fn chain_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 3 {
        println!(
            "usage: fevm-replay chain <dir> [rpc-url] | chain <dir> --system <out-dir> | chain <dir> <dir>...",
        )
        return 2
    }
    let rpc = args.count() == 4 && is_url(args.get(3))
    if args.count() == 3 || rpc {
        return chain_block(args.get(2), rpc: rpc, ports: SystemPorts::none())
    }
    // `chain <dir> --system <out-dir>`: the block's four system calls run
    // the Fe ports in `out-dir` (ports/system built) instead of the
    // deployed code.
    if args.count() == 5 && is_word(
            args.get(3),
            [0x2d, 0x2d, 0x73, 0x79, 0x73, 0x74, 0x65, 0x6d],
        ) {
        let Option::Some(ports) = read_system_ports(args.get(4)) else {
            return 1
        }
        return chain_block(args.get(2), rpc: false, ports)
    }
    // Consecutive blocks: each validated, then linked. A block's parent
    // must be the block before it, and the state root its pre-state was
    // proven against must be that block's, which fevm computed.
    var failed: u64 = 0
    var linked: u64 = 0
    var previous_hash: u256 = 0
    var previous_root: u256 = 0
    for i in 2 .. args.count() {
        println!("== ", args.get(i))
        if chain_block(args.get(i), rpc: false, ports: SystemPorts::none()) != 0 {
            failed += 1
        }
        let Option::Some(block) = load_response(args.get(i), "block.json") else {
            return 1
        }
        let Option::Some(proofs) = load_json(args.get(i), "proofs.json") else {
            return 1
        }
        let header = ref block["result"]
        let stateless = !proof::code_of(proofs, proof::BEACON_ROOTS).is_empty()
        if i > 2 {
            if field(header, "parentHash") == previous_hash
                && field(proofs["parent"], "stateRoot") == previous_root
                && stateless {
                linked += 1
            } else {
                failed += 1
                println!(
                    "LINK ",
                    args.get(i),
                    ": its parent is not the block before it, or it was not validated statelessly",
                )
            }
        }
        previous_hash = field(header, "hash")
        previous_root = field(header, "stateRoot")
    }
    let blocks = args.count() - 2
    println!(
        "chain of ",
        blocks,
        " blocks: ",
        linked,
        " of ",
        blocks - 1,
        " links hold (each block's parent is the block before it, and its pre-state was proven against the state root fevm computed for that block)",
    )
    if failed == 0 { 0 } else { 1 }
}

// `chain` for one saved block; with `rpc`, the URL in argument 3 checks
// the withdrawal recipients' balances.
// Whether an argument is a URL (starts with `http`), not a directory.
fn is_url(_ arg: Arg) -> bool {
    let bytes = arg.span()
    bytes.len() > 4 && bytes[0] == 0x68 && bytes[1] == 0x74 && bytes[2] == 0x74 && bytes[3] == 0x70
}

#[cfg(target_family = "unix")]
fn chain_block(_ dir: Arg, rpc: bool, ports: SystemPorts) -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return 1
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(receipts) = load_response(dir, "receipts.json") else {
        return 1
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return 1
    }
    let Option::Some(diffs) = load_response(dir, "diff.json") else {
        return 1
    }
    let header = ref block["result"]
    let txs = header["transactions"].items()
    let count = txs.len()
    if !same_length(receipts["result"], count)
        || !same_length(prestates["result"], count)
        || !same_length(diffs["result"], count) {
        println!(
            "ERROR ",
            dir,
            ": the receipts and traces do not list one entry per transaction",
        )
        return 1
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let extras = match load_json(dir, "delegates.json") {
        Option::Some(doc) => doc,
        Option::None => Value::object(),
    }
    // The block's pre-state.
    var world = fevm::WorldState::empty()
    var i = count
    while i > 0 {
        i -= 1
        load::add_prestate(mut world, prestates["result"][i]["result"])
        load::clear_created(
            mut world,
            prestates["result"][i]["result"],
            diffs["result"][i]["result"],
        )
    }
    // An empty account does not exist on chain (EIP-161), though the
    // tracer lists accounts a transaction only looked at; a record of one
    // would count as existing, as for an EIP-7702 authority's refund.
    var empty: core::MemVec<u256> = core::MemVec::new()
    for k in 0 .. world.account_count() {
        let address = world.account_at(k).address
        if world.is_empty(address) && !world.has_storage(address) {
            empty.push(address)
        }
    }
    for k in 0 .. empty.len() {
        world.remove_account(empty[k])
    }
    world.set_block_hash(env.number - 1, field(header, "parentHash"))
    load::add_extras(mut world, extras)
    // With proofs saved beside the block (`fetch-proofs`), the block's
    // pre-state is checked against the parent's state root here, and the end
    // state against the block's own after the last transaction. Both roots
    // come from headers whose hashes are checked, so what a MATCH rests on
    // is the block hash, not the node.
    var proofs = Value::object()
    let proving = has_file(dir, "proofs.json")
    var keys = fevm::WorldState::empty()
    var parent_root: u256 = 0
    var unproven: u64 = 0
    var first_calls = false
    // What `summary.json` adds for a block validated statelessly.
    var stateless_summary = MemBuffer::empty()
    var stateless_ok = false
    // The pre-state for fevm's own block layer (`crosscheck`).
    var cross_pre: Option<fevm::WorldState> = Option::None
    if proving {
        let Option::Some(doc) = load_json(dir, "proofs.json") else {
            return 1
        }
        proofs = doc
        let parent = ref proofs["parent"]
        if proof::header_hash(header) != field(header, "hash")
            || proof::header_hash(parent) != field(parent, "hash")
            || field(parent, "hash") != field(header, "parentHash") {
            println!(
                "PROOF ",
                dir,
                ": the headers do not hash to the block's hash and its parent's",
            )
            return 1
        }
        parent_root = field(parent, "stateRoot")
        keys = proof::touched(
            prestates["result"],
            diffs["result"],
            header,
            recipients: false,
        )
        // Proofs that saved the first system contracts' code let fevm run
        // their calls: the world starts as the parent left it, and fevm
        // writes what EIP-4788 and EIP-2935 store. Older proofs check the
        // written slots against what the calls store instead.
        first_calls = !proof::code_of(proofs, proof::BEACON_ROOTS).is_empty()
            && !proof::code_of(proofs, proof::HISTORY).is_empty()
        var written: core::MemVec<proof::Written> = proof::system_writes(header)
        if first_calls {
            proof::add_system_keys(mut keys, header)
            for c in 0 .. 2 {
                let target = if c == 0 {
                    proof::BEACON_ROOTS
                } else {
                    proof::HISTORY
                }
                if !proof::load_system_contract(
                    mut world,
                    proofs,
                    state_root: parent_root,
                    address: target,
                    keys,
                ) {
                    first_calls = false
                }
            }
            written = core::MemVec::new()
        }
        var text = MemBuffer::empty()
        let pre = with (mut text) {
            proof::check(
                world,
                state_root: parent_root,
                proofs["pre"],
                keys,
                written,
                skip: core::MemVec::new(),
                code_unknown: core::MemVec::new(),
            )
        }
        print!(text)
        println!(
            "headers: block 0x",
            core::text::hex(field(header, "hash"), 32),
            " and its parent hash to themselves",
        )
        print_checked("pre-state", "the parent's", pre)
        unproven += pre.differ + pre.broken + pre.unproven
        if first_calls {
            cross_pre = world.try_clone()
            var ran: u64 = 0
            for c in 0 .. 2 {
                let (target, input) = if c == 0 {
                    (proof::BEACON_ROOTS, field(header, "parentBeaconBlockRoot"))
                } else {
                    (proof::HISTORY, field(header, "parentHash"))
                }
                var bytes = MemBuffer::with_capacity(32)
                bytes.write_word(offset: 0, value: input)
                ports.install(mut world, target)
                let (after, result) = requests::system_call(world, target, input: bytes.span(), env)
                world = after
                ports.restore(mut world, proofs, target)
                if result.status == fevm::OK {
                    ran += 1
                }
            }
            if ran == 2 {
                println!(
                    "system calls: fevm ran EIP-4788 (beacon root) and EIP-2935 (parent hash) before the first transaction",
                    if ports.on {
                        ", both as the Fe ports"
                    } else {
                        ""
                    },
                )
            } else {
                unproven += 1
                println!("SYSTEM a first system call failed in fevm")
            }
        }
    }
    var matched: u64 = 0
    var old_hashes: u64 = 0
    var drift: u64 = 0
    // fevm's own receipts, encoded as the chain encodes them, for the
    // receipts root the header commits to.
    var own_receipts: core::MemVec<MemBuffer> = core::MemVec::new()
    var cumulative_gas: u256 = 0
    // The OR of their blooms: the header's logsBloom.
    var block_bloom: [u8; 256] = [0; 256]
    // The deposits fevm's logs hold (EIP-6110), for the requests hash.
    var deposits = MemBuffer::empty()
    var deposits_ok = true
    for index in 0 .. count {
        // The carried state must hold what the node saw before this
        // transaction, for every account and slot it touched.
        let off = load::prestate_mismatches(world, prestates["result"][index]["result"])
        if off > 0 {
            drift += 1
            println!(
                "STATE tx ",
                index,
                ": ",
                off,
                " values differ from the node's prestate",
            )
        }
        let Option::Some(before) = world.try_clone() else {
            println!("ERROR out of memory")
            return 1
        }
        var expected = before
        apply_diff(mut expected, diffs["result"][index]["result"])
        var buffers = fevm::Buffers::new()
        var tracer = watch::GasWatch::new(shadows: core::MemVec::new())
        let applied = ingot::compat::transact(
            world,
            load_tx(txs[index]),
            env,
            fevm::Config::osaka(),
            mut buffers,
            mut tracer,
        )
        cumulative_gas += applied.receipt.gas_used as u256
        if !requests::add_deposits(mut deposits, applied.receipt.logs) {
            deposits_ok = false
        }
        own_receipts
            .push(
                receipts::encode(
                    tx_type: field(txs[index], "type"),
                    success: applied.receipt.status == fevm::OK,
                    cumulative_gas,
                    applied.receipt.logs,
                    block_bloom: mut block_bloom,
                ),
            )
        var text = MemBuffer::empty()
        let found = with (mut text) {
            compare(
                applied.receipt,
                applied.state,
                receipts["result"][index],
                expected,
                gas_must_match: true,
            )
        }
        if found.total() == 0 {
            matched += 1
            world = applied.state
        } else {
            if tracer.read_blockhash {
                old_hashes += 1
                println!(
                    "DIFF  tx ",
                    index,
                    " ",
                    txs[index]["hash"].text(),
                    " (ran BLOCKHASH; a hash before the parent's is not in the node's traces)",
                )
            } else {
                println!("DIFF  tx ", index, " ", txs[index]["hash"].text())
                print!(text)
                // The same transaction on its own prestate: the first call
                // whose gas differs shows where the carried state matters.
                var alone = watch::GasWatch::new(shadows: core::MemVec::new())
                var more = fevm::Buffers::new()
                let mut_world = replay::build_world(
                    prestates["result"][index]["result"],
                    env,
                    field(header, "parentHash"),
                    extras,
                    core::MemVec::new(),
                    MemBuffer::empty().span(),
                )
                ingot::compat::transact(
                    mut_world,
                    load_tx(txs[index]),
                    env,
                    fevm::Config::osaka(),
                    mut more,
                    mut alone,
                )
                let n = if alone.calls.len() < tracer.calls.len() {
                    alone.calls.len()
                } else {
                    tracer.calls.len()
                }
                for c in 0 .. n {
                    let x = tracer.calls[c]
                    let y = alone.calls[c]
                    if x.used != y.used || x.gas != y.gas || x.to != y.to {
                        println!(
                            "  call ",
                            c,
                            " to 0x",
                            core::text::hex(x.to, 20),
                            " selector 0x",
                            core::text::hex(x.selector as u256, 4),
                            ": gas given ",
                            x.gas,
                            " used ",
                            x.used,
                            " in the chain, given ",
                            y.gas,
                            " used ",
                            y.used,
                            " on its own prestate",
                        )
                        break
                    }
                }
            }
            // Go on from the chain's state, so one difference stays one.
            let Option::Some(chain_state) = expected.try_clone() else {
                return 1
            }
            world = chain_state
        }
    }
    print!("chain ", dir, ": ")
    print_share(matched, count.downcast_unchecked())
    // fevm's receipts against the header: status, gas and every log, with
    // no node in between. The header itself must hash to the block's hash.
    let receipts_root = receipts::trie_root(own_receipts)
    let header_hashes = proof::header_hash(header) == field(header, "hash")
    let receipts_match = header_hashes && receipts_root == field(header, "receiptsRoot")
    if receipts_match {
        println!(
            "receipts: fevm's ",
            count,
            " receipts hash to the header's receiptsRoot",
        )
    } else if !header_hashes {
        println!("RECEIPTS the header does not hash to the block's hash")
    } else {
        println!(
            "RECEIPTS fevm's receipts hash to 0x",
            core::text::hex(receipts_root, 32),
            ", the header's receiptsRoot is 0x",
            core::text::hex(field(header, "receiptsRoot"), 32),
        )
    }
    if !receipts_match {
        unproven += 1
    }
    // The rest of what the header commits to about the block's body and
    // its execution, from the block's own data and fevm's results.
    unproven += header_commitments(header, gas_used: cumulative_gas, bloom: block_bloom)
    if old_hashes > 0 {
        println!("  of the differences, ", old_hashes, " ran BLOCKHASH")
    }
    if drift > 0 {
        println!(
            "  ",
            drift,
            " transactions started from a state that differs from the node's prestate",
        )
    }
    // Withdrawals: each credits its recipient, in gwei.
    var unknown: u64 = 0
    var code_unknown: core::MemVec<u256> = core::MemVec::new()
    var paid: u64 = 0
    if header.has("withdrawals") {
        let withdrawals = header["withdrawals"].items()
        paid = withdrawals.len().downcast_unchecked()
        for w in 0 .. withdrawals.len() {
            let address = field(withdrawals[w], "address")
            // A recipient no transaction touched is not in the world: its
            // balance before the withdrawals is the parent block's.
            if !world.exists(address) {
                if proving {
                    match proof::find_account(proofs["pre"], state_root: parent_root, address) {
                        Option::Some(account) => {
                            if !world.set_balance(address, account.balance)
                                || !world.set_nonce(address, account.nonce) {
                                unknown += 1
                            }
                            // Its code, if any, is not fetched.
                            if account.code_hash != proof::EMPTY_CODE {
                                code_unknown.push(address)
                            }
                        },
                        Option::None => {
                            unknown += 1
                        },
                    }
                } else if rpc {
                    match fetch::balance_at(args.get(3), address, number: env.number - 1) {
                        Option::Some(balance) => {
                            if !world.set_balance(address, balance) {
                                unknown += 1
                            }
                        },
                        Option::None => {
                            unknown += 1
                        },
                    }
                } else {
                    unknown += 1
                }
            }
            if !world
                .set_balance(
                    address,
                    world.balance(address) + field(withdrawals[w], "amount") * 1_000_000_000,
                ) {
                unknown += 1
            }
        }
    }
    // The end-of-block system calls (EIP-7002, EIP-7251) run on the
    // request contracts as the parent's proofs prove them; with the
    // deposits, their output must hash to the header's requestsHash.
    // Proofs saved before `fetch-proofs` saved the contracts' code leave
    // them out, and the end state skips the two contracts.
    let system_calls = proving && proofs.has("code")
    if system_calls {
        var withdrawal_requests = MemBuffer::empty()
        var consolidation_requests = MemBuffer::empty()
        var ran: u64 = 0
        for c in 0 .. 2 {
            let target = if c == 0 {
                proof::WITHDRAWAL_REQUESTS
            } else {
                proof::CONSOLIDATION_REQUESTS
            }
            if !proof::load_request_contract(
                mut world,
                proofs,
                state_root: parent_root,
                address: target,
                keys,
            ) {
                println!(
                    "SYSTEM 0x",
                    core::text::hex(target, 20),
                    ": its code or slots are not proven, or its queue held earlier requests",
                )
                continue
            }
            ports.install(mut world, target)
            let (after, result) = requests::system_call(
                world,
                target,
                input: MemBuffer::empty().span(),
                env,
            )
            world = after
            ports.restore(mut world, proofs, target)
            if result.status != fevm::OK {
                println!(
                    "SYSTEM 0x",
                    core::text::hex(target, 20),
                    ": the system call failed",
                )
                continue
            }
            ran += 1
            if c == 0 {
                withdrawal_requests = result.output
            } else {
                consolidation_requests = result.output
            }
        }
        let hash = requests::requests_hash(
            deposits: deposits.span(),
            withdrawals: withdrawal_requests.span(),
            consolidations: consolidation_requests.span(),
        )
        if ran == 2
            && deposits_ok
            && header.has("requestsHash")
            && hash == field(header, "requestsHash") {
            println!(
                "requests: fevm's ",
                deposits.len() / 192,
                " deposits, ",
                withdrawal_requests.len() / 76,
                " withdrawal and ",
                consolidation_requests.len() / 116,
                " consolidation requests hash to the header's requestsHash",
                if ports.on {
                    ", both request lists from the Fe ports"
                } else {
                    ""
                },
            )
        } else {
            unproven += 1
            if ran == 2 && deposits_ok && header.has("requestsHash") {
                println!(
                    "REQUESTS fevm's requests hash to 0x",
                    core::text::hex(hash, 32),
                    ", the header's requestsHash is 0x",
                    core::text::hex(field(header, "requestsHash"), 32),
                )
            } else {
                println!(
                    "REQUESTS not checked: a system call did not run, or a deposit log is malformed",
                )
            }
        }
    }
    if proving {
        keys = proof::touched(
            prestates["result"],
            diffs["result"],
            header,
            recipients: true,
        )
        if first_calls {
            proof::add_system_keys(mut keys, header)
        }
        var skip: core::MemVec<u256> = core::MemVec::new()
        if system_calls {
            proof::add_request_keys(mut keys)
        } else {
            skip.push(proof::WITHDRAWAL_REQUESTS)
            skip.push(proof::CONSOLIDATION_REQUESTS)
        }
        var text = MemBuffer::empty()
        let post = with (mut text) {
            proof::check(
                world,
                state_root: field(header, "stateRoot"),
                proofs["post"],
                keys,
                written: core::MemVec::new(),
                skip,
                code_unknown,
            )
        }
        print!(text)
        print_checked("end state", "the block's", post)
        unproven += post.differ + post.broken + post.unproven
        // Stateless: the end-state root itself, computed from the parent's
        // witness and fevm's end state, against the header.
        if first_calls && system_calls {
            let computed = stateless::state_root(world, parent_root, proofs, keys, code_unknown)
            stateless_ok = computed.root == field(header, "stateRoot")
            if stateless_ok {
                println!(
                    "state root: fevm's end state (",
                    computed.accounts,
                    " accounts and ",
                    computed.slots,
                    " slots written) on the parent's witness (",
                    computed.witness_nodes,
                    " nodes, ",
                    computed.witness_bytes / 1024,
                    " KiB) hashes to the header's stateRoot",
                )
            } else {
                unproven += 1
                println!(
                    "STATE ROOT fevm's end state hashes to 0x",
                    core::text::hex(computed.root, 32),
                    ", the header's stateRoot is 0x",
                    core::text::hex(field(header, "stateRoot"), 32),
                )
                if computed.stage > 0 {
                    println!(
                        "  a node is missing at 0x",
                        core::text::hex(computed.stuck, 20),
                        " (stage ",
                        computed.stage,
                        ")",
                    )
                }
            }
            // The code that ran, from the second run through fevm's block
            // layer: whole for the Merkle-Patricia witness, by the 31-byte
            // chunks run for EIP-7864's.
            var code_run = fevm::WorldState::empty()
            var contracts: u64 = 0
            var code_bytes: u64 = 0
            var chunk_count: u64 = 0
            var tx_gas: core::MemVec<u64> = core::MemVec::new()
            var charges: core::MemVec<ingot::gas4762::Charged> = core::MemVec::new()
            if let Option::Some(pre) = cross_pre {
                let checked = ingot::crosscheck::run(
                    pre,
                    header,
                    proofs["parent"],
                    proofs,
                    parent_root,
                    keys,
                    code_unknown,
                    chain_id: field(chain, "result"),
                    prestates["result"],
                    diffs["result"],
                )
                if !checked.agreed {
                    unproven += 1
                }
                contracts = checked.contracts
                code_bytes = checked.code_bytes
                chunk_count = checked.chunks
                code_run = checked.code
                tx_gas = checked.tx_gas
                charges = checked.charges
            }
            let (heaviest, storage_bytes) = stateless::heaviest_storage(proofs["pre"], count: 5)
            println!(
                "witness: ",
                storage_bytes / 1024,
                " KiB of it in storage proofs; heaviest storage:",
            )
            var heavy_json = MemBuffer::empty()
            for h in 0 .. heaviest.len() {
                let w = heaviest[h]
                // The same account and slots alone in a binary tree, for
                // its own path from the root, as its account proof is.
                var alone = fevm::WorldState::empty()
                let _ = alone.ensure_account(w.address)
                let slots = proof::slots_of(keys, w.address)
                for s in 0 .. slots.len() {
                    let _ = alone.storage_store(w.address, slots[s], 1)
                }
                let solo = binary::estimate(alone, fevm::WorldState::empty())
                let per_slot = w.nodes * 10 / w.slots
                println!(
                    "  storage witness 0x",
                    core::text::hex(w.address, 20),
                    ": ",
                    w.bytes / 1024,
                    " KiB, ",
                    w.slots,
                    " slots, ",
                    per_slot / 10,
                    ".",
                    per_slot % 10,
                    " nodes a slot; with its account proof ",
                    (w.bytes + w.account_bytes) / 1024,
                    " KiB, binary tree ",
                    solo.low_bytes / 1024,
                    " to ",
                    solo.high_bytes / 1024,
                    " KiB",
                )
                if h > 0 {
                    ",".fmt(mut heavy_json)
                }
                "{\"address\":\"0x".fmt(mut heavy_json)
                core::text::hex(w.address, 20).fmt(mut heavy_json)
                "\",\"storage_bytes\":".fmt(mut heavy_json)
                core::text::decimal(w.bytes as u256).fmt(mut heavy_json)
                ",\"account_bytes\":".fmt(mut heavy_json)
                core::text::decimal(w.account_bytes as u256).fmt(mut heavy_json)
                ",\"slots\":".fmt(mut heavy_json)
                core::text::decimal(w.slots as u256).fmt(mut heavy_json)
                ",\"proof_nodes\":".fmt(mut heavy_json)
                core::text::decimal(w.nodes as u256).fmt(mut heavy_json)
                ",\"binary_low\":".fmt(mut heavy_json)
                core::text::decimal(solo.low_bytes as u256).fmt(mut heavy_json)
                ",\"binary_high\":".fmt(mut heavy_json)
                core::text::decimal(solo.high_bytes as u256).fmt(mut heavy_json)
                "}".fmt(mut heavy_json)
            }
            let bin = binary::estimate(keys, fevm::WorldState::empty())
            let bin_code = binary::estimate(keys, code_run)
            // Each transaction's share, as if alone in a block, by kind:
            // ETH transfer, contract call, contract creation, blob, set code.
            var kind_count: [u64; 5] = [0; 5]
            var kind_bytes: [u64; 5] = [0; 5]
            var kind_max: [u64; 5] = [0; 5]
            var alone_sum: u64 = 0
            // EIP-4762's witness charges, EIP-2929's cold charges for the
            // same accesses and the gas used, by kind.
            let charged = tx_gas.len() == count && charges.len() == count
            var kind_witness: [u64; 5] = [0; 5]
            var kind_today: [u64; 5] = [0; 5]
            var kind_gas: [u64; 5] = [0; 5]
            var code_charges: u64 = 0
            var write_charges: u64 = 0
            var coinbase_charges: u64 = 0
            // Transactions whose gas limit, as sent, would not cover the
            // gas they used plus the witness charges less today's: with the
            // coinbase charged, and with it exempt.
            var short_of_gas: u64 = 0
            var short_exempt: u64 = 0
            // The same by kind, and the transactions sent with a gas limit
            // of exactly the gas they used (no margin at all).
            var short_kind: [u64; 5] = [0; 5]
            var short_exempt_kind: [u64; 5] = [0; 5]
            var exact_kind: [u64; 5] = [0; 5]
            // What-ifs, with the coinbase exempt: code chunks at half price,
            // and free.
            var short_code_half: u64 = 0
            // The contracts that contract calls short of gas even with the
            // coinbase exempt were sent to.
            var short_targets = MemBuffer::empty()
            var short_code_free: u64 = 0
            for t in 0 .. count {
                let tx = ref txs[t]
                let kind: usize = if field(tx, "type") == 3 {
                    3
                } else if field(tx, "type") == 4 {
                    4
                } else if !tx.has("to") || tx["to"].is_null() {
                    2
                } else if tx["input"].text().len() <= 2 { 0 } else { 1 }
                let b = stateless::tx_witness(
                    proofs["pre"],
                    prestates["result"][t]["result"],
                    diffs["result"][t]["result"]["post"],
                )
                kind_count[kind] = kind_count[kind] + 1
                kind_bytes[kind] = kind_bytes[kind] + b
                if b > kind_max[kind] {
                    kind_max[kind] = b
                }
                alone_sum += b
                if charged {
                    kind_witness[kind] = kind_witness[kind] + charges[t].witness
                    kind_today[kind] = kind_today[kind] + charges[t].today
                    kind_gas[kind] = kind_gas[kind] + tx_gas[t]
                    code_charges += charges[t].code
                    write_charges += charges[t].writes
                    coinbase_charges += charges[t].coinbase
                    let limit = field(tx, "gas")
                    let used = tx_gas[t] as u256 + charges[t].witness as u256
                    if used > limit + charges[t].today as u256 {
                        short_of_gas += 1
                        short_kind[kind] = short_kind[kind] + 1
                    }
                    if used - charges[t].coinbase as u256 > limit + charges[t].today as u256 {
                        short_exempt += 1
                        short_exempt_kind[kind] = short_exempt_kind[kind] + 1
                        if kind == 1 {
                            if short_targets.len() > 0 {
                                ",".fmt(mut short_targets)
                            }
                            "\"0x".fmt(mut short_targets)
                            core::text::hex(field(tx, "to"), 20).fmt(mut short_targets)
                            "\"".fmt(mut short_targets)
                        }
                    }
                    if limit == tx_gas[t] as u256 {
                        exact_kind[kind] = exact_kind[kind] + 1
                    }
                    let exempt = used - charges[t].coinbase as u256
                    if exempt - (charges[t].code / 2) as u256 > limit + charges[t].today as u256 {
                        short_code_half += 1
                    }
                    if exempt - charges[t].code as u256 > limit + charges[t].today as u256 {
                        short_code_free += 1
                    }
                }
            }
            if charged {
                var w_sum: u64 = 0
                var c_sum: u64 = 0
                for k in 0 .. 5 {
                    w_sum += kind_witness[k]
                    c_sum += kind_today[k]
                }
                println!(
                    "EIP-4762: witness charges for the block's accesses come to ",
                    w_sum,
                    " gas (",
                    code_charges,
                    " for code chunks, ",
                    write_charges,
                    " for writes), where today's charges for the same accesses and writes come to ",
                    c_sum,
                    "; the block used ",
                    field(header, "gasUsed"),
                )
                json_num(mut stateless_summary, "gas4762_code", code_charges)
                json_num(mut stateless_summary, "gas4762_writes", write_charges)
                json_num(
                    mut stateless_summary,
                    "gas4762_coinbase",
                    coinbase_charges,
                )
                json_num(mut stateless_summary, "gas4762_short", short_of_gas)
                json_num(
                    mut stateless_summary,
                    "gas4762_short_exempt",
                    short_exempt,
                )
                json_num(
                    mut stateless_summary,
                    "gas_limit",
                    field(header, "gasLimit").downcast_unchecked(),
                )
                json_num(
                    mut stateless_summary,
                    "gas4762_short_code_half",
                    short_code_half,
                )
                json_num(
                    mut stateless_summary,
                    "gas4762_short_code_free",
                    short_code_free,
                )
                ",\"gas4762_short_targets\":[".fmt(mut stateless_summary)
                short_targets.span().fmt(mut stateless_summary)
                "]".fmt(mut stateless_summary)
                // Per kind: short of gas, short with the coinbase exempt,
                // sent with no margin.
                ",\"gas4762_short_by_kind\":[".fmt(mut stateless_summary)
                for k in 0 .. 5 {
                    if k > 0 {
                        ",".fmt(mut stateless_summary)
                    }
                    "[".fmt(mut stateless_summary)
                    core::text::decimal(short_kind[k] as u256).fmt(mut stateless_summary)
                    ",".fmt(mut stateless_summary)
                    core::text::decimal(short_exempt_kind[k] as u256).fmt(mut stateless_summary)
                    ",".fmt(mut stateless_summary)
                    core::text::decimal(exact_kind[k] as u256).fmt(mut stateless_summary)
                    "]".fmt(mut stateless_summary)
                }
                "]".fmt(mut stateless_summary)
                ",\"gas4762\":[".fmt(mut stateless_summary)
                for k in 0 .. 5 {
                    if k > 0 {
                        ",".fmt(mut stateless_summary)
                    }
                    "[".fmt(mut stateless_summary)
                    core::text::decimal(kind_witness[k] as u256).fmt(mut stateless_summary)
                    ",".fmt(mut stateless_summary)
                    core::text::decimal(kind_today[k] as u256).fmt(mut stateless_summary)
                    ",".fmt(mut stateless_summary)
                    core::text::decimal(kind_gas[k] as u256).fmt(mut stateless_summary)
                    "]".fmt(mut stateless_summary)
                }
                "]".fmt(mut stateless_summary)
            }
            println!(
                "witness per transaction alone: ",
                kind_count[0],
                " transfers, ",
                kind_count[1],
                " calls, ",
                kind_count[2],
                " creations, ",
                kind_count[3],
                " blob, ",
                kind_count[4],
                " set code; alone they would need ",
                alone_sum / 1024,
                " KiB, which the block shares in ",
                computed.witness_bytes / 1024,
                " KiB",
            )
            json_num(
                mut stateless_summary,
                "blob_gas_used",
                field(header, "blobGasUsed").downcast_unchecked(),
            )
            json_num(mut stateless_summary, "tx_witness_sum", alone_sum)
            // EIP-7928's block access list, and the block's dependency depth.
            let bal = ingot::bal::measure(
                prestates["result"],
                diffs["result"],
                header,
                coinbase: field(header, "miner"),
            )
            println!(
                "block access list (EIP-7928): ",
                bal.bytes,
                " bytes for ",
                bal.accounts,
                " accounts, ",
                bal.writes,
                " storage writes, ",
                bal.reads,
                " slots only read, ",
                bal.account_changes,
                " balance, nonce and code changes; the longest chain of dependent transactions is ",
                bal.depth,
                " of ",
                count,
                ", and ",
                bal.free,
                " depend on no earlier one",
            )
            json_num(mut stateless_summary, "bal_bytes", bal.bytes)
            json_num(mut stateless_summary, "bal_accounts", bal.accounts)
            json_num(mut stateless_summary, "bal_writes", bal.writes)
            json_num(mut stateless_summary, "bal_reads", bal.reads)
            json_num(mut stateless_summary, "bal_changes", bal.account_changes)
            json_num(mut stateless_summary, "bal_depth", bal.depth)
            json_num(mut stateless_summary, "bal_free", bal.free)
            ",\"by_kind\":[".fmt(mut stateless_summary)
            for k in 0 .. 5 {
                if k > 0 {
                    ",".fmt(mut stateless_summary)
                }
                "[".fmt(mut stateless_summary)
                core::text::decimal(kind_count[k] as u256).fmt(mut stateless_summary)
                ",".fmt(mut stateless_summary)
                core::text::decimal(kind_bytes[k] as u256).fmt(mut stateless_summary)
                ",".fmt(mut stateless_summary)
                core::text::decimal(kind_max[k] as u256).fmt(mut stateless_summary)
                "]".fmt(mut stateless_summary)
            }
            "]".fmt(mut stateless_summary)
            json_num(
                mut stateless_summary,
                "witness_nodes",
                computed.witness_nodes,
            )
            json_num(
                mut stateless_summary,
                "witness_bytes",
                computed.witness_bytes,
            )
            json_num(
                mut stateless_summary,
                "block_proof_nodes",
                computed.hinted,
            )
            json_num(
                mut stateless_summary,
                "block_proof_bytes",
                computed.hinted_bytes,
            )
            json_num(
                mut stateless_summary,
                "assumed_branches",
                computed.assumed,
            )
            json_num(mut stateless_summary, "storage_bytes", storage_bytes)
            json_num(mut stateless_summary, "binary_stems", bin.stems)
            json_num(mut stateless_summary, "binary_values", bin.values)
            json_num(mut stateless_summary, "binary_low", bin.low_bytes)
            json_num(mut stateless_summary, "binary_high", bin.high_bytes)
            ",\"heaviest\":[".fmt(mut stateless_summary)
            heavy_json.span().fmt(mut stateless_summary)
            "]".fmt(mut stateless_summary)
            println!(
                "binary tree (EIP-7864), estimated for the same keys: ",
                bin.stems,
                " stems, ",
                bin.values,
                " values, ",
                bin.low_bytes / 1024,
                " to ",
                bin.high_bytes / 1024,
                " KiB at ",
                bin.low_depth,
                " to ",
                bin.high_depth,
                " levels above the stems (Merkle-Patricia: ",
                (computed.witness_bytes + computed.hinted_bytes) / 1024,
                " KiB)",
            )
            if contracts > 0 {
                println!(
                    "code: ",
                    contracts,
                    " contracts ran, ",
                    code_bytes / 1024,
                    " KiB of code, which a Merkle-Patricia witness carries whole; they ran ",
                    chunk_count,
                    " chunks of 31 bytes, which EIP-7864 carries alone; with code, Merkle-Patricia ",
                    (computed.witness_bytes + computed.hinted_bytes + code_bytes) / 1024,
                    " KiB, binary tree ",
                    bin_code.low_bytes / 1024,
                    " to ",
                    bin_code.high_bytes / 1024,
                    " KiB",
                )
            }
            json_num(mut stateless_summary, "code_contracts", contracts)
            json_num(mut stateless_summary, "code_bytes", code_bytes)
            json_num(mut stateless_summary, "code_chunks", chunk_count)
            json_num(
                mut stateless_summary,
                "binary_code_low",
                bin_code.low_bytes,
            )
            json_num(
                mut stateless_summary,
                "binary_code_high",
                bin_code.high_bytes,
            )
            if computed.hinted > 0 {
                // eth_getProof names keys, and these are keys no
                // transaction touched: their nodes come from the block's
                // proofs, each found by a hash a parent's node names.
                println!(
                    "  plus ",
                    computed.hinted,
                    " nodes the parent's proofs lack (",
                    computed.hinted_bytes / 1024,
                    " KiB), siblings a deletion moved up, taken from the block's proofs by the hashes the parent's nodes name",
                )
            }
            if computed.assumed > 0 {
                println!(
                    "  siblings found nowhere, taken to be branches: ",
                    computed.assumed,
                )
            }
        }
        if paid > 0 {
            println!(
                "withdrawals: ",
                paid,
                " credited, their recipients checked by the end state's proofs",
            )
        }
    }
    var right: u64 = 0
    var checked: u64 = 0
    if rpc && paid > 0 {
        let withdrawals = header["withdrawals"].items()
        for w in 0 .. withdrawals.len() {
            let address = field(withdrawals[w], "address")
            // A recipient paid twice is checked once, after both.
            var seen = false
            for v in 0 .. w {
                if field(withdrawals[v], "address") == address {
                    seen = true
                }
            }
            if seen { continue }
            checked += 1
            match fetch::balance_at(args.get(3), address, number: env.number) {
                Option::Some(balance) => {
                    if balance == world.balance(address) {
                        right += 1
                    } else {
                        println!(
                            "DIFF  withdrawal to 0x",
                            core::text::hex(address, 20),
                            ": node ",
                            balance,
                            ", fevm ",
                            world.balance(address),
                        )
                    }
                },
                Option::None => {
                    println!("ERROR no balance for 0x", core::text::hex(address, 20))
                },
            }
        }
        println!(
            "withdrawals: ",
            paid,
            " to ",
            checked,
            " recipients, ",
            right,
            " balances match the node at the end of the block",
        )
    } else if !proving && paid > 0 {
        println!(
            "withdrawals: ",
            paid,
            " credited; pass an RPC URL or fetch proofs to check the recipients' balances",
        )
    }
    let clean = matched == count.downcast_unchecked()
        && right == checked
        && unknown == 0
        && unproven == 0
    // The run in short, for `follow` and the stateless page.
    var summary = MemBuffer::empty()
    "{\"number\":".fmt(mut summary)
    core::text::decimal(env.number).fmt(mut summary)
    ",\"hash\":\"0x".fmt(mut summary)
    core::text::hex(field(header, "hash"), 32).fmt(mut summary)
    "\",\"matched\":".fmt(mut summary)
    core::text::decimal(matched as u256).fmt(mut summary)
    ",\"transactions\":".fmt(mut summary)
    core::text::decimal(count as u256).fmt(mut summary)
    ",\"gas_used\":".fmt(mut summary)
    core::text::decimal(cumulative_gas).fmt(mut summary)
    if clean && stateless_ok {
        ",\"every_root\":true".fmt(mut summary)
    } else {
        ",\"every_root\":false".fmt(mut summary)
    }
    stateless_summary.span().fmt(mut summary)
    "}".fmt(mut summary)
    let _ = fs.write(fetch::join(dir, "summary.json"), summary.span())
    if clean { 0 } else { 1 }
}

// The header's transactionsRoot (each transaction re-encoded, and hashing
// to its own hash), withdrawalsRoot, gasUsed (fevm's cumulative gas),
// blobGasUsed and logsBloom (fevm's logs). Returns how many do not match.
fn header_commitments(_ header: Value, gas_used: u256, bloom: [u8; 256]) -> u64
uses (out: mut Stdout)
{
    var wrong: u64 = 0
    let txs = header["transactions"].items()
    let (encoded, misencoded) = roots::transactions(header["transactions"])
    let tx_root = receipts::trie_root(encoded)
    if misencoded == 0 && tx_root == field(header, "transactionsRoot") {
        println!(
            "transactions: ",
            txs.len(),
            " re-encoded, each hashes to its hash, and they hash to the header's transactionsRoot",
        )
    } else {
        wrong += 1
        println!(
            "TRANSACTIONS ",
            misencoded,
            " do not hash to their hash; the trie hashes to 0x",
            core::text::hex(tx_root, 32),
            ", the header's transactionsRoot is 0x",
            core::text::hex(field(header, "transactionsRoot"), 32),
        )
    }
    let withdrawals = roots::withdrawals(header)
    let w_root = receipts::trie_root(withdrawals)
    if w_root == field(header, "withdrawalsRoot") {
        println!(
            "withdrawals: ",
            withdrawals.len(),
            " hash to the header's withdrawalsRoot",
        )
    } else {
        wrong += 1
        println!(
            "WITHDRAWALS hash to 0x",
            core::text::hex(w_root, 32),
            ", the header's withdrawalsRoot is 0x",
            core::text::hex(field(header, "withdrawalsRoot"), 32),
        )
    }
    var blob_gas: u256 = 0
    for ref tx in txs {
        if tx.has("blobVersionedHashes") {
            blob_gas += 131072 * tx["blobVersionedHashes"].items().len() as u256
        }
    }
    let bloom_bytes = load::hex_bytes(header["logsBloom"].text())
    var same_bloom = bloom_bytes.len() == 256
    for i in 0 .. bloom_bytes.len() {
        if same_bloom && bloom_bytes.span()[i] != bloom[i] {
            same_bloom = false
        }
    }
    if gas_used == field(header, "gasUsed")
        && blob_gas == field(header, "blobGasUsed")
        && same_bloom {
        println!(
            "header: fevm's gas (",
            gas_used,
            "), the blob gas and fevm's logs bloom are the header's gasUsed, blobGasUsed and logsBloom",
        )
    } else {
        wrong += 1
        println!(
            "HEADER gasUsed: fevm ",
            gas_used,
            ", header ",
            field(header, "gasUsed"),
            "; blobGasUsed: ",
            blob_gas,
            ", header ",
            field(header, "blobGasUsed"),
            "; logsBloom ",
            if same_bloom { "matches" } else { "differs" },
        )
    }
    wrong
}

// `,"name":value` into a JSON object being written.
fn json_num(_ out: mut MemBuffer, _ name: String<24>, _ value: u64) {
    ",\"".fmt(mut out)
    name.fmt(mut out)
    "\":".fmt(mut out)
    core::text::decimal(value as u256).fmt(mut out)
}

// Whether `dir/name` exists (and reads).
#[cfg(target_family = "unix")]
fn has_file<D: Display>(_ dir: D, _ name: String<16>) -> bool
uses (fs: std::fs::Fs)
{
    match fs.read(fetch::join(dir, name)) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

fn print_checked(_ what: String<10>, _ whose: String<12>, _ found: proof::Checked)
uses (out: mut Stdout)
{
    println!(
        what,
        ": ",
        found.accounts,
        " accounts and ",
        found.slots,
        " slots proven against ",
        whose,
        " state root, ",
        found.differ,
        " differ",
    )
    if found.written > 0 {
        println!(
            "  ",
            found.written,
            " slots set by the block's first system calls, checked",
        )
    }
    if found.skipped > 0 {
        println!(
            "  ",
            found.skipped,
            " request contracts (EIP-7002, EIP-7251) not compared",
        )
    }
    if found.unproven > 0 || found.broken > 0 {
        println!(
            "  ",
            found.unproven,
            " touched accounts and slots without a proof, ",
            found.broken,
            " proofs that do not hold",
        )
    }
}

/// `certify <out.html> <deployed.hex> <port-dir> <Contract> <token.hex|-> <mutants> <dir>...`:
/// everything the tool knows to check about a port, in one HTML page. It
/// builds the port from source with `fe`, replays the saved blocks with it
/// in place of every copy of the deployed code, mutates their transactions
/// (`fuzz-block`), fuzzes it with random calls (`fuzz` or `fuzz-pair`), and
/// scores the checks themselves by planting `mutants` mutants in the port
/// (checked on the first ten blocks). Exits 1 if anything differs.
#[cfg(target_family = "unix")]
fn certify_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 9 {
        println!(
            "usage: fevm-replay certify <out.html> <deployed.hex> <port-dir> <Contract> <token.hex|-> <mutants> <dir>...",
        )
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(3)) else {
        return 1
    }
    let token = if starts_with_proxy(args.get(6)) {
        let Option::Some(code) = read_proxy_token(args.get(6)) else {
            return 1
        }
        code
    } else if is_word(args.get(6), [0x75, 0x73, 0x64, 0x74]) {
        // `usdt`: the USDT scenario (see `fuzz::is_usdt`).
        var marker = MemBuffer::empty()
        marker.push(0x55)
        marker
    } else if is_word(args.get(6), [0x64, 0x61, 0x69]) {
        // `dai`: the DAI scenario (see `fuzz::is_dai`).
        var marker = MemBuffer::empty()
        marker.push(0x44)
        marker
    } else if args.get(6).span().len() == 1 {
        MemBuffer::empty()
    } else {
        let Option::Some(code) = read_shadow(args.get(6)) else {
            return 1
        }
        code
    }
    let wanted: u64 = core::text::parse_uint(args.get(7).span())
        .unwrap_or(default: 20)
        .downcast_unchecked()
    let first_dir: usize = 8
    let last_dir = args.count()
    // The port, built from its source.
    var built = MemBuffer::empty()
    "/tmp/fevm-replay-certify-".fmt(mut built)
    args.get(5).fmt(mut built)
    println!("building ", args.get(4), " in ", args.get(5))
    // The port's source, to point each function's row at its lines.
    let port_source = match fs.read(fetch::join(args.get(4), "src/lib.fe")) {
        Result::Ok(bytes) => bytes,
        Result::Err(_) => MemBuffer::empty(),
    }
    if !fe_build(args.get(4), built) {
        println!("ERROR ", args.get(4), ": does not build with fe")
        return 1
    }
    var binary = MemBuffer::empty()
    built.fmt(mut binary)
    "/".fmt(mut binary)
    args.get(5).fmt(mut binary)
    ".runtime.bin".fmt(mut binary)
    let Result::Ok(hex) = fs.read(binary) else {
        println!("ERROR ", binary, ": cannot read")
        return 1
    }
    let port = hex_bytes(hex.span())
    // Mainnet, as it happened, with the port in place.
    println!("replaying ", last_dir - first_dir, " blocks")
    var totals = Totals::new()
    for d in first_dir .. last_dir {
        add_shadow_block(args.get(d), port.span(), deployed.span(), mut totals)
    }
    // Mainnet, mutated.
    println!("mutating their transactions")
    var found = mutate::Mutations::new()
    var first_block = MemBuffer::empty()
    var first_hash = MemBuffer::empty()
    for d in first_dir .. last_dir {
        mutate_dir(
            args.get(d),
            deployed: deployed.span(),
            port: port.span(),
            count: 20,
            seed: 7,
            mut found,
            mut first_block,
            mut first_hash,
            fetch: MemBuffer::empty(),
        )
    }
    // Random calls.
    println!("fuzzing")
    var fuzzed = fuzz::Findings::new()
    fuzz::fuzz(
        deployed.span(),
        port.span(),
        token: token.span(),
        runs: 1000,
        steps: 60,
        seed: 1,
        mut fuzzed,
    )
    // The checks, checked.
    println!("planting ", wanted, " mutants")
    let score = score_mutants(
        args.get(4),
        args.get(5),
        deployed: deployed.span(),
        token: token.span(),
        wanted,
        first_dir,
        last_dir: if last_dir - first_dir > 10 {
            first_dir + 10
        } else {
            last_dir
        },
        each: false,
    )
    let fuzz_differ = fuzzed.calls[0] - fuzzed.identical[0]
    let clean = totals.failures() + found.failures() + fuzzed.failures() + score.failures() == 0
    var html = MemBuffer::empty()
    with (mut html) {
        certify::open(args.get(5))
        "<p>Port source <code>".fmt(mut html)
        args.get(4).fmt(mut html)
        "</code>, runtime code hash <code>0x".fmt(mut html)
        core::text::hex(fuzz::keccak(MemBuffer::from_span(port.span())), 32).fmt(mut html)
        "</code> (".fmt(mut html)
        port.len().fmt(mut html)
        " bytes), in place of the deployed code with hash <code>0x".fmt(mut html)
        core::text::hex(fuzz::keccak(MemBuffer::from_span(deployed.span())), 32).fmt(mut html)
        "</code> (".fmt(mut html)
        deployed.len().fmt(mut html)
        " bytes). Blocks <code>".fmt(mut html)
        args.get(first_dir).fmt(mut html)
        "</code> to <code>".fmt(mut html)
        args.get(last_dir - 1).fmt(mut html)
        "</code>.</p>\n".fmt(mut html)
        if clean {
            "<p class=\"verdict\">No behavior difference: every transaction that ran the port, every mutation of them and every random call behaved as on the deployed code.</p>\n"
                .fmt(mut html)
        } else {
            "<p class=\"verdict bad\">Differences found: see below.</p>\n".fmt(mut html)
        }
        "<table>\n".fmt(mut html)
        certify::summary(totals)
        certify::summary(found)
        certify::summary(fuzzed)
        certify::summary(score)
        "</table>\n".fmt(mut html)

        "<h2>Mainnet, as it happened</h2>\n<p>Each transaction of the blocks ran on its own mainnet pre-state, with the port in place of every account holding the deployed code, and was compared with the chain: status, logs, every balance, nonce and storage slot. Only gas may differ.</p>\n<table>\n"
            .fmt(mut html)
        certify::row("Blocks", totals.blocks)
        certify::row("Transactions", totals.transactions)
        certify::row("Transactions that ran the port", totals.shadowed)
        certify::row(
            "Identical to the chain",
            totals.shadowed -
                totals.gas_sensitive -
                totals.code_sensitive -
                totals.cheaper -
                totals.behavior,
        )
        certify::row(
            "Differ where other code read the gas left",
            totals.gas_sensitive,
        )
        certify::row(
            "&nbsp;&nbsp;of which part at or under that code",
            totals.gas_explained,
        )
        certify::row(
            "Differ where other code read code hashes",
            totals.code_sensitive,
        )
        certify::row("Only the deployed code ran out of gas", totals.cheaper)
        certify::row("<strong>Behave differently</strong>", totals.behavior)
        "</table>\n".fmt(mut html)
        certificate_gas(
            totals.deployed_profile,
            totals.shadow_profile,
            port_source.span(),
        )

        "<h2>Mainnet, mutated</h2>\n<p>Each transaction that touched the deployed code ran again with its calldata changed, or with one call into the contract changed in flight, on both codes, gas free.</p>\n<table>\n"
            .fmt(mut html)
        certify::row("Transactions", found.transactions)
        certify::row("Runs", found.runs)
        certify::row("Identical", found.identical)
        certify::row(
            "Differ where other code read the gas left or code hashes",
            found.sensitive,
        )
        certify::row("&nbsp;&nbsp;of which code hashes", found.code_sensitive)
        certify::row(
            "&nbsp;&nbsp;of the rest, part at or under the code that read the gas left",
            found.gas_explained,
        )
        certify::row("Only the deployed code ran out of gas", found.cheaper)
        certify::row(
            "Differ after an address-shaped word got upper bits",
            found.dirtied,
        )
        certify::row("Differ after the calldata was cut short", found.shortened)
        certify::row("<strong>Differ</strong>", found.differ)
        "</table>\n<p>The port ran ".fmt(mut html)
        let ran = watch::coverage_count(found.covered)
        let total: u64 = watch::instructions(port.span()).downcast_unchecked()
        ran.fmt(mut html)
        " of its ".fmt(mut html)
        total.fmt(mut html)
        " instructions (".fmt(mut html)
        certify::percent(ran, total)
        ") in these runs.</p>\n".fmt(mut html)

        "<h2>Random calls</h2>\n<p>1,000 sessions of up to 60 random calls each, against both codes in step"
            .fmt(mut html)
        // Only the pair scenario has invariants (a one-byte marker names a
        // token scenario; the proxy's starts with `P`).
        if token.len() > 1 && !fuzz::is_proxy(token.span()) {
            ", checking the pair's invariants after every call".fmt(mut html)
        }
        ".</p>\n<table>\n".fmt(mut html)
        certify::row("Well-formed calls", fuzzed.calls[0])
        certify::row(
            "<strong>Well-formed calls that differ</strong>",
            fuzz_differ,
        )
        certify::row(
            "Calls with short calldata that differ",
            fuzzed.calls[1] - fuzzed.identical[1],
        )
        certify::row(
            "Calls with dirty addresses that differ",
            fuzzed.calls[2] - fuzzed.identical[2],
        )
        certify::row("Invariants broken", fuzzed.invariant_breaks)
        "</table>\n<p>The port ran ".fmt(mut html)
        let ran2 = watch::coverage_count(fuzzed.covered)
        ran2.fmt(mut html)
        " of its ".fmt(mut html)
        total.fmt(mut html)
        " instructions (".fmt(mut html)
        certify::percent(ran2, total)
        ").</p>\n".fmt(mut html)

        "<h2>How sharp the checks are</h2>\n<p>Mutants of the port's source, one operator changed each, built with <code>fe</code> and put through random calls and then mutations of the first ten blocks. The unchanged port passed the same checks first.</p>\n<table>\n"
            .fmt(mut html)
        certify::row("Operators in the source", score.sites)
        certify::row("Mutants built", score.built)
        certify::row("Killed by random calls", score.by_fuzz)
        certify::row("Killed by mainnet mutations", score.by_mainnet)
        certify::row("Survived", score.survived)
        "</table>\n<p>".fmt(mut html)
        certify::percent(score.by_fuzz + score.by_mainnet, score.built)
        " killed.".fmt(mut html)
        if score.survived > 0 {
            " A survivor is a blind spot of the checks or a change that means the same; each deserves a look:</p>\n<pre>"
                .fmt(mut html)
            certify::escape(score.survivors.span())
            "</pre>\n".fmt(mut html)
        } else {
            "</p>\n".fmt(mut html)
        }
        certify::close()
    }
    let Result::Ok(_) = fs.write(args.get(2), html.span()) else {
        println!("ERROR ", args.get(2), ": cannot write")
        return 1
    }
    println!("wrote ", args.get(2))
    // The badge beside the page: the same path with `.svg` for `.html`.
    var badge_path = MemBuffer::empty()
    let out_path = args.get(2).span()
    let html: [u8; 5] = [0x2e, 0x68, 0x74, 0x6d, 0x6c]
    var keep = out_path.len()
    if keep > 5 {
        var ends = true
        for i in 0 .. 5 {
            if out_path[keep - 5 + i] != html[i] {
                ends = false
            }
        }
        if ends { keep -= 5 }
    }
    for i in 0 .. keep {
        badge_path.push(out_path[i])
    }
    ".svg".fmt(mut badge_path)
    var svg = MemBuffer::empty()
    with (mut svg) {
        certify::badge(args.get(5), clean)
    }
    let Result::Ok(_) = fs.write(badge_path, svg.span()) else {
        println!("ERROR ", badge_path, ": cannot write")
        return 1
    }
    println!("wrote ", badge_path)
    if clean { 0 } else { 1 }
}

// Replays the block in `dir` with `port` in place of every copy of
// `deployed`, quietly, adding to `totals`.
fn add_shadow_block<D: Display>(
    _ dir: D,
    _ port: MemSpan,
    _ deployed: MemSpan,
    _ totals: mut Totals,
)
uses (fs: std::fs::Fs, out: mut Stdout)
{
    if !replay_block(
        dir,
        shadow_address: 0,
        shadow_code: port,
        shadow_like: deployed,
        mut totals,
    ) {
        println!("ERROR ", dir, ": skipped")
    }
}

// The gas table of a certificate.
fn certificate_gas(
    _ deployed: core::MemVec<SelectorGas>,
    _ shadow: core::MemVec<SelectorGas>,
    _ source: core::MemSpan,
)
uses (html: mut MemBuffer)
{
    if deployed.len() == 0 {
        return
    }
    "<h3>Gas per call in identical transactions</h3>\n<div class=\"scroll\"><table>\n<tr><th>Function</th><th>In the port's source</th><th class=\"n\">Calls</th><th class=\"n\">Deployed</th><th class=\"n\">Port</th><th class=\"n\">Change</th></tr>\n"
        .fmt(mut html)
    for i in 0 .. deployed.len() {
        let d = deployed[i]
        var s_gas = watch::Gas::of(0)
        var s_calls: u64 = 0
        for j in 0 .. shadow.len() {
            if shadow[j].selector == d.selector {
                s_gas = shadow[j].gas
                s_calls = shadow[j].calls
            }
        }
        if d.calls == 0 || s_calls == 0 {
            continue
        }
        let before = d.gas / d.calls
        let after = s_gas / s_calls
        // Fe writes no source map: the line comes from the `msg` variant
        // with this selector and the `recv` arm that runs it.
        let place = source::locate(source, d.selector)
        "<tr><td><code>".fmt(mut html)
        if place.name_len > 0 {
            source.slice(offset: place.name_at, len: place.name_len).fmt(mut html)
        } else {
            function_name(d.selector).fmt(mut html)
        }
        "</code></td><td>".fmt(mut html)
        if place.handled > 0 {
            "<code>src/lib.fe:".fmt(mut html)
            place.handled.fmt(mut html)
            "</code>".fmt(mut html)
        } else if place.declared > 0 {
            "<code>src/lib.fe:".fmt(mut html)
            place.declared.fmt(mut html)
            "</code>".fmt(mut html)
        } else {
            "&ndash;".fmt(mut html)
        }
        "</td><td class=\"n\">".fmt(mut html)
        d.calls.fmt(mut html)
        "</td><td class=\"n\">".fmt(mut html)
        before.fmt(mut html)
        "</td><td class=\"n\">".fmt(mut html)
        after.fmt(mut html)
        "</td><td class=\"n\">".fmt(mut html)
        certify::signed_change(before, after)
        "</td></tr>\n".fmt(mut html)
    }
    "</table></div>\n".fmt(mut html)
}

// What fails a port, check by check (see `certify::Check`).

impl certify::Check for Totals {
    fn name(self) -> String<31> {
        "Mainnet, as it happened"
    }
    // Behaving differently; gas and code-hash readings are explained.
    fn failures(self) -> u64 {
        self.behavior
    }
}

impl certify::Check for mutate::Mutations {
    fn name(self) -> String<31> {
        "Mainnet, mutated"
    }
    fn failures(self) -> u64 {
        self.differ
    }
}

impl certify::Check for fuzz::Findings {
    fn name(self) -> String<31> {
        "Random calls"
    }
    // Well-formed calls that differ, and broken invariants. Short calldata
    // and dirty addresses are shown, not counted: old solc read them loosely.
    fn failures(self) -> u64 {
        self.calls[0] - self.identical[0] + self.invariant_breaks
    }
}

impl certify::Check for MutantScore {
    fn name(self) -> String<31> {
        "Mutants: the unchanged port"
    }
    // Surviving mutants are blind spots, not failures; the unchanged port
    // failing its own checks is.
    fn failures(self) -> u64 {
        if self.baseline { 0 } else { 1 }
    }
}

/// What mutation testing found (see `score_mutants`).
pub struct MutantScore {
    pub sites: u64,
    pub built: u64,
    pub by_fuzz: u64,
    pub by_mainnet: u64,
    pub survived: u64,
    /// With `each`: the mutants mainnet mutations kill on their own.
    pub mainnet_alone: u64,
    /// One line per survivor: its line number and text.
    pub survivors: MemBuffer,
    /// Whether the unchanged port built and passed; if not, nothing else
    /// is meaningful.
    pub baseline: bool,
}

/// Builds the ingot at `dir` with `fe` into `out_dir`.
#[cfg(target_family = "unix")]
fn fe_build<D: Display, O: Display>(_ dir: D, _ out_dir: O) -> bool
uses (proc: mut std::process::Spawn)
{
    let command = std::process::Command::new("fe")
        .arg("build")
        .arg("-O")
        .arg("2")
        .arg("--out-dir")
        .arg(out_dir)
        .arg(dir)
        .stdout(std::process::Redirect::Capture)
        .stderr(std::process::Redirect::Capture)
    match proc.output(command) {
        Result::Ok(output) => output.status.success(),
        Result::Err(_) => false,
    }
}

/// Plants `wanted` mutants, spread over the operators in `port_dir`'s
/// `src/lib.fe` (see `mutants::sites`), builds each with `fe` as
/// `contract`, and checks it as `fuzz` or `fuzz-pair` would (a well-formed
/// call that differs, or a broken invariant, kills it), then on the blocks
/// in arguments `first_dir` onward as `fuzz-block` would. The unchanged
/// port goes first and must pass.
#[cfg(target_family = "unix")]
fn score_mutants<P: Display, C: Display>(
    _ port_dir: P,
    _ name: C,
    deployed: MemSpan,
    token: MemSpan,
    wanted: u64,
    first_dir: usize,
    last_dir: usize,
    each: bool,
) -> MutantScore
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    var score = MutantScore {
        sites: 0,
        built: 0,
        by_fuzz: 0,
        by_mainnet: 0,
        survived: 0,
        mainnet_alone: 0,
        survivors: MemBuffer::empty(),
        baseline: false,
    }
    let Result::Ok(source) = fs.read(fetch::join(port_dir, "src/lib.fe")) else {
        println!("ERROR ", port_dir, "/src/lib.fe: cannot read")
        return score
    }
    let Result::Ok(manifest) = fs.read(fetch::join(port_dir, "fe.toml")) else {
        println!("ERROR ", port_dir, "/fe.toml: cannot read")
        return score
    }
    // The mutant's ingot: the port's manifest and one mutated source.
    // One work directory per contract, so runs for different ports can
    // share a machine.
    var work = MemBuffer::empty()
    "/tmp/fevm-replay-mutant-".fmt(mut work)
    name.fmt(mut work)
    let Result::Ok(_) = fs.create_dir_all(fetch::join(work, "src")) else {
        println!("ERROR ", work, ": cannot create")
        return score
    }
    let Result::Ok(_) = fs.write(fetch::join(work, "fe.toml"), manifest.span()) else {
        return score
    }
    var binary = MemBuffer::empty()
    work.fmt(mut binary)
    "/out/".fmt(mut binary)
    name.fmt(mut binary)
    ".runtime.bin".fmt(mut binary)
    let all = mutants::sites(source.span())
    let total: u64 = all.len().downcast_unchecked()
    score.sites = total
    let count = if wanted > total { total } else { wanted }
    var n: u64 = 0
    while n <= count {
        let pick: usize = if n == 0 {
            0
        } else {
            ((n - 1) * total / count).downcast_unchecked()
        }
        let mutated = if n == 0 {
            MemBuffer::from_span(source.span())
        } else {
            mutants::apply(source.span(), all[pick])
        }
        let Result::Ok(_) = fs.write(fetch::join(work, "src/lib.fe"), mutated.span()) else {
            return score
        }
        if !fe_build(work, fetch::join(work, "out")) {
            if n == 0 {
                println!("ERROR the port itself does not build with fe")
                return score
            }
            n += 1
            continue
        }
        let Result::Ok(hex) = fs.read(binary) else {
            println!("ERROR ", binary, ": cannot read")
            return score
        }
        let port = hex_bytes(hex.span())
        var fuzzed = fuzz::Findings::new()
        fuzz::fuzz(
            deployed,
            port.span(),
            token,
            runs: 300,
            steps: 60,
            seed: 1,
            mut fuzzed,
        )
        let killed = fuzzed.identical[0] != fuzzed.calls[0] || fuzzed.invariant_breaks > 0
        var mainnet = false
        // With `each`, mainnet mutations check every mutant, not only the
        // ones random calls missed, so each check's own score shows.
        if (each || !killed) && last_dir > first_dir {
            var found = mutate::Mutations::new()
            var first_block = MemBuffer::empty()
            var first_hash = MemBuffer::empty()
            for d in first_dir .. last_dir {
                mutate_dir(
                    args.get(d),
                    deployed,
                    port: port.span(),
                    count: 20,
                    seed: 7,
                    mut found,
                    mut first_block,
                    mut first_hash,
                    fetch: MemBuffer::empty(),
                )
            }
            mainnet = found.differ > 0
        }
        if n == 0 {
            if killed || mainnet {
                println!("ERROR the unchanged port already differs; fix it first")
                return score
            }
            score.baseline = true
            n += 1
            continue
        }
        score.built += 1
        if mainnet {
            score.mainnet_alone += 1
        }
        if killed {
            score.by_fuzz += 1
        } else if mainnet {
            score.by_mainnet += 1
        } else {
            score.survived += 1
            let (line, start, end) = mutants::line_of(mutated.span(), all[pick].at)
            "line ".fmt(mut score.survivors)
            line.fmt(mut score.survivors)
            ": ".fmt(mut score.survivors)
            let text = mutated.span()
            var i = start
            // Skip the indentation.
            while i < end && text[i] == 0x20 {
                i += 1
            }
            while i < end {
                score.survivors.push(text[i])
                i += 1
            }
            "\n".fmt(mut score.survivors)
        }
        n += 1
    }
    score
}

/// `mutants <port-dir> <Contract> <deployed.hex> <token.hex|-> <count> [<dir>...]`:
/// mutation testing of the checks (see `score_mutants`): prints the
/// survivors and the share of mutants killed.
#[cfg(target_family = "unix")]
fn mutants_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 7 {
        println!(
            "usage: fevm-replay mutants <port-dir> <Contract> <deployed.hex> <token.hex|-> <count> [<dir>...]",
        )
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(4)) else {
        return 1
    }
    let token = if starts_with_proxy(args.get(5)) {
        let Option::Some(code) = read_proxy_token(args.get(5)) else {
            return 1
        }
        code
    } else if is_word(args.get(5), [0x75, 0x73, 0x64, 0x74]) {
        // `usdt`: the USDT scenario (see `fuzz::is_usdt`).
        var marker = MemBuffer::empty()
        marker.push(0x55)
        marker
    } else if is_word(args.get(5), [0x64, 0x61, 0x69]) {
        // `dai`: the DAI scenario (see `fuzz::is_dai`).
        var marker = MemBuffer::empty()
        marker.push(0x44)
        marker
    } else if args.get(5).span().len() == 1 {
        MemBuffer::empty()
    } else {
        let Option::Some(code) = read_shadow(args.get(5)) else {
            return 1
        }
        code
    }
    let wanted: u64 = core::text::parse_uint(args.get(6).span())
        .unwrap_or(default: 20)
        .downcast_unchecked()
    // `each` before the blocks: mainnet mutations check every mutant.
    let each = args.count() > 7 && is_word(args.get(7), [0x65, 0x61, 0x63, 0x68])
    let score = score_mutants(
        args.get(2),
        args.get(3),
        deployed: deployed.span(),
        token: token.span(),
        wanted,
        first_dir: if each { 8 } else { 7 },
        last_dir: args.count(),
        each,
    )
    if !score.baseline {
        return 1
    }
    println!("mutated ", args.get(2), ": ", score.sites, " operators")
    print!(score.survivors)
    print_score(score)
    0
}

fn print_score(_ score: MutantScore) uses (out: mut Stdout) {
    println!(
        "  ",
        score.built,
        " mutants built: ",
        score.by_fuzz,
        " killed by fuzzing, ",
        score.by_mainnet,
        " by mainnet mutations, ",
        score.survived,
        " survived; ",
        if score.built == 0 {
            0
        } else {
            (score.by_fuzz + score.by_mainnet) * 100 / score.built
        },
        "% killed",
    )
    if score.mainnet_alone > 0 {
        println!(
            "  mainnet mutations alone kill ",
            score.mainnet_alone,
            " of the ",
            score.built,
        )
    }
}

/// `opgas <address|deployed.hex> <port.bin> <selector> <dir>...`: the gas
/// the deployed code and the port spend on each opcode in calls to
/// `selector` (`0x022c0d9f`, say; 0 for every call), over the transactions of
/// the saved blocks that run the deployed code. Each transaction runs once
/// with each code, as in shadow replay. Calls the code makes are left out.
fn opgas_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() < 6 {
        println!(
            "usage: fevm-replay opgas <shadow-address>|<deployed.hex> <port.bin> <selector> <dir>...",
        )
        return 2
    }
    var like = MemBuffer::empty()
    let Option::Some(address) = shadow_target(args.get(2), mut like) else {
        return 1
    }
    let Option::Some(port) = read_shadow(args.get(3)) else {
        return 1
    }
    let selector: u32 = core::text::parse_hex_uint(args.get(4).span())
        .unwrap_or(default: 0)
        .downcast_truncate()
    var deployed_gas: core::MemVec<u64> = core::MemVec::new()
    var port_gas: core::MemVec<u64> = core::MemVec::new()
    for _ in 0 .. 256 {
        deployed_gas.push(0)
        port_gas.push(0)
    }
    var runs: u64 = 0
    for d in 5 .. args.count() {
        let dir = args.get(d)
        let Option::Some(chain) = load_response(dir, "chain.json") else {
            continue
        }
        let Option::Some(block) = load_response(dir, "block.json") else {
            continue
        }
        let Option::Some(prestates) = load_response(dir, "prestate.json") else {
            continue
        }
        let header = ref block["result"]
        let env = load_block(
            header,
            chain_id: field(chain, "result"),
            blobbasefee: fetch::header_blob_fee(header).as_wei(),
        )
        let extras = match load_json(dir, "delegates.json") {
            Option::Some(doc) => doc,
            Option::None => Value::object(),
        }
        let txs = header["transactions"].items()
        for index in 0 .. txs.len() {
            let entry = ref prestates["result"][index]
            if !entry.as_object().is_some() || !entry.has("result") {
                continue
            }
            let prestate = ref entry["result"]
            let targets = replay::shadow_targets(load_world(prestate), address, like.span())
            if targets.len() == 0 {
                continue
            }
            runs += 1
            for side in 0 .. 2 {
                var watch = watch::GasWatch::new(shadows: targets)
                watch.cover = replay::copy_targets(targets)
                watch.op_selector = selector
                var buffers = fevm::Buffers::new()
                let world = replay::build_world(
                    prestate,
                    env,
                    field(header, "parentHash"),
                    extras,
                    if side == 0 {
                        core::MemVec::new()
                    } else {
                        replay::copy_targets(targets)
                    },
                    port.span(),
                )
                ingot::compat::transact(
                    world,
                    load_tx(txs[index]),
                    env,
                    fevm::Config::osaka(),
                    mut buffers,
                    mut watch,
                )
                for op in 0 .. watch.op_gas.len() {
                    if side == 0 {
                        deployed_gas[op] += watch.op_gas[op]
                    } else {
                        port_gas[op] += watch.op_gas[op]
                    }
                }
            }
        }
    }
    var deployed_total: u64 = 0
    var port_total: u64 = 0
    for op in 0 .. 256 {
        deployed_total += deployed_gas[op]
        port_total += port_gas[op]
    }
    println!(
        "gas per opcode in calls to 0x",
        core::text::hex(selector as u256, 4),
        " over ",
        runs,
        " transactions: deployed ",
        deployed_total,
        ", port ",
        port_total,
    )
    println!("opcode deployed port")
    for op in 0 .. 256 {
        if deployed_gas[op] != 0 || port_gas[op] != 0 {
            let code: u8 = op.downcast_truncate()
            if code >= 0x60 && code <= 0x7f {
                print!("PUSH", code - 0x5f)
            } else if code >= 0x80 && code <= 0x8f {
                print!("DUP", code - 0x7f)
            } else if code >= 0x90 && code <= 0x9f {
                print!("SWAP", code - 0x8f)
            } else if code >= 0xa0 && code <= 0xa4 {
                print!("LOG", code - 0xa0)
            } else {
                print!(op_name(code))
            }
            println!(" ", deployed_gas[op], " ", port_gas[op])
        }
    }
    0
}

// The mnemonic of opcode `op`.
fn op_name(_ op: u8) -> String<14> {
    if op >= 0x60 && op <= 0x7f {
        return "PUSH1-32"
    }
    if op >= 0x80 && op <= 0x8f {
        return "DUP1-16"
    }
    if op >= 0x90 && op <= 0x9f {
        return "SWAP1-16"
    }
    if op >= 0xa0 && op <= 0xa4 {
        return "LOG0-4"
    }
    match op {
        0x00 => "STOP",
        0x01 => "ADD",
        0x02 => "MUL",
        0x03 => "SUB",
        0x04 => "DIV",
        0x05 => "SDIV",
        0x06 => "MOD",
        0x07 => "SMOD",
        0x08 => "ADDMOD",
        0x09 => "MULMOD",
        0x0a => "EXP",
        0x0b => "SIGNEXTEND",
        0x10 => "LT",
        0x11 => "GT",
        0x12 => "SLT",
        0x13 => "SGT",
        0x14 => "EQ",
        0x15 => "ISZERO",
        0x16 => "AND",
        0x17 => "OR",
        0x18 => "XOR",
        0x19 => "NOT",
        0x1a => "BYTE",
        0x1b => "SHL",
        0x1c => "SHR",
        0x1d => "SAR",
        0x1e => "CLZ",
        0x20 => "KECCAK256",
        0x30 => "ADDRESS",
        0x31 => "BALANCE",
        0x32 => "ORIGIN",
        0x33 => "CALLER",
        0x34 => "CALLVALUE",
        0x35 => "CALLDATALOAD",
        0x36 => "CALLDATASIZE",
        0x37 => "CALLDATACOPY",
        0x38 => "CODESIZE",
        0x39 => "CODECOPY",
        0x3a => "GASPRICE",
        0x3b => "EXTCODESIZE",
        0x3c => "EXTCODECOPY",
        0x3d => "RETURNDATASIZE",
        0x3e => "RETURNDATACOPY",
        0x3f => "EXTCODEHASH",
        0x40 => "BLOCKHASH",
        0x41 => "COINBASE",
        0x42 => "TIMESTAMP",
        0x43 => "NUMBER",
        0x44 => "PREVRANDAO",
        0x45 => "GASLIMIT",
        0x46 => "CHAINID",
        0x47 => "SELFBALANCE",
        0x48 => "BASEFEE",
        0x49 => "BLOBHASH",
        0x4a => "BLOBBASEFEE",
        0x50 => "POP",
        0x51 => "MLOAD",
        0x52 => "MSTORE",
        0x53 => "MSTORE8",
        0x54 => "SLOAD",
        0x55 => "SSTORE",
        0x56 => "JUMP",
        0x57 => "JUMPI",
        0x58 => "PC",
        0x59 => "MSIZE",
        0x5a => "GAS",
        0x5b => "JUMPDEST",
        0x5c => "TLOAD",
        0x5d => "TSTORE",
        0x5e => "MCOPY",
        0x5f => "PUSH0",
        0xf0 => "CREATE",
        0xf1 => "CALL",
        0xf2 => "CALLCODE",
        0xf3 => "RETURN",
        0xf4 => "DELEGATECALL",
        0xf5 => "CREATE2",
        0xfa => "STATICCALL",
        0xfd => "REVERT",
        0xfe => "INVALID",
        0xff => "SELFDESTRUCT",
        _ => "OTHER",
    }
}

/// `trace <dir> <index> <address|deployed.hex> <port.bin>`: both runs of one
/// saved transaction, deployed and shadowed, call by call as JSON (see
/// `replay::trace_tx`).
fn trace_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() != 6 {
        println!(
            "usage: fevm-replay trace <dir> <tx-index> <shadow-address>|<deployed.hex> <runtime.bin>",
        )
        return 2
    }
    let dir = args.get(2)
    var like = MemBuffer::empty()
    let Option::Some(address) = shadow_target(args.get(4), mut like) else {
        return 1
    }
    let Option::Some(code) = read_shadow(args.get(5)) else {
        return 1
    }
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return 1
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return 1
    }
    let header = ref block["result"]
    let index: usize = core::text::parse_uint(args.get(3).span())
        .unwrap_or(default: 0)
        .downcast_unchecked()
    let txs = header["transactions"].items()
    if index >= txs.len() {
        println!("ERROR no transaction ", index, " in ", dir)
        return 1
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let extras = match load_json(dir, "delegates.json") {
        Option::Some(doc) => doc,
        Option::None => Value::object(),
    }
    var text = MemBuffer::empty()
    with (mut text) {
        replay::trace_tx(
            env,
            parent_hash: field(header, "parentHash"),
            extras,
            txs[index],
            prestates["result"][index]["result"],
            shadow_address: address,
            shadow_code: code.span(),
            shadow_like: like.span(),
        )
    }
    print!(text)
    0
}

fn block_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() != 3 && args.count() != 5 {
        println!(
            "usage: fevm-replay block <dir> [<shadow-address>|<deployed.hex> <runtime.bin>]",
        )
        return 2
    }
    // Shadow replay: run the hex runtime code in `runtime.bin` in place of
    // the code at `shadow-address`, or of every copy of `deployed.hex`.
    var shadow_address: u256 = 0
    var shadow_code = MemBuffer::empty()
    var shadow_like = MemBuffer::empty()
    if args.count() == 5 {
        let Option::Some(address) = shadow_target(args.get(3), mut shadow_like) else {
            return 1
        }
        shadow_address = address
        let Option::Some(code) = read_shadow(args.get(4)) else {
            return 1
        }
        shadow_code = code
    }
    var totals = Totals::new()
    if !replay_block(
        args.get(2),
        shadow_address,
        shadow_code: shadow_code.span(),
        shadow_like: shadow_like.span(),
        mut totals,
    ) {
        return 1
    }
    if args.count() == 5 {
        print_totals(totals, shadowing: true)
    }
    if totals.matched == totals.transactions {
        0
    } else {
        1
    }
}

/// `range <first> <count> <dir> [<shadow-address> <runtime.bin>]`: fetches
/// (unless already saved) and replays `count` blocks from `first` (decimal
/// or `0x`), each in `dir/<number>`, then prints the totals.
#[cfg(target_family = "unix")]
fn range_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 5 || args.count() > 8 {
        println!(
            "usage: fevm-replay range <first-block> <count> <dir> [<shadow-address>|<deployed.hex> <runtime.bin>] [rpc-url]",
        )
        return 2
    }
    // An odd count of arguments after the command ends with an RPC URL.
    let rpc_given = args.count() == 6 || args.count() == 8
    let shadowing = args.count() >= 7
    let first_arg = args.get(2).span()
    let first = if first_arg.len() > 1 && first_arg[1] == 0x78 {
        core::text::parse_hex_uint(first_arg).unwrap_or(default: 0)
    } else {
        core::text::parse_uint(first_arg).unwrap_or(default: 0)
    }
    let count = core::text::parse_uint(args.get(3).span()).unwrap_or(default: 0)
    var shadow_address: u256 = 0
    var shadow_code = MemBuffer::empty()
    var shadow_like = MemBuffer::empty()
    if shadowing {
        let Option::Some(address) = shadow_target(args.get(5), mut shadow_like) else {
            return 1
        }
        shadow_address = address
        let Option::Some(code) = read_shadow(args.get(6)) else {
            return 1
        }
        shadow_code = code
    }
    var totals = Totals::new()
    var unusable: u64 = 0
    var n = first
    while n < first + count {
        let number = fetch::quantity(n)
        var dir = MemBuffer::empty()
        args.get(4).fmt(mut dir)
        "/".fmt(mut dir)
        number.span().fmt(mut dir)
        let saved = match fs.metadata(fetch::join(dir.span(), "diff.json")) {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
        if !saved {
            let Result::Ok(_) = fs.create_dir_all(dir.span()) else {
                println!("ERROR ", dir, ": cannot create")
                return 1
            }
            let fetched = if rpc_given {
                fetch::fetch_block(args.get(args.count() - 1), number.span(), dir.span())
            } else {
                fetch::fetch_block(DEFAULT_RPC, number.span(), dir.span())
            }
            if !fetched {
                println!("ERROR block ", number, ": the node did not answer")
            }
        }
        var block_totals = Totals::new()
        var usable = replay_block(
            dir.span(),
            shadow_address,
            shadow_code: shadow_code.span(),
            shadow_like: shadow_like.span(),
            mut block_totals,
        )
        // A transaction that read an older block's hash: fetch the 256
        // before this block once, and replay the block again with them.
        if usable && block_totals.old_hashes > 0 && !has_block_hashes(dir.span()) {
            println!(
                "  fetching the 256 block hashes before ",
                number,
                " and replaying it again",
            )
            let fetched = if rpc_given {
                fetch::fetch_hashes(args.get(args.count() - 1), number: n, dir.span())
            } else {
                fetch::fetch_hashes(DEFAULT_RPC, number: n, dir.span())
            }
            if fetched {
                block_totals = Totals::new()
                usable = replay_block(
                    dir.span(),
                    shadow_address,
                    shadow_code: shadow_code.span(),
                    shadow_like: shadow_like.span(),
                    mut block_totals,
                )
            } else {
                println!(
                    "ERROR block ",
                    number,
                    ": the node did not answer for older block hashes",
                )
            }
        }
        if usable {
            add_totals(mut totals, block_totals)
        } else {
            unusable += 1
        }
        n += 1
    }
    print_totals(totals, shadowing)
    if unusable > 0 {
        println!(
            "  ",
            unusable,
            " blocks could not be used; run the same command again to fetch them",
        )
    }
    if totals.matched == totals.transactions && unusable == 0 {
        0
    } else {
        1
    }
}

#[cfg(target_family = "unix")]
fn fetch_code_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 4 && args.count() != 5 {
        println!("usage: fevm-replay fetch-code <address> <file> [rpc-url]")
        return 2
    }
    var text = MemBuffer::empty()
    let fetched = if args.count() == 5 {
        fetch::fetch_code(args.get(4), args.get(2), mut text)
    } else {
        fetch::fetch_code(DEFAULT_RPC, args.get(2), mut text)
    }
    if !fetched {
        println!("ERROR ", args.get(2), ": the node did not answer")
        return 1
    }
    let Result::Ok(_) = fs.write(args.get(3), text.span()) else {
        println!("ERROR ", args.get(3), ": cannot write")
        return 1
    }
    println!("wrote ", args.get(3))
    0
}

// A decimal argument, or `default` when it is absent.
fn number_arg(_ index: usize, default: u64) -> u64 uses (args: Args) {
    if args.count() <= index {
        return default
    }
    core::text::parse_uint(args.get(index).span())
        .unwrap_or(default: default as u256)
        .downcast_truncate()
}

fn category_line(_ name: String<16>, _ found: fuzz::Findings, _ category: usize)
uses (out: mut Stdout)
{
    println!(
        "  ",
        name,
        ": ",
        found.calls[category],
        " calls, ",
        found.identical[category],
        " identical, ",
        found.calls[category] - found.identical[category],
        " differ",
    )
}

/// `fuzz <deployed.bin> <port.bin> [runs] [steps] [seed]`: random calls
/// against the deployed code and its port in two copies of one world.
/// `fuzz-pair <deployed.bin> <port.bin> <token.bin> [runs] [steps] [seed]`
/// does the same for a Uniswap V2 pair between two tokens running `token`.
#[cfg(target_family = "unix")]
fn fuzz_command(pair: bool) -> i32
uses (args: Args, fs: std::fs::Fs, out: mut Stdout)
{
    let first: usize = if pair { 5 } else { 4 }
    if args.count() < first || args.count() > first + 3 {
        if pair {
            println!(
                "usage: fevm-replay fuzz-pair <deployed.bin> <port.bin> <token.bin> [runs] [steps] [seed]",
            )
        } else {
            println!(
                "usage: fevm-replay fuzz <deployed.bin> <port.bin> [runs] [steps] [seed]",
            )
        }
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(2)) else {
        return 1
    }
    let Option::Some(port) = read_shadow(args.get(3)) else {
        return 1
    }
    var token = MemBuffer::empty()
    if pair {
        let Option::Some(code) = read_shadow(args.get(4)) else {
            return 1
        }
        // fuzz-proxy: the implementation's code behind the marker `P` (see
        // `fuzz::is_proxy`).
        if is_word(
            args.get(1),
            [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x70, 0x72, 0x6f, 0x78, 0x79],
        ) {
            token.push(0x50)
        }
        for i in 0 .. code.len() {
            token.push(code.span()[i])
        }
    } else if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x75, 0x73, 0x64, 0x74],
    ) {
        // The USDT scenario (see `fuzz::is_usdt`).
        token.push(0x55)
    } else if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x64, 0x61, 0x69],
    ) {
        // The DAI scenario (see `fuzz::is_dai`).
        token.push(0x44)
    }
    let runs = number_arg(first, default: 200)
    let steps = number_arg(first + 1, default: 40)
    let seed = number_arg(first + 2, default: 1)
    var found = fuzz::Findings::new()
    fuzz::fuzz(
        deployed.span(),
        port.span(),
        token: token.span(),
        runs,
        steps,
        seed,
        mut found,
    )
    println!(
        "fuzzed ",
        runs,
        " runs of up to ",
        steps,
        " calls from seed ",
        seed,
    )
    category_line("well-formed", found, 0)
    category_line("short calldata", found, 1)
    category_line("dirty address", found, 2)
    print_coverage(found.covered, port.span())
    if pair {
        print!("  succeeded:")
        for i in 0 .. found.succeeded.len() {
            print!(
                " ",
                function_name(found.succeeded[i].selector),
                " ",
                found.succeeded[i].calls,
            )
        }
        println!("")
    }
    if found.dirty_padding > 0 {
        println!(
            "  ",
            found.dirty_padding,
            " identical but for the padding after an Error(string) reason",
        )
    }
    if found.invariant_breaks > 0 {
        println!(
            "invariant broken ",
            found.invariant_breaks,
            " times, first: seed ",
            found.invariant_seed,
            ", call ",
            found.invariant_step,
            if found.invariant_kind == 1 {
                " (lock still held)"
            } else if found.invariant_kind == 2 {
                " (k fell in a swap)"
            } else if found.invariant_kind == 3 {
                " (supply below the minimum)"
            } else if found.invariant_kind == 4 {
                " (a token balance below its reserve)"
            } else if found.invariant_kind == 5 {
                " (a cumulative price fell)"
            } else {
                " (kLast disagrees with the fee)"
            },
        )
    }
    if found.first_step == 0 {
        println!("no differences")
        return if found.invariant_breaks > 0 { 1 } else { 0 }
    }
    println!(
        "first difference: seed ",
        found.first_seed,
        ", call ",
        found.first_step,
        ", selector 0x",
        core::text::hex(found.first_selector as u256, 4),
        " ",
        function_name(found.first_selector),
        if found.first_category == 0 {
            " (well-formed)"
        } else if found.first_category == 1 {
            " (short calldata)"
        } else {
            " (dirty address)"
        },
        if found.first_what == 1 {
            ": status differs"
        } else if found.first_what == 2 {
            ": return data differs"
        } else if found.first_what == 3 {
            ": logs differ"
        } else {
            ": state differs"
        },
    )
    println!(
        "  from 0x",
        core::text::hex(found.first_from, 20),
        " to 0x",
        core::text::hex(found.first_to, 20),
        " value ",
        found.first_value,
    )
    println!("  calldata 0x", hex_text(found.first_data.span()))
    println!(
        "  deployed ",
        outcome(found.first_deployed),
        ", port ",
        outcome(found.first_port),
    )
    if found.first_what == 2 {
        println!(
            "  deployed returned 0x",
            hex_text(found.first_deployed_output.span()),
        )
        println!(
            "  port returned     0x",
            hex_text(found.first_port_output.span()),
        )
    }
    if pair {
        print!(
            "replay it: fevm-replay fuzz-pair <deployed.bin> <port.bin> <token.bin> 1 ",
        )
    } else if fuzz::is_usdt(token.span()) {
        print!(
            "replay it: fevm-replay fuzz-usdt <deployed.bin> <port.bin> 1 ",
        )
    } else if fuzz::is_dai(token.span()) {
        print!(
            "replay it: fevm-replay fuzz-dai <deployed.bin> <port.bin> 1 ",
        )
    } else {
        print!("replay it: fevm-replay fuzz <deployed.bin> <port.bin> 1 ")
    }
    println!(found.first_step, " ", found.first_seed)
    println!(
        "shrunk to ",
        found.shrunk.len(),
        " of ",
        found.first_step,
        " calls:",
    )
    for i in 0 .. found.shrunk.len() {
        let sent = found.shrunk[i]
        var bytes = MemBuffer::empty()
        for j in 0 .. sent.len {
            bytes.push(found.shrunk_inputs.span()[sent.start + j])
        }
        println!(
            "  call ",
            sent.step,
            " from 0x",
            core::text::hex(sent.sender, 20),
            " to 0x",
            core::text::hex(sent.to, 20),
            " value ",
            sent.value,
            " calldata 0x",
            hex_text(bytes.span()),
        )
    }
    if found.calls[0] != found.identical[0] || found.invariant_breaks > 0 {
        return 1
    }
    0
}

fn hex_text(_ bytes: MemSpan) -> MemBuffer {
    var text = MemBuffer::empty()
    for i in 0 .. bytes.len() {
        core::text::hex(bytes[i] as u256, 1).fmt(mut text)
    }
    text
}

fn outcome(_ result: [i32; 2]) -> String<20> {
    if result[0] != 0 {
        fevm::status::invalid_name(result[0])
    } else {
        fevm::status::status_name(result[1])
    }
}

/// `fuzz-block <dir>... <deployed.hex> <port.bin> [mutations] [seed]`:
/// mainnet-seeded fuzzing. Every transaction of the saved blocks whose
/// pre-state holds the deployed code is mutated `mutations` times (default
/// 20) and run on its own pre-state with the deployed code and with the
/// port. The directories come first; the last arguments that read as
/// numbers are `mutations` and `seed`.
#[cfg(target_family = "unix")]
 // How much of the port's code the runs covered.
fn print_coverage(_ covered: MemVec<u8>, _ port: MemSpan)
uses (out: mut Stdout) {
    let ran = watch::coverage_count(covered)
    let total: u64 = watch::instructions(port).downcast_unchecked()
    println!(
        "  the port ran ",
        ran,
        " of its ",
        total,
        " instructions (",
        if total == 0 { 0 } else { ran * 100 / total },
        "%)",
    )
}

// Mutates every transaction of the block saved in `dir` that touches
// `deployed` (see `mutate::mutate_tx`), recording the first difference's
// block and transaction hash.
fn mutate_dir<D: Display>(
    _ dir: D,
    deployed: MemSpan,
    port: MemSpan,
    count: u64,
    seed: u64,
    _ found: mut mutate::Mutations,
    _ first_block: mut MemBuffer,
    _ first_hash: mut MemBuffer,
    fetch: MemBuffer,
)
uses (fs: std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return
    }
    // The block's state diffs, to bring fetched state up to each transaction.
    let diffs = if fetch.len() > 0 {
        match load_response(dir, "diff.json") {
            Option::Some(doc) => doc,
            Option::None => Value::object(),
        }
    } else {
        Value::object()
    }
    let header = ref block["result"]
    var problem = MemBuffer::empty()
    if !check::header_ok(header, mut problem) || !header["transactions"].as_array().is_some() {
        println!("ERROR ", dir, "/block.json: ", problem)
        return
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let extras = match load_json(dir, "delegates.json") {
        Option::Some(doc) => doc,
        Option::None => Value::object(),
    }
    let txs = header["transactions"].items()
    if !same_length(prestates["result"], txs.len()) {
        println!(
            "ERROR ",
            dir,
            ": the traces do not list one entry per transaction",
        )
        return
    }
    for index in 0 .. txs.len() {
        let entry = ref prestates["result"][index]
        if !entry.as_object().is_some() || !entry.has("result") {
            return
        }
        let before = found.first_tx
        mutate::mutate_tx(
            env,
            parent_hash: field(header, "parentHash"),
            extras,
            txs[index],
            entry["result"],
            index: index.downcast_unchecked(),
            deployed,
            port,
            count,
            seed,
            fetch: MemBuffer::from_span(fetch.span()),
            diffs,
            mut found,
        )
        if before == 0 && found.first_tx != 0 {
            dir.fmt(mut first_block)
            txs[index]["hash"].text().fmt(mut first_hash)
        }
    }
}

// The contracts that read the gas left where runs part, most runs first,
// at most ten.
fn print_readers(_ readers: MemVec<mutate::Reader>) uses (out: mut Stdout) {
    var shown: MemVec<bool> = MemVec::new()
    for _ in 0 .. readers.len() {
        shown.push(false)
    }
    var printed: usize = 0
    while printed < 10 && printed < readers.len() {
        var best: usize = 0
        var best_runs: u64 = 0
        for i in 0 .. readers.len() {
            if !shown[i] && readers[i].runs >= best_runs {
                best = i
                best_runs = readers[i].runs
            }
        }
        shown[best] = true
        println!(
            "    0x",
            core::text::hex(readers[best].address, 20),
            ": ",
            best_runs,
            " runs",
        )
        printed += 1
    }
}

fn fuzz_block_command() -> i32
uses (args: Args, fs: std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    // A node to fetch untouched state from, last (see `mutate::fetch_missing`).
    var end = args.count()
    var fetch_url = MemBuffer::empty()
    let last = args.get(end - 1).span()
    if last.len() > 4 && last[0] == 0x68 && last[1] == 0x74 && last[2] == 0x74 && last[3] == 0x70 {
        for i in 0 .. last.len() {
            fetch_url.push(last[i])
        }
        end -= 1
    }
    // Trailing numbers: up to two.
    var numbers: usize = 0
    while numbers < 2 && end > 5 && is_number(args.get(end - 1)) {
        end -= 1
        numbers += 1
    }
    if end < 5 {
        println!(
            "usage: fevm-replay fuzz-block <dir>... <deployed.hex> <port.bin> [mutations] [seed]",
        )
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(end - 2)) else {
        return 1
    }
    let Option::Some(port) = read_shadow(args.get(end - 1)) else {
        return 1
    }
    let count = if numbers >= 1 {
        number_arg(end, default: 20)
    } else {
        20
    }
    let seed = if numbers == 2 {
        number_arg(end + 1, default: 1)
    } else {
        1
    }
    var found = mutate::Mutations::new()
    var first_block = MemBuffer::empty()
    var first_hash = MemBuffer::empty()
    for d in 2 .. end - 2 {
        mutate_dir(
            args.get(d),
            deployed: deployed.span(),
            port: port.span(),
            count,
            seed,
            mut found,
            mut first_block,
            mut first_hash,
            fetch: MemBuffer::from_span(fetch_url.span()),
        )
    }
    println!(
        "mutated ",
        found.transactions,
        " transactions ",
        count,
        " times each (",
        found.tx_runs,
        " with their own calldata changed, ",
        found.direct_runs,
        " changing a call into the shadowed code in flight, ",
        found.flight_succeeded,
        " of which succeeded)",
    )
    println!(
        "  ",
        found.runs,
        " runs: ",
        found.identical,
        " identical, ",
        found.sensitive,
        " differ where code reads the gas left or code hashes (",
        found.code_sensitive,
        " code hashes), ",
        found.dirtied,
        " differ after an address-shaped word got upper bits, ",
        found.shortened,
        " after the calldata was cut short, ",
        found.cheaper,
        " where only the deployed code ran out of gas, ",
        found.differ,
        " differ",
    )
    println!(
        "  of the ",
        found.sensitive - found.code_sensitive,
        " where code reads the gas left, ",
        found.gas_explained,
        " part at or under a call whose code read it",
    )
    print_readers(found.readers)
    if fetch_url.len() > 0 {
        println!(
            "  ",
            found.fetched_runs,
            " mutated runs reached state their transaction never touched; ",
            found.fetched_keys,
            " accounts and slots fetched for them",
        )
    }
    if found.unexplained_tx != 0 {
        println!(
            "  first other: tx ",
            found.unexplained_tx - 1,
            ", parting call ",
            found.unexplained_at,
            " to 0x",
            core::text::hex(found.unexplained_to, 20),
            ", deployed ",
            found.unexplained_deployed,
            ", port ",
            found.unexplained_port,
            ", what ",
            found.unexplained_what,
        )
    }
    print_coverage(found.covered, port.span())
    if found.first_tx == 0 {
        return 0
    }
    println!(
        "first difference: ",
        first_block,
        " tx ",
        found.first_tx - 1,
        " ",
        first_hash,
        if found.first_direct {
            " (a call into the shadowed code changed in flight)"
        } else {
            " (its calldata changed)"
        },
    )
    println!(
        "  call to 0x",
        core::text::hex(found.first_to, 20),
        " with calldata 0x",
        hex_text(found.first_data.span()),
    )
    println!(
        "  deployed ",
        outcome(found.first_deployed),
        ", port ",
        outcome(found.first_port),
    )
    println!(
        "  deployed returned 0x",
        hex_text(found.first_deployed_output.span()),
    )
    println!(
        "  port returned     0x",
        hex_text(found.first_port_output.span()),
    )
    println!(
        "  runs part at the call to 0x",
        core::text::hex(found.parting_to, 20),
        " selector 0x",
        core::text::hex(found.parting_selector as u256, 4),
        ": deployed ",
        if found.parting_deployed < 0 {
            "made no such call"
        } else {
            fevm::status::status_name(found.parting_deployed)
        },
        ", port ",
        if found.parting_port < 0 {
            "made no such call"
        } else {
            fevm::status::status_name(found.parting_port)
        },
    )
    1
}

#[cfg(target_family = "unix")]
fn is_number(_ arg: Arg) -> bool {
    let text = arg.span()
    if text.len() == 0 {
        return false
    }
    for i in 0 .. text.len() {
        if text[i] < 0x30 || text[i] > 0x39 {
            return false
        }
    }
    true
}

/// `fetch-hashes <dir> [rpc-url]`: adds the 256 block hashes before the
/// block saved in `dir` to its `delegates.json`, for transactions that read
/// an older block's hash.
#[cfg(target_family = "unix")]
fn fetch_hashes_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 3 && args.count() != 4 {
        println!("usage: fevm-replay fetch-hashes <dir> [rpc-url]")
        return 2
    }
    let Option::Some(block) = load_response(args.get(2), "block.json") else {
        return 1
    }
    let number = field(block["result"], "number")
    let fetched = if args.count() == 4 {
        fetch::fetch_hashes(args.get(3), number: number, args.get(2))
    } else {
        fetch::fetch_hashes(DEFAULT_RPC, number: number, args.get(2))
    }
    if !fetched {
        println!("ERROR ", args.get(2), ": the node did not answer")
        return 1
    }
    println!(
        "saved the 256 block hashes before block ",
        number,
        " in ",
        args.get(2),
        "/delegates.json",
    )
    0
}

/// `system <dir> <BeaconRoots.runtime.bin> <HistoryStorage.runtime.bin>`:
/// runs the Fe ports of the first system contracts (ports/system) beside the
/// deployed ones on a saved block's proven state. Both get the block's
/// system call (EIP-4788's parent beacon root, EIP-2935's parent hash),
/// and each must write what the header implies; then both answer the same
/// reads from another caller (a stored and a missing timestamp or number,
/// zero, the window's edges, calldata of the wrong length), and each answer
/// must be the deployed one's: status and output. Gas is reported.
#[cfg(target_family = "unix")]
fn system_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, out: mut Stdout)
{
    if args.count() != 5 && args.count() != 7 {
        println!(
            "usage: fevm-replay system <dir> <BeaconRoots.runtime.bin> <HistoryStorage.runtime.bin> [<WithdrawalRequests.runtime.bin> <ConsolidationRequests.runtime.bin>]",
        )
        return 2
    }
    let dir = args.get(2)
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return 1
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(proofs) = load_json(dir, "proofs.json") else {
        return 1
    }
    let header = ref block["result"]
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let parent_root = field(proofs["parent"], "stateRoot")
    var keys = fevm::WorldState::empty()
    proof::add_system_keys(mut keys, header)
    var world = fevm::WorldState::empty()
    for c in 0 .. 2 {
        let target = if c == 0 {
            proof::BEACON_ROOTS
        } else {
            proof::HISTORY
        }
        if !proof::load_system_contract(
            mut world,
            proofs,
            state_root: parent_root,
            address: target,
            keys,
        ) {
            println!(
                "ERROR ",
                dir,
                ": no proven code and slots for the system contracts",
            )
            return 1
        }
    }
    let writes = proof::system_writes(header)
    let timestamp = field(header, "timestamp")
    let number = field(header, "number")
    var differ: u64 = 0
    var reads: u64 = 0
    for c in 0 .. 2 {
        let (target, input, name) = if c == 0 {
            (proof::BEACON_ROOTS, field(header, "parentBeaconBlockRoot"), "EIP-4788 beacon roots")
        } else {
            (proof::HISTORY, field(header, "parentHash"), "EIP-2935 history")
        }
        let Option::Some(port_code) = read_shadow(args.get(3 + c)) else {
            return 1
        }
        let port = port_code.span()
        let deployed = proof::code_of(proofs, target)
        var word = MemBuffer::with_capacity(32)
        word.write_word(offset: 0, value: input)
        let Option::Some(start) = world.try_clone() else {
            return 1
        }
        let (d_world, d) = requests::system_call(start, target, input: word.span(), env)
        let Option::Some(port_start) = world.try_clone() else {
            return 1
        }
        var p_start = port_start
        p_start.set_code(address: target, code: port)
        let (p_world, p) = requests::system_call(p_start, target, input: word.span(), env)
        var wrote = d.status == fevm::OK && p.status == fevm::OK
        for w in 0 .. writes.len() {
            if writes[w].address != target {
                continue
            }
            if d_world.storage_load(target, writes[w].slot) != writes[w].value
                || p_world.storage_load(target, writes[w].slot) != writes[w].value {
                wrote = false
            }
        }
        if !wrote { differ += 1 }
        println!(
            name,
            ": the system call writes what the header implies, deployed ",
            if d.status == fevm::OK { "yes" } else { "NO" },
            " and Fe port ",
            if wrote { "yes" } else { "NO" },
            "; gas ",
            requests::SYSTEM_GAS - d.gas_remaining,
            " deployed, ",
            requests::SYSTEM_GAS - p.gas_remaining,
            " Fe (",
            deployed.len(),
            " and ",
            port.len(),
            " bytes of code)",
        )
        // Reads from another caller, on the state the call left.
        let asked: [u256; 8] = if c == 0 {
            [timestamp, timestamp - 12, 0, timestamp + 1, timestamp + 8191 * 12, 1, 0xff, timestamp]
        } else {
            [
                number - 1,
                number,
                number - 8191,
                number - 8192,
                0,
                number + 1,
                number - 2,
                number - 1,
            ]
        }
        // Calldata lengths: 32, but the last read is cut to 31 and the one
        // before it padded to 33.
        var same: u64 = 0
        var d_gas: u64 = 0
        var p_gas: u64 = 0
        for r in 0 .. 8 {
            let length: usize = if r == 7 { 31 } else if r == 6 { 33 } else { 32 }
            var data = MemBuffer::with_capacity(64)
            data.write_word(offset: 0, value: asked[r])
            data.write_word(offset: 32, value: 0)
            data.truncate(length)
            let Option::Some(a) = d_world.try_clone() else {
                return 1
            }
            let Option::Some(b) = d_world.try_clone() else {
                return 1
            }
            var b_port = b
            b_port.set_code(address: target, code: port)
            let (_, dr) = requests::call_as(
                a,
                caller: 0x1234,
                target,
                input: data.span(),
                value: 0,
                env,
            )
            let (_, pr) = requests::call_as(
                b_port,
                caller: 0x1234,
                target,
                input: data.span(),
                value: 0,
                env,
            )
            d_gas += requests::SYSTEM_GAS - dr.gas_remaining
            p_gas += requests::SYSTEM_GAS - pr.gas_remaining
            reads += 1
            if dr.status == pr.status && fuzz::same_bytes(dr.output.span(), pr.output.span()) {
                same += 1
            } else {
                differ += 1
                println!("DIFF ", name, ": read ", r, " answered differently")
            }
        }
        println!(
            name,
            ": ",
            same,
            "/8 reads answered as deployed; gas ",
            d_gas,
            " deployed, ",
            p_gas,
            " Fe",
        )
    }
    if args.count() == 7 {
        for c in 0 .. 2 {
            let Option::Some(port_code) = read_shadow(args.get(5 + c)) else {
                return 1
            }
            let (found, calls) = request_contract(
                proofs,
                parent_root,
                address: if c == 0 {
                    proof::WITHDRAWAL_REQUESTS
                } else {
                    proof::CONSOLIDATION_REQUESTS
                },
                port: port_code.span(),
                env,
            )
            differ += found
            reads += calls
        }
    }
    if differ == 0 {
        println!(
            "system contracts: the Fe ports did what the deployed ones did (",
            reads,
            " reads)",
        )
        0
    } else {
        println!("system contracts: ", differ, " differences")
        1
    }
}

// Request contract `address` (EIP-7002, EIP-7251) beside its Fe port
// `port`, on the parent's proven state: the end-of-block system call (the
// queue it dequeues, its output, the excess and count it leaves), then a
// fee read, a request paying the fee, one paying nothing, one paying more
// and one of the wrong length. Each must return what the deployed code
// returns and leave the same storage. Returns the differences and the
// calls compared.
#[cfg(target_family = "unix")]
fn request_contract(
    _ proofs: Value,
    _ parent_root: u256,
    address: u256,
    port: core::MemSpan,
    _ env: fevm::BlockEnv,
) -> (u64, u64)
uses (out: mut Stdout)
{
    let name = if address == proof::WITHDRAWAL_REQUESTS {
        "EIP-7002 withdrawal requests"
    } else {
        "EIP-7251 consolidation requests"
    }
    let input: usize = if address == proof::WITHDRAWAL_REQUESTS {
        56
    } else {
        96
    }
    var world = fevm::WorldState::empty()
    if !proof::load_request_contract(
        mut world,
        proofs,
        state_root: parent_root,
        address,
        fevm::WorldState::empty(),
    ) {
        println!(name, ": not in these proofs, skipped")
        return (0, 0)
    }
    let queued = world.storage_load(address, 3) - world.storage_load(address, 2)
    var differ: u64 = 0
    // The end-of-block system call, from the parent's queue.
    let Option::Some(a) = world.try_clone() else {
        return (1, 0)
    }
    let Option::Some(b) = world.try_clone() else {
        return (1, 0)
    }
    var b_port = b
    b_port.set_code(address: address, code: port)
    let (d_world, d) = requests::system_call(
        a,
        target: address,
        input: MemBuffer::empty().span(),
        env,
    )
    let (p_world, p) = requests::system_call(
        b_port,
        target: address,
        input: MemBuffer::empty().span(),
        env,
    )
    let dequeued_same = d.status == p.status
        && fuzz::same_bytes(d.output.span(), p.output.span())
        && same_storage(d_world, p_world, address)
    if !dequeued_same {
        differ += 1
    }
    println!(
        name,
        ": end-of-block call on a queue of ",
        queued,
        ": ",
        d.output.len(),
        " bytes of requests out, ",
        if dequeued_same {
            "same output and storage"
        } else {
            "DIFFERENT"
        },
        "; gas ",
        requests::SYSTEM_GAS - d.gas_remaining,
        " deployed, ",
        requests::SYSTEM_GAS - p.gas_remaining,
        " Fe",
    )
    // Calls from another account, on what the system call left.
    var fee: u256 = 0
    var same: u64 = 0
    for r in 0 .. 5 {
        let length: usize = if r == 0 {
            0
        } else if r == 4 { input - 1 } else { input }
        let value: u256 = if r == 2 {
            0
        } else if r == 3 { fee * 3 } else { fee }
        var data = MemBuffer::with_capacity(input + 32)
        var w: usize = 0
        while w * 32 < input {
            data.write_word(
                offset: w * 32,
                value: 0x0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
                    + (((r + w) as u256) << 248),
            )
            w += 1
        }
        data.truncate(length)
        let Option::Some(a) = d_world.try_clone() else {
            return (differ + 1, 0)
        }
        let Option::Some(b) = d_world.try_clone() else {
            return (differ + 1, 0)
        }
        var b_port = b
        b_port.set_code(address: address, code: port)
        let (ad, dr, dl) = requests::call_logged(
            a,
            caller: 0x1234,
            target: address,
            input: data.span(),
            value,
            env,
        )
        let (ap, pr, pl) = requests::call_logged(
            b_port,
            caller: 0x1234,
            target: address,
            input: data.span(),
            value,
            env,
        )
        if r == 0 && dr.output.len() == 32 {
            fee = dr.output.span().read_word(offset: 0)
        }
        if dr.status == pr.status
            && fuzz::same_bytes(dr.output.span(), pr.output.span())
            && requests::same_logs(dl, pl)
            && same_storage(ad, ap, address) {
            same += 1
        } else {
            differ += 1
            println!("DIFF ", name, ": call ", r, " answered differently")
        }
    }
    println!(
        name,
        ": ",
        same,
        "/5 calls (a fee read; requests paying the fee, nothing and more; a wrong length) answered as deployed, same logs and storage; fee ",
        fee,
        " wei",
    )
    // A queue the blocks did not have: one request more than a block
    // takes, then two end-of-block calls, so the second starts from a head
    // past zero and empties the queue (head and tail back to zero), with
    // the count above the target.
    let most: usize = if address == proof::WITHDRAWAL_REQUESTS {
        16
    } else {
        2
    }
    let Option::Some(start_d) = d_world.try_clone() else {
        return (differ + 1, 0)
    }
    let Option::Some(start_p) = d_world.try_clone() else {
        return (differ + 1, 0)
    }
    var wd = start_d
    var wp = start_p
    wp.set_code(address: address, code: port)
    var steps_same: u64 = 0
    var out_bytes: usize = 0
    var added: u64 = 0
    for step in 0 .. most + 3 {
        var data = MemBuffer::with_capacity(input + 32)
        var w: usize = 0
        while w * 32 < input {
            data.write_word(
                offset: w * 32,
                value: 0x0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
                    + (((step * 8 + w) as u256) << 248),
            )
            w += 1
        }
        let system = step > most
        data.truncate(if system { 0 } else { input })
        let (nd, dr, dl) = requests::call_logged(
            wd,
            caller: if system { requests::SYSTEM } else { 0x5678 },
            target: address,
            input: data.span(),
            value: if system { 0 } else { fee },
            env,
        )
        let (np, pr, pl) = requests::call_logged(
            wp,
            caller: if system { requests::SYSTEM } else { 0x5678 },
            target: address,
            input: data.span(),
            value: if system { 0 } else { fee },
            env,
        )
        wd = nd
        wp = np
        if system {
            out_bytes += dr.output.len()
        } else if dr.status == fevm::OK {
            added += 1
        }
        if dr.status == pr.status
            && fuzz::same_bytes(dr.output.span(), pr.output.span())
            && requests::same_logs(dl, pl)
            && same_storage(wd, wp, address) {
            steps_same += 1
        } else {
            differ += 1
            println!(
                "DIFF ",
                name,
                ": queue step ",
                step,
                " answered differently",
            )
        }
    }
    println!(
        name,
        ": a queue of ",
        most + 1,
        " requests and two end-of-block calls: ",
        steps_same,
        "/",
        most + 3,
        " steps as deployed (",
        added,
        " requests queued, ",
        out_bytes,
        " bytes of requests out)",
    )
    (differ, 6 + (most + 3).downcast_unchecked())
}

// Whether `a` and `b` hold the same storage for `address`.
fn same_storage(_ a: fevm::WorldState, _ b: fevm::WorldState, _ address: u256) -> bool {
    for i in 0 .. a.storage_slots() {
        let e = a.storage_at(i)
        if e.occupied && e.address == address && b.storage_load(address, e.slot) != e.value {
            return false
        }
    }
    for i in 0 .. b.storage_slots() {
        let e = b.storage_at(i)
        if e.occupied && e.address == address && a.storage_load(address, e.slot) != e.value {
            return false
        }
    }
    true
}

/// `mutants-system <port-dir> <dir>...`: mutation testing of the system
/// contracts' check. Every operator in `port-dir`'s `src/lib.fe` (the four
/// system contracts, see `mutants::sites`) is flipped in turn, the mutant
/// is built with `fe`, and `system` runs it beside the deployed contracts
/// on each saved block; a block where it differs kills it. The unchanged
/// ports go first and must pass on every block.
#[cfg(target_family = "unix")]
fn mutants_system_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 4 {
        println!("usage: fevm-replay mutants-system <port-dir> <dir>...")
        return 2
    }
    let port_dir = args.get(2)
    let Result::Ok(source) = fs.read(fetch::join(port_dir, "src/lib.fe")) else {
        println!("ERROR ", port_dir, "/src/lib.fe: cannot read")
        return 1
    }
    let Result::Ok(manifest) = fs.read(fetch::join(port_dir, "fe.toml")) else {
        println!("ERROR ", port_dir, "/fe.toml: cannot read")
        return 1
    }
    let work = "/tmp/fevm-replay-mutant-system"
    let Result::Ok(_) = fs.create_dir_all(fetch::join(work, "src")) else {
        println!("ERROR ", work, ": cannot create")
        return 1
    }
    let Result::Ok(_) = fs.write(fetch::join(work, "fe.toml"), manifest.span()) else {
        return 1
    }
    let all = mutants::sites(source.span())
    var built: u64 = 0
    var killed: u64 = 0
    var survivors = MemBuffer::empty()
    for n in 0 .. all.len() + 1 {
        let mutated = if n == 0 {
            MemBuffer::from_span(source.span())
        } else {
            mutants::apply(source.span(), all[n - 1])
        }
        let Result::Ok(_) = fs.write(fetch::join(work, "src/lib.fe"), mutated.span()) else {
            return 1
        }
        if !fe_build(work, "/tmp/fevm-replay-mutant-system/out") {
            if n == 0 {
                println!("ERROR the ports themselves do not build with fe")
                return 1
            }
            continue
        }
        var differs = false
        for d in 3 .. args.count() {
            let command = std::process::Command::new(args.get(0))
                .arg("system")
                .arg(args.get(d))
                .arg(
                    "/tmp/fevm-replay-mutant-system/out/BeaconRoots.runtime.bin",
                )
                .arg(
                    "/tmp/fevm-replay-mutant-system/out/HistoryStorage.runtime.bin",
                )
                .arg(
                    "/tmp/fevm-replay-mutant-system/out/WithdrawalRequests.runtime.bin",
                )
                .arg(
                    "/tmp/fevm-replay-mutant-system/out/ConsolidationRequests.runtime.bin",
                )
                .stdout(std::process::Redirect::Capture)
                .stderr(std::process::Redirect::Capture)
            let ok = match proc.output(command) {
                Result::Ok(output) => output.status.success(),
                Result::Err(_) => false,
            }
            if !ok {
                differs = true
                break
            }
        }
        if n == 0 {
            if differs {
                println!("ERROR the unchanged ports already differ; fix them first")
                return 1
            }
            continue
        }
        built += 1
        if differs {
            killed += 1
        } else {
            let (line, start, end) = mutants::line_of(mutated.span(), all[n - 1].at)
            "  survived, line ".fmt(mut survivors)
            line.fmt(mut survivors)
            ": ".fmt(mut survivors)
            let text = mutated.span()
            var i = start
            while i < end && text[i] == 0x20 {
                i += 1
            }
            while i < end {
                survivors.push(text[i])
                i += 1
            }
            "\n".fmt(mut survivors)
        }
    }
    println!("mutated ", port_dir, ": ", all.len(), " operators")
    print!(survivors)
    println!(
        "  ",
        built,
        " mutants built: ",
        killed,
        " killed by the system check on ",
        args.count() - 3,
        " mainnet blocks, ",
        built - killed,
        " survived; ",
        if built == 0 { 0 } else { killed * 100 / built },
        "% killed",
    )
    0
}

/// The Fe ports of the four system contracts (ports/system), which `chain
/// <dir> --system <out-dir>` runs in place of the deployed code; `on` is
/// false when the block runs the deployed code.
pub struct SystemPorts {
    on: bool,
    beacon: MemBuffer,
    history: MemBuffer,
    withdrawals: MemBuffer,
    consolidations: MemBuffer,
}

impl SystemPorts {
    fn none() -> Self {
        SystemPorts {
            on: false,
            beacon: MemBuffer::empty(),
            history: MemBuffer::empty(),
            withdrawals: MemBuffer::empty(),
            consolidations: MemBuffer::empty(),
        }
    }

    // Puts the port of system contract `address` in its place.
    fn install(self, _ world: mut fevm::WorldState, _ address: u256) {
        if !self.on { return }
        if address == proof::BEACON_ROOTS {
            world.set_code(address: address, code: self.beacon.span())
        } else if address == proof::HISTORY {
            world.set_code(address: address, code: self.history.span())
        } else if address == proof::WITHDRAWAL_REQUESTS {
            world.set_code(address: address, code: self.withdrawals.span())
        } else {
            world.set_code(address: address, code: self.consolidations.span())
        }
    }

    // Puts the deployed code, as the parent's proofs prove it, back: a
    // system call writes storage, never code, so the roots see the code
    // the chain holds and the storage the port wrote.
    fn restore(self, _ world: mut fevm::WorldState, _ proofs: Value, _ address: u256) {
        if self.on {
            world.set_code(
                    address: address,
                    code: proof::code_of(proofs, address).span(),
                )
        }
    }
}

#[cfg(target_family = "unix")]
fn read_system_ports(_ dir: Arg) -> Option<SystemPorts>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let beacon = read_port(dir, "BeaconRoots")?
    let history = read_port(dir, "HistoryStorage")?
    let withdrawals = read_port(dir, "WithdrawalRequests")?
    let consolidations = read_port(dir, "ConsolidationRequests")?
    Option::Some(
        SystemPorts { on: true, beacon, history, withdrawals, consolidations },
    )
}

#[cfg(target_family = "unix")]
fn read_port(_ dir: Arg, _ name: String<24>) -> Option<MemBuffer>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    var path = MemBuffer::empty()
    dir.fmt(mut path)
    "/".fmt(mut path)
    name.fmt(mut path)
    ".runtime.bin".fmt(mut path)
    let Result::Ok(hex) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    Option::Some(hex_bytes(hex.span()))
}

/// `certify-system <out-dir> <certificate.html> <dir>...`: the system
/// contracts' certificate. For each saved block it runs this program's
/// `system` (each Fe port beside the deployed contract) and `chain <dir>
/// --system` (the whole block on the Fe ports, every root), counts the
/// blocks each passes, and writes a one-page certificate with each port's
/// code hash, and its badge beside it (`.svg` in place of `.html`).
#[cfg(target_family = "unix")]
fn certify_system_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 5 {
        println!(
            "usage: fevm-replay certify-system <out-dir> <certificate.html> <dir>...",
        )
        return 2
    }
    let bins = args.get(2)
    var system_ok: u64 = 0
    var chain_ok: u64 = 0
    var blocks: u64 = 0
    for d in 4 .. args.count() {
        blocks += 1
        var paths: [MemBuffer; 4] = [
            MemBuffer::empty(),
            MemBuffer::empty(),
            MemBuffer::empty(),
            MemBuffer::empty(),
        ]
        let names = ["BeaconRoots", "HistoryStorage", "WithdrawalRequests", "ConsolidationRequests"]
        for k in 0 .. 4 {
            bins.fmt(mut paths[k])
            "/".fmt(mut paths[k])
            names[k].fmt(mut paths[k])
            ".runtime.bin".fmt(mut paths[k])
        }
        let system = std::process::Command::new(args.get(0))
            .arg("system")
            .arg(args.get(d))
            .arg(paths[0].span())
            .arg(paths[1].span())
            .arg(paths[2].span())
            .arg(paths[3].span())
            .stdout(std::process::Redirect::Capture)
            .stderr(std::process::Redirect::Capture)
        if match proc.output(system) {
            Result::Ok(output) => output.status.success(),
            Result::Err(_) => false,
        } {
            system_ok += 1
        }
        let chain = std::process::Command::new(args.get(0))
            .arg("chain")
            .arg(args.get(d))
            .arg("--system")
            .arg(bins)
            .stdout(std::process::Redirect::Capture)
            .stderr(std::process::Redirect::Capture)
        match proc.output(chain) {
            Result::Ok(output) => {
                let text = output.stdout.span()
                if output.status.success()
                    && contains(text, "both as the Fe ports".span())
                    && contains(text, "both request lists from the Fe ports".span())
                    && contains(text, "hashes to the header's stateRoot".span()) {
                    chain_ok += 1
                }
            },
            Result::Err(_) => {},
        }
    }
    let Option::Some(ports) = read_system_ports(bins) else {
        return 1
    }
    let passed = system_ok == blocks && chain_ok == blocks
    var html = MemBuffer::empty()
    "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>System contracts certificate</title>\n<style>\n:root{--paper:#f2f4f3;--ink:#1f2624;--steel:#5b6b73;--rule:#c9d1ce;--match:#2e8b6f;--diff:#c9961a}\n@media (prefers-color-scheme:dark){:root{--paper:#161b1a;--ink:#e4e9e7;--steel:#93a3aa;--rule:#34403d;--match:#4fb894;--diff:#e0b03a}}\n*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,sans-serif}\nmain{width:min(880px,100% - 2rem);margin:2rem auto 4rem}h1{font-size:clamp(1.8rem,5vw,2.6rem);line-height:1.1;letter-spacing:-.02em;margin:.25rem 0 1rem}\nh2{margin-top:2.5rem;padding-top:1rem;border-top:1px solid var(--rule);font-size:1.2rem}.kicker{color:var(--steel);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:.8rem}\ncode{font-family:ui-monospace,monospace;font-size:.85em;overflow-wrap:anywhere}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}\nth,td{text-align:left;padding:.45rem .6rem .45rem 0;border-bottom:1px solid var(--rule);vertical-align:top}th{color:var(--steel);font-weight:600}td.n{text-align:right}\n.verdict{border-left:4px solid var(--match);padding:.6rem 1rem;background:color-mix(in srgb,var(--match) 12%,transparent);font-size:1.1rem}.verdict.bad{border-color:var(--diff);background:color-mix(in srgb,var(--diff) 15%,transparent)}\n.note{color:var(--steel);font-size:.92rem}\n</style>\n</head>\n<body>\n<main>\n<div class=\"kicker\">Fe port certificate</div>\n<h1>Ethereum's system contracts</h1>\n<p>Port source <code>ports/system</code>: EIP-4788, EIP-2935, EIP-7002 and EIP-7251, in place of the deployed assembly. Runtime code hashes:</p>\n<table>\n"
        .fmt(mut html)
    port_row(mut html, "BeaconRoots", "4788", ports.beacon.span())
    port_row(mut html, "HistoryStorage", "2935", ports.history.span())
    port_row(
        mut html,
        "WithdrawalRequests",
        "7002",
        ports.withdrawals.span(),
    )
    port_row(
        mut html,
        "ConsolidationRequests",
        "7251",
        ports.consolidations.span(),
    )
    "</table>\n<p class=\"verdict".fmt(mut html)
    if passed {
        "\">On every block, the Fe ports did what the deployed contracts did, and the block validated on them, every root in its header.</p>\n"
            .fmt(mut html)
    } else {
        " bad\">Some blocks differ; see below.</p>\n".fmt(mut html)
    }
    "<h2>Each port beside the deployed contract</h2>\n<p><code>fevm_replay system</code> on the block's proven state: the system call each makes (the block's beacon root and parent hash; the end-of-block dequeue of the parent's queue), 8 reads of each of the first two, 5 calls to each request contract (a fee read; requests paying the fee, nothing, three times it; a wrong length) and a queue no block had, one request more than a block takes and two end-of-block calls. Every status, output, log and storage slot must be the deployed contract's.</p>\n<table>\n<tr><th>Blocks</th><td class=\"n\">"
        .fmt(mut html)
    blocks.fmt(mut html)
    "</td></tr>\n<tr><th>Blocks where all four did as deployed</th><td class=\"n\">".fmt(mut html)
    system_ok.fmt(mut html)
    "</td></tr>\n</table>\n<h2>Whole blocks on the Fe ports</h2>\n<p><code>fevm_replay chain &lt;dir&gt; --system</code>: the block validated statelessly with its four system calls run by the Fe ports, the deployed code put back before the roots are hashed. The state root and the requests hash must be the header's.</p>\n<table>\n<tr><th>Blocks where every root matched</th><td class=\"n\">"
        .fmt(mut html)
    chain_ok.fmt(mut html)
    "</td></tr>\n</table>\n<p class=\"note\">Written by <code>fevm_replay certify-system</code>. Mutation testing of these checks: <code>fevm_replay mutants-system ports/system &lt;dir&gt;...</code>.</p>\n</main>\n</body>\n</html>\n"
        .fmt(mut html)
    let Result::Ok(_) = fs.write(args.get(3), html.span()) else {
        println!("ERROR ", args.get(3), ": cannot write")
        return 1
    }
    // The badge, beside the page.
    var svg = MemBuffer::empty()
    if passed {
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"254\" height=\"20\" role=\"img\" aria-label=\"Fe port: verified on mainnet\"><rect width=\"64\" height=\"20\" fill=\"#1f2624\"/><rect x=\"64\" width=\"190\" height=\"20\" fill=\"#2e8b6f\"/><g fill=\"#fff\" font-family=\"Verdana,DejaVu Sans,sans-serif\" font-size=\"11\"><text x=\"8\" y=\"14\">Fe port</text><text x=\"72\" y=\"14\">system contracts verified</text></g><title>fevm-replay certify-system</title></svg>\n"
            .fmt(mut svg)
    } else {
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"254\" height=\"20\" role=\"img\" aria-label=\"Fe port: differs\"><rect width=\"64\" height=\"20\" fill=\"#1f2624\"/><rect x=\"64\" width=\"190\" height=\"20\" fill=\"#c9961a\"/><g fill=\"#fff\" font-family=\"Verdana,DejaVu Sans,sans-serif\" font-size=\"11\"><text x=\"8\" y=\"14\">Fe port</text><text x=\"72\" y=\"14\">system contracts differ</text></g><title>fevm-replay certify-system</title></svg>\n"
            .fmt(mut svg)
    }
    var svg_path = MemBuffer::empty()
    let page = args.get(3).span()
    for i in 0 .. page.len() - 5 {
        svg_path.push(page[i])
    }
    ".svg".fmt(mut svg_path)
    let Result::Ok(_) = fs.write(svg_path, svg.span()) else {
        println!("ERROR ", svg_path, ": cannot write")
        return 1
    }
    println!(
        "system contracts: ",
        system_ok,
        "/",
        blocks,
        " blocks as deployed, ",
        chain_ok,
        "/",
        blocks,
        " blocks validated on the Fe ports; wrote ",
        args.get(3),
        " and ",
        svg_path,
    )
    if passed { 0 } else { 1 }
}

fn port_row(_ html: mut MemBuffer, _ name: String<24>, _ eip: String<4>, _ code: core::MemSpan) {
    "<tr><th>".fmt(mut html)
    name.fmt(mut html)
    " (EIP-".fmt(mut html)
    eip.fmt(mut html)
    ")".fmt(mut html)
    "</th><td><code>0x".fmt(mut html)
    core::text::hex(fuzz::keccak(MemBuffer::from_span(code)), 32).fmt(mut html)
    "</code> (".fmt(mut html)
    code.len().fmt(mut html)
    " bytes)</td></tr>\n".fmt(mut html)
}

fn contains(_ text: core::MemSpan, _ needle: core::MemSpan) -> bool {
    var i: usize = 0
    while i + needle.len() <= text.len() {
        var k: usize = 0
        while k < needle.len() && text[i + k] == needle[k] {
            k += 1
        }
        if k == needle.len() {
            return true
        }
        i += 1
    }
    false
}
