//! fevm-replay: replay Ethereum mainnet transactions in fevm and check the
//! result against the chain.

use core::MemBuffer
use certify::Check
use core::fixed::UFixed
use std::env::{Arg, Args}
use std::io::{Display, Stdout}
use json::{Value, parse}

pub use check::{fixture_ok, transaction_ok}
pub use compare::{Mismatches, apply_diff, compare}
pub use load::{field, hex_bytes, hex_word, load_block, load_tx, load_world}
pub use replay::{replay, replay_tx}
pub use watch::{SelectorGas, add_profile}

const DEFAULT_RPC: String<21> = "https://eth.drpc.org"

// `proxy:<file>`: the proxy scenario, with the implementation's code read
// from the file.
fn starts_with_proxy(_ arg: Arg) -> bool {
    let bytes = arg.span()
    let prefix: [u8; 6] = [0x70, 0x72, 0x6f, 0x78, 0x79, 0x3a]
    if bytes.len() <= 6 {
        return false
    }
    for i in 0 .. 6 {
        if bytes[i] != prefix[i] {
            return false
        }
    }
    true
}

#[cfg(target_family = "unix")]
fn read_proxy_token(_ arg: Arg) -> Option<MemBuffer>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    var path = MemBuffer::empty()
    let bytes = arg.span()
    for i in 6 .. bytes.len() {
        path.push(bytes[i])
    }
    let Result::Ok(hex) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    var token = MemBuffer::empty()
    token.push(0x50)
    let code = hex_bytes(hex.span())
    for i in 0 .. code.len() {
        token.push(code.span()[i])
    }
    Option::Some(token)
}

fn is_word<const N: usize>(_ arg: Arg, _ word: [u8; N]) -> bool {
    let bytes = arg.span()
    if bytes.len() != N {
        return false
    }
    for i in 0 .. N {
        if bytes[i] != word[i] {
            return false
        }
    }
    true
}

/// `fevm-replay <fixture.json>...` replays each fixture and prints MATCH or
/// DIFF with the differences; the exit status is the number of fixtures
/// that did not match.
/// `fevm-replay fetch <txhash> <fixture.json> [rpc-url]` writes the fixture
/// for one mainnet transaction.
/// `fevm-replay fetch-block <0x-number> <dir> [rpc-url]` saves the node's
/// answers for a whole block, and `fevm-replay block <dir>` replays every
/// transaction in it.
#[cfg(target_family = "unix")]
pub fn main() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 2 {
        println!("usage: fevm-replay <fixture.json>...")
        println!(
            "       fevm-replay fetch <txhash> <fixture.json> [rpc-url]",
        )
        println!(
            "       fevm-replay fetch-block <0x-number> <dir> [rpc-url]",
        )
        println!(
            "       fevm-replay block <dir> [<shadow-address>|<deployed.hex> <runtime.bin>]",
        )
        println!(
            "       fevm-replay range <first-block> <count> <dir> [<shadow-address>|<deployed.hex> <runtime.bin>]",
        )
        println!("       fevm-replay fetch-code <address> <file> [rpc-url]")
        println!(
            "       fevm-replay fuzz <deployed.hex> <port.bin> [runs] [steps] [seed]",
        )
        return 2
    }
    // "fetch-block"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x62, 0x6c, 0x6f, 0x63, 0x6b],
    ) {
        return fetch_block_command()
    }
    // "fuzz"
    if is_word(args.get(1), [0x66, 0x75, 0x7a, 0x7a]) {
        return fuzz_command(pair: false)
    }
    // "fetch-hashes"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x68, 0x61, 0x73, 0x68, 0x65, 0x73],
    ) {
        return fetch_hashes_command()
    }
    // "fetch-proofs"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x70, 0x72, 0x6f, 0x6f, 0x66, 0x73],
    ) {
        return fetch_proofs_command()
    }
    // "chain"
    if is_word(args.get(1), [0x63, 0x68, 0x61, 0x69, 0x6e]) {
        return chain_command()
    }
    // "certify"
    if is_word(args.get(1), [0x63, 0x65, 0x72, 0x74, 0x69, 0x66, 0x79]) {
        return certify_command()
    }
    // "mutants"
    if is_word(args.get(1), [0x6d, 0x75, 0x74, 0x61, 0x6e, 0x74, 0x73]) {
        return mutants_command()
    }
    // "opgas"
    if is_word(args.get(1), [0x6f, 0x70, 0x67, 0x61, 0x73]) {
        return opgas_command()
    }
    // "trace"
    if is_word(args.get(1), [0x74, 0x72, 0x61, 0x63, 0x65]) {
        return trace_command()
    }
    // "fuzz-block"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x62, 0x6c, 0x6f, 0x63, 0x6b],
    ) {
        return fuzz_block_command()
    }
    // "fuzz-pair"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x70, 0x61, 0x69, 0x72],
    ) {
        return fuzz_command(pair: true)
    }
    // "fuzz-proxy"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x70, 0x72, 0x6f, 0x78, 0x79],
    ) {
        return fuzz_command(pair: true)
    }
    // "fuzz-usdt"
    if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x75, 0x73, 0x64, 0x74],
    ) {
        return fuzz_command(pair: false)
    }
    // "fetch-code"
    if is_word(
        args.get(1),
        [0x66, 0x65, 0x74, 0x63, 0x68, 0x2d, 0x63, 0x6f, 0x64, 0x65],
    ) {
        return fetch_code_command()
    }
    // "range"
    if is_word(args.get(1), [0x72, 0x61, 0x6e, 0x67, 0x65]) {
        return range_command()
    }
    // "block"
    if is_word(args.get(1), [0x62, 0x6c, 0x6f, 0x63, 0x6b]) {
        return block_command()
    }
    // "fetch"
    if is_word(args.get(1), [0x66, 0x65, 0x74, 0x63, 0x68]) {
        return fetch_command()
    }
    replay_command()
}

#[cfg(target_family = "unix")]
fn fetch_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 4 && args.count() != 5 {
        println!(
            "usage: fevm-replay fetch <txhash> <fixture.json> [rpc-url]",
        )
        return 2
    }
    var text = MemBuffer::empty()
    let fetched = if args.count() == 5 {
        fetch::fetch(args.get(4), args.get(2), mut text)
    } else {
        fetch::fetch(DEFAULT_RPC, args.get(2), mut text)
    }
    if !fetched {
        println!("ERROR ", args.get(2), ": the node did not answer")
        return 1
    }
    let Result::Ok(_) = fs.write(args.get(3), text.span()) else {
        println!("ERROR ", args.get(3), ": cannot write")
        return 1
    }
    println!("wrote ", args.get(3))
    0
}

#[cfg(target_family = "unix")]
fn replay_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    var failed: i32 = 0
    for index in 1 .. args.count() {
        let path = args.get(index)
        let Result::Ok(bytes) = fs.read(path) else {
            println!("ERROR ", path, ": cannot read")
            failed += 1
            continue
        }
        let Result::Ok(doc) = parse(bytes.span()) else {
            println!("ERROR ", path, ": not JSON")
            failed += 1
            continue
        }
        var problem = MemBuffer::empty()
        if !fixture_ok(doc, mut problem) {
            println!("ERROR ", path, ": ", problem)
            failed += 1
            continue
        }
        var text = MemBuffer::empty()
        let found = with (mut text) {
            replay(doc)
        }
        if found.total() == 0 {
            println!("MATCH ", path)
        } else {
            println!("DIFF  ", path)
            print!(text)
            failed += 1
        }
    }
    failed
}

#[cfg(target_family = "unix")]
fn fetch_block_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 4 && args.count() != 5 {
        println!(
            "usage: fevm-replay fetch-block <0x-number> <dir> [rpc-url]",
        )
        return 2
    }
    let Result::Ok(_) = fs.create_dir_all(args.get(3)) else {
        println!("ERROR ", args.get(3), ": cannot create")
        return 1
    }
    let fetched = if args.count() == 5 {
        fetch::fetch_block(args.get(4), args.get(2), args.get(3))
    } else {
        fetch::fetch_block(DEFAULT_RPC, args.get(2), args.get(3))
    }
    if !fetched {
        println!("ERROR block ", args.get(2), ": the node did not answer")
        return 1
    }
    println!("saved block ", args.get(2), " in ", args.get(3))
    0
}

// Whether `list` is a JSON array of `count` entries.
fn same_length(_ list: Value, _ count: usize) -> bool {
    match list.as_array() {
        Option::Some(ref items) => items.len() == count,
        Option::None => false,
    }
}

// The JSON document saved in `dir/name`.
#[cfg(target_family = "unix")]
fn load_json<D: Display>(_ dir: D, _ name: String<16>) -> Option<json::Value>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let path = fetch::join(dir, name)
    let Result::Ok(bytes) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    let Result::Ok(doc) = parse(bytes.span()) else {
        println!("ERROR ", path, ": not JSON")
        return Option::None
    }
    Option::Some(doc)
}

// The JSON-RPC response saved in `dir/name`, which must hold a `result`.
#[cfg(target_family = "unix")]
fn load_response<D: Display>(_ dir: D, _ name: String<16>) -> Option<json::Value>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let Option::Some(doc) = load_json(dir, name) else {
        return Option::None
    }
    if !doc.has("result") {
        println!("ERROR ", dir, "/", name, ": no result")
        return Option::None
    }
    Option::Some(doc)
}

/// What a run of blocks found.
pub struct Totals {
    pub blocks: u64,
    pub transactions: u64,
    pub matched: u64,
    /// Differences in transactions that ran BLOCKHASH.
    pub old_hashes: u64,
    pub shadowed: u64,
    /// Shadowed transactions that differ where code read the gas left.
    pub gas_sensitive: u64,
    /// Of those, the ones a gas reading explains (see `watch::explain_gas`).
    pub gas_explained: u64,
    /// Shadowed transactions that differ where code read a code hash.
    pub code_sensitive: u64,
    /// Shadowed transactions where only the deployed code ran out of gas.
    pub cheaper: u64,
    /// Shadowed transactions that differ without reading the gas left.
    pub behavior: u64,
    pub chain_gas: u64,
    pub shadow_gas: u64,
    /// Gas per function of the shadowed contract in identical transactions,
    /// on the deployed code and on the shadow code.
    pub deployed_profile: core::MemVec<SelectorGas>,
    pub shadow_profile: core::MemVec<SelectorGas>,
}

// Whether `dir/delegates.json` already holds older block hashes.
#[cfg(target_family = "unix")]
fn has_block_hashes(_ dir: MemSpan) -> bool uses (fs: mut std::fs::Fs) {
    let Result::Ok(bytes) = fs.read(fetch::join(dir, "delegates.json")) else {
        return false
    }
    match parse(bytes.span()) {
        Result::Ok(doc) => doc.has("blockHashes"),
        Result::Err(_) => false,
    }
}

fn add_totals(_ into: mut Totals, _ from: Totals) {
    into.blocks += from.blocks
    into.transactions += from.transactions
    into.matched += from.matched
    into.old_hashes += from.old_hashes
    into.shadowed += from.shadowed
    into.gas_sensitive += from.gas_sensitive
    into.gas_explained += from.gas_explained
    into.code_sensitive += from.code_sensitive
    into.cheaper += from.cheaper
    into.behavior += from.behavior
    into.chain_gas += from.chain_gas
    into.shadow_gas += from.shadow_gas
    add_profile(mut into.deployed_profile, from.deployed_profile)
    add_profile(mut into.shadow_profile, from.shadow_profile)
}

impl Totals {
    pub fn new() -> Self {
        Totals {
            blocks: 0,
            transactions: 0,
            matched: 0,
            old_hashes: 0,
            shadowed: 0,
            gas_sensitive: 0,
            gas_explained: 0,
            code_sensitive: 0,
            cheaper: 0,
            behavior: 0,
            chain_gas: 0,
            shadow_gas: 0,
            deployed_profile: core::MemVec::new(),
            shadow_profile: core::MemVec::new(),
        }
    }
}

fn print_share(_ matched: u64, _ total: u64) uses (out: mut Stdout) {
    // Nothing to replay matched in full.
    let share = if total == 0 {
        UFixed<1>::from_int(100)
    } else {
        certify::share(matched, total)
    }
    println!(matched, "/", total, " transactions MATCH (", share, "%)")
}

fn read_shadow(_ path: Arg) -> Option<MemBuffer>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let Result::Ok(hex) = fs.read(path) else {
        println!("ERROR ", path, ": cannot read")
        return Option::None
    }
    Option::Some(hex_bytes(hex.span()))
}

// A shadow target: a `0x` address, or a hex file of deployed code, read into
// `like`, whose every copy is shadowed (then the address is 0).
#[cfg(target_family = "unix")]
fn shadow_target(_ arg: Arg, _ like: mut MemBuffer) -> Option<u256>
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let text = arg.span()
    if text.len() > 1 && text[0] == 0x30 && text[1] == 0x78 {
        return Option::Some(core::text::parse_hex_uint(text).unwrap_or(default: 0))
    }
    let Option::Some(code) = read_shadow(arg) else {
        return Option::None
    }
    like = code
    Option::Some(0)
}

/// Replays every transaction of the block saved in `dir`, printing each
/// difference and the block's share of matches, and adds to `totals`.
/// False if the saved answers cannot be used.
#[cfg(target_family = "unix")]
fn replay_block<D: Display>(
    _ dir: D,
    shadow_address: u256,
    shadow_code: MemSpan,
    shadow_like: MemSpan,
    _ totals: mut Totals,
) -> bool
uses (fs: std::fs::Fs, out: mut Stdout)
{
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return false
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return false
    }
    let Option::Some(receipts) = load_response(dir, "receipts.json") else {
        return false
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return false
    }
    let Option::Some(diffs) = load_response(dir, "diff.json") else {
        return false
    }
    let header = ref block["result"]
    var problem = MemBuffer::empty()
    if !check::header_ok(header, mut problem) || !header["transactions"].as_array().is_some() {
        println!(
            "ERROR ",
            dir,
            "/block.json: ",
            problem,
            " (or no transaction list)",
        )
        return false
    }
    let count = header["transactions"].items().len()
    if !same_length(receipts["result"], count)
        || !same_length(prestates["result"], count)
        || !same_length(diffs["result"], count) {
        println!(
            "ERROR ",
            dir,
            ": the receipts and traces do not list one entry per transaction; fetch again",
        )
        return false
    }
    // A load-balanced endpoint may answer the calls from nodes at
    // different heights; around a reorg they can describe different blocks.
    let first = receipts["result"].items()
    if first.len() > 0 && field(first[0], "blockHash") != field(header, "hash") {
        println!(
            "ERROR ",
            dir,
            ": the receipts belong to another block than the header; fetch again",
        )
        return false
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    // Saved by `fetch-block` since EIP-7702 delegates were added; older
    // block directories have none.
    let has_delegates = match fs.metadata(fetch::join(dir, "delegates.json")) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
    let extras = if has_delegates {
        let Option::Some(doc) = load_json(dir, "delegates.json") else {
            return false
        }
        doc
    } else {
        Value::object()
    }
    if !check::extras_ok(extras, mut problem) {
        println!("ERROR ", dir, "/delegates.json: ", problem)
        return false
    }
    let txs = header["transactions"].items()
    var matched: u64 = 0
    for index in 0 .. txs.len() {
        let trace_ok = prestates["result"][index].as_object().is_some()
            && prestates["result"][index].has("result")
            && diffs["result"][index].as_object().is_some()
            && diffs["result"][index].has("result")
        var bad = MemBuffer::empty()
        if !trace_ok
            || !transaction_ok(
                txs[index],
                receipts["result"][index],
                prestates["result"][index]["result"],
                diffs["result"][index]["result"],
                mut bad,
            ) {
            if !trace_ok {
                "a trace has no result".fmt(mut bad)
            }
            println!("ERROR tx ", index, " ", dir, ": ", bad)
            continue
        }
        var text = MemBuffer::empty()
        let found = with (mut text) {
            replay_tx(
                env,
                parent_hash: field(header, "parentHash"),
                extras,
                txs[index],
                receipts["result"][index],
                prestates["result"][index]["result"],
                diffs["result"][index]["result"],
                shadow_address,
                shadow_code,
                shadow_like,
                deployed_gas: mut totals.deployed_profile,
                shadow_gas: mut totals.shadow_profile,
            )
        }
        if found.shadowed {
            totals.shadowed += 1
            totals.chain_gas += found.chain_gas
            totals.shadow_gas += found.fevm_gas
        }
        if found.total() == 0 {
            matched += 1
            continue
        }
        if found.shadowed && found.gas_observed {
            totals.gas_sensitive += 1
            if found.gas_reader != 0 {
                totals.gas_explained += 1
                println!(
                    "DIFF  tx ",
                    index,
                    " ",
                    txs[index]["hash"].text(),
                    " (reads gas after the shadow code ran: 0x",
                    core::text::hex(found.gas_reader, 20),
                    " read it where the runs part)",
                )
            } else {
                println!(
                    "DIFF  tx ",
                    index,
                    " ",
                    txs[index]["hash"].text(),
                    " (reads gas after the shadow code ran, but the runs part elsewhere)",
                )
            }
        } else if found.shadowed && found.code_observed {
            totals.code_sensitive += 1
            print!(
                "DIFF  tx ",
                index,
                " ",
                txs[index]["hash"].text(),
                " (reads code hashes, and the shadow code is other code",
            )
            if !found.shadow_ran {
                print!("; it stops before calling the port")
            }
            if found.code_target != 0 {
                print!(
                    "; the port alone changes it at ",
                    found.code_targets,
                    " of ",
                    found.shadow_targets,
                    " pairs, first 0x",
                    core::text::hex(found.code_target, 20),
                )
            }
            println!(")")
        } else if found.read_blockhash {
            totals.old_hashes += 1
            println!(
                "DIFF  tx ",
                index,
                " ",
                txs[index]["hash"].text(),
                " (ran BLOCKHASH; a hash before the parent's is not in the node's traces)",
            )
        } else if found.shadowed && found.cheaper {
            totals.cheaper += 1
            println!(
                "DIFF  tx ",
                index,
                " ",
                txs[index]["hash"].text(),
                " (the deployed code ran out of gas where the shadow code, cheaper, did not)",
            )
        } else {
            if found.shadowed {
                totals.behavior += 1
            }
            println!("DIFF  tx ", index, " ", txs[index]["hash"].text())
        }
        print!(text)
    }
    let total: u64 = txs.len().downcast_unchecked()
    totals.blocks += 1
    totals.transactions += total
    totals.matched += matched
    print!("block ", header["number"].text(), ": ")
    print_share(matched, total)
    true
}

#[cfg(target_family = "unix")]
fn print_totals(_ totals: Totals, shadowing: bool) uses (out: mut Stdout) {
    print!(totals.blocks, " blocks: ")
    print_share(totals.matched, totals.transactions)
    if totals.old_hashes > 0 {
        println!(
            "  of the differences, ",
            totals.old_hashes,
            " ran BLOCKHASH (see `blockHashes` in the README)",
        )
    }
    if shadowing {
        println!(
            "shadow: ",
            totals.shadowed,
            " transactions ran the shadow code, ",
            totals.shadowed -
                totals.gas_sensitive -
                totals.code_sensitive -
                totals.cheaper -
                totals.behavior,
            " identical, ",
            totals.gas_sensitive,
            " differ where code reads the gas left, ",
            totals.code_sensitive,
            " where code reads code hashes, ",
            totals.behavior,
            " behave differently; gas used chain ",
            totals.chain_gas,
            ", shadow ",
            totals.shadow_gas,
        )
        if totals.cheaper > 0 {
            println!(
                "  ",
                totals.cheaper,
                " more differ where only the deployed code ran out of gas",
            )
        }
        if totals.gas_sensitive > 0 {
            println!(
                "  of the ",
                totals.gas_sensitive,
                " where code reads the gas left, ",
                totals.gas_explained,
                " part at or under a call whose code read it",
            )
        }
        print_profile(totals.deployed_profile, totals.shadow_profile)
    }
}

// The name of a standard ERC-20 or WETH9 function, or nothing.
fn function_name(_ selector: u32) -> String<20> {
    match selector {
        0 => "fallback",
        0xd0e30db0 => "deposit",
        0x2e1a7d4d => "withdraw",
        0xa9059cbb => "transfer",
        0x23b872dd => "transferFrom",
        0x095ea7b3 => "approve",
        0x70a08231 => "balanceOf",
        0xdd62ed3e => "allowance",
        0x18160ddd => "totalSupply",
        0x313ce567 => "decimals",
        0x06fdde03 => "name",
        0x95d89b41 => "symbol",
        0x022c0d9f => "swap",
        0x6a627842 => "mint",
        0x89afcb44 => "burn",
        0xbc25cf77 => "skim",
        0xfff6cae9 => "sync",
        0x0902f1ac => "getReserves",
        0x0dfe1681 => "token0",
        0xd21220a7 => "token1",
        0xc45a0155 => "factory",
        0xd505accf => "permit",
        0x485cc955 => "initialize",
        0x7ecebe00 => "nonces",
        0x3644e515 => "DOMAIN_SEPARATOR",
        0x30adf81f => "PERMIT_TYPEHASH",
        0xba9a7a56 => "MINIMUM_LIQUIDITY",
        0x5909c0d5 => "price0Cumulative",
        0x5a3d5493 => "price1Cumulative",
        0x7464fc3d => "kLast",
        _ => "",
    }
}

// Average gas per call of each function, deployed against shadow, over the
// transactions the shadow code left identical.
#[cfg(target_family = "unix")]
fn print_profile(_ deployed: core::MemVec<SelectorGas>, _ shadow: core::MemVec<SelectorGas>)
uses (out: mut Stdout)
{
    if deployed.len() == 0 {
        return
    }
    println!(
        "gas per call in identical transactions (deployed -> shadow):",
    )
    for i in 0 .. deployed.len() {
        let d = deployed[i]
        var s_gas = watch::Gas::of(0)
        var s_calls: u64 = 0
        for j in 0 .. shadow.len() {
            if shadow[j].selector == d.selector {
                s_gas = shadow[j].gas
                s_calls = shadow[j].calls
            }
        }
        if d.calls == 0 || s_calls == 0 {
            continue
        }
        let before = d.gas / d.calls
        let after = s_gas / s_calls
        // The certificate's cell, as terminal text.
        var html = MemBuffer::empty()
        with (mut html) {
            certify::signed_change(before, after)
        }
        println!(
            "  0x",
            core::text::hex(d.selector as u256, 4),
            " ",
            function_name(d.selector),
            ": ",
            d.calls,
            " calls, ",
            before,
            " -> ",
            after,
            " (",
            html.span(),
            ")",
        )
    }
}

/// `fetch-proofs <dir> [rpc-url]`: for a block saved by `fetch-block`, the
/// Merkle proofs (`eth_getProof`) of every account and slot it touched, at
/// the end of the parent block and of the block itself, and the parent's
/// header, into `dir/proofs.json`. `chain` then checks the block's
/// pre-state and its replayed end state against the two state roots,
/// offline. Run it within about 128 blocks of the block: nodes keep no
/// older state for proofs.
#[cfg(target_family = "unix")]
fn fetch_proofs_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 3 && args.count() != 4 {
        println!("usage: fevm-replay fetch-proofs <dir> [rpc-url]")
        return 2
    }
    let dir = args.get(2)
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return 1
    }
    let Option::Some(diffs) = load_response(dir, "diff.json") else {
        return 1
    }
    let header = ref block["result"]
    let number = field(header, "number")
    let keys = proof::touched(
        prestates["result"],
        diffs["result"],
        header,
        recipients: true,
    )
    var text = MemBuffer::empty()
    "{\"parent\":".fmt(mut text)
    let parent = if args.count() == 4 {
        fetch::header(args.get(3), number: number - 1)
    } else {
        fetch::header(DEFAULT_RPC, number: number - 1)
    }
    let Option::Some(parent) = parent else {
        println!("ERROR the node did not send the parent's header")
        return 1
    }
    parent["result"].write(mut text)
    var slots: u64 = 0
    for position in 0 .. keys.storage_slots() {
        if keys.storage_at(position).occupied {
            slots += 1
        }
    }
    // The same accounts at both ends, the parent's first: it is the older.
    for end in 0 .. 2 {
        if end == 0 {
            ",\"pre\":[".fmt(mut text)
        } else {
            "],\"post\":[".fmt(mut text)
        }
        let at = if end == 0 { number - 1 } else { number }
        var k: usize = 0
        while k < keys.account_count() {
            let count = if keys.account_count() - k < 12 {
                keys.account_count() - k
            } else {
                12
            }
            let answers = if args.count() == 4 {
                fetch::proofs(args.get(3), keys, first: k, count, number: at, dir)
            } else {
                fetch::proofs(DEFAULT_RPC, keys, first: k, count, number: at, dir)
            }
            let Option::Some(answers) = answers else {
                println!(
                    "ERROR no proofs for accounts ",
                    k,
                    " to ",
                    k + count,
                    " at block ",
                    at,
                    " (nodes keep about 128 blocks of state)",
                )
                return 1
            }
            if k > 0 { ",".fmt(mut text) }
            answers.span().fmt(mut text)
            k += count
            if k % 120 == 0 || k == keys.account_count() {
                println!(
                    "  block ",
                    at,
                    ": ",
                    k,
                    " of ",
                    keys.account_count(),
                    " accounts",
                )
            }
        }
    }
    "]}".fmt(mut text)
    let path = fetch::join(dir, "proofs.json")
    let Result::Ok(_) = fs.write(path, text.span()) else {
        println!("ERROR ", path, ": cannot write")
        return 1
    }
    println!(
        "saved proofs of ",
        keys.account_count(),
        " accounts and ",
        slots,
        " slots at blocks ",
        number - 1,
        " and ",
        number,
        " in ",
        path,
    )
    0
}

#[cfg(target_family = "unix")]
/// `chain <dir> [rpc-url]`: replays the saved block as a chain. The world
/// starts as the block's pre-state (every prestate, last transaction
/// first) and each transaction runs on what the one before it left, checked
/// against the chain's receipt and state diff. After the last, the block's
/// withdrawals (EIP-4895) credit their recipients; with an RPC URL, every
/// recipient's balance is checked against the node's for the end of the
/// block.
#[cfg(target_family = "unix")]
fn chain_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 3 && args.count() != 4 {
        println!("usage: fevm-replay chain <dir> [rpc-url]")
        return 2
    }
    let dir = args.get(2)
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return 1
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(receipts) = load_response(dir, "receipts.json") else {
        return 1
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return 1
    }
    let Option::Some(diffs) = load_response(dir, "diff.json") else {
        return 1
    }
    let header = ref block["result"]
    let txs = header["transactions"].items()
    let count = txs.len()
    if !same_length(receipts["result"], count)
        || !same_length(prestates["result"], count)
        || !same_length(diffs["result"], count) {
        println!(
            "ERROR ",
            dir,
            ": the receipts and traces do not list one entry per transaction",
        )
        return 1
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let extras = match load_json(dir, "delegates.json") {
        Option::Some(doc) => doc,
        Option::None => Value::object(),
    }
    // The block's pre-state.
    var world = fevm::WorldState::empty()
    var i = count
    while i > 0 {
        i -= 1
        load::add_prestate(mut world, prestates["result"][i]["result"])
        load::clear_created(
            mut world,
            prestates["result"][i]["result"],
            diffs["result"][i]["result"],
        )
    }
    // An empty account does not exist on chain (EIP-161), though the
    // tracer lists accounts a transaction only looked at; a record of one
    // would count as existing, as for an EIP-7702 authority's refund.
    var empty: core::MemVec<u256> = core::MemVec::new()
    for k in 0 .. world.account_count() {
        let address = world.account_at(k).address
        if world.is_empty(address) && !world.has_storage(address) {
            empty.push(address)
        }
    }
    for k in 0 .. empty.len() {
        world.remove_account(empty[k])
    }
    world.set_block_hash(env.number - 1, field(header, "parentHash"))
    load::add_extras(mut world, extras)
    // With proofs saved beside the block (`fetch-proofs`), the block's
    // pre-state is checked against the parent's state root here, and the end
    // state against the block's own after the last transaction. Both roots
    // come from headers whose hashes are checked, so what a MATCH rests on
    // is the block hash, not the node.
    var proofs = Value::object()
    let proving = has_file(dir, "proofs.json")
    var keys = fevm::WorldState::empty()
    var parent_root: u256 = 0
    var unproven: u64 = 0
    if proving {
        let Option::Some(doc) = load_json(dir, "proofs.json") else {
            return 1
        }
        proofs = doc
        let parent = ref proofs["parent"]
        if proof::header_hash(header) != field(header, "hash")
            || proof::header_hash(parent) != field(parent, "hash")
            || field(parent, "hash") != field(header, "parentHash") {
            println!(
                "PROOF ",
                dir,
                ": the headers do not hash to the block's hash and its parent's",
            )
            return 1
        }
        parent_root = field(parent, "stateRoot")
        keys = proof::touched(
            prestates["result"],
            diffs["result"],
            header,
            recipients: false,
        )
        var text = MemBuffer::empty()
        let pre = with (mut text) {
            proof::check(
                world,
                state_root: parent_root,
                proofs["pre"],
                keys,
                written: proof::system_writes(header),
                skip: core::MemVec::new(),
                code_unknown: core::MemVec::new(),
            )
        }
        print!(text)
        println!(
            "headers: block 0x",
            core::text::hex(field(header, "hash"), 32),
            " and its parent hash to themselves",
        )
        print_checked("pre-state", "the parent's", pre)
        unproven += pre.differ + pre.broken + pre.unproven
    }
    var matched: u64 = 0
    var old_hashes: u64 = 0
    var drift: u64 = 0
    for index in 0 .. count {
        // The carried state must hold what the node saw before this
        // transaction, for every account and slot it touched.
        let off = load::prestate_mismatches(world, prestates["result"][index]["result"])
        if off > 0 {
            drift += 1
            println!(
                "STATE tx ",
                index,
                ": ",
                off,
                " values differ from the node's prestate",
            )
        }
        let Option::Some(before) = world.try_clone() else {
            println!("ERROR out of memory")
            return 1
        }
        var expected = before
        apply_diff(mut expected, diffs["result"][index]["result"])
        var buffers = fevm::Buffers::new()
        var tracer = watch::GasWatch::new(shadows: core::MemVec::new())
        let applied = fevm::transact(
            world,
            load_tx(txs[index]),
            env,
            fevm::Config::osaka(),
            mut buffers,
            mut tracer,
        )
        var text = MemBuffer::empty()
        let found = with (mut text) {
            compare(
                applied.receipt,
                applied.state,
                receipts["result"][index],
                expected,
                gas_must_match: true,
            )
        }
        if found.total() == 0 {
            matched += 1
            world = applied.state
        } else {
            if tracer.read_blockhash {
                old_hashes += 1
                println!(
                    "DIFF  tx ",
                    index,
                    " ",
                    txs[index]["hash"].text(),
                    " (ran BLOCKHASH; a hash before the parent's is not in the node's traces)",
                )
            } else {
                println!("DIFF  tx ", index, " ", txs[index]["hash"].text())
                print!(text)
                // The same transaction on its own prestate: the first call
                // whose gas differs shows where the carried state matters.
                var alone = watch::GasWatch::new(shadows: core::MemVec::new())
                var more = fevm::Buffers::new()
                let mut_world = replay::build_world(
                    prestates["result"][index]["result"],
                    env,
                    field(header, "parentHash"),
                    extras,
                    core::MemVec::new(),
                    MemBuffer::empty().span(),
                )
                fevm::transact(
                    mut_world,
                    load_tx(txs[index]),
                    env,
                    fevm::Config::osaka(),
                    mut more,
                    mut alone,
                )
                let n = if alone.calls.len() < tracer.calls.len() {
                    alone.calls.len()
                } else {
                    tracer.calls.len()
                }
                for c in 0 .. n {
                    let x = tracer.calls[c]
                    let y = alone.calls[c]
                    if x.used != y.used || x.gas != y.gas || x.to != y.to {
                        println!(
                            "  call ",
                            c,
                            " to 0x",
                            core::text::hex(x.to, 20),
                            " selector 0x",
                            core::text::hex(x.selector as u256, 4),
                            ": gas given ",
                            x.gas,
                            " used ",
                            x.used,
                            " in the chain, given ",
                            y.gas,
                            " used ",
                            y.used,
                            " on its own prestate",
                        )
                        break
                    }
                }
            }
            // Go on from the chain's state, so one difference stays one.
            let Option::Some(chain_state) = expected.try_clone() else {
                return 1
            }
            world = chain_state
        }
    }
    print!("chain ", dir, ": ")
    print_share(matched, count.downcast_unchecked())
    if old_hashes > 0 {
        println!("  of the differences, ", old_hashes, " ran BLOCKHASH")
    }
    if drift > 0 {
        println!(
            "  ",
            drift,
            " transactions started from a state that differs from the node's prestate",
        )
    }
    // Withdrawals: each credits its recipient, in gwei.
    let rpc = args.count() == 4
    var unknown: u64 = 0
    var code_unknown: core::MemVec<u256> = core::MemVec::new()
    var paid: u64 = 0
    if header.has("withdrawals") {
        let withdrawals = header["withdrawals"].items()
        paid = withdrawals.len().downcast_unchecked()
        for w in 0 .. withdrawals.len() {
            let address = field(withdrawals[w], "address")
            // A recipient no transaction touched is not in the world: its
            // balance before the withdrawals is the parent block's.
            if !world.exists(address) {
                if proving {
                    match proof::find_account(proofs["pre"], state_root: parent_root, address) {
                        Option::Some(account) => {
                            if !world.set_balance(address, account.balance)
                                || !world.set_nonce(address, account.nonce) {
                                unknown += 1
                            }
                            // Its code, if any, is not fetched.
                            if account.code_hash != proof::EMPTY_CODE {
                                code_unknown.push(address)
                            }
                        },
                        Option::None => {
                            unknown += 1
                        },
                    }
                } else if rpc {
                    match fetch::balance_at(args.get(3), address, number: env.number - 1) {
                        Option::Some(balance) => {
                            if !world.set_balance(address, balance) {
                                unknown += 1
                            }
                        },
                        Option::None => {
                            unknown += 1
                        },
                    }
                } else {
                    unknown += 1
                }
            }
            if !world
                .set_balance(
                    address,
                    world.balance(address) + field(withdrawals[w], "amount") * 1_000_000_000,
                ) {
                unknown += 1
            }
        }
    }
    if proving {
        // The end-of-block system calls (EIP-7002, EIP-7251) are not run, so
        // their contracts are not compared.
        keys = proof::touched(
            prestates["result"],
            diffs["result"],
            header,
            recipients: true,
        )
        var skip: core::MemVec<u256> = core::MemVec::new()
        skip.push(proof::WITHDRAWAL_REQUESTS)
        skip.push(proof::CONSOLIDATION_REQUESTS)
        var text = MemBuffer::empty()
        let post = with (mut text) {
            proof::check(
                world,
                state_root: field(header, "stateRoot"),
                proofs["post"],
                keys,
                written: core::MemVec::new(),
                skip,
                code_unknown,
            )
        }
        print!(text)
        print_checked("end state", "the block's", post)
        unproven += post.differ + post.broken + post.unproven
        if paid > 0 {
            println!(
                "withdrawals: ",
                paid,
                " credited, their recipients checked by the end state's proofs",
            )
        }
    }
    var right: u64 = 0
    var checked: u64 = 0
    if rpc && paid > 0 {
        let withdrawals = header["withdrawals"].items()
        for w in 0 .. withdrawals.len() {
            let address = field(withdrawals[w], "address")
            // A recipient paid twice is checked once, after both.
            var seen = false
            for v in 0 .. w {
                if field(withdrawals[v], "address") == address {
                    seen = true
                }
            }
            if seen { continue }
            checked += 1
            match fetch::balance_at(args.get(3), address, number: env.number) {
                Option::Some(balance) => {
                    if balance == world.balance(address) {
                        right += 1
                    } else {
                        println!(
                            "DIFF  withdrawal to 0x",
                            core::text::hex(address, 20),
                            ": node ",
                            balance,
                            ", fevm ",
                            world.balance(address),
                        )
                    }
                },
                Option::None => {
                    println!("ERROR no balance for 0x", core::text::hex(address, 20))
                },
            }
        }
        println!(
            "withdrawals: ",
            paid,
            " to ",
            checked,
            " recipients, ",
            right,
            " balances match the node at the end of the block",
        )
    } else if !proving && paid > 0 {
        println!(
            "withdrawals: ",
            paid,
            " credited; pass an RPC URL or fetch proofs to check the recipients' balances",
        )
    }
    if matched == count.downcast_unchecked() && right == checked && unknown == 0 && unproven == 0 {
        0
    } else {
        1
    }
}

// Whether `dir/name` exists (and reads).
#[cfg(target_family = "unix")]
fn has_file<D: Display>(_ dir: D, _ name: String<16>) -> bool
uses (fs: std::fs::Fs)
{
    match fs.read(fetch::join(dir, name)) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

fn print_checked(_ what: String<10>, _ whose: String<12>, _ found: proof::Checked)
uses (out: mut Stdout)
{
    println!(
        what,
        ": ",
        found.accounts,
        " accounts and ",
        found.slots,
        " slots proven against ",
        whose,
        " state root, ",
        found.differ,
        " differ",
    )
    if found.written > 0 {
        println!(
            "  ",
            found.written,
            " slots set by the block's first system calls, checked",
        )
    }
    if found.skipped > 0 {
        println!(
            "  ",
            found.skipped,
            " request contracts (EIP-7002, EIP-7251) not compared",
        )
    }
    if found.unproven > 0 || found.broken > 0 {
        println!(
            "  ",
            found.unproven,
            " touched accounts and slots without a proof, ",
            found.broken,
            " proofs that do not hold",
        )
    }
}

/// `certify <out.html> <deployed.hex> <port-dir> <Contract> <token.hex|-> <mutants> <dir>...`:
/// everything the tool knows to check about a port, in one HTML page. It
/// builds the port from source with `fe`, replays the saved blocks with it
/// in place of every copy of the deployed code, mutates their transactions
/// (`fuzz-block`), fuzzes it with random calls (`fuzz` or `fuzz-pair`), and
/// scores the checks themselves by planting `mutants` mutants in the port
/// (checked on the first ten blocks). Exits 1 if anything differs.
#[cfg(target_family = "unix")]
fn certify_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 9 {
        println!(
            "usage: fevm-replay certify <out.html> <deployed.hex> <port-dir> <Contract> <token.hex|-> <mutants> <dir>...",
        )
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(3)) else {
        return 1
    }
    let token = if starts_with_proxy(args.get(6)) {
        let Option::Some(code) = read_proxy_token(args.get(6)) else {
            return 1
        }
        code
    } else if is_word(args.get(6), [0x75, 0x73, 0x64, 0x74]) {
        // `usdt`: the USDT scenario (see `fuzz::is_usdt`).
        var marker = MemBuffer::empty()
        marker.push(0x55)
        marker
    } else if args.get(6).span().len() == 1 {
        MemBuffer::empty()
    } else {
        let Option::Some(code) = read_shadow(args.get(6)) else {
            return 1
        }
        code
    }
    let wanted: u64 = core::text::parse_uint(args.get(7).span())
        .unwrap_or(default: 20)
        .downcast_unchecked()
    let first_dir: usize = 8
    let last_dir = args.count()
    // The port, built from its source.
    var built = MemBuffer::empty()
    "/tmp/fevm-replay-certify-".fmt(mut built)
    args.get(5).fmt(mut built)
    println!("building ", args.get(4), " in ", args.get(5))
    // The port's source, to point each function's row at its lines.
    let port_source = match fs.read(fetch::join(args.get(4), "src/lib.fe")) {
        Result::Ok(bytes) => bytes,
        Result::Err(_) => MemBuffer::empty(),
    }
    if !fe_build(args.get(4), built) {
        println!("ERROR ", args.get(4), ": does not build with fe")
        return 1
    }
    var binary = MemBuffer::empty()
    built.fmt(mut binary)
    "/".fmt(mut binary)
    args.get(5).fmt(mut binary)
    ".runtime.bin".fmt(mut binary)
    let Result::Ok(hex) = fs.read(binary) else {
        println!("ERROR ", binary, ": cannot read")
        return 1
    }
    let port = hex_bytes(hex.span())
    // Mainnet, as it happened, with the port in place.
    println!("replaying ", last_dir - first_dir, " blocks")
    var totals = Totals::new()
    for d in first_dir .. last_dir {
        add_shadow_block(args.get(d), port.span(), deployed.span(), mut totals)
    }
    // Mainnet, mutated.
    println!("mutating their transactions")
    var found = mutate::Mutations::new()
    var first_block = MemBuffer::empty()
    var first_hash = MemBuffer::empty()
    for d in first_dir .. last_dir {
        mutate_dir(
            args.get(d),
            deployed: deployed.span(),
            port: port.span(),
            count: 20,
            seed: 7,
            mut found,
            mut first_block,
            mut first_hash,
            fetch: MemBuffer::empty(),
        )
    }
    // Random calls.
    println!("fuzzing")
    var fuzzed = fuzz::Findings::new()
    fuzz::fuzz(
        deployed.span(),
        port.span(),
        token: token.span(),
        runs: 1000,
        steps: 60,
        seed: 1,
        mut fuzzed,
    )
    // The checks, checked.
    println!("planting ", wanted, " mutants")
    let score = score_mutants(
        args.get(4),
        args.get(5),
        deployed: deployed.span(),
        token: token.span(),
        wanted,
        first_dir,
        last_dir: if last_dir - first_dir > 10 {
            first_dir + 10
        } else {
            last_dir
        },
        each: false,
    )
    let fuzz_differ = fuzzed.calls[0] - fuzzed.identical[0]
    let clean = totals.failures() + found.failures() + fuzzed.failures() + score.failures() == 0
    var html = MemBuffer::empty()
    with (mut html) {
        certify::open(args.get(5))
        "<p>Port source <code>".fmt(mut html)
        args.get(4).fmt(mut html)
        "</code>, runtime code hash <code>0x".fmt(mut html)
        core::text::hex(fuzz::keccak(MemBuffer::from_span(port.span())), 32).fmt(mut html)
        "</code> (".fmt(mut html)
        port.len().fmt(mut html)
        " bytes), in place of the deployed code with hash <code>0x".fmt(mut html)
        core::text::hex(fuzz::keccak(MemBuffer::from_span(deployed.span())), 32).fmt(mut html)
        "</code> (".fmt(mut html)
        deployed.len().fmt(mut html)
        " bytes). Blocks <code>".fmt(mut html)
        args.get(first_dir).fmt(mut html)
        "</code> to <code>".fmt(mut html)
        args.get(last_dir - 1).fmt(mut html)
        "</code>.</p>\n".fmt(mut html)
        if clean {
            "<p class=\"verdict\">No behavior difference: every transaction that ran the port, every mutation of them and every random call behaved as on the deployed code.</p>\n"
                .fmt(mut html)
        } else {
            "<p class=\"verdict bad\">Differences found: see below.</p>\n".fmt(mut html)
        }
        "<table>\n".fmt(mut html)
        certify::summary(totals)
        certify::summary(found)
        certify::summary(fuzzed)
        certify::summary(score)
        "</table>\n".fmt(mut html)

        "<h2>Mainnet, as it happened</h2>\n<p>Each transaction of the blocks ran on its own mainnet pre-state, with the port in place of every account holding the deployed code, and was compared with the chain: status, logs, every balance, nonce and storage slot. Only gas may differ.</p>\n<table>\n"
            .fmt(mut html)
        certify::row("Blocks", totals.blocks)
        certify::row("Transactions", totals.transactions)
        certify::row("Transactions that ran the port", totals.shadowed)
        certify::row(
            "Identical to the chain",
            totals.shadowed -
                totals.gas_sensitive -
                totals.code_sensitive -
                totals.cheaper -
                totals.behavior,
        )
        certify::row(
            "Differ where other code read the gas left",
            totals.gas_sensitive,
        )
        certify::row(
            "&nbsp;&nbsp;of which part at or under that code",
            totals.gas_explained,
        )
        certify::row(
            "Differ where other code read code hashes",
            totals.code_sensitive,
        )
        certify::row("Only the deployed code ran out of gas", totals.cheaper)
        certify::row("<strong>Behave differently</strong>", totals.behavior)
        "</table>\n".fmt(mut html)
        certificate_gas(
            totals.deployed_profile,
            totals.shadow_profile,
            port_source.span(),
        )

        "<h2>Mainnet, mutated</h2>\n<p>Each transaction that touched the deployed code ran again with its calldata changed, or with one call into the contract changed in flight, on both codes, gas free.</p>\n<table>\n"
            .fmt(mut html)
        certify::row("Transactions", found.transactions)
        certify::row("Runs", found.runs)
        certify::row("Identical", found.identical)
        certify::row(
            "Differ where other code read the gas left or code hashes",
            found.sensitive,
        )
        certify::row("&nbsp;&nbsp;of which code hashes", found.code_sensitive)
        certify::row(
            "&nbsp;&nbsp;of the rest, part at or under the code that read the gas left",
            found.gas_explained,
        )
        certify::row("Only the deployed code ran out of gas", found.cheaper)
        certify::row(
            "Differ after an address-shaped word got upper bits",
            found.dirtied,
        )
        certify::row("Differ after the calldata was cut short", found.shortened)
        certify::row("<strong>Differ</strong>", found.differ)
        "</table>\n<p>The port ran ".fmt(mut html)
        let ran = watch::coverage_count(found.covered)
        let total: u64 = watch::instructions(port.span()).downcast_unchecked()
        ran.fmt(mut html)
        " of its ".fmt(mut html)
        total.fmt(mut html)
        " instructions (".fmt(mut html)
        certify::percent(ran, total)
        ") in these runs.</p>\n".fmt(mut html)

        "<h2>Random calls</h2>\n<p>1,000 sessions of up to 60 random calls each, against both codes in step"
            .fmt(mut html)
        if token.len() > 0 {
            ", checking the pair's invariants after every call".fmt(mut html)
        }
        ".</p>\n<table>\n".fmt(mut html)
        certify::row("Well-formed calls", fuzzed.calls[0])
        certify::row(
            "<strong>Well-formed calls that differ</strong>",
            fuzz_differ,
        )
        certify::row(
            "Calls with short calldata that differ",
            fuzzed.calls[1] - fuzzed.identical[1],
        )
        certify::row(
            "Calls with dirty addresses that differ",
            fuzzed.calls[2] - fuzzed.identical[2],
        )
        certify::row("Invariants broken", fuzzed.invariant_breaks)
        "</table>\n<p>The port ran ".fmt(mut html)
        let ran2 = watch::coverage_count(fuzzed.covered)
        ran2.fmt(mut html)
        " of its ".fmt(mut html)
        total.fmt(mut html)
        " instructions (".fmt(mut html)
        certify::percent(ran2, total)
        ").</p>\n".fmt(mut html)

        "<h2>How sharp the checks are</h2>\n<p>Mutants of the port's source, one operator changed each, built with <code>fe</code> and put through random calls and then mutations of the first ten blocks. The unchanged port passed the same checks first.</p>\n<table>\n"
            .fmt(mut html)
        certify::row("Operators in the source", score.sites)
        certify::row("Mutants built", score.built)
        certify::row("Killed by random calls", score.by_fuzz)
        certify::row("Killed by mainnet mutations", score.by_mainnet)
        certify::row("Survived", score.survived)
        "</table>\n<p>".fmt(mut html)
        certify::percent(score.by_fuzz + score.by_mainnet, score.built)
        " killed.".fmt(mut html)
        if score.survived > 0 {
            " A survivor is a blind spot of the checks or a change that means the same; each deserves a look:</p>\n<pre>"
                .fmt(mut html)
            certify::escape(score.survivors.span())
            "</pre>\n".fmt(mut html)
        } else {
            "</p>\n".fmt(mut html)
        }
        certify::close()
    }
    let Result::Ok(_) = fs.write(args.get(2), html.span()) else {
        println!("ERROR ", args.get(2), ": cannot write")
        return 1
    }
    println!("wrote ", args.get(2))
    // The badge beside the page: the same path with `.svg` for `.html`.
    var badge_path = MemBuffer::empty()
    let out_path = args.get(2).span()
    let html: [u8; 5] = [0x2e, 0x68, 0x74, 0x6d, 0x6c]
    var keep = out_path.len()
    if keep > 5 {
        var ends = true
        for i in 0 .. 5 {
            if out_path[keep - 5 + i] != html[i] {
                ends = false
            }
        }
        if ends { keep -= 5 }
    }
    for i in 0 .. keep {
        badge_path.push(out_path[i])
    }
    ".svg".fmt(mut badge_path)
    var svg = MemBuffer::empty()
    with (mut svg) {
        certify::badge(args.get(5), clean)
    }
    let Result::Ok(_) = fs.write(badge_path, svg.span()) else {
        println!("ERROR ", badge_path, ": cannot write")
        return 1
    }
    println!("wrote ", badge_path)
    if clean { 0 } else { 1 }
}

// Replays the block in `dir` with `port` in place of every copy of
// `deployed`, quietly, adding to `totals`.
fn add_shadow_block<D: Display>(
    _ dir: D,
    _ port: MemSpan,
    _ deployed: MemSpan,
    _ totals: mut Totals,
)
uses (fs: std::fs::Fs, out: mut Stdout)
{
    if !replay_block(
        dir,
        shadow_address: 0,
        shadow_code: port,
        shadow_like: deployed,
        mut totals,
    ) {
        println!("ERROR ", dir, ": skipped")
    }
}

// The gas table of a certificate.
fn certificate_gas(
    _ deployed: core::MemVec<SelectorGas>,
    _ shadow: core::MemVec<SelectorGas>,
    _ source: core::MemSpan,
)
uses (html: mut MemBuffer)
{
    if deployed.len() == 0 {
        return
    }
    "<h3>Gas per call in identical transactions</h3>\n<div class=\"scroll\"><table>\n<tr><th>Function</th><th>In the port's source</th><th class=\"n\">Calls</th><th class=\"n\">Deployed</th><th class=\"n\">Port</th><th class=\"n\">Change</th></tr>\n"
        .fmt(mut html)
    for i in 0 .. deployed.len() {
        let d = deployed[i]
        var s_gas = watch::Gas::of(0)
        var s_calls: u64 = 0
        for j in 0 .. shadow.len() {
            if shadow[j].selector == d.selector {
                s_gas = shadow[j].gas
                s_calls = shadow[j].calls
            }
        }
        if d.calls == 0 || s_calls == 0 {
            continue
        }
        let before = d.gas / d.calls
        let after = s_gas / s_calls
        "<tr><td><code>".fmt(mut html)
        function_name(d.selector).fmt(mut html)
        "</code></td><td>".fmt(mut html)
        // Fe writes no source map: the line comes from the `msg` variant
        // with this selector and the `recv` arm that runs it.
        let place = source::locate(source, d.selector)
        if place.handled > 0 {
            "<code>src/lib.fe:".fmt(mut html)
            place.handled.fmt(mut html)
            "</code>".fmt(mut html)
        } else if place.declared > 0 {
            "<code>src/lib.fe:".fmt(mut html)
            place.declared.fmt(mut html)
            "</code>".fmt(mut html)
        } else {
            "&ndash;".fmt(mut html)
        }
        "</td><td class=\"n\">".fmt(mut html)
        d.calls.fmt(mut html)
        "</td><td class=\"n\">".fmt(mut html)
        before.fmt(mut html)
        "</td><td class=\"n\">".fmt(mut html)
        after.fmt(mut html)
        "</td><td class=\"n\">".fmt(mut html)
        certify::signed_change(before, after)
        "</td></tr>\n".fmt(mut html)
    }
    "</table></div>\n".fmt(mut html)
}

// What fails a port, check by check (see `certify::Check`).

impl certify::Check for Totals {
    fn name(self) -> String<31> {
        "Mainnet, as it happened"
    }
    // Behaving differently; gas and code-hash readings are explained.
    fn failures(self) -> u64 {
        self.behavior
    }
}

impl certify::Check for mutate::Mutations {
    fn name(self) -> String<31> {
        "Mainnet, mutated"
    }
    fn failures(self) -> u64 {
        self.differ
    }
}

impl certify::Check for fuzz::Findings {
    fn name(self) -> String<31> {
        "Random calls"
    }
    // Well-formed calls that differ, and broken invariants. Short calldata
    // and dirty addresses are shown, not counted: old solc read them loosely.
    fn failures(self) -> u64 {
        self.calls[0] - self.identical[0] + self.invariant_breaks
    }
}

impl certify::Check for MutantScore {
    fn name(self) -> String<31> {
        "Mutants: the unchanged port"
    }
    // Surviving mutants are blind spots, not failures; the unchanged port
    // failing its own checks is.
    fn failures(self) -> u64 {
        if self.baseline { 0 } else { 1 }
    }
}

/// What mutation testing found (see `score_mutants`).
pub struct MutantScore {
    pub sites: u64,
    pub built: u64,
    pub by_fuzz: u64,
    pub by_mainnet: u64,
    pub survived: u64,
    /// With `each`: the mutants mainnet mutations kill on their own.
    pub mainnet_alone: u64,
    /// One line per survivor: its line number and text.
    pub survivors: MemBuffer,
    /// Whether the unchanged port built and passed; if not, nothing else
    /// is meaningful.
    pub baseline: bool,
}

/// Builds the ingot at `dir` with `fe` into `out_dir`.
#[cfg(target_family = "unix")]
fn fe_build<D: Display, O: Display>(_ dir: D, _ out_dir: O) -> bool
uses (proc: mut std::process::Spawn)
{
    let command = std::process::Command::new("fe")
        .arg("build")
        .arg("-O")
        .arg("2")
        .arg("--out-dir")
        .arg(out_dir)
        .arg(dir)
        .stdout(std::process::Redirect::Capture)
        .stderr(std::process::Redirect::Capture)
    match proc.output(command) {
        Result::Ok(output) => output.status.success(),
        Result::Err(_) => false,
    }
}

/// Plants `wanted` mutants, spread over the operators in `port_dir`'s
/// `src/lib.fe` (see `mutants::sites`), builds each with `fe` as
/// `contract`, and checks it as `fuzz` or `fuzz-pair` would (a well-formed
/// call that differs, or a broken invariant, kills it), then on the blocks
/// in arguments `first_dir` onward as `fuzz-block` would. The unchanged
/// port goes first and must pass.
#[cfg(target_family = "unix")]
fn score_mutants<P: Display, C: Display>(
    _ port_dir: P,
    _ name: C,
    deployed: MemSpan,
    token: MemSpan,
    wanted: u64,
    first_dir: usize,
    last_dir: usize,
    each: bool,
) -> MutantScore
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    var score = MutantScore {
        sites: 0,
        built: 0,
        by_fuzz: 0,
        by_mainnet: 0,
        survived: 0,
        mainnet_alone: 0,
        survivors: MemBuffer::empty(),
        baseline: false,
    }
    let Result::Ok(source) = fs.read(fetch::join(port_dir, "src/lib.fe")) else {
        println!("ERROR ", port_dir, "/src/lib.fe: cannot read")
        return score
    }
    let Result::Ok(manifest) = fs.read(fetch::join(port_dir, "fe.toml")) else {
        println!("ERROR ", port_dir, "/fe.toml: cannot read")
        return score
    }
    // The mutant's ingot: the port's manifest and one mutated source.
    // One work directory per contract, so runs for different ports can
    // share a machine.
    var work = MemBuffer::empty()
    "/tmp/fevm-replay-mutant-".fmt(mut work)
    name.fmt(mut work)
    let Result::Ok(_) = fs.create_dir_all(fetch::join(work, "src")) else {
        println!("ERROR ", work, ": cannot create")
        return score
    }
    let Result::Ok(_) = fs.write(fetch::join(work, "fe.toml"), manifest.span()) else {
        return score
    }
    var binary = MemBuffer::empty()
    work.fmt(mut binary)
    "/out/".fmt(mut binary)
    name.fmt(mut binary)
    ".runtime.bin".fmt(mut binary)
    let all = mutants::sites(source.span())
    let total: u64 = all.len().downcast_unchecked()
    score.sites = total
    let count = if wanted > total { total } else { wanted }
    var n: u64 = 0
    while n <= count {
        let pick: usize = if n == 0 {
            0
        } else {
            ((n - 1) * total / count).downcast_unchecked()
        }
        let mutated = if n == 0 {
            MemBuffer::from_span(source.span())
        } else {
            mutants::apply(source.span(), all[pick])
        }
        let Result::Ok(_) = fs.write(fetch::join(work, "src/lib.fe"), mutated.span()) else {
            return score
        }
        if !fe_build(work, fetch::join(work, "out")) {
            if n == 0 {
                println!("ERROR the port itself does not build with fe")
                return score
            }
            n += 1
            continue
        }
        let Result::Ok(hex) = fs.read(binary) else {
            println!("ERROR ", binary, ": cannot read")
            return score
        }
        let port = hex_bytes(hex.span())
        var fuzzed = fuzz::Findings::new()
        fuzz::fuzz(
            deployed,
            port.span(),
            token,
            runs: 300,
            steps: 60,
            seed: 1,
            mut fuzzed,
        )
        let killed = fuzzed.identical[0] != fuzzed.calls[0] || fuzzed.invariant_breaks > 0
        var mainnet = false
        // With `each`, mainnet mutations check every mutant, not only the
        // ones random calls missed, so each check's own score shows.
        if (each || !killed) && last_dir > first_dir {
            var found = mutate::Mutations::new()
            var first_block = MemBuffer::empty()
            var first_hash = MemBuffer::empty()
            for d in first_dir .. last_dir {
                mutate_dir(
                    args.get(d),
                    deployed,
                    port: port.span(),
                    count: 20,
                    seed: 7,
                    mut found,
                    mut first_block,
                    mut first_hash,
                    fetch: MemBuffer::empty(),
                )
            }
            mainnet = found.differ > 0
        }
        if n == 0 {
            if killed || mainnet {
                println!("ERROR the unchanged port already differs; fix it first")
                return score
            }
            score.baseline = true
            n += 1
            continue
        }
        score.built += 1
        if mainnet {
            score.mainnet_alone += 1
        }
        if killed {
            score.by_fuzz += 1
        } else if mainnet {
            score.by_mainnet += 1
        } else {
            score.survived += 1
            let (line, start, end) = mutants::line_of(mutated.span(), all[pick].at)
            "line ".fmt(mut score.survivors)
            line.fmt(mut score.survivors)
            ": ".fmt(mut score.survivors)
            let text = mutated.span()
            var i = start
            // Skip the indentation.
            while i < end && text[i] == 0x20 {
                i += 1
            }
            while i < end {
                score.survivors.push(text[i])
                i += 1
            }
            "\n".fmt(mut score.survivors)
        }
        n += 1
    }
    score
}

/// `mutants <port-dir> <Contract> <deployed.hex> <token.hex|-> <count> [<dir>...]`:
/// mutation testing of the checks (see `score_mutants`): prints the
/// survivors and the share of mutants killed.
#[cfg(target_family = "unix")]
fn mutants_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 7 {
        println!(
            "usage: fevm-replay mutants <port-dir> <Contract> <deployed.hex> <token.hex|-> <count> [<dir>...]",
        )
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(4)) else {
        return 1
    }
    let token = if starts_with_proxy(args.get(5)) {
        let Option::Some(code) = read_proxy_token(args.get(5)) else {
            return 1
        }
        code
    } else if is_word(args.get(5), [0x75, 0x73, 0x64, 0x74]) {
        // `usdt`: the USDT scenario (see `fuzz::is_usdt`).
        var marker = MemBuffer::empty()
        marker.push(0x55)
        marker
    } else if args.get(5).span().len() == 1 {
        MemBuffer::empty()
    } else {
        let Option::Some(code) = read_shadow(args.get(5)) else {
            return 1
        }
        code
    }
    let wanted: u64 = core::text::parse_uint(args.get(6).span())
        .unwrap_or(default: 20)
        .downcast_unchecked()
    // `each` before the blocks: mainnet mutations check every mutant.
    let each = args.count() > 7 && is_word(args.get(7), [0x65, 0x61, 0x63, 0x68])
    let score = score_mutants(
        args.get(2),
        args.get(3),
        deployed: deployed.span(),
        token: token.span(),
        wanted,
        first_dir: if each { 8 } else { 7 },
        last_dir: args.count(),
        each,
    )
    if !score.baseline {
        return 1
    }
    println!("mutated ", args.get(2), ": ", score.sites, " operators")
    print!(score.survivors)
    print_score(score)
    0
}

fn print_score(_ score: MutantScore) uses (out: mut Stdout) {
    println!(
        "  ",
        score.built,
        " mutants built: ",
        score.by_fuzz,
        " killed by fuzzing, ",
        score.by_mainnet,
        " by mainnet mutations, ",
        score.survived,
        " survived; ",
        if score.built == 0 {
            0
        } else {
            (score.by_fuzz + score.by_mainnet) * 100 / score.built
        },
        "% killed",
    )
    if score.mainnet_alone > 0 {
        println!(
            "  mainnet mutations alone kill ",
            score.mainnet_alone,
            " of the ",
            score.built,
        )
    }
}

/// `opgas <address|deployed.hex> <port.bin> <selector> <dir>...`: the gas
/// the deployed code and the port spend on each opcode in calls to
/// `selector` (`0x022c0d9f`, say; 0 for every call), over the transactions of
/// the saved blocks that run the deployed code. Each transaction runs once
/// with each code, as in shadow replay. Calls the code makes are left out.
fn opgas_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() < 6 {
        println!(
            "usage: fevm-replay opgas <shadow-address>|<deployed.hex> <port.bin> <selector> <dir>...",
        )
        return 2
    }
    var like = MemBuffer::empty()
    let Option::Some(address) = shadow_target(args.get(2), mut like) else {
        return 1
    }
    let Option::Some(port) = read_shadow(args.get(3)) else {
        return 1
    }
    let selector: u32 = core::text::parse_hex_uint(args.get(4).span())
        .unwrap_or(default: 0)
        .downcast_truncate()
    var deployed_gas: core::MemVec<u64> = core::MemVec::new()
    var port_gas: core::MemVec<u64> = core::MemVec::new()
    for _ in 0 .. 256 {
        deployed_gas.push(0)
        port_gas.push(0)
    }
    var runs: u64 = 0
    for d in 5 .. args.count() {
        let dir = args.get(d)
        let Option::Some(chain) = load_response(dir, "chain.json") else {
            continue
        }
        let Option::Some(block) = load_response(dir, "block.json") else {
            continue
        }
        let Option::Some(prestates) = load_response(dir, "prestate.json") else {
            continue
        }
        let header = ref block["result"]
        let env = load_block(
            header,
            chain_id: field(chain, "result"),
            blobbasefee: fetch::header_blob_fee(header).as_wei(),
        )
        let extras = match load_json(dir, "delegates.json") {
            Option::Some(doc) => doc,
            Option::None => Value::object(),
        }
        let txs = header["transactions"].items()
        for index in 0 .. txs.len() {
            let entry = ref prestates["result"][index]
            if !entry.as_object().is_some() || !entry.has("result") {
                continue
            }
            let prestate = ref entry["result"]
            let targets = replay::shadow_targets(load_world(prestate), address, like.span())
            if targets.len() == 0 {
                continue
            }
            runs += 1
            for side in 0 .. 2 {
                var watch = watch::GasWatch::new(shadows: targets)
                watch.cover = replay::copy_targets(targets)
                watch.op_selector = selector
                var buffers = fevm::Buffers::new()
                let world = replay::build_world(
                    prestate,
                    env,
                    field(header, "parentHash"),
                    extras,
                    if side == 0 {
                        core::MemVec::new()
                    } else {
                        replay::copy_targets(targets)
                    },
                    port.span(),
                )
                fevm::transact(
                    world,
                    load_tx(txs[index]),
                    env,
                    fevm::Config::osaka(),
                    mut buffers,
                    mut watch,
                )
                for op in 0 .. watch.op_gas.len() {
                    if side == 0 {
                        deployed_gas[op] += watch.op_gas[op]
                    } else {
                        port_gas[op] += watch.op_gas[op]
                    }
                }
            }
        }
    }
    var deployed_total: u64 = 0
    var port_total: u64 = 0
    for op in 0 .. 256 {
        deployed_total += deployed_gas[op]
        port_total += port_gas[op]
    }
    println!(
        "gas per opcode in calls to 0x",
        core::text::hex(selector as u256, 4),
        " over ",
        runs,
        " transactions: deployed ",
        deployed_total,
        ", port ",
        port_total,
    )
    println!("opcode deployed port")
    for op in 0 .. 256 {
        if deployed_gas[op] != 0 || port_gas[op] != 0 {
            let code: u8 = op.downcast_truncate()
            if code >= 0x60 && code <= 0x7f {
                print!("PUSH", code - 0x5f)
            } else if code >= 0x80 && code <= 0x8f {
                print!("DUP", code - 0x7f)
            } else if code >= 0x90 && code <= 0x9f {
                print!("SWAP", code - 0x8f)
            } else if code >= 0xa0 && code <= 0xa4 {
                print!("LOG", code - 0xa0)
            } else {
                print!(op_name(code))
            }
            println!(" ", deployed_gas[op], " ", port_gas[op])
        }
    }
    0
}

// The mnemonic of opcode `op`.
fn op_name(_ op: u8) -> String<14> {
    if op >= 0x60 && op <= 0x7f {
        return "PUSH1-32"
    }
    if op >= 0x80 && op <= 0x8f {
        return "DUP1-16"
    }
    if op >= 0x90 && op <= 0x9f {
        return "SWAP1-16"
    }
    if op >= 0xa0 && op <= 0xa4 {
        return "LOG0-4"
    }
    match op {
        0x00 => "STOP",
        0x01 => "ADD",
        0x02 => "MUL",
        0x03 => "SUB",
        0x04 => "DIV",
        0x05 => "SDIV",
        0x06 => "MOD",
        0x07 => "SMOD",
        0x08 => "ADDMOD",
        0x09 => "MULMOD",
        0x0a => "EXP",
        0x0b => "SIGNEXTEND",
        0x10 => "LT",
        0x11 => "GT",
        0x12 => "SLT",
        0x13 => "SGT",
        0x14 => "EQ",
        0x15 => "ISZERO",
        0x16 => "AND",
        0x17 => "OR",
        0x18 => "XOR",
        0x19 => "NOT",
        0x1a => "BYTE",
        0x1b => "SHL",
        0x1c => "SHR",
        0x1d => "SAR",
        0x1e => "CLZ",
        0x20 => "KECCAK256",
        0x30 => "ADDRESS",
        0x31 => "BALANCE",
        0x32 => "ORIGIN",
        0x33 => "CALLER",
        0x34 => "CALLVALUE",
        0x35 => "CALLDATALOAD",
        0x36 => "CALLDATASIZE",
        0x37 => "CALLDATACOPY",
        0x38 => "CODESIZE",
        0x39 => "CODECOPY",
        0x3a => "GASPRICE",
        0x3b => "EXTCODESIZE",
        0x3c => "EXTCODECOPY",
        0x3d => "RETURNDATASIZE",
        0x3e => "RETURNDATACOPY",
        0x3f => "EXTCODEHASH",
        0x40 => "BLOCKHASH",
        0x41 => "COINBASE",
        0x42 => "TIMESTAMP",
        0x43 => "NUMBER",
        0x44 => "PREVRANDAO",
        0x45 => "GASLIMIT",
        0x46 => "CHAINID",
        0x47 => "SELFBALANCE",
        0x48 => "BASEFEE",
        0x49 => "BLOBHASH",
        0x4a => "BLOBBASEFEE",
        0x50 => "POP",
        0x51 => "MLOAD",
        0x52 => "MSTORE",
        0x53 => "MSTORE8",
        0x54 => "SLOAD",
        0x55 => "SSTORE",
        0x56 => "JUMP",
        0x57 => "JUMPI",
        0x58 => "PC",
        0x59 => "MSIZE",
        0x5a => "GAS",
        0x5b => "JUMPDEST",
        0x5c => "TLOAD",
        0x5d => "TSTORE",
        0x5e => "MCOPY",
        0x5f => "PUSH0",
        0xf0 => "CREATE",
        0xf1 => "CALL",
        0xf2 => "CALLCODE",
        0xf3 => "RETURN",
        0xf4 => "DELEGATECALL",
        0xf5 => "CREATE2",
        0xfa => "STATICCALL",
        0xfd => "REVERT",
        0xfe => "INVALID",
        0xff => "SELFDESTRUCT",
        _ => "OTHER",
    }
}

/// `trace <dir> <index> <address|deployed.hex> <port.bin>`: both runs of one
/// saved transaction, deployed and shadowed, call by call as JSON (see
/// `replay::trace_tx`).
fn trace_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() != 6 {
        println!(
            "usage: fevm-replay trace <dir> <tx-index> <shadow-address>|<deployed.hex> <runtime.bin>",
        )
        return 2
    }
    let dir = args.get(2)
    var like = MemBuffer::empty()
    let Option::Some(address) = shadow_target(args.get(4), mut like) else {
        return 1
    }
    let Option::Some(code) = read_shadow(args.get(5)) else {
        return 1
    }
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return 1
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return 1
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return 1
    }
    let header = ref block["result"]
    let index: usize = core::text::parse_uint(args.get(3).span())
        .unwrap_or(default: 0)
        .downcast_unchecked()
    let txs = header["transactions"].items()
    if index >= txs.len() {
        println!("ERROR no transaction ", index, " in ", dir)
        return 1
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let extras = match load_json(dir, "delegates.json") {
        Option::Some(doc) => doc,
        Option::None => Value::object(),
    }
    var text = MemBuffer::empty()
    with (mut text) {
        replay::trace_tx(
            env,
            parent_hash: field(header, "parentHash"),
            extras,
            txs[index],
            prestates["result"][index]["result"],
            shadow_address: address,
            shadow_code: code.span(),
            shadow_like: like.span(),
        )
    }
    print!(text)
    0
}

fn block_command() -> i32 uses (args: Args, fs: std::fs::Fs, out: mut Stdout) {
    if args.count() != 3 && args.count() != 5 {
        println!(
            "usage: fevm-replay block <dir> [<shadow-address>|<deployed.hex> <runtime.bin>]",
        )
        return 2
    }
    // Shadow replay: run the hex runtime code in `runtime.bin` in place of
    // the code at `shadow-address`, or of every copy of `deployed.hex`.
    var shadow_address: u256 = 0
    var shadow_code = MemBuffer::empty()
    var shadow_like = MemBuffer::empty()
    if args.count() == 5 {
        let Option::Some(address) = shadow_target(args.get(3), mut shadow_like) else {
            return 1
        }
        shadow_address = address
        let Option::Some(code) = read_shadow(args.get(4)) else {
            return 1
        }
        shadow_code = code
    }
    var totals = Totals::new()
    if !replay_block(
        args.get(2),
        shadow_address,
        shadow_code: shadow_code.span(),
        shadow_like: shadow_like.span(),
        mut totals,
    ) {
        return 1
    }
    if args.count() == 5 {
        print_totals(totals, shadowing: true)
    }
    if totals.matched == totals.transactions {
        0
    } else {
        1
    }
}

/// `range <first> <count> <dir> [<shadow-address> <runtime.bin>]`: fetches
/// (unless already saved) and replays `count` blocks from `first` (decimal
/// or `0x`), each in `dir/<number>`, then prints the totals.
#[cfg(target_family = "unix")]
fn range_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() < 5 || args.count() > 8 {
        println!(
            "usage: fevm-replay range <first-block> <count> <dir> [<shadow-address>|<deployed.hex> <runtime.bin>] [rpc-url]",
        )
        return 2
    }
    // An odd count of arguments after the command ends with an RPC URL.
    let rpc_given = args.count() == 6 || args.count() == 8
    let shadowing = args.count() >= 7
    let first_arg = args.get(2).span()
    let first = if first_arg.len() > 1 && first_arg[1] == 0x78 {
        core::text::parse_hex_uint(first_arg).unwrap_or(default: 0)
    } else {
        core::text::parse_uint(first_arg).unwrap_or(default: 0)
    }
    let count = core::text::parse_uint(args.get(3).span()).unwrap_or(default: 0)
    var shadow_address: u256 = 0
    var shadow_code = MemBuffer::empty()
    var shadow_like = MemBuffer::empty()
    if shadowing {
        let Option::Some(address) = shadow_target(args.get(5), mut shadow_like) else {
            return 1
        }
        shadow_address = address
        let Option::Some(code) = read_shadow(args.get(6)) else {
            return 1
        }
        shadow_code = code
    }
    var totals = Totals::new()
    var unusable: u64 = 0
    var n = first
    while n < first + count {
        let number = fetch::quantity(n)
        var dir = MemBuffer::empty()
        args.get(4).fmt(mut dir)
        "/".fmt(mut dir)
        number.span().fmt(mut dir)
        let saved = match fs.metadata(fetch::join(dir.span(), "diff.json")) {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
        if !saved {
            let Result::Ok(_) = fs.create_dir_all(dir.span()) else {
                println!("ERROR ", dir, ": cannot create")
                return 1
            }
            let fetched = if rpc_given {
                fetch::fetch_block(args.get(args.count() - 1), number.span(), dir.span())
            } else {
                fetch::fetch_block(DEFAULT_RPC, number.span(), dir.span())
            }
            if !fetched {
                println!("ERROR block ", number, ": the node did not answer")
            }
        }
        var block_totals = Totals::new()
        var usable = replay_block(
            dir.span(),
            shadow_address,
            shadow_code: shadow_code.span(),
            shadow_like: shadow_like.span(),
            mut block_totals,
        )
        // A transaction that read an older block's hash: fetch the 256
        // before this block once, and replay the block again with them.
        if usable && block_totals.old_hashes > 0 && !has_block_hashes(dir.span()) {
            println!(
                "  fetching the 256 block hashes before ",
                number,
                " and replaying it again",
            )
            let fetched = if rpc_given {
                fetch::fetch_hashes(args.get(args.count() - 1), number: n, dir.span())
            } else {
                fetch::fetch_hashes(DEFAULT_RPC, number: n, dir.span())
            }
            if fetched {
                block_totals = Totals::new()
                usable = replay_block(
                    dir.span(),
                    shadow_address,
                    shadow_code: shadow_code.span(),
                    shadow_like: shadow_like.span(),
                    mut block_totals,
                )
            } else {
                println!(
                    "ERROR block ",
                    number,
                    ": the node did not answer for older block hashes",
                )
            }
        }
        if usable {
            add_totals(mut totals, block_totals)
        } else {
            unusable += 1
        }
        n += 1
    }
    print_totals(totals, shadowing)
    if unusable > 0 {
        println!(
            "  ",
            unusable,
            " blocks could not be used; run the same command again to fetch them",
        )
    }
    if totals.matched == totals.transactions && unusable == 0 {
        0
    } else {
        1
    }
}

#[cfg(target_family = "unix")]
fn fetch_code_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 4 && args.count() != 5 {
        println!("usage: fevm-replay fetch-code <address> <file> [rpc-url]")
        return 2
    }
    var text = MemBuffer::empty()
    let fetched = if args.count() == 5 {
        fetch::fetch_code(args.get(4), args.get(2), mut text)
    } else {
        fetch::fetch_code(DEFAULT_RPC, args.get(2), mut text)
    }
    if !fetched {
        println!("ERROR ", args.get(2), ": the node did not answer")
        return 1
    }
    let Result::Ok(_) = fs.write(args.get(3), text.span()) else {
        println!("ERROR ", args.get(3), ": cannot write")
        return 1
    }
    println!("wrote ", args.get(3))
    0
}

// A decimal argument, or `default` when it is absent.
fn number_arg(_ index: usize, default: u64) -> u64 uses (args: Args) {
    if args.count() <= index {
        return default
    }
    core::text::parse_uint(args.get(index).span())
        .unwrap_or(default: default as u256)
        .downcast_truncate()
}

fn category_line(_ name: String<16>, _ found: fuzz::Findings, _ category: usize)
uses (out: mut Stdout)
{
    println!(
        "  ",
        name,
        ": ",
        found.calls[category],
        " calls, ",
        found.identical[category],
        " identical, ",
        found.calls[category] - found.identical[category],
        " differ",
    )
}

/// `fuzz <deployed.bin> <port.bin> [runs] [steps] [seed]`: random calls
/// against the deployed code and its port in two copies of one world.
/// `fuzz-pair <deployed.bin> <port.bin> <token.bin> [runs] [steps] [seed]`
/// does the same for a Uniswap V2 pair between two tokens running `token`.
#[cfg(target_family = "unix")]
fn fuzz_command(pair: bool) -> i32
uses (args: Args, fs: std::fs::Fs, out: mut Stdout)
{
    let first: usize = if pair { 5 } else { 4 }
    if args.count() < first || args.count() > first + 3 {
        if pair {
            println!(
                "usage: fevm-replay fuzz-pair <deployed.bin> <port.bin> <token.bin> [runs] [steps] [seed]",
            )
        } else {
            println!(
                "usage: fevm-replay fuzz <deployed.bin> <port.bin> [runs] [steps] [seed]",
            )
        }
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(2)) else {
        return 1
    }
    let Option::Some(port) = read_shadow(args.get(3)) else {
        return 1
    }
    var token = MemBuffer::empty()
    if pair {
        let Option::Some(code) = read_shadow(args.get(4)) else {
            return 1
        }
        // fuzz-proxy: the implementation's code behind the marker `P` (see
        // `fuzz::is_proxy`).
        if is_word(
            args.get(1),
            [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x70, 0x72, 0x6f, 0x78, 0x79],
        ) {
            token.push(0x50)
        }
        for i in 0 .. code.len() {
            token.push(code.span()[i])
        }
    } else if is_word(
        args.get(1),
        [0x66, 0x75, 0x7a, 0x7a, 0x2d, 0x75, 0x73, 0x64, 0x74],
    ) {
        // The USDT scenario (see `fuzz::is_usdt`).
        token.push(0x55)
    }
    let runs = number_arg(first, default: 200)
    let steps = number_arg(first + 1, default: 40)
    let seed = number_arg(first + 2, default: 1)
    var found = fuzz::Findings::new()
    fuzz::fuzz(
        deployed.span(),
        port.span(),
        token: token.span(),
        runs,
        steps,
        seed,
        mut found,
    )
    println!(
        "fuzzed ",
        runs,
        " runs of up to ",
        steps,
        " calls from seed ",
        seed,
    )
    category_line("well-formed", found, 0)
    category_line("short calldata", found, 1)
    category_line("dirty address", found, 2)
    print_coverage(found.covered, port.span())
    if pair {
        print!("  succeeded:")
        for i in 0 .. found.succeeded.len() {
            print!(
                " ",
                function_name(found.succeeded[i].selector),
                " ",
                found.succeeded[i].calls,
            )
        }
        println!("")
    }
    if found.dirty_padding > 0 {
        println!(
            "  ",
            found.dirty_padding,
            " identical but for the padding after an Error(string) reason",
        )
    }
    if found.invariant_breaks > 0 {
        println!(
            "invariant broken ",
            found.invariant_breaks,
            " times, first: seed ",
            found.invariant_seed,
            ", call ",
            found.invariant_step,
            if found.invariant_kind == 1 {
                " (lock still held)"
            } else if found.invariant_kind == 2 {
                " (k fell in a swap)"
            } else if found.invariant_kind == 3 {
                " (supply below the minimum)"
            } else if found.invariant_kind == 4 {
                " (a token balance below its reserve)"
            } else if found.invariant_kind == 5 {
                " (a cumulative price fell)"
            } else {
                " (kLast disagrees with the fee)"
            },
        )
    }
    if found.first_step == 0 {
        println!("no differences")
        return if found.invariant_breaks > 0 { 1 } else { 0 }
    }
    println!(
        "first difference: seed ",
        found.first_seed,
        ", call ",
        found.first_step,
        ", selector 0x",
        core::text::hex(found.first_selector as u256, 4),
        " ",
        function_name(found.first_selector),
        if found.first_category == 0 {
            " (well-formed)"
        } else if found.first_category == 1 {
            " (short calldata)"
        } else {
            " (dirty address)"
        },
        if found.first_what == 1 {
            ": status differs"
        } else if found.first_what == 2 {
            ": return data differs"
        } else if found.first_what == 3 {
            ": logs differ"
        } else {
            ": state differs"
        },
    )
    println!(
        "  from 0x",
        core::text::hex(found.first_from, 20),
        " to 0x",
        core::text::hex(found.first_to, 20),
        " value ",
        found.first_value,
    )
    println!("  calldata 0x", hex_text(found.first_data.span()))
    println!(
        "  deployed ",
        outcome(found.first_deployed),
        ", port ",
        outcome(found.first_port),
    )
    if found.first_what == 2 {
        println!(
            "  deployed returned 0x",
            hex_text(found.first_deployed_output.span()),
        )
        println!(
            "  port returned     0x",
            hex_text(found.first_port_output.span()),
        )
    }
    if pair {
        print!(
            "replay it: fevm-replay fuzz-pair <deployed.bin> <port.bin> <token.bin> 1 ",
        )
    } else if fuzz::is_usdt(token.span()) {
        print!(
            "replay it: fevm-replay fuzz-usdt <deployed.bin> <port.bin> 1 ",
        )
    } else {
        print!("replay it: fevm-replay fuzz <deployed.bin> <port.bin> 1 ")
    }
    println!(found.first_step, " ", found.first_seed)
    println!(
        "shrunk to ",
        found.shrunk.len(),
        " of ",
        found.first_step,
        " calls:",
    )
    for i in 0 .. found.shrunk.len() {
        let sent = found.shrunk[i]
        var bytes = MemBuffer::empty()
        for j in 0 .. sent.len {
            bytes.push(found.shrunk_inputs.span()[sent.start + j])
        }
        println!(
            "  call ",
            sent.step,
            " from 0x",
            core::text::hex(sent.sender, 20),
            " to 0x",
            core::text::hex(sent.to, 20),
            " value ",
            sent.value,
            " calldata 0x",
            hex_text(bytes.span()),
        )
    }
    if found.calls[0] != found.identical[0] || found.invariant_breaks > 0 {
        return 1
    }
    0
}

fn hex_text(_ bytes: MemSpan) -> MemBuffer {
    var text = MemBuffer::empty()
    for i in 0 .. bytes.len() {
        core::text::hex(bytes[i] as u256, 1).fmt(mut text)
    }
    text
}

fn outcome(_ result: [i32; 2]) -> String<20> {
    if result[0] != 0 {
        fevm::status::invalid_name(result[0])
    } else {
        fevm::status::status_name(result[1])
    }
}

/// `fuzz-block <dir>... <deployed.hex> <port.bin> [mutations] [seed]`:
/// mainnet-seeded fuzzing. Every transaction of the saved blocks whose
/// pre-state holds the deployed code is mutated `mutations` times (default
/// 20) and run on its own pre-state with the deployed code and with the
/// port. The directories come first; the last arguments that read as
/// numbers are `mutations` and `seed`.
#[cfg(target_family = "unix")]
 // How much of the port's code the runs covered.
fn print_coverage(_ covered: MemVec<u8>, _ port: MemSpan)
uses (out: mut Stdout) {
    let ran = watch::coverage_count(covered)
    let total: u64 = watch::instructions(port).downcast_unchecked()
    println!(
        "  the port ran ",
        ran,
        " of its ",
        total,
        " instructions (",
        if total == 0 { 0 } else { ran * 100 / total },
        "%)",
    )
}

// Mutates every transaction of the block saved in `dir` that touches
// `deployed` (see `mutate::mutate_tx`), recording the first difference's
// block and transaction hash.
fn mutate_dir<D: Display>(
    _ dir: D,
    deployed: MemSpan,
    port: MemSpan,
    count: u64,
    seed: u64,
    _ found: mut mutate::Mutations,
    _ first_block: mut MemBuffer,
    _ first_hash: mut MemBuffer,
    fetch: MemBuffer,
)
uses (fs: std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    let Option::Some(chain) = load_response(dir, "chain.json") else {
        return
    }
    let Option::Some(block) = load_response(dir, "block.json") else {
        return
    }
    let Option::Some(prestates) = load_response(dir, "prestate.json") else {
        return
    }
    // The block's state diffs, to bring fetched state up to each transaction.
    let diffs = if fetch.len() > 0 {
        match load_response(dir, "diff.json") {
            Option::Some(doc) => doc,
            Option::None => Value::object(),
        }
    } else {
        Value::object()
    }
    let header = ref block["result"]
    var problem = MemBuffer::empty()
    if !check::header_ok(header, mut problem) || !header["transactions"].as_array().is_some() {
        println!("ERROR ", dir, "/block.json: ", problem)
        return
    }
    let env = load_block(
        header,
        chain_id: field(chain, "result"),
        blobbasefee: fetch::header_blob_fee(header).as_wei(),
    )
    let extras = match load_json(dir, "delegates.json") {
        Option::Some(doc) => doc,
        Option::None => Value::object(),
    }
    let txs = header["transactions"].items()
    if !same_length(prestates["result"], txs.len()) {
        println!(
            "ERROR ",
            dir,
            ": the traces do not list one entry per transaction",
        )
        return
    }
    for index in 0 .. txs.len() {
        let entry = ref prestates["result"][index]
        if !entry.as_object().is_some() || !entry.has("result") {
            return
        }
        let before = found.first_tx
        mutate::mutate_tx(
            env,
            parent_hash: field(header, "parentHash"),
            extras,
            txs[index],
            entry["result"],
            index: index.downcast_unchecked(),
            deployed,
            port,
            count,
            seed,
            fetch: MemBuffer::from_span(fetch.span()),
            diffs,
            mut found,
        )
        if before == 0 && found.first_tx != 0 {
            dir.fmt(mut first_block)
            txs[index]["hash"].text().fmt(mut first_hash)
        }
    }
}

// The contracts that read the gas left where runs part, most runs first,
// at most ten.
fn print_readers(_ readers: MemVec<mutate::Reader>) uses (out: mut Stdout) {
    var shown: MemVec<bool> = MemVec::new()
    for _ in 0 .. readers.len() {
        shown.push(false)
    }
    var printed: usize = 0
    while printed < 10 && printed < readers.len() {
        var best: usize = 0
        var best_runs: u64 = 0
        for i in 0 .. readers.len() {
            if !shown[i] && readers[i].runs >= best_runs {
                best = i
                best_runs = readers[i].runs
            }
        }
        shown[best] = true
        println!(
            "    0x",
            core::text::hex(readers[best].address, 20),
            ": ",
            best_runs,
            " runs",
        )
        printed += 1
    }
}

fn fuzz_block_command() -> i32
uses (args: Args, fs: std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    // A node to fetch untouched state from, last (see `mutate::fetch_missing`).
    var end = args.count()
    var fetch_url = MemBuffer::empty()
    let last = args.get(end - 1).span()
    if last.len() > 4 && last[0] == 0x68 && last[1] == 0x74 && last[2] == 0x74 && last[3] == 0x70 {
        for i in 0 .. last.len() {
            fetch_url.push(last[i])
        }
        end -= 1
    }
    // Trailing numbers: up to two.
    var numbers: usize = 0
    while numbers < 2 && end > 5 && is_number(args.get(end - 1)) {
        end -= 1
        numbers += 1
    }
    if end < 5 {
        println!(
            "usage: fevm-replay fuzz-block <dir>... <deployed.hex> <port.bin> [mutations] [seed]",
        )
        return 2
    }
    let Option::Some(deployed) = read_shadow(args.get(end - 2)) else {
        return 1
    }
    let Option::Some(port) = read_shadow(args.get(end - 1)) else {
        return 1
    }
    let count = if numbers >= 1 {
        number_arg(end, default: 20)
    } else {
        20
    }
    let seed = if numbers == 2 {
        number_arg(end + 1, default: 1)
    } else {
        1
    }
    var found = mutate::Mutations::new()
    var first_block = MemBuffer::empty()
    var first_hash = MemBuffer::empty()
    for d in 2 .. end - 2 {
        mutate_dir(
            args.get(d),
            deployed: deployed.span(),
            port: port.span(),
            count,
            seed,
            mut found,
            mut first_block,
            mut first_hash,
            fetch: MemBuffer::from_span(fetch_url.span()),
        )
    }
    println!(
        "mutated ",
        found.transactions,
        " transactions ",
        count,
        " times each (",
        found.tx_runs,
        " with their own calldata changed, ",
        found.direct_runs,
        " changing a call into the shadowed code in flight, ",
        found.flight_succeeded,
        " of which succeeded)",
    )
    println!(
        "  ",
        found.runs,
        " runs: ",
        found.identical,
        " identical, ",
        found.sensitive,
        " differ where code reads the gas left or code hashes (",
        found.code_sensitive,
        " code hashes), ",
        found.dirtied,
        " differ after an address-shaped word got upper bits, ",
        found.shortened,
        " after the calldata was cut short, ",
        found.cheaper,
        " where only the deployed code ran out of gas, ",
        found.differ,
        " differ",
    )
    println!(
        "  of the ",
        found.sensitive - found.code_sensitive,
        " where code reads the gas left, ",
        found.gas_explained,
        " part at or under a call whose code read it",
    )
    print_readers(found.readers)
    if fetch_url.len() > 0 {
        println!(
            "  ",
            found.fetched_runs,
            " mutated runs reached state their transaction never touched; ",
            found.fetched_keys,
            " accounts and slots fetched for them",
        )
    }
    if found.unexplained_tx != 0 {
        println!(
            "  first other: tx ",
            found.unexplained_tx - 1,
            ", parting call ",
            found.unexplained_at,
            " to 0x",
            core::text::hex(found.unexplained_to, 20),
            ", deployed ",
            found.unexplained_deployed,
            ", port ",
            found.unexplained_port,
            ", what ",
            found.unexplained_what,
        )
    }
    print_coverage(found.covered, port.span())
    if found.first_tx == 0 {
        return 0
    }
    println!(
        "first difference: ",
        first_block,
        " tx ",
        found.first_tx - 1,
        " ",
        first_hash,
        if found.first_direct {
            " (a call into the shadowed code changed in flight)"
        } else {
            " (its calldata changed)"
        },
    )
    println!(
        "  call to 0x",
        core::text::hex(found.first_to, 20),
        " with calldata 0x",
        hex_text(found.first_data.span()),
    )
    println!(
        "  deployed ",
        outcome(found.first_deployed),
        ", port ",
        outcome(found.first_port),
    )
    println!(
        "  deployed returned 0x",
        hex_text(found.first_deployed_output.span()),
    )
    println!(
        "  port returned     0x",
        hex_text(found.first_port_output.span()),
    )
    println!(
        "  runs part at the call to 0x",
        core::text::hex(found.parting_to, 20),
        " selector 0x",
        core::text::hex(found.parting_selector as u256, 4),
        ": deployed ",
        if found.parting_deployed < 0 {
            "made no such call"
        } else {
            fevm::status::status_name(found.parting_deployed)
        },
        ", port ",
        if found.parting_port < 0 {
            "made no such call"
        } else {
            fevm::status::status_name(found.parting_port)
        },
    )
    1
}

#[cfg(target_family = "unix")]
fn is_number(_ arg: Arg) -> bool {
    let text = arg.span()
    if text.len() == 0 {
        return false
    }
    for i in 0 .. text.len() {
        if text[i] < 0x30 || text[i] > 0x39 {
            return false
        }
    }
    true
}

/// `fetch-hashes <dir> [rpc-url]`: adds the 256 block hashes before the
/// block saved in `dir` to its `delegates.json`, for transactions that read
/// an older block's hash.
#[cfg(target_family = "unix")]
fn fetch_hashes_command() -> i32
uses (args: Args, fs: mut std::fs::Fs, proc: mut std::process::Spawn, out: mut Stdout)
{
    if args.count() != 3 && args.count() != 4 {
        println!("usage: fevm-replay fetch-hashes <dir> [rpc-url]")
        return 2
    }
    let Option::Some(block) = load_response(args.get(2), "block.json") else {
        return 1
    }
    let number = field(block["result"], "number")
    let fetched = if args.count() == 4 {
        fetch::fetch_hashes(args.get(3), number: number, args.get(2))
    } else {
        fetch::fetch_hashes(DEFAULT_RPC, number: number, args.get(2))
    }
    if !fetched {
        println!("ERROR ", args.get(2), ": the node did not answer")
        return 1
    }
    println!(
        "saved the 256 block hashes before block ",
        number,
        " in ",
        args.get(2),
        "/delegates.json",
    )
    0
}
