//! `follow <work-dir> <out.json> <blocks> [rpc-url]`: follows the chain
//! head and validates blocks statelessly as they come. Each round takes the
//! block two behind the head, saves it (`fetch-block`), fetches the
//! parent's and the block's proofs (`fetch-proofs`) and runs `chain`, by
//! running this same program; when a transaction read an older block's
//! hash, it fetches the 256 before (`fetch-hashes`) and runs `chain` again.
//! The `summary.json` that `chain` writes is added to `out.json`, the
//! stateless blocks page's data: the transactions that matched, whether
//! every root in the header did, the witness, the binary-tree estimate and
//! the heaviest storage tries. A block that cannot be proven in time is
//! recorded as such.

use replay_core::{load}
use core::{MemBuffer, MemSpan}
use core::text::decimal
use std::env::{Arg, Args}
use std::fs::Fs
use std::io::{Display, Stdout}
use std::process::{Command, Redirect, Spawn}
use json::parse
use fevm::WorldState
use load::field
use ingot::fetch

// Where `needle` first occurs in `text` at or after `from`.
fn find(_ text: MemSpan, _ needle: MemSpan, from: usize) -> Option<usize> {
    var i = from
    while i + needle.len() <= text.len() {
        var k: usize = 0
        while k < needle.len() && text[i + k] == needle[k] {
            k += 1
        }
        if k == needle.len() {
            return Option::Some(i)
        }
        i += 1
    }
    Option::None
}

// How many times `needle` occurs in `text`.
fn occurrences(_ text: MemSpan, _ needle: MemSpan) -> u256 {
    var n: u256 = 0
    var at: usize = 0
    while let Option::Some(found) = find(text, needle, from: at) {
        n += 1
        at = found + needle.len()
    }
    n
}

// A badge in the style of the port certificates' badges.
fn badge(_ blocks: u256) -> MemBuffer {
    var label = MemBuffer::empty()
    decimal(blocks).fmt(mut label)
    " mainnet blocks, every root".fmt(mut label)
    // Verdana 11px: about 7 px a character.
    let width = 72 + label.len() * 7 + 16
    var svg = MemBuffer::empty()
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"".fmt(mut svg)
    decimal(width as u256).fmt(mut svg)
    "\" height=\"20\" role=\"img\" aria-label=\"validated by fevm: ".fmt(mut svg)
    label.span().fmt(mut svg)
    "\"><rect width=\"72\" height=\"20\" fill=\"#1f2624\"/><rect x=\"72\" width=\"".fmt(mut svg)
    decimal((width - 72) as u256).fmt(mut svg)
    "\" height=\"20\" fill=\"#2e8b6f\"/><g fill=\"#fff\" font-family=\"Verdana,DejaVu Sans,sans-serif\" font-size=\"11\"><text x=\"8\" y=\"14\">fevm</text><text x=\"80\" y=\"14\">"
        .fmt(mut svg)
    label.span().fmt(mut svg)
    "</text></g><title>validated statelessly by fevm-replay follow</title></svg>
".fmt(mut svg)
    svg
}

fn has(_ text: MemSpan, _ needle: MemSpan) -> bool {
    find(text, needle, from: 0).is_some()
}

// What a run of this program did: whether it succeeded, and what it printed.
struct Ran { ok: bool, text: MemBuffer }

// This program run with `command`, `first` and, unless empty, `second`.
fn run<C: Display>(_ tool: Arg, _ command: C, _ first: MemSpan, _ second: MemSpan) -> Ran
uses (proc: mut Spawn)
{
    var c = Command::new(tool).arg(command).arg(first)
    if second.len() > 0 {
        c = c.arg(second)
    }
    c = c.stdout(Redirect::Capture).stderr(Redirect::Capture)
    match proc.output(c) {
        Result::Ok(output) => Ran { ok: output.status.success(), text: output.stdout },
        Result::Err(_) => Ran { ok: false, text: MemBuffer::empty() },
    }
}

fn sleep(_ seconds: String<2>) uses (proc: mut Spawn) {
    let _ = proc.output(Command::new("sleep").arg(seconds))
}

// The current time, UTC, to the minute.
fn now() -> MemBuffer uses (proc: mut Spawn) {
    let c = Command::new("date").arg("-u").arg("+%Y-%m-%d %H:%M UTC").stdout(Redirect::Capture)
    var out = MemBuffer::empty()
    if let Result::Ok(output) = proc.output(c) {
        let text = output.stdout.span()
        for i in 0 .. text.len() {
            if text[i] != 0x0a {
                out.push(text[i])
            }
        }
    }
    out
}

// `text` as a JSON string's contents.
fn escaped(_ text: MemSpan, _ out: mut MemBuffer) {
    for i in 0 .. text.len() {
        let c = text[i]
        if c == 0x22 || c == 0x5c {
            out.push(0x5c)
            out.push(c)
        } else if c >= 0x20 {
            out.push(c)
        } else if c == 0x0a {
            out.push(0x20)
        }
    }
}

// The lines of `text` that report a problem (they start with a capital
// letter, except the per-block summary), joined.
fn problems(_ text: MemSpan) -> MemBuffer {
    var out = MemBuffer::empty()
    var start: usize = 0
    while start < text.len() && out.len() < 300 {
        var end = start
        while end < text.len() && text[end] != 0x0a {
            end += 1
        }
        let first = text[start]
        if end > start && first >= 0x41 && first <= 0x5a {
            if out.len() > 0 {
                " | ".fmt(mut out)
            }
            for i in start .. end {
                out.push(text[i])
            }
        }
        start = end + 1
    }
    out
}

fn put_bool(_ out: mut MemBuffer, _ name: String<24>, _ value: bool) {
    ",\"".fmt(mut out)
    name.fmt(mut out)
    if value {
        "\":true".fmt(mut out)
    } else {
        "\":false".fmt(mut out)
    }
}

/// The command.
#[cfg(target_family = "unix")]
pub fn follow_command() -> i32
uses (args: Args, fs: mut Fs, proc: mut Spawn, out: mut Stdout)
{
    if args.count() != 5 && args.count() != 6 {
        println!(
            "usage: fevm-replay follow <work-dir> <out.json> <blocks> [rpc-url]",
        )
        return 2
    }
    let tool = args.get(0)
    let work = args.get(2)
    let path = args.get(3)
    var wanted: u64 = 0
    let count = args.get(4).span()
    for i in 0 .. count.len() {
        wanted = wanted * 10 + (count[i] - 0x30) as u64
    }
    var rpc = MemBuffer::empty()
    if args.count() == 6 {
        args.get(5).fmt(mut rpc)
    } else {
        "https://ethereum-rpc.publicnode.com".fmt(mut rpc)
    }
    // The records so far, and the blocks they cover.
    var records = MemBuffer::empty()
    var done = WorldState::empty()
    if let Result::Ok(bytes) = fs.read(path) {
        if let Result::Ok(doc) = parse(bytes.span()) {
            for ref record in doc.items() {
                let _ = done.ensure_account(field(record, "number"))
                if records.len() > 0 {
                    ",\n".fmt(mut records)
                }
                record.write(mut records)
            }
        }
    }
    var taken: u64 = 0
    while taken < wanted {
        let Option::Some(head) = fetch::block_number(rpc.span()) else {
            sleep("12")
            continue
        }
        let n = head - 2
        if done.exists(n) {
            sleep("12")
            continue
        }
        let _ = done.ensure_account(n)
        taken += 1
        let number = fetch::quantity(n)
        var dir = MemBuffer::empty()
        work.fmt(mut dir)
        "/".fmt(mut dir)
        number.span().fmt(mut dir)
        var record = MemBuffer::empty()
        "{\"at\":\"".fmt(mut record)
        now().span().fmt(mut record)
        "\"".fmt(mut record)
        var step = run(tool, "fetch-block", number.span(), dir.span())
        if step.ok {
            step = run(tool, "fetch-proofs", dir.span(), rpc.span())
        }
        if !step.ok {
            // Without a summary from `chain`, the number is the follower's.
            ",\"number\":".fmt(mut record)
            decimal(n).fmt(mut record)
            ",\"result\":\"not proven: ".fmt(mut record)
            escaped(problems(step.text.span()).span(), mut record)
            "\"}".fmt(mut record)
        } else {
            step = run(tool, "chain", dir.span(), MemBuffer::empty().span())
            var older = false
            if !step.ok && has(step.text.span(), "ran BLOCKHASH".span()) {
                if run(tool, "fetch-hashes", dir.span(), rpc.span()).ok {
                    step = run(tool, "chain", dir.span(), MemBuffer::empty().span())
                    older = true
                }
            }
            // What `chain` wrote in short, copied: every number comes
            // from the run itself, not from reading its printed text.
            let t = step.text.span()
            var summary = MemBuffer::empty()
            if let Result::Ok(bytes) = fs.read(fetch::join(dir.span(), "summary.json")) {
                summary = bytes
            }
            let every_root = step.ok && has(summary.span(), "\"every_root\":true".span())
            put_bool(mut record, "older_hashes", older)
            if every_root {
                ",\"result\":\"every root matches\"".fmt(mut record)
            } else {
                ",\"result\":\"DIFF: ".fmt(mut record)
                escaped(problems(t).span(), mut record)
                "\"".fmt(mut record)
            }
            // The summary's fields after its opening brace.
            let fields = summary.span()
            if fields.len() > 2 && fields[0] == 0x7b {
                ",".fmt(mut record)
                for i in 1 .. fields.len() - 1 {
                    record.push(fields[i])
                }
            }
            "}".fmt(mut record)
        }
        if records.len() > 0 {
            ",\n".fmt(mut records)
        }
        record.span().fmt(mut records)
        var file = MemBuffer::empty()
        "[\n".fmt(mut file)
        records.span().fmt(mut file)
        "\n]\n".fmt(mut file)
        let Result::Ok(_) = fs.write(path, file.span()) else {
            println!("ERROR ", path, ": cannot write")
            return 1
        }
        println!(record.span())
        // A badge beside the data (`stateless.json` -> `stateless.svg`):
        // the blocks where every root in the header came out of fevm.
        let validated = occurrences(records.span(), "\"every_root\":true".span())
            + occurrences(records.span(), "\"every_root\": true".span())
        var badge_path = MemBuffer::empty()
        path.fmt(mut badge_path)
        if badge_path.len() > 5 {
            badge_path.truncate(badge_path.len() - 5)
        }
        ".svg".fmt(mut badge_path)
        let _ = fs.write(badge_path.span(), badge(validated).span())
    }
    0
}
