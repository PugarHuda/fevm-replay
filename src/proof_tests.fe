#[test]
fn a_header_hashes_to_its_block_hash() {
    let doc = vector()
    assert!(
        proof::header_hash(doc["header"]) == field(doc["header"], "hash"),
    )
}

#[test]
fn an_account_and_a_slot_are_proven_from_the_state_root() {
    let doc = vector()
    let root = field(doc["header"], "stateRoot")
    let account = proof::account(
        state_root: root,
        address: field(doc, "address"),
        doc["accountProof"],
    )
        .unwrap()
    assert!(account.nonce == field(doc, "nonce"))
    assert!(account.balance == field(doc, "balance"))
    assert!(account.code_hash == field(doc, "codeHash"))
    assert!(account.storage_root == field(doc, "storageHash"))
    let value = proof::slot(
        storage_root: account.storage_root,
        slot: field(doc, "key"),
        doc["proof"],
    )
        .unwrap()
    assert!(value == field(doc, "value"))
}

// Another root, another key or another account: the proof no longer holds.
#[test]
fn a_proof_holds_for_its_root_and_key_only() {
    let doc = vector()
    let root = field(doc["header"], "stateRoot")
    let address = field(doc, "address")
    assert!(
        proof::account(state_root: root + 1, address, doc["accountProof"]).is_none(),
    )
    assert!(
        proof::account(
            state_root: root,
            address: address + 1,
            doc["accountProof"],
        ).is_none(),
    )
    let storage = field(doc, "storageHash")
    assert!(
        proof::slot(
            storage_root: storage + 1,
            slot: field(doc, "key"),
            doc["proof"],
        ).is_none(),
    )
}

// A contract without storage: the node sends no nodes, and every slot is 0.
#[test]
fn every_slot_of_an_empty_trie_is_zero() {
    let none = parse("[]".span()).unwrap()
    assert!(
        proof::slot(storage_root: proof::EMPTY_TRIE, slot: 5, none).unwrap() == 0,
    )
    assert!(proof::slot(storage_root: 0x1234, slot: 5, none).is_none())
}
