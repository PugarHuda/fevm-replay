//! A tracer that tells whether a shadow run could have changed behavior just
//! by costing different gas.

use core::{MemBuffer, MemSpan, MemVec}
use fevm::trace::{CallEnd, CallStart, Step, Tracer}

const OP_GAS: u8 = 0x5a
const OP_BLOCKHASH: u8 = 0x40
const OP_EXTCODECOPY: u8 = 0x3c
const OP_EXTCODEHASH: u8 = 0x3f

/// Watches a shadow replay for code other than the shadow code reading the
/// gas left (the GAS opcode) after the shadow code first ran. Until the
/// shadow code runs, both executions have the same gas, so only later
/// readings can differ. A transaction that reads none of them and still
/// differs points at the shadow code's behavior, not its cost.
/// The calls into one function of the watched contract: how many, and the
/// gas they used in all (their frames' gas, calls they made included).
pub struct SelectorGas {
    /// The first four calldata bytes; a call with fewer (the fallback) is 0.
    pub selector: u32,
    pub calls: u64,
    pub gas: u64,
}

impl Copy for SelectorGas {}

// An open call frame: the code it runs, and for calls into the watched
// address, the function and the gas the frame started with.
struct Frame { to: u256, selector: u32, gas: u64, record: usize }

impl Copy for Frame {}

/// One call a run made, in the order calls began: its depth, target,
/// selector, a hash of its calldata, and once it ended, its status and a
/// hash of its output. Two runs of one transaction can be compared call by
/// call to find where they part.
pub struct CallRecord {
    pub depth: usize,
    pub to: u256,
    pub selector: u32,
    pub input: u64,
    pub status: i32,
    pub output: u64,
}

impl Copy for CallRecord {}

// FNV-1a: enough to tell two byte strings apart in a report.
fn fingerprint(_ bytes: MemSpan) -> u64 {
    var hash: u64 = 0xcbf29ce484222325
    for i in 0 .. bytes.len() {
        hash = (hash ^ bytes[i] as u64).wrapping_mul(0x100000001b3)
    }
    hash
}

/// The first call where `a` and `b` part: a different target, calldata,
/// status or output. None if they agree as far as both go.
pub fn first_parting(_ a: MemVec<CallRecord>, _ b: MemVec<CallRecord>) -> Option<usize> {
    let shorter = if a.len() < b.len() { a.len() } else { b.len() }
    for i in 0 .. shorter {
        let x = a[i]
        let y = b[i]
        if x.to != y.to || x.input != y.input || x.status != y.status || x.output != y.output {
            return Option::Some(i)
        }
    }
    if a.len() != b.len() {
        Option::Some(shorter)
    } else {
        Option::None
    }
}

/// Adds the calls and gas of each function in `from` to `into`.
pub fn add_profile(_ into: mut MemVec<SelectorGas>, _ from: MemVec<SelectorGas>) {
    for i in 0 .. from.len() {
        record(
            mut into,
            from[i].selector,
            calls: from[i].calls,
            gas: from[i].gas,
        )
    }
}

fn record(_ profile: mut MemVec<SelectorGas>, _ selector: u32, calls: u64, gas: u64) {
    for i in 0 .. profile.len() {
        if profile[i].selector == selector {
            profile[i].calls += calls
            profile[i].gas += gas
            return
        }
    }
    profile.push(SelectorGas { selector, calls, gas })
}

pub struct GasWatch {
    // The accounts running shadow code.
    shadows: MemVec<u256>,
    // The open call frames, innermost last.
    frames: MemVec<Frame>,
    shadow_ran: bool,
    pub observed: bool,
    /// Whether any code ran BLOCKHASH. A replay holds the parent's hash
    /// only, so a transaction that differs after reading another one most
    /// likely read a hash the node's traces do not carry.
    pub read_blockhash: bool,
    /// Whether code other than the shadow code ran EXTCODEHASH or
    /// EXTCODECOPY. Shadow code is other code, so a contract that checks
    /// what runs at an address (a bot verifying a pair's code hash, say)
    /// may refuse it.
    pub read_code: bool,
    /// The outcome of the first call into `focus` (when nonzero): its
    /// status and output, once `focused`.
    pub focus: u256,
    pub focused: bool,
    pub focus_status: i32,
    pub focus_output: MemBuffer,
    /// Every call of the run (see `CallRecord`).
    pub calls: MemVec<CallRecord>,
    /// Gas used per function of the code at the watched address, whichever
    /// code runs there: the deployed contract or the shadow port.
    pub profile: MemVec<SelectorGas>,
}

impl GasWatch {
    pub fn new(shadows: MemVec<u256>) -> Self {
        var own_copy: MemVec<u256> = MemVec::new()
        for i in 0 .. shadows.len() {
            own_copy.push(shadows[i])
        }
        GasWatch {
            shadows: own_copy,
            frames: MemVec::new(),
            shadow_ran: false,
            observed: false,
            read_blockhash: false,
            read_code: false,
            focus: 0,
            focused: false,
            focus_status: 0,
            focus_output: MemBuffer::empty(),
            calls: MemVec::new(),
            profile: MemVec::new(),
        }
    }
}

fn is_shadow(_ shadows: MemVec<u256>, _ address: u256) -> bool {
    for i in 0 .. shadows.len() {
        if shadows[i] == address {
            return true
        }
    }
    false
}

impl Tracer for GasWatch {
    fn step(mut self, _ step: Step) {
        if step.op == OP_BLOCKHASH {
            self.read_blockhash = true
        }
        if (step.op == OP_EXTCODEHASH || step.op == OP_EXTCODECOPY) && self.shadows.len() > 0 {
            match self.frames.last() {
                Option::Some(ref frame) => {
                    if !is_shadow(self.shadows, frame.to) {
                        self.read_code = true
                    }
                },
                Option::None => {},
            }
        }
        if step.op == OP_GAS && self.shadow_ran {
            match self.frames.last() {
                Option::Some(ref frame) => {
                    if !is_shadow(self.shadows, frame.to) {
                        self.observed = true
                    }
                },
                Option::None => {},
            }
        }
    }

    fn enter(mut self, _ call: CallStart, input: MemSpan) {
        if is_shadow(self.shadows, call.to) {
            self.shadow_ran = true
        }
        var selector: u32 = 0
        if input.len() >= 4 {
            for i in 0 .. 4 {
                selector = (selector << 8) | input[i] as u32
            }
        }
        let record = self.calls.len()
        self.calls
            .push(
                CallRecord {
                    depth: call.depth,
                    to: call.to,
                    selector,
                    input: fingerprint(input),
                    status: -1,
                    output: 0,
                },
            )
        self.frames.push(Frame { to: call.to, selector, gas: call.gas, record })
    }

    fn leave(mut self, _ call: CallEnd, output: MemSpan) {
        match self.frames.pop() {
            Option::Some(frame) => {
                self.calls[frame.record].status = call.status
                self.calls[frame.record].output = fingerprint(output)
                if self.focus != 0 && !self.focused && frame.to == self.focus {
                    self.focused = true
                    self.focus_status = call.status
                    self.focus_output = MemBuffer::from_span(output)
                }
                if is_shadow(self.shadows, frame.to) && frame.gas >= call.gas {
                    record(
                        mut self.profile,
                        frame.selector,
                        calls: 1,
                        gas: frame.gas - call.gas,
                    )
                }
            },
            Option::None => {},
        }
    }
}
