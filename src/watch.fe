//! A tracer that tells whether a shadow run could have changed behavior just
//! by costing different gas.

use core::{MemBuffer, MemSpan, MemVec}
use fevm::{LogBuffer, WorldState}
use fevm::status::{ERR_OUT_OF_GAS, OK}
use fevm::trace::{CallEnd, CallStart, Step, Tracer}

const OP_GAS: u8 = 0x5a
const OP_BLOCKHASH: u8 = 0x40
const OP_EXTCODECOPY: u8 = 0x3c
const OP_EXTCODEHASH: u8 = 0x3f
const OP_CALLCODE: u8 = 0xf2
const OP_DELEGATECALL: u8 = 0xf4

/// Watches a shadow replay for code other than the shadow code reading the
/// gas left (the GAS opcode) after the shadow code first ran. Until the
/// shadow code runs, both executions have the same gas, so only later
/// readings can differ. A transaction that reads none of them and still
/// differs points at the shadow code's behavior, not its cost.
/// The calls into one function of the watched contract: how many, and the
/// gas they used in all (their frames' gas, calls they made included).
pub struct SelectorGas {
    /// The first four calldata bytes; a call with fewer (the fallback) is 0.
    pub selector: u32,
    pub calls: u64,
    pub gas: u64,
}

impl Copy for SelectorGas {}

// An open call frame: the code it runs, and for calls into the watched
// address, the function and the gas the frame started with.
struct Frame {
    to: u256,
    selector: u32,
    gas: u64,
    record: usize,
    shadow: bool,
    covered: bool,
    // The last opcode the frame ran and the gas before it, while measured.
    last_op: u8,
    last_gas: u64,
    has_last: bool,
}

impl Copy for Frame {}

/// One call a run made, in the order calls began: its depth, target,
/// selector, a hash of its calldata, and once it ended, its status and a
/// hash of its output. Two runs of one transaction can be compared call by
/// call to find where they part. `parent` indexes the call that made it
/// (`NO_PARENT` for the transaction's own); `read_gas` is whether code
/// other than the shadow code ran GAS in it after the shadow code first ran;
/// `context` is the account it runs as, the caller's for DELEGATECALL and
/// CALLCODE.
pub struct CallRecord {
    pub depth: usize,
    pub parent: usize,
    pub read_gas: bool,
    pub context: u256,
    /// The opcode that made it, the gas it got and used, and with
    /// `GasWatch::keep`, where its calldata and output (their first
    /// `KEPT` bytes) sit in `GasWatch::bytes`.
    pub kind: u8,
    pub value: u256,
    pub gas: u64,
    pub used: u64,
    pub input_at: usize,
    pub input_len: usize,
    pub output_at: usize,
    pub output_len: usize,
    pub to: u256,
    pub selector: u32,
    pub input: u64,
    pub status: i32,
    pub output: u64,
}

impl Copy for CallRecord {}

pub const NO_PARENT: usize = 0xffffffff

/// How many bytes of a call's calldata and output a keeping watch keeps.
pub const KEPT: usize = 256

// FNV-1a: enough to tell two byte strings apart in a report.
fn fingerprint(_ bytes: MemSpan) -> u64 {
    var hash: u64 = 0xcbf29ce484222325
    for i in 0 .. bytes.len() {
        hash = (hash ^ bytes[i] as u64).wrapping_mul(0x100000001b3)
    }
    hash
}

/// Where two runs part: the first call, in the order calls ended, with a
/// different target, value, calldata, status or output. Calls that enclose it end
/// later, so this is the innermost cause. The result indexes `a.ended` and
/// `b.ended`; None if the runs agree as far as both go.
pub fn first_parting(_ a: GasWatch, _ b: GasWatch) -> Option<usize> {
    let shorter = if a.ended.len() < b.ended.len() {
        a.ended.len()
    } else {
        b.ended.len()
    }
    for k in 0 .. shorter {
        let x = a.calls[a.ended[k]]
        let y = b.calls[b.ended[k]]
        if x.to != y.to
            || x.value != y.value
            || x.input != y.input
            || x.status != y.status
            || x.output != y.output {
            return Option::Some(k)
        }
    }
    if a.ended.len() != b.ended.len() {
        Option::Some(shorter)
    } else {
        Option::None
    }
}

/// Where two runs that differ only where code read the gas left part: the
/// address of the code that read it, when the parting call (see
/// `first_parting`) is that code's call or runs under it, as when a contract
/// forwards a share of the gas it reads. None if the runs agree or part
/// elsewhere, which a gas reading does not explain.
pub fn gas_reader(_ a: GasWatch, _ b: GasWatch) -> Option<u256> {
    match first_parting(a, b) {
        Option::Some(k) => {
            let reader = reader_above(a, k)
            if reader != 0 {
                return Option::Some(reader)
            }
            let other = reader_above(b, k)
            if other != 0 {
                return Option::Some(other)
            }
            Option::None
        },
        Option::None => Option::None,
    }
}

// The address of the nearest call, from the `k`th to end up through its
// callers, that read the gas left; 0 if none.
fn reader_above(_ run: GasWatch, _ k: usize) -> u256 {
    if k >= run.ended.len() {
        return 0
    }
    var at = run.ended[k]
    while at != NO_PARENT {
        let call = run.calls[at]
        if call.read_gas {
            return call.context
        }
        at = call.parent
    }
    0
}

/// Marks in `into` every program counter `from` marks.
pub fn merge_coverage(_ into: mut MemVec<u8>, _ from: MemVec<u8>) {
    for pc in 0 .. from.len() {
        if from[pc] != 0 {
            while into.len() <= pc {
                into.push(0)
            }
            into[pc] = 1
        }
    }
}

/// How many program counters `covered` marks.
pub fn coverage_count(_ covered: MemVec<u8>) -> u64 {
    var count: u64 = 0
    for pc in 0 .. covered.len() {
        if covered[pc] != 0 {
            count += 1
        }
    }
    count
}

/// The instruction offsets of `code`: every byte that starts an opcode
/// rather than sitting in a PUSH's data.
pub fn instructions(_ code: MemSpan) -> usize {
    var count: usize = 0
    var pc: usize = 0
    while pc < code.len() {
        let op = code[pc]
        count += 1
        pc += 1
        if op >= 0x60 && op <= 0x7f {
            pc += (op - 0x5f) as usize
        }
    }
    count
}

// The account a difference between two runs belongs to: the emitter of the
// first log that differs, or else the first account whose balance, nonce or
// storage differs; 0 if none does.
pub fn differing_owner(_ a: LogBuffer, _ b: LogBuffer, _ x: WorldState, _ y: WorldState) -> u256 {
    var i: u64 = 0
    while i < a.len() || i < b.len() {
        if i >= a.len() {
            return b.entry(i).address
        }
        if i >= b.len() {
            return a.entry(i).address
        }
        let one = a.entry(i)
        let two = b.entry(i)
        var differs = one.address != two.address
            || one.topic_count != two.topic_count
            || !same_payload(a.payload(i), b.payload(i))
        for t in 0 .. 4 {
            if one.topics[t] != two.topics[t] {
                differs = true
            }
        }
        if differs {
            return one.address
        }
        i += 1
    }
    for position in 0 .. x.account_count() {
        let address = x.account_at(position).address
        if x.balance(address) != y.balance(address) || x.nonce(address) != y.nonce(address) {
            return address
        }
    }
    for slot in 0 .. x.storage_slots() {
        let entry = x.storage_at(slot)
        if entry.occupied && y.storage_load(entry.address, entry.slot) != entry.value {
            return entry.address
        }
    }
    for slot in 0 .. y.storage_slots() {
        let entry = y.storage_at(slot)
        if entry.occupied && x.storage_load(entry.address, entry.slot) != entry.value {
            return entry.address
        }
    }
    0
}

// Whether code at `address` read the gas left in `run`.
fn read_gas_in(_ run: GasWatch, _ address: u256) -> bool {
    for i in 0 .. run.calls.len() {
        if run.calls[i].read_gas && run.calls[i].context == address {
            return true
        }
    }
    false
}

/// Why two runs that differ where code read the gas left differ: the
/// account whose code read it, when the runs part at or under its call (see
/// `gas_reader`) or, with every call alike, when the first log or state
/// that differs is its own. None if no gas reading explains the difference.
pub fn explain_gas(
    _ a: GasWatch,
    _ b: GasWatch,
    _ a_logs: LogBuffer,
    _ b_logs: LogBuffer,
    _ a_state: WorldState,
    _ b_state: WorldState,
) -> Option<u256> {
    match gas_reader(a, b) {
        Option::Some(reader) => Option::Some(reader),
        Option::None => {
            let owner = differing_owner(a_logs, b_logs, a_state, b_state)
            if owner != 0 && (read_gas_in(a, owner) || read_gas_in(b, owner)) {
                Option::Some(owner)
            } else {
                Option::None
            }
        },
    }
}

fn same_payload(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0 .. a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

/// Whether the runs part at a call, with the same target and calldata, that
/// ran out of gas on the deployed code and succeeded on the port.
pub fn ran_out_first(_ a: GasWatch, _ b: GasWatch) -> bool {
    match first_parting(a, b) {
        Option::Some(k) => {
            if k >= a.ended.len() || k >= b.ended.len() {
                return false
            }
            let x = a.calls[a.ended[k]]
            let y = b.calls[b.ended[k]]
            x.to == y.to && x.input == y.input && x.status == ERR_OUT_OF_GAS && y.status == OK
        },
        Option::None => false,
    }
}

/// Adds the calls and gas of each function in `from` to `into`.
pub fn add_profile(_ into: mut MemVec<SelectorGas>, _ from: MemVec<SelectorGas>) {
    for i in 0 .. from.len() {
        record(
            mut into,
            from[i].selector,
            calls: from[i].calls,
            gas: from[i].gas,
        )
    }
}

fn record(_ profile: mut MemVec<SelectorGas>, _ selector: u32, calls: u64, gas: u64) {
    for i in 0 .. profile.len() {
        if profile[i].selector == selector {
            profile[i].calls += calls
            profile[i].gas += gas
            return
        }
    }
    profile.push(SelectorGas { selector, calls, gas })
}

pub struct GasWatch {
    // The accounts running shadow code.
    shadows: MemVec<u256>,
    // The open call frames, innermost last.
    frames: MemVec<Frame>,
    /// Whether a call into a shadow account ran.
    pub shadow_ran: bool,
    pub observed: bool,
    /// Whether any code ran BLOCKHASH. A replay holds the parent's hash
    /// only, so a transaction that differs after reading another one most
    /// likely read a hash the node's traces do not carry.
    pub read_blockhash: bool,
    /// Whether code other than the shadow code ran EXTCODEHASH or
    /// EXTCODECOPY. Shadow code is other code, so a contract that checks
    /// what runs at an address (a bot verifying a pair's code hash, say)
    /// may refuse it.
    pub read_code: bool,
    /// The outcome of the first call into `focus` (when nonzero): its
    /// status and output, once `focused`.
    pub focus: u256,
    pub focused: bool,
    pub focus_status: i32,
    pub focus_output: MemBuffer,
    /// Every call of the run (see `CallRecord`).
    pub calls: MemVec<CallRecord>,
    /// Indexes into `calls`, in the order the calls ended.
    pub ended: MemVec<usize>,
    /// The accounts whose code to measure coverage of, and for each
    /// program counter they ran, a 1 (a byte per offset).
    pub cover: MemVec<u256>,
    pub covered: MemVec<u8>,
    /// The gas the covered code spent on each opcode (indexed by opcode),
    /// in calls to `op_selector` (0 for any). A call's own cost is left out,
    /// with the gas the called code used.
    pub op_gas: MemVec<u64>,
    pub op_selector: u32,
    /// Whether to keep each call's calldata and output in `bytes`.
    pub keep: bool,
    pub bytes: MemBuffer,
    /// Gas used per function of the code at the watched address, whichever
    /// code runs there: the deployed contract or the shadow port.
    pub profile: MemVec<SelectorGas>,
}

impl GasWatch {
    pub fn new(shadows: MemVec<u256>) -> Self {
        var own_copy: MemVec<u256> = MemVec::new()
        for i in 0 .. shadows.len() {
            own_copy.push(shadows[i])
        }
        GasWatch {
            shadows: own_copy,
            frames: MemVec::new(),
            shadow_ran: false,
            observed: false,
            read_blockhash: false,
            read_code: false,
            focus: 0,
            focused: false,
            focus_status: 0,
            focus_output: MemBuffer::empty(),
            calls: MemVec::new(),
            ended: MemVec::new(),
            cover: MemVec::new(),
            covered: MemVec::new(),
            op_gas: MemVec::new(),
            op_selector: 0,
            keep: false,
            bytes: MemBuffer::empty(),
            profile: MemVec::new(),
        }
    }
}

fn is_shadow(_ shadows: MemVec<u256>, _ address: u256) -> bool {
    for i in 0 .. shadows.len() {
        if shadows[i] == address {
            return true
        }
    }
    false
}

impl Tracer for GasWatch {
    fn step(mut self, _ step: Step) {
        if step.op == OP_BLOCKHASH {
            self.read_blockhash = true
        }
        match self.frames.last() {
            Option::Some(ref frame) => {
                if (step.op == OP_EXTCODEHASH || step.op == OP_EXTCODECOPY)
                    && self.shadows.len() > 0
                    && !frame.shadow {
                    self.read_code = true
                }
                if step.op == OP_GAS && self.shadow_ran && !frame.shadow {
                    self.observed = true
                    self.calls[frame.record].read_gas = true
                }
                if frame.covered {
                    while self.covered.len() <= step.pc {
                        self.covered.push(0)
                    }
                    self.covered[step.pc] = 1
                }
            },
            Option::None => {},
        }
        // Gas per opcode: what the frame's last opcode cost, seen from the
        // gas left now.
        let depth = self.frames.len()
        if depth > 0 {
            let top = depth - 1
            let frame = self.frames[top]
            if frame.covered && (self.op_selector == 0 || frame.selector == self.op_selector) {
                if frame.has_last && frame.last_gas >= step.gas {
                    while self.op_gas.len() < 256 {
                        self.op_gas.push(0)
                    }
                    self.op_gas[frame.last_op as usize] += frame.last_gas - step.gas
                }
                self.frames[top].last_op = step.op
                self.frames[top].last_gas = step.gas
                self.frames[top].has_last = true
            }
        }
    }

    fn enter(mut self, _ call: CallStart, input: MemSpan) {
        if is_shadow(self.shadows, call.to) {
            self.shadow_ran = true
        }
        var selector: u32 = 0
        if input.len() >= 4 {
            for i in 0 .. 4 {
                selector = (selector << 8) | input[i] as u32
            }
        }
        let record = self.calls.len()
        let input_at = self.bytes.len()
        if self.keep {
            for i in 0 .. input.len() {
                if i < KEPT {
                    self.bytes.push(input[i])
                }
            }
        }
        let input_len = self.bytes.len() - input_at
        let parent = match self.frames.last() {
            Option::Some(ref frame) => frame.record,
            Option::None => NO_PARENT,
        }
        self.calls
            .push(
                CallRecord {
                    depth: call.depth,
                    parent,
                    read_gas: false,
                    context: if call.kind == OP_DELEGATECALL || call.kind == OP_CALLCODE {
                        call.from
                    } else {
                        call.to
                    },
                    kind: call.kind,
                    value: call.value,
                    gas: call.gas,
                    used: 0,
                    input_at,
                    input_len,
                    output_at: 0,
                    output_len: 0,
                    to: call.to,
                    selector,
                    input: fingerprint(input),
                    status: -1,
                    output: 0,
                },
            )
        let shadow = is_shadow(self.shadows, call.to)
        let covered = is_shadow(self.cover, call.to)
        // The caller's call opcode is not measured: the gas it spends
        // includes what the callee uses.
        let depth = self.frames.len()
        if depth > 0 {
            self.frames[depth - 1].has_last = false
        }
        self.frames
            .push(
                Frame {
                    to: call.to,
                    selector,
                    gas: call.gas,
                    record,
                    shadow,
                    covered,
                    last_op: 0,
                    last_gas: 0,
                    has_last: false,
                },
            )
    }

    fn leave(mut self, _ call: CallEnd, output: MemSpan) {
        match self.frames.pop() {
            Option::Some(frame) => {
                self.calls[frame.record].status = call.status
                self.calls[frame.record].output = fingerprint(output)
                if frame.gas >= call.gas {
                    self.calls[frame.record].used = frame.gas - call.gas
                }
                if self.keep {
                    self.calls[frame.record].output_at = self.bytes.len()
                    for i in 0 .. output.len() {
                        if i < KEPT {
                            self.bytes.push(output[i])
                        }
                    }
                    self.calls[frame.record].output_len = self.bytes.len() -
                        self.calls[frame.record].output_at
                }
                self.ended.push(frame.record)
                if self.focus != 0 && !self.focused && frame.to == self.focus {
                    self.focused = true
                    self.focus_status = call.status
                    self.focus_output = MemBuffer::from_span(output)
                }
                if is_shadow(self.shadows, frame.to) && frame.gas >= call.gas {
                    record(
                        mut self.profile,
                        frame.selector,
                        calls: 1,
                        gas: frame.gas - call.gas,
                    )
                }
            },
            Option::None => {},
        }
    }
}
