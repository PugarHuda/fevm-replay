//! The certificate page: what one `certify` run found about a port, as a
//! self-contained HTML file.

use core::{MemBuffer, MemSpan}
use std::io::Display

/// Writes `value` with `<`, `>`, `&` and `"` escaped for HTML.
pub fn escape(_ value: MemSpan) uses (html: mut MemBuffer) {
    for i in 0 .. value.len() {
        let b = value[i]
        if b == 0x3c {
            "&lt;".fmt(mut html)
        } else if b == 0x3e {
            "&gt;".fmt(mut html)
        } else if b == 0x26 {
            "&amp;".fmt(mut html)
        } else if b == 0x22 {
            "&quot;".fmt(mut html)
        } else {
            html.push(b)
        }
    }
}

/// The page up to its body's first section: title, styles and header.
pub fn open<C: Display>(_ name: C) uses (html: mut MemBuffer) {
    "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n".fmt(mut html)
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n".fmt(mut html)
    "<title>".fmt(mut html)
    name.fmt(mut html)
    " port certificate</title>\n<style>\n".fmt(mut html)
    ":root{--paper:#f2f4f3;--ink:#1f2624;--steel:#5b6b73;--rule:#c9d1ce;--match:#2e8b6f;--diff:#c9961a;--code:#e9edeb}\n"
        .fmt(mut html)
    "@media (prefers-color-scheme:dark){:root{--paper:#161b1a;--ink:#e4e9e7;--steel:#93a3aa;--rule:#34403d;--match:#4fb894;--diff:#e0b03a;--code:#1f2725}}\n"
        .fmt(mut html)
    "*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,sans-serif}\n"
        .fmt(mut html)
    "main{width:min(880px,100% - 2rem);margin:2rem auto 4rem}h1{font-size:clamp(1.8rem,5vw,2.6rem);line-height:1.1;letter-spacing:-.02em;margin:.25rem 0 1rem}\n"
        .fmt(mut html)
    "h2{margin-top:2.5rem;padding-top:1rem;border-top:1px solid var(--rule);font-size:1.2rem}.kicker{color:var(--steel);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:.8rem}\n"
        .fmt(mut html)
    "code,.mono{font-family:ui-monospace,monospace;font-size:.85em;overflow-wrap:anywhere}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}\n"
        .fmt(mut html)
    "th,td{text-align:left;padding:.45rem .6rem .45rem 0;border-bottom:1px solid var(--rule);vertical-align:top}th{color:var(--steel);font-weight:600}td.n,th.n{text-align:right}\n"
        .fmt(mut html)
    ".verdict{border-left:4px solid var(--match);padding:.6rem 1rem;background:color-mix(in srgb,var(--match) 12%,transparent);font-size:1.1rem}.verdict.bad{border-color:var(--diff);background:color-mix(in srgb,var(--diff) 15%,transparent)}\n"
        .fmt(mut html)
    ".note{color:var(--steel);font-size:.92rem}pre{background:var(--code);padding:.8rem;overflow-x:auto;font-size:.8rem}.scroll{overflow-x:auto}\n"
        .fmt(mut html)
    "</style>\n</head>\n<body>\n<main>\n<div class=\"kicker\">Fe port certificate</div>\n<h1>"
        .fmt(mut html)
    name.fmt(mut html)
    "</h1>\n".fmt(mut html)
}

/// A table row of a label and a number.
pub fn row<L: Display>(_ label: L, _ value: u64) uses (html: mut MemBuffer) {
    "<tr><th>".fmt(mut html)
    label.fmt(mut html)
    "</th><td class=\"n\">".fmt(mut html)
    value.fmt(mut html)
    "</td></tr>\n".fmt(mut html)
}

/// `part` of `whole` as a percentage with one decimal.
pub fn percent(_ part: u64, _ whole: u64) uses (html: mut MemBuffer) {
    let permille = if whole == 0 { 0 } else { part * 1000 / whole }
    (permille / 10).fmt(mut html)
    ".".fmt(mut html)
    (permille % 10).fmt(mut html)
    "%".fmt(mut html)
}

/// The end of the page.
pub fn close() uses (html: mut MemBuffer) {
    "<p class=\"note\">Made by <a href=\"https://github.com/PugarHuda/fevm-replay\">fevm-replay</a> <code>certify</code>, written in Fe and running fevm, the EVM written in Fe.</p>\n"
        .fmt(mut html)
    "</main>\n</body>\n</html>\n".fmt(mut html)
}
