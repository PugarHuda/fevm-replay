//! Merkle-Patricia proofs (EIP-1186, `eth_getProof`) checked against a state
//! root, and block headers checked against their hash. Nothing here reaches
//! the network or the disk: proofs saved beside a block verify offline, and
//! what they prove rests on the block hash alone, not on the node that sent
//! them.
//!
//! RLP decoding is std's (`std::evm::rlp`), hashing core's Keccak.

use core::{MemBuffer, MemSpan, MemVec}
use core::hash::keccak256_word
use core::text::parse_hex_uint
use fevm::WorldState
use std::io::Display
use std::evm::rlp
use json::Value
use ingot::load::{field, hex_bytes, hex_word}

/// keccak256 of no bytes: the code hash of an account without code.
pub const EMPTY_CODE: u256 = 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470
/// The root of an empty trie: the storage root of an account without storage.
pub const EMPTY_TRIE: u256 = 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421

/// An account as the state trie holds it.
pub struct Account {
    pub nonce: u256,
    pub balance: u256,
    pub storage_root: u256,
    pub code_hash: u256,
}

impl Copy for Account {}

// Up to 32 bytes, big-endian, leading zeros allowed (hashes may have them).
fn word(_ bytes: MemSpan) -> u256 {
    var value: u256 = 0
    for i in 0 .. bytes.len() {
        value = (value << 8) | (bytes[i] as u256)
    }
    value
}

// The `n`th of the 64 nibbles of a 32-byte key.
fn nibble(_ key: u256, _ n: usize) -> u256 {
    (key >> (4 * (63 - n) as u256)) & 0xf
}

// The nibbles of a hex-prefix encoded path (the first item of a leaf or an
// extension), checked against `key` from nibble `at`. Returns how many
// nibbles the path has, whether they all match, and whether it ends a leaf.
fn compare_path(_ encoded: MemSpan, _ key: u256, at: usize) -> Option<(usize, bool, bool)> {
    if encoded.len() == 0 {
        return Option::None
    }
    let flag = encoded[0] >> 4
    if flag > 3 {
        return Option::None
    }
    let leaf = flag >= 2
    let odd = flag % 2 == 1
    let count = (encoded.len() - 1) * 2 + if odd { 1 } else { 0 }
    var same = at + count <= 64
    var n: usize = 0
    while same && n < count {
        // The odd path's first nibble shares the flag's byte.
        let position = if odd { n + 1 } else { n + 2 }
        let byte = encoded[position / 2]
        let digit = if position % 2 == 0 {
            byte >> 4
        } else {
            byte & 0xf
        }
        same = digit as u256 == nibble(key, at + n)
        n += 1
    }
    Option::Some((count, same, leaf))
}

/// Walks `proof` (the node list `eth_getProof` returns, as hex strings) from
/// `root` along the 32-byte `key`. `None` if the proof does not hold: a node
/// whose hash is not the one its parent names, a malformed node, or nodes
/// left over. Otherwise `Some(None)` if the trie proves the key absent, or
/// `Some(Some(value))` with the value's bytes.
pub fn walk(root: u256, key: u256, _ proof: Value) -> Option<Option<MemBuffer>> {
    let entries = proof.items()
    // An empty trie has no node to show: every key is absent.
    if root == EMPTY_TRIE && entries.len() == 0 {
        return Option::Some(Option::None)
    }
    var next: usize = 0
    var expected = root
    var depth: usize = 0
    // The node to read: the next proof entry, whose hash its parent named,
    // or a child under 32 bytes that its parent held inline.
    var buffer = MemBuffer::empty()
    var from_proof = true
    while true {
        if from_proof {
            if next == entries.len() {
                return Option::None
            }
            buffer = hex_bytes(entries[next].text())
            next += 1
            if keccak256_word(buffer.span()) != expected {
                return Option::None
            }
        }
        let input = buffer.span()
        let items = rlp::decode(input)?.items(input)?
        var which: usize = 1
        if items.len() == 17 {
            if depth == 64 {
                return Option::None
            }
            which = nibble(key, depth).downcast_unchecked()
            depth += 1
        } else if items.len() == 2 {
            let (count, same, leaf) = compare_path(items[0].as_bytes(input)?, key, at: depth)?
            if !same {
                // The path leaves the key: nothing is stored under it.
                return if next == entries.len() {
                    Option::Some(Option::None)
                } else {
                    Option::None
                }
            }
            depth += count
            if leaf {
                if depth != 64 || next != entries.len() {
                    return Option::None
                }
                return Option::Some(Option::Some(copy(items[1].as_bytes(input)?)))
            }
        } else {
            return Option::None
        }
        let child = items[which]
        if child.is_list() {
            // Inline: rebuilt with its one-byte list header (under 32 bytes).
            let payload = child.payload(input)
            var inline = MemBuffer::empty()
            inline.push((0xc0 + payload.len()).downcast_unchecked())
            for i in 0 .. payload.len() {
                inline.push(payload[i])
            }
            buffer = inline
            from_proof = false
        } else {
            let reference = child.as_bytes(input)?
            if reference.len() == 0 {
                // An empty branch slot: the key is not in the trie.
                return if next == entries.len() {
                    Option::Some(Option::None)
                } else {
                    Option::None
                }
            }
            if reference.len() != 32 {
                return Option::None
            }
            expected = word(reference)
            from_proof = true
        }
    }
    Option::None
}

fn copy(_ bytes: MemSpan) -> MemBuffer {
    var out = MemBuffer::empty()
    for i in 0 .. bytes.len() {
        out.push(bytes[i])
    }
    out
}

// The 32-byte trie key of the first `len` bytes of `value`, as a word.
fn hashed(_ value: u256, len: usize) -> u256 {
    var bytes = MemBuffer::with_capacity(32)
    bytes.write_word(offset: 0, value: value << (8 * (32 - len) as u256))
    bytes.truncate(len)
    keccak256_word(bytes.span())
}

/// The account at `address` under `state_root`, from its account proof. An
/// account the trie does not hold reads as empty. `None` if the proof does
/// not hold.
pub fn account(state_root: u256, address: u256, _ proof: Value) -> Option<Account> {
    let Option::Some(value) = walk(
        root: state_root,
        key: hashed(address, len: 20),
        proof,
    )? else {
        return Option::Some(
            Account { nonce: 0, balance: 0, storage_root: EMPTY_TRIE, code_hash: EMPTY_CODE },
        )
    }
    let input = value.span()
    let fields = rlp::decode(input)?.items(input)?
    if fields.len() != 4 {
        return Option::None
    }
    Option::Some(
        Account {
            nonce: fields[0].as_uint(input)?,
            balance: fields[1].as_uint(input)?,
            storage_root: word(fields[2].as_bytes(input)?),
            code_hash: word(fields[3].as_bytes(input)?),
        },
    )
}

/// The value of `slot` under an account's `storage_root`, from its storage
/// proof; zero if the trie does not hold it. `None` if the proof does not
/// hold.
pub fn slot(storage_root: u256, slot: u256, _ proof: Value) -> Option<u256> {
    let Option::Some(value) = walk(
        root: storage_root,
        key: hashed(slot, len: 32),
        proof,
    )? else {
        return Option::Some(0)
    }
    let input = value.span()
    rlp::decode(input)?.as_uint(input)
}

fn hex_field(_ value: Value) -> core::abi::Bytes {
    rlp::encode_bytes(hex_bytes(value.text()).span())
}

fn number_field(_ value: Value) -> core::abi::Bytes {
    rlp::encode_uint(hex_word(value))
}

/// keccak256 of the RLP of a post-Prague header (`eth_getBlockByNumber`'s
/// result): the block hash it must carry.
pub fn header_hash(_ header: Value) -> u256 {
    let encoded = rlp::encode_list(
        [
            hex_field(header["parentHash"]),
            hex_field(header["sha3Uncles"]),
            hex_field(header["miner"]),
            hex_field(header["stateRoot"]),
            hex_field(header["transactionsRoot"]),
            hex_field(header["receiptsRoot"]),
            hex_field(header["logsBloom"]),
            number_field(header["difficulty"]),
            number_field(header["number"]),
            number_field(header["gasLimit"]),
            number_field(header["gasUsed"]),
            number_field(header["timestamp"]),
            hex_field(header["extraData"]),
            hex_field(header["mixHash"]),
            hex_field(header["nonce"]),
            number_field(header["baseFeePerGas"]),
            hex_field(header["withdrawalsRoot"]),
            number_field(header["blobGasUsed"]),
            number_field(header["excessBlobGas"]),
            hex_field(header["parentBeaconBlockRoot"]),
            hex_field(header["requestsHash"]),
        ],
    )
    keccak256_word(encoded.span())
}

/// Every account and slot a block touched, as a set: a world whose accounts
/// are the addresses and whose nonzero slots mark the slots. From each
/// transaction's prestate and diff (`prestates` and `diffs` are the saved
/// responses' `result` lists), and with `recipients` the header's
/// withdrawal recipients, which enter the world only at the block's end.
pub fn touched(
    _ prestates: Value,
    _ diffs: Value,
    _ header: Value,
    recipients: bool,
) -> WorldState {
    var keys = WorldState::empty()
    for i in 0 .. prestates.items().len() {
        mark(mut keys, prestates[i]["result"])
        mark(mut keys, diffs[i]["result"]["post"])
    }
    if recipients && header.has("withdrawals") {
        for ref w in header["withdrawals"].items() {
            let _ = keys.ensure_account(field(w, "address"))
        }
    }
    keys
}

fn mark(_ keys: mut WorldState, _ accounts: Value) {
    for ref member in accounts.members() {
        let address = parse_hex_uint(member.key.span()).unwrap_or(default: 0)
        let _ = keys.ensure_account(address)
        if member.value.has("storage") {
            for ref slot in member.value["storage"].members() {
                let _ = keys
                    .storage_store(
                        address,
                        parse_hex_uint(slot.key.span()).unwrap_or(default: 0),
                        1,
                    )
            }
        }
    }
}

/// The slots of `address` in a set made by `touched`.
 // ponytail: scans every slot per account, O(accounts x slots); fine for a
// block (about 10^7 steps), index by address if blocks grow.
pub fn slots_of(_ keys: WorldState, _ address: u256) -> MemVec<u256> {
    var slots: MemVec<u256> = MemVec::new()
    for position in 0 .. keys.storage_slots() {
        let entry = keys.storage_at(position)
        if entry.occupied && entry.address == address {
            slots.push(entry.slot)
        }
    }
    slots
}

/// A slot a system call writes before the block's transactions run.
pub struct Written { pub address: u256, pub slot: u256, pub value: u256 }

impl Copy for Written {}

pub const BEACON_ROOTS: u256 = 0x000f3df6d732807ef1319fb7b8bb8522d0beac02
pub const HISTORY: u256 = 0x0000f90827f1c53a10cb7a02335b175320002935
pub const WITHDRAWAL_REQUESTS: u256 = 0x00000961ef480eb55e80d19ad83579a64c007002
pub const CONSOLIDATION_REQUESTS: u256 = 0x0000bbddc7ce488642fb579f8b00f3a590007251
const HISTORY_LENGTH: u256 = 8191

/// What the block's first system calls write: EIP-4788 stores the timestamp
/// and the parent beacon root in its ring buffer, EIP-2935 the parent hash
/// in its own. A transaction that reads these slots sees the new values,
/// so the parent's state root holds the old ones.
pub fn system_writes(_ header: Value) -> MemVec<Written> {
    let timestamp = field(header, "timestamp")
    let number = field(header, "number")
    var writes: MemVec<Written> = MemVec::new()
    writes
        .push(
            Written { address: BEACON_ROOTS, slot: timestamp % HISTORY_LENGTH, value: timestamp },
        )
    writes
        .push(
            Written {
                address: BEACON_ROOTS,
                slot: timestamp % HISTORY_LENGTH + HISTORY_LENGTH,
                value: field(header, "parentBeaconBlockRoot"),
            },
        )
    writes
        .push(
            Written {
                address: HISTORY,
                slot: (number - 1) % HISTORY_LENGTH,
                value: field(header, "parentHash"),
            },
        )
    writes
}

/// What checking a world against proofs found.
pub struct Checked {
    pub accounts: u64,
    pub slots: u64,
    /// Values that differ from what the proofs prove.
    pub differ: u64,
    /// Slots a system call wrote, checked against what it writes.
    pub written: u64,
    /// Accounts left out on purpose (`skip`).
    pub skipped: u64,
    /// Touched accounts and slots without a proof.
    pub unproven: u64,
    /// Proofs that do not hold.
    pub broken: u64,
}

impl Copy for Checked {}

/// Checks `world` against `proofs` (`eth_getProof` results) under
/// `state_root`, for every account and slot in `keys`: nonce, balance, code
/// hash and storage. A slot in `written` is checked against the system
/// call's value instead; an account in `skip` is not checked, nor the code
/// of one in `code_unknown` (an account the world holds without its code).
pub fn check(
    _ world: WorldState,
    state_root: u256,
    _ proofs: Value,
    _ keys: WorldState,
    written: MemVec<Written>,
    skip: MemVec<u256>,
    code_unknown: MemVec<u256>,
) -> Checked
uses (text: mut MemBuffer)
{
    var found = Checked {
        accounts: 0,
        slots: 0,
        differ: 0,
        written: 0,
        skipped: 0,
        unproven: 0,
        broken: 0,
    }
    var seen = WorldState::empty()
    for ref result in proofs.items() {
        let address = field(result, "address")
        // Proofs of other accounts (there are more at the block's end) are
        // not this check's.
        if !keys.exists(address) {
            continue
        }
        let _ = seen.ensure_account(address)
        var skipped = false
        for k in 0 .. skip.len() {
            if skip[k] == address {
                skipped = true
            }
        }
        for ref entry in result["storageProof"].items() {
            let _ = seen.storage_store(address, field(entry, "key"), 1)
        }
        if skipped {
            found.skipped += 1
            continue
        }
        let Option::Some(proven) = account(state_root, address, result["accountProof"]) else {
            found.broken += 1
            line("BROKEN account proof", address, 0, 0, 0)
            continue
        }
        found.accounts += 1
        let exists = world.exists(address)
        let nonce = if exists { world.nonce(address) } else { 0 }
        let balance = if exists { world.balance(address) } else { 0 }
        var code_hash = keccak256_word(world.code(address))
        for k in 0 .. code_unknown.len() {
            if code_unknown[k] == address {
                code_hash = proven.code_hash
            }
        }
        if proven.nonce != nonce || proven.balance != balance || proven.code_hash != code_hash {
            found.differ += 1
            if proven.nonce != nonce {
                line("DIFF  nonce", address, 0, proven.nonce, nonce)
            }
            if proven.balance != balance {
                line("DIFF  balance", address, 0, proven.balance, balance)
            }
            if proven.code_hash != code_hash {
                line("DIFF  code hash", address, 0, proven.code_hash, code_hash)
            }
        }
        for ref entry in result["storageProof"].items() {
            let key = field(entry, "key")
            let actual = world.storage_load(address, key)
            var system = false
            for w in 0 .. written.len() {
                if written[w].address == address && written[w].slot == key {
                    system = true
                    found.written += 1
                    if written[w].value != actual {
                        found.differ += 1
                        line(
                            "DIFF  system call slot",
                            address,
                            key,
                            written[w].value,
                            actual,
                        )
                    }
                }
            }
            if system { continue }
            let Option::Some(value) = slot(
                storage_root: proven.storage_root,
                slot: key,
                entry["proof"],
            ) else {
                found.broken += 1
                line("BROKEN storage proof", address, key, 0, 0)
                continue
            }
            found.slots += 1
            if value != actual {
                found.differ += 1
                line("DIFF  slot", address, key, value, actual)
            }
        }
    }
    for k in 0 .. keys.account_count() {
        if !seen.exists(keys.account_at(k).address) {
            found.unproven += 1
        }
    }
    for position in 0 .. keys.storage_slots() {
        let entry = keys.storage_at(position)
        if entry.occupied && seen.storage_load(entry.address, entry.slot) == 0 {
            found.unproven += 1
        }
    }
    found
}

fn line(_ what: String<24>, _ address: u256, _ slot: u256, _ proven: u256, _ actual: u256)
uses (text: mut MemBuffer)
{
    what.fmt(mut text)
    " 0x".fmt(mut text)
    core::text::hex(address, 20).fmt(mut text)
    if slot != 0 {
        " slot 0x".fmt(mut text)
        core::text::hex(slot, 32).fmt(mut text)
    }
    if proven != 0 || actual != 0 {
        ": proven 0x".fmt(mut text)
        core::text::hex(proven, 32).fmt(mut text)
        ", fevm 0x".fmt(mut text)
        core::text::hex(actual, 32).fmt(mut text)
    }
    "\n".fmt(mut text)
}

/// The account at `address` as `proofs` prove it under `state_root`; None
/// if no proof names it or its proof does not hold.
pub fn find_account(_ proofs: Value, state_root: u256, address: u256) -> Option<Account> {
    for ref result in proofs.items() {
        if field(result, "address") == address {
            return account(state_root, address, result["accountProof"])
        }
    }
    Option::None
}
