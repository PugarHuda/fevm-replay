{
  "ci": {
    "collect": {
      "url": [
        "https://fevm-replay.vercel.app/",
        "https://fevm-replay.vercel.app/verify.html",
        "https://fevm-replay.vercel.app/stateless.html",
        "https://fevm-replay.vercel.app/glamsterdam.html",
        "https://fevm-replay.vercel.app/upstream.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["error", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lhci" }
  }
}
