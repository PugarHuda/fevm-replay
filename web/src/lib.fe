//! fevm-replay's Merkle-Patricia proof check, built for the browser with
//! `fe build --backend wasm`: the same `mpt` ingot the native tool checks
//! every stateless block with. The host hands over one `eth_getProof`
//! answer and the state root of a block's header; `verify` walks the account
//! proof to that root, then the storage proof to the account's storage
//! root, and prints what the proofs prove.
use core::ptr::MemArray
use core::text::{decimal, hex, parse_hex_uint}
use std::io::Stdout
use std::wasm::{HostText, Reply}
use std::wasm::files::{Files, close, open, read, size}
use json::{Value, parse}
use replay_core::validate::{SystemPorts, validate}
use replay_core::{load, proof}

fn number(_ value: Value) -> u256 {
    parse_hex_uint(value.text()).unwrap_or(default: 0)
}

/// The whole of the host's file `name`, or the error code reading it gave.
fn read_all(_ name: HostText) -> Result<u32, MemArray<u8>>
uses (files: mut Files)
{
    let handle = match open(name.copy()) {
        Result::Ok(handle) => handle,
        Result::Err(error) => {
            return Result::Err(error.code())
        },
    }
    let length = match size(handle) {
        Result::Ok(length) => length,
        Result::Err(error) => {
            return Result::Err(error.code())
        },
    }
    var data: MemArray<u8> = MemArray::new_zeroed(length as usize)
    var offset: u32 = 0
    while offset < length {
        match read(
            handle,
            offset,
            mut data.as_slice().slice(offset: offset as usize, len: (length - offset) as usize),
        ) {
            Result::Ok(count) => {
                if count == 0 { break }
                offset += count
            },
            Result::Err(error) => {
                close(handle)
                return Result::Err(error.code())
            },
        }
    }
    close(handle)
    Result::Ok(data)
}

/// Checks the proof file `name` (`{"stateRoot", "address", "accountProof",
/// "storageProof": [{"key", "value", "proof"}]}`). Replies 1 if every proof
/// holds and every value is the one claimed, 0 if not, and an error code if
/// the file cannot be read or parsed.
#[unsafe(export)]
pub fn verify(name: HostText) -> Reply uses (files: mut Files, out: mut Stdout) {
    let data = match read_all(name) {
        Result::Ok(data) => data,
        Result::Err(code) => {
            return Reply::error(code)
        },
    }
    let Result::Ok(doc) = parse(data.as_slice()) else {
        return Reply::error(100)
    }
    let state_root = number(doc["stateRoot"])
    let address = number(doc["address"])
    println!("state root  0x", hex(state_root, 32))
    println!("account     0x", hex(address, 20))
    let Option::Some(account) = mpt::account(
        state_root: state_root,
        address: address,
        doc["accountProof"],
    ) else {
        println!("the account proof does NOT hold under this state root")
        return Reply::ok(0)
    }
    println!(
        "proven      nonce ",
        decimal(account.nonce),
        ", balance ",
        decimal(account.balance),
        " wei",
    )
    println!(
        "            storage root 0x",
        hex(account.storage_root, 32),
    )
    println!("            code hash    0x", hex(account.code_hash, 32))
    var all = true
    for ref entry in doc["storageProof"].items() {
        let key = number(entry["key"])
        match mpt::slot(
            storage_root: account.storage_root,
            slot: key,
            entry["proof"],
        ) {
            Option::Some(value) => {
                let same = value == number(entry["value"])
                println!(
                    "slot        0x",
                    hex(key, 32),
                    " = 0x",
                    hex(value, 32),
                    if same {
                        "  proven"
                    } else {
                        "  NOT the value claimed"
                    },
                )
                all = all && same
            },
            Option::None => {
                println!(
                    "slot        0x",
                    hex(key, 32),
                    ": the storage proof does NOT hold",
                )
                all = false
            },
        }
    }
    Reply::ok(if all { 1 } else { 0 })
}

/// Validates a mainnet block statelessly: `name` is one JSON file holding
/// what a node said about the block (`chain`, `block`, `receipts`,
/// `prestate`, `diff`, `delegates`) and the parent's and the block's proofs
/// (`proofs`). fevm, compiled into this module, runs the block's system
/// calls and transactions on the pre-state the parent's proofs prove, and
/// every root in the header is checked: the same `validate` the native
/// tool runs. Replies 1 if every transaction matched and every root held.
#[unsafe(export)]
pub fn validate_block(name: HostText) -> Reply
uses (files: mut Files, out: mut Stdout)
{
    let data = match read_all(name) {
        Result::Ok(data) => data,
        Result::Err(code) => {
            return Reply::error(code)
        },
    }
    let Result::Ok(doc) = parse(data.as_slice()) else {
        return Reply::error(100)
    }
    let found = validate(
        "block",
        chain: doc["chain"],
        block: doc["block"],
        receipts: doc["receipts"],
        prestates: doc["prestate"],
        diffs: doc["diff"],
        extras: doc["delegates"],
        proofs: doc["proofs"],
        proving: true,
        fetched: fevm::WorldState::empty(),
        ports: SystemPorts::none(),
    )
    let clean = !found.failed
        && found.matched == found.count.downcast_unchecked()
        && found.unknown == 0
        && found.unproven == 0
        && found.stateless_ok
    Reply::ok(if clean { 1 } else { 0 })
}

/// What to prove for a block, as `fetch-proofs` decides it natively: `name`
/// holds the node's `block`, `prestate` and `diff` answers and `queues`, the
/// head and tail of the two request queues at the parent (EIP-7002, then
/// EIP-7251). Prints `{"accounts": [[address, [slot...]]...], "delegates":
/// [address...]}`: every account and slot the block touches, the system
/// contracts' slots and the queue entries their calls read, and the EIP-7702
/// delegation targets the traces leave out. The browser asks a node for
/// exactly these proofs.
#[unsafe(export)]
pub fn witness_keys(name: HostText) -> Reply
uses (files: mut Files, out: mut Stdout)
{
    let data = match read_all(name) {
        Result::Ok(data) => data,
        Result::Err(code) => {
            return Reply::error(code)
        },
    }
    let Result::Ok(doc) = parse(data.as_slice()) else {
        return Reply::error(100)
    }
    let header = ref doc["block"]["result"]
    var keys = proof::touched(
        doc["prestate"]["result"],
        doc["diff"]["result"],
        header,
        recipients: true,
    )
    proof::add_request_keys(mut keys)
    proof::add_system_keys(mut keys, header)
    let queues = doc["queues"].items()
    proof::add_queue_keys(
        mut keys,
        address: proof::WITHDRAWAL_REQUESTS,
        head: number(queues[0]),
        tail: number(queues[1]),
    )
    proof::add_queue_keys(
        mut keys,
        address: proof::CONSOLIDATION_REQUESTS,
        head: number(queues[2]),
        tail: number(queues[3]),
    )
    print!("{\"accounts\":[")
    for a in 0 .. keys.account_count() {
        let address = keys.account_at(a).address
        if a > 0 { print!(",") }
        print!("[\"0x", hex(address, 20), "\",[")
        let slots = proof::slots_of(keys, address)
        for s in 0 .. slots.len() {
            if s > 0 { print!(",") }
            print!("\"0x", hex(slots[s], 32), "\"")
        }
        print!("]]")
    }
    print!("],\"delegates\":[")
    var targets: core::MemVec<u256> = core::MemVec::new()
    let txs = header["transactions"].items()
    for index in 0 .. txs.len() {
        load::collect_delegates(
            txs[index],
            doc["prestate"]["result"][index]["result"],
            mut targets,
        )
    }
    for t in 0 .. targets.len() {
        if t > 0 { print!(",") }
        print!("\"0x", hex(targets[t], 20), "\"")
    }
    println!("]}")
    Reply::ok(1)
}

/// EIP-4762's witness charges for each transaction of a block, as the
/// native tool computes them (`replay_core::gas4762::charge`), for an
/// independent implementation to be checked against: `name` holds the
/// node's `block`, `receipts`, `prestate` and `diff` answers and, if given,
/// `chunks`: per transaction, `{address: ["0x" chunk...]}` of code run. Prints
/// one `[witness, code, writes, coinbase, today]` per transaction.
#[unsafe(export)]
pub fn witness_gas(name: HostText) -> Reply
uses (files: mut Files, out: mut Stdout)
{
    let data = match read_all(name) {
        Result::Ok(data) => data,
        Result::Err(code) => {
            return Reply::error(code)
        },
    }
    let Result::Ok(doc) = parse(data.as_slice()) else {
        return Reply::error(100)
    }
    let header = ref doc["block"]["result"]
    let txs = header["transactions"].items()
    let receipts = doc["receipts"]["result"].items()
    let prestates = doc["prestate"]["result"].items()
    let diffs = doc["diff"]["result"].items()
    print!("[")
    for t in 0 .. txs.len() {
        var chunks = fevm::WorldState::empty()
        if doc.has("chunks") {
            for ref ran in doc["chunks"].items()[t].members() {
                let address = parse_hex_uint(ran.key.span()).unwrap_or(default: 0)
                let _ = chunks.ensure_account(address)
                for ref c in ran.value.items() {
                    let _ = chunks.storage_store(address, number(c), 1)
                }
            }
        }
        let created = load::field(receipts[t], "contractAddress")
        let charged = replay_core::gas4762::charge(
            prestates[t]["result"],
            diffs[t]["result"]["pre"],
            diffs[t]["result"]["post"],
            chunks,
            origin: load::field(txs[t], "from"),
            target: if created != 0 {
                created
            } else {
                load::field(txs[t], "to")
            },
            value: load::field(txs[t], "value"),
            coinbase: load::field(header, "miner"),
        )
        if t > 0 { print!(",") }
        print!(
            "[",
            decimal(charged.witness as u256),
            ",",
            decimal(charged.code as u256),
            ",",
            decimal(charged.writes as u256),
            ",",
            decimal(charged.coinbase as u256),
            ",",
            decimal(charged.today as u256),
            "]",
        )
    }
    println!("]")
    Reply::ok(1)
}

/// fevm's own precompiles, called directly: `name` holds `{"calls":
/// [{"address", "input"}...]}` (hex). Prints one `[status, "0x" output]` per
/// call. The browser's light client checks each sync committee signature
/// here too, with EIP-2537's BLS12-381 precompiles as fevm implements them
/// in Fe (G1 MSM to aggregate the keys, map to G2, the pairing check).
#[unsafe(export)]
pub fn precompiles(name: HostText) -> Reply
uses (files: mut Files, out: mut Stdout)
{
    let data = match read_all(name) {
        Result::Ok(data) => data,
        Result::Err(code) => {
            return Reply::error(code)
        },
    }
    let Result::Ok(doc) = parse(data.as_slice()) else {
        return Reply::error(100)
    }
    print!("[")
    var first = true
    for ref call in doc["calls"].items() {
        let address = number(call["address"])
        if !fevm_precompiles::is_precompile(address) {
            return Reply::error(101)
        }
        let input = load::hex_bytes(call["input"].text())
        let result = fevm_precompiles::run(address, input, gas: 1000000000000)
        if !first { print!(",") }
        first = false
        print!("[", decimal(result.status as u256), ",\"0x")
        for i in 0 .. result.output.len() {
            print!(hex(result.output[i] as u256, 1))
        }
        print!("\"]")
    }
    println!("]")
    Reply::ok(1)
}

struct Ran {
    valid: bool,
    ok: bool,
    status: i32,
    invalid: i32,
    gas: u64,
    state: u64,
}

impl Copy for Ran {}

// One transaction on its traced pre-state under `config`, with gas limit
// `limit`; unpriced (and the base fee check off) to try limits its sender
// could not pay for.
fn run_one(
    _ prestate: Value,
    _ env: fevm::BlockEnv,
    _ parent: u256,
    _ tx: Value,
    _ base: fevm::Config,
    _ limit: u64,
    _ priced: bool,
) -> Ran {
    let none = core::MemBuffer::empty()
    var tracer = ()
    var buffers = fevm::Buffers::new()
    let input = load::hex_bytes(tx["input"].text())
    var request = load::load_tx_with(tx, input: input.span(), priced)
    request.env.gas_limit = limit
    var config = base
    if !priced {
        config.check_base_fee = false
    }
    let r = replay_core::compat::transact(
        replay_core::replay::build_world(prestate, env, parent, Value::object(), core::MemVec::new(), none.span()),
        request,
        env,
        config,
        mut buffers,
        mut tracer,
    )
    let valid = r.receipt.invalid == fevm::status::VALID
    Ran {
        valid,
        ok: valid && r.receipt.status == fevm::OK,
        status: r.receipt.status,
        invalid: r.receipt.invalid,
        gas: r.receipt.gas_used,
        state: r.receipt.state_gas_used,
    }
}

fn ran_json(_ r: Ran) uses (out: mut Stdout) {
    print!(
        "{\"valid\":",
        if r.valid { "true" } else { "false" },
        ",\"ok\":",
        if r.ok { "true" } else { "false" },
        ",\"status\":",
        decimal(r.status.downcast_unchecked()),
        ",\"invalid\":",
        decimal(r.invalid.downcast_unchecked()),
        ",\"gas\":",
        decimal(r.gas as u256),
        ",\"state\":",
        decimal(r.state as u256),
        "}",
    )
}

/// One mainnet transaction under Osaka and under Glamsterdam's execution
/// rules (`Config::amsterdam()`): `name` holds `{chain, block, tx, prestate}`
/// (the chain id, the block's header, the transaction and its prestate
/// trace). Prints both outcomes and, if it would no longer succeed, the
/// least gas limit under which it would.
#[unsafe(export)]
pub fn amsterdam_tx(name: HostText) -> Reply
uses (files: mut Files, out: mut Stdout)
{
    let data = match read_all(name) {
        Result::Ok(data) => data,
        Result::Err(code) => {
            return Reply::error(code)
        },
    }
    let Result::Ok(doc) = parse(data.as_slice()) else {
        return Reply::error(100)
    }
    let header = ref doc["block"]
    let env = load::load_block(
        header,
        chain_id: load::field(doc, "chain"),
        blobbasefee: replay_core::blob::header_blob_fee(header).as_wei(),
    )
    let tx = ref doc["tx"]
    let prestate = ref doc["prestate"]
    let parent = load::field(header, "parentHash")
    let limit: u64 = load::field(tx, "gas").downcast_truncate()
    let osaka = run_one(prestate, env, parent, tx, fevm::Config::osaka(), limit, true)
    let next = run_one(prestate, env, parent, tx, fevm::Config::amsterdam(), limit, true)
    var least: u64 = 0
    var at = next
    if osaka.ok && !next.ok {
        let cap: u64 = 16777216
        if run_one(prestate, env, parent, tx, fevm::Config::amsterdam(), cap, false).ok {
            var lo = limit
            var hi = cap
            while hi - lo > 1 {
                let mid = lo + (hi - lo) / 2
                if run_one(prestate, env, parent, tx, fevm::Config::amsterdam(), mid, false).ok {
                    hi = mid
                } else {
                    lo = mid
                }
            }
            least = hi
            at = run_one(prestate, env, parent, tx, fevm::Config::amsterdam(), hi, false)
        }
    }
    print!("{\"limit\":", decimal(limit as u256), ",\"osaka\":")
    ran_json(osaka)
    print!(",\"amsterdam\":")
    ran_json(next)
    print!(",\"least\":", decimal(least as u256), ",\"at_least\":")
    ran_json(at)
    println!("}")
    Reply::ok(1)
}
