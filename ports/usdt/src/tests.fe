// Run with `fe test .` in ports/usdt. Mainnet behavior is checked by shadow
// replay (see the repository README); these cover what the owner does, which
// mainnet traffic rarely shows.

use ingot::TetherToken

// The calls as any ABI encoder makes them; the token reads them back with
// CALLDATALOAD.
msg Usdt {
    #[selector = sol("balanceOf(address)")]
    BalanceOf { who: Address } -> u256,
    #[selector = sol("transfer(address,uint256)")]
    Transfer { to: Address, value: u256 },
    #[selector = sol("approve(address,uint256)")]
    Approve { spender: Address, value: u256 },
    #[selector = sol("setParams(uint256,uint256)")]
    SetParams { basis_points: u256, max_fee: u256 },
    #[selector = sol("pause()")]
    Pause,
    #[selector = sol("addBlackList(address)")]
    AddBlackList { who: Address },
}

fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<TetherToken>(value: Wei::zero(), args: (1_000_000_000,), salt: 0)
}

fn balance(_ token: Address, _ who: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: token,
        gas: 100000,
        value: Wei::zero(),
        message: Usdt::BalanceOf { who },
    )
}

fn send(_ token: Address, _ message: own Usdt::Transfer) uses (evm: mut Evm) {
    evm.call(addr: token, gas: 200000, value: Wei::zero(), message)
}

#[test]
fn the_creator_holds_the_supply_and_transfers() uses (evm: mut Evm) {
    let usdt = deploy()
    send(
        usdt,
        Usdt::Transfer { to: Address::new(0xbeef), value: 400 },
    )
    assert!(balance(usdt, Address::new(0xbeef)) == 400)
    assert!(balance(usdt, evm.address()) == 1_000_000_000 - 400)
}

// With a fee set, the owner keeps it: 10 basis points of 1,000,000, capped
// at 1 whole token (10^6 units).
#[test]
fn fees_go_to_the_owner() uses (evm: mut Evm) {
    let usdt = deploy()
    evm.call(
        addr: usdt,
        gas: 100000,
        value: Wei::zero(),
        message: Usdt::SetParams { basis_points: 10, max_fee: 1 },
    )
    send(
        usdt,
        Usdt::Transfer { to: Address::new(0xbeef), value: 1_000_000 },
    )
    assert!(balance(usdt, Address::new(0xbeef)) == 999_000)
    // The owner sent 1,000,000 and got the 1,000 fee back.
    assert!(balance(usdt, evm.address()) == 1_000_000_000 - 999_000)
}

#[test(should_revert)]
fn paused_tokens_do_not_move() uses (evm: mut Evm) {
    let usdt = deploy()
    evm.call(
        addr: usdt,
        gas: 100000,
        value: Wei::zero(),
        message: Usdt::Pause {},
    )
    send(
        usdt,
        Usdt::Transfer { to: Address::new(0xbeef), value: 1 },
    )
}

#[test(should_revert)]
fn black_listed_senders_cannot_transfer() uses (evm: mut Evm) {
    let usdt = deploy()
    evm.call(
        addr: usdt,
        gas: 100000,
        value: Wei::zero(),
        message: Usdt::AddBlackList { who: evm.address() },
    )
    send(
        usdt,
        Usdt::Transfer { to: Address::new(0xbeef), value: 1 },
    )
}

// A nonzero allowance must be set to zero before it changes.
#[test(should_revert)]
fn approve_needs_a_zero_allowance_first() uses (evm: mut Evm) {
    let usdt = deploy()
    evm.call(
        addr: usdt,
        gas: 100000,
        value: Wei::zero(),
        message: Usdt::Approve { spender: Address::new(0x5eed), value: 5 },
    )
    evm.call(
        addr: usdt,
        gas: 100000,
        value: Wei::zero(),
        message: Usdt::Approve { spender: Address::new(0x5eed), value: 6 },
    )
}

#[test(should_revert)]
fn transfer_beyond_the_balance_halts() uses (evm: mut Evm) {
    let usdt = deploy()
    send(
        usdt,
        Usdt::Transfer { to: Address::new(0xbeef), value: 1_000_000_001 },
    )
}
